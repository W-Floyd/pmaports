@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * PDAF phase estimation tests
+ */
+
+#include "../src/ipa/libipa/pdaf.h"
+
+#include <cmath>
+#include <iostream>
+#include <random>
+#include <stdint.h>
+#include <vector>
+
+#include "test.h"
+
+using namespace std;
+using namespace libcamera;
+using namespace ipa;
+
+namespace {
+
+/* The S5KJN1 layout: 8x8 blocks, four R/L pairs, R then L in the stream */
+PdafLayout testLayout()
+{
+	using Side = PdafLayout::Side;
+
+	return {
+		.blocks = { 508, 382 },
+		.blockSize = { 8, 8 },
+		.offset = { 8, 8 },
+		.lines = {
+			{ Side::Right, 0, { 2, 0 } }, { Side::Left, 0, { 3, 0 } },
+			{ Side::Right, 1, { 0, 3 } }, { Side::Left, 1, { 1, 3 } },
+			{ Side::Right, 2, { 4, 4 } }, { Side::Left, 2, { 5, 4 } },
+			{ Side::Right, 3, { 6, 7 } }, { Side::Left, 3, { 7, 7 } },
+		},
+		.bitDepth = 10,
+	};
+}
+
+/*
+ * A scene of random vertical texture, seen by the left pixels displaced by
+ * +phase/2 samples and by the right ones by -phase/2, packed as the sensor
+ * sends it (CSI-2 RAW10, 640 bytes per line).
+ */
+vector<uint8_t> makeBuffer(const PdafLayout &layout, double phase, unsigned int bpl)
+{
+	const Size size = layout.bufferSize();
+	mt19937 rng(1234);
+	uniform_real_distribution<double> u(0.0, 1.0);
+
+	/* Smooth random texture, sampled finely (32 steps per sample) */
+	const unsigned int fine = 32;
+	vector<double> tex((size.width + 64) * fine);
+	double v = 0.5;
+	for (double &t : tex) {
+		v = 0.995 * v + 0.005 * u(rng);
+		t = v;
+	}
+	/* Add some edges, at random positions and of random widths */
+	for (unsigned int i = 0; i + 16 * fine < tex.size();
+	     i += static_cast<unsigned int>((20 + 40 * u(rng)) * fine)) {
+		unsigned int w = static_cast<unsigned int>((2 + 10 * u(rng)) * fine);
+		for (unsigned int k = i; k < i + w; k++)
+			tex[k] += 0.3;
+	}
+
+	/* A pixel integrates the light over its width */
+	auto sample = [&](double x) {
+		unsigned int i = static_cast<unsigned int>((x + 32 - 0.5) * fine);
+		double sum = 0.0;
+		for (unsigned int k = 0; k < fine; k++)
+			sum += tex[i + k];
+		return sum / fine;
+	};
+
+	vector<uint8_t> buf(bpl * size.height, 0);
+	vector<uint16_t> line(size.width);
+
+	for (unsigned int y = 0; y < size.height; y++) {
+		const PdafLayout::Line &l = layout.lines[y % layout.lines.size()];
+		double d = l.side == PdafLayout::Side::Left ? -phase / 2 : phase / 2;
+
+		for (unsigned int x = 0; x < size.width; x++)
+			line[x] = static_cast<uint16_t>(64 + 400 * sample(x + d) +
+							 (u(rng) - 0.5) * 2);
+
+		uint8_t *dst = &buf[y * bpl];
+		for (unsigned int x = 0; x + 3 < size.width; x += 4) {
+			uint8_t lsb = 0;
+			for (unsigned int k = 0; k < 4; k++) {
+				dst[x / 4 * 5 + k] = line[x + k] >> 2;
+				lsb |= (line[x + k] & 3) << (2 * k);
+			}
+			dst[x / 4 * 5 + 4] = lsb;
+		}
+	}
+
+	return buf;
+}
+
+} /* namespace */
+
+class PdafTest : public Test
+{
+protected:
+	int run()
+	{
+		const PdafLayout layout = testLayout();
+		const unsigned int bpl = 640;
+
+		if (!layout.isValid() || layout.bufferSize() != Size(508, 3056)) {
+			cout << "Bad layout" << endl;
+			return TestFail;
+		}
+
+		for (double phase : { -3.0, -1.25, 0.0, 0.4, 2.5 }) {
+			vector<uint8_t> buf = makeBuffer(layout, phase, bpl);
+			PdafPhase pdaf(layout, { 4, 3 });
+
+			if (pdaf.process(buf, bpl)) {
+				cout << "process() failed" << endl;
+				return TestFail;
+			}
+
+			PdafData all = pdaf.combined();
+			cout << "phase " << phase << ": measured " << all.phase
+			     << " conf " << all.conf << endl;
+
+			if (all.conf <= 0.0 || std::abs(all.phase - phase) > 0.15) {
+				cout << "Phase " << phase << " measured as "
+				     << all.phase << endl;
+				return TestFail;
+			}
+		}
+
+		/* A flat buffer has no texture, hence no confidence */
+		vector<uint8_t> flat(bpl * 3056, 0x00);
+		PdafPhase pdaf(layout, { 4, 3 });
+		pdaf.process(flat, bpl);
+		if (pdaf.combined().conf != 0.0) {
+			cout << "Confidence on a flat buffer" << endl;
+			return TestFail;
+		}
+
+		/* A buffer too small for the layout is refused */
+		if (pdaf.process(Span<const uint8_t>(flat).first(1000), bpl) != -EINVAL) {
+			cout << "Short buffer accepted" << endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(PdafTest)

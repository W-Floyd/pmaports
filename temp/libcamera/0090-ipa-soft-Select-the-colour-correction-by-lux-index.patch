 namespace libcamera {
 
@@ -36,9 +38,21 @@ public:
 		     ControlList &metadata) override;
 
 private:
+	/* The matrices of one lux index region, by colour temperature */
+	struct LuxSet {
+		Interpolator<Matrix<float, 3, 3>> ccm;
+	};
+
+	Matrix<float, 3, 3> matrixAt(unsigned int ct, double lux);
+
 	unsigned int lastCt_;
+	double lastLux_ = -1.0;
 	Interpolator<Matrix<float, 3, 3>> ccm_;
 	std::optional<Matrix<float, 3, 3>> currentCcm_;
+
+	/* By lux index, if the tuning has them; ccm_ is used otherwise */
+	std::vector<ipa::soft::LuxRange> luxRanges_;
+	std::vector<LuxSet> luxSets_;
 };
 
 } /* namespace ipa::soft::algorithms */

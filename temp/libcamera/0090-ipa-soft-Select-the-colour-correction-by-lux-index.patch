diff --git a/src/ipa/soft/lux.h b/src/ipa/soft/lux.h
new file mode 100644
index 000000000..29d7cece4
--- /dev/null
+++ b/src/ipa/soft/lux.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * Tuning data selected by lux index
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <vector>
+
+namespace libcamera {
+
+namespace ipa::soft {
+
+/*
+ * A tuning file's lux index regions, in Qualcomm's terms: the lux index grows
+ * as the scene darkens, each region holds from its start to its end, and the
+ * data of the two regions either side of a gap between them blends across it.
+ */
+struct LuxRange {
+	double start;
+	double end;
+};
+
+/* The two regions to blend, and the weight of the second */
+struct LuxBlend {
+	unsigned int lo;
+	unsigned int hi;
+	double weight;
+};
+
+/* Ranges are sorted by start, as the converter writes them */
+inline LuxBlend luxBlend(const std::vector<LuxRange> &ranges, double lux)
+{
+	const unsigned int last = ranges.size() - 1;
+
+	for (unsigned int i = 0; i <= last; i++) {
+		if (lux < ranges[i].start) {
+			if (i == 0)
+				return { 0, 0, 0.0 };
+			/* In the gap below this region */
+			const double from = ranges[i - 1].end;
+			const double span = ranges[i].start - from;
+			return { i - 1, i, span > 0 ? std::clamp((lux - from) / span, 0.0, 1.0) : 1.0 };
+		}
+		if (lux <= ranges[i].end)
+			return { i, i, 0.0 };
+	}
+
+	return { last, last, 0.0 };
+}
+
+} /* namespace ipa::soft */
+
+} /* namespace libcamera */

 src/ipa/soft/algorithms/agc.h   | 11 +++++++
 src/ipa/soft/algorithms/ccm.cpp | 48 +++++++++++++++++++++++++--
 src/ipa/soft/algorithms/ccm.h   | 14 ++++++++
 src/ipa/soft/ipa_context.h      |  6 ++++
 src/ipa/soft/lux.h              | 57 +++++++++++++++++++++++++++++++++
 6 files changed, 161 insertions(+), 3 deletions(-)
 create mode 100644 src/ipa/soft/lux.h

diff --git a/src/ipa/soft/algorithms/agc.cpp b/src/ipa/soft/algorithms/agc.cpp
index 4d0ddcdb5..bd708c300 100644
--- a/src/ipa/soft/algorithms/agc.cpp
+++ b/src/ipa/soft/algorithms/agc.cpp
@@ -158,6 +158,24 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 	if (mean.has_value() && *mean > 0.0 && *mean < 1.0)
 		meanTarget_ = *mean;
 
+	/*
+	 * lux: a model of the lux index the vendor tuning's regions are keyed
+	 * by (Qualcomm's AEC, whose own is not public), for the algorithms
+	 * that switch their data by it. The scene's brightness is the exposure
+	 * time x gain that brings the frame to the luma target, and the index
+	 * moves by perStop for each stop of it away from refProduct, that of
+	 * lux index 250 (ordinary indoor light):
+	 *
+	 *   lux:
+	 *     refProduct: 40000   # exposure time in us x analogue gain
+	 *     perStop: 36
+	 */
+	const ValueNode &lux = tuningData["lux"];
+	auto luxRef = lux["refProduct"].get<double>();
+	auto luxStop = lux["perStop"].get<double>();
+	if (meanTarget_ && luxRef && *luxRef > 0.0 && luxStop && *luxStop > 0.0)
+		lux_ = LuxTuning{ *luxRef, *luxStop };
+
 	/*
 	 * histogram: adjusts the mean luminance target from the brightest
 	 * pixels, after the histogram luma target of Qualcomm's AEC metering
@@ -666,6 +684,16 @@ void Agc::process(IPAContext &context,
 	agc.lastMean = std::max((meanY - black) / (kYMax - black), 1e-3);
 	agc.lastProduct = frameContext.sensor.exposure * frameContext.sensor.gain;
 
+	if (lux_) {
+		/* The exposure that would put this frame's mean on the target */
+		const double plain = hist_ ? agc.plainTarget : *meanTarget_;
+		const double product = exposureTime.get<std::micro>() *
+				       frameContext.sensor.gain * plain / agc.lastMean;
+		agc.luxIndex = std::clamp(250.0 + lux_->perStop * std::log2(product / lux_->refProduct),
+					  0.0, 900.0);
+		LOG(IPASoftExposure, Debug) << "Lux index " << agc.luxIndex;
+	}
+
 	updateExposure(context, frameContext, exposureMSV, meanY, target);
 	applyManual(context, frameContext);
 
diff --git a/src/ipa/soft/algorithms/agc.h b/src/ipa/soft/algorithms/agc.h
index 10346ad2c..54afd7e52 100644
--- a/src/ipa/soft/algorithms/agc.h
+++ b/src/ipa/soft/algorithms/agc.h
@@ -64,6 +64,17 @@ private:
 	std::optional<double> meanTarget_;
 	std::optional<HistTuning> hist_;
 
+	/*
+	 * The lux index model: the exposure time (us) x gain at which a scene
+	 * of lux index 250 meets the luma target, and how many lux index
+	 * steps a stop of scene brightness is.
+	 */
+	struct LuxTuning {
+		double refProduct;
+		double perStop;
+	};
+	std::optional<LuxTuning> lux_;
+
 	/* The DRC gain exposure is being set for */
 	double drcDecided_ = 1.0;
 	/* The dark boost the tone curve is being set for */
diff --git a/src/ipa/soft/algorithms/ccm.cpp b/src/ipa/soft/algorithms/ccm.cpp
index ace9c35dc..69634ab7c 100644
--- a/src/ipa/soft/algorithms/ccm.cpp
+++ b/src/ipa/soft/algorithms/ccm.cpp
@@ -8,6 +8,8 @@
 
 #include "ccm.h"
 
+#include <cmath>
+
 #include <libcamera/base/log.h>
 #include <libcamera/base/utils.h>
 
@@ -18,6 +20,7 @@
 namespace {
 
 constexpr unsigned int kTemperatureThreshold = 100;
+constexpr double kLuxThreshold = 5.0;
 
 }
 
@@ -36,21 +39,60 @@ int Ccm::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 		return ret;
 	}
 
+	/*
+	 * luxSets: the same matrices by lux index region, which Agc estimates:
+	 *
+	 *   luxSets:
+	 *     - lux: [ 220, 300 ]
+	 *       ccms: [ ... ]    # as above
+	 */
+	for (const ValueNode &node : tuningData["luxSets"].asList()) {
+		auto lux = node["lux"].get<std::vector<double>>();
+		LuxSet set;
+		if (!lux || lux->size() != 2 || set.ccm.readYaml(node["ccms"], "ct", "ccm") < 0) {
+			LOG(IPASoftCcm, Error) << "Invalid 'luxSets' in tuning file";
+			return -EINVAL;
+		}
+		luxRanges_.push_back({ (*lux)[0], (*lux)[1] });
+		luxSets_.push_back(std::move(set));
+	}
+
 	context.ccmEnabled = true;
 
 	return 0;
 }
 
+/* The matrix at a colour temperature, blended across lux index regions */
+Matrix<float, 3, 3> Ccm::matrixAt(unsigned int ct, double lux)
+{
+	if (luxSets_.empty() || lux < 0)
+		return ccm_.getInterpolated(ct);
+
+	const ipa::soft::LuxBlend b = ipa::soft::luxBlend(luxRanges_, lux);
+	const Matrix<float, 3, 3> lo = luxSets_[b.lo].ccm.getInterpolated(ct);
+	if (b.lo == b.hi)
+		return lo;
+
+	const Matrix<float, 3, 3> hi = luxSets_[b.hi].ccm.getInterpolated(ct);
+	return lo * static_cast<float>(1.0 - b.weight) + hi * static_cast<float>(b.weight);
+}
+
 void Ccm::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
 		  IPAFrameContext &frameContext, [[maybe_unused]] DebayerParams *params)
 {
 	const unsigned int ct = context.activeState.awb.temperatureK;
+	const double lux = context.activeState.agc.luxIndex;
 
-	/* Change CCM only on bigger temperature changes. */
+	/*
+	 * Change CCM only on bigger temperature changes, and on a change of
+	 * the lux index that is a visible step of the blend.
+	 */
 	if (!currentCcm_ ||
-	    utils::abs_diff(ct, lastCt_) >= kTemperatureThreshold) {
-		currentCcm_ = ccm_.getInterpolated(ct);
+	    utils::abs_diff(ct, lastCt_) >= kTemperatureThreshold ||
+	    std::abs(lux - lastLux_) >= kLuxThreshold) {
+		currentCcm_ = matrixAt(ct, lux);
 		lastCt_ = ct;
+		lastLux_ = lux;
 	}
 
 	context.activeState.combinedMatrix =

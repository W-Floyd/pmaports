 			   << context_.configuration.focus.focus_max << "]";
 }
 
+/*
+ * Record the range of the iris actuator, or a zero range when the camera has
+ * no aperture mechanism. Called from both init() and configure() for the same
+ * reason as updateFocusRange().
+ */
+void IPASoftSimple::updateApertureRange()
+{
+	const auto it = irisInfoMap_.find(V4L2_CID_IRIS_ABSOLUTE);
+
+	if (it == irisInfoMap_.end()) {
+		LOG(IPASoft, Debug) << "No iris, aperture control disabled";
+		context_.configuration.aperture.iris_min = 0;
+		context_.configuration.aperture.iris_max = 0;
+		return;
+	}
+
+	context_.configuration.aperture.iris_min = it->second.min().get<int32_t>();
+	context_.configuration.aperture.iris_max = it->second.max().get<int32_t>();
+	LOG(IPASoft, Info) << "Iris range ["
+			   << context_.configuration.aperture.iris_min << ", "
+			   << context_.configuration.aperture.iris_max << "]";
+}
+
 int IPASoftSimple::configure(const IPAConfigInfo &configInfo)
 {
 	sensorInfoMap_ = configInfo.sensorControls;
 	lensInfoMap_ = configInfo.lensControls;
+	irisInfoMap_ = configInfo.irisControls;
 
 	const ControlInfo &exposureInfo = sensorInfoMap_.find(V4L2_CID_EXPOSURE)->second;
 	const ControlInfo &gainInfo = sensorInfoMap_.find(V4L2_CID_ANALOGUE_GAIN)->second;
@@ -254,6 +286,7 @@ int IPASoftSimple::configure(const IPAConfigInfo &configInfo)
 	 * the AF algorithm ends up mapping every position onto zero.
 	 */
 	updateFocusRange();
+	updateApertureRange();
 
 	context_.configuration.agc.lineDuration =
 		context_.sensorInfo.minLineLength * 1.0s / context_.sensorInfo.pixelRate;
@@ -381,10 +414,14 @@ void IPASoftSimple::processStats(const uint32_t frame,
 		  static_cast<int32_t>(camHelper_ ? camHelper_->gainCode(againNew) : againNew));
 
 	ControlList lensCtrls(lensInfoMap_);
-	if (!lensInfoMap_.empty())
+	if (lensInfoMap_.count(V4L2_CID_FOCUS_ABSOLUTE))
 		lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE, frameContext.lens.focus_pos);
 
-	setSensorControls.emit(ctrls, lensCtrls);
+	ControlList irisCtrls(irisInfoMap_);
+	if (irisInfoMap_.count(V4L2_CID_IRIS_ABSOLUTE))
+		irisCtrls.set(V4L2_CID_IRIS_ABSOLUTE, frameContext.iris.iris_pos);
+
+	setSensorControls.emit(ctrls, lensCtrls, irisCtrls);
 }
 

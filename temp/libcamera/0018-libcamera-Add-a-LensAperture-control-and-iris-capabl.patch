+	 * both jobs.
+	 */
+	std::vector<std::unique_ptr<CameraLens>> lenses_;
+	CameraLens *focusLens_ = nullptr;
+	CameraLens *irisLens_ = nullptr;
 };
 
 /**
@@ -656,15 +664,43 @@ int CameraSensorLegacy::discoverAncillaryDevices()
 
 	for (MediaEntity *ancillary : entity_->ancillaryEntities()) {
 		switch (ancillary->function()) {
-		case MEDIA_ENT_F_LENS:
-			focusLens_ = std::make_unique<CameraLens>(ancillary);
-			ret = focusLens_->init();
+		case MEDIA_ENT_F_LENS: {
+			/*
+			 * A sensor can have more than one lens entity: a focus
+			 * actuator and an aperture mechanism are separate
+			 * devices on some modules. Sort them by what they can
+			 * actually do rather than assuming the first one found
+			 * is the focus lens. A single entity may be both.
+			 */
+			std::unique_ptr<CameraLens> lens =
+				std::make_unique<CameraLens>(ancillary);
+			ret = lens->init();
 			if (ret) {
 				LOG(CameraSensor, Error)
 					<< "Lens initialisation failed, lens disabled";
-				focusLens_.reset();
+				break;
+			}
+
+			CameraLens *l = lens.get();
+			bool used = false;
+
+			if (l->hasFocus() && !focusLens_) {
+				focusLens_ = l;
+				used = true;
+			}
+			if (l->hasIris() && !irisLens_) {
+				irisLens_ = l;
+				used = true;
 			}
+
+			if (used)
+				lenses_.push_back(std::move(lens));
+			else
+				LOG(CameraSensor, Warning)
+					<< "Ignoring extra lens entity "
+					<< ancillary->name();
 			break;
+		}
 
 		default:
 			LOG(CameraSensor, Warning)

diff --git a/src/libcamera/control_ids_core.yaml b/src/libcamera/control_ids_core.yaml
index 89991d0..6f87091 100644
--- a/src/libcamera/control_ids_core.yaml
+++ b/src/libcamera/control_ids_core.yaml
@@ -1376,4 +1376,35 @@ controls:
         The nominal range is [-180, 180], where 0° leaves hues unchanged and the
         range wraps around continuously, with 180° == -180°.
 
+  - LensAperture:
+      type: float
+      direction: inout
+      description: |
+        Set and report the lens aperture, as an f-number.
+
+        The value is the ratio of the lens focal length to the diameter of the
+        entrance pupil, so smaller values admit more light. Setting a smaller
+        f-number opens the iris.
+
+        Cameras come in two kinds, and both are reported through this one
+        control. Which kind a camera is can be told from the ControlInfo:
+
+        \li A camera with a continuously variable iris reports a min() and a
+        max() f-number, and any value in that range may be requested.
+
+        \li A camera with a fixed set of apertures, such as a phone module
+        with a two-position blade mechanism, reports the available f-numbers
+        in values(). Only those values may be requested. min() and max() are
+        the smallest and largest of them.
+
+        A camera whose aperture cannot be changed at all does not advertise
+        this control. Applications should therefore treat its absence, rather
+        than a single-valued range, as "no aperture control", and should
+        consult values() before offering a continuous slider.
+
+        When a requested value cannot be honoured exactly, because it falls
+        between two available apertures, the implementation selects the
+        nearest available one and reports what it actually selected in the
+        request metadata.
+
 ...
diff --git a/src/libcamera/sensor/camera_sensor_legacy.cpp b/src/libcamera/sensor/camera_sensor_legacy.cpp

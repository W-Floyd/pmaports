  */
 int CameraLens::setFocusPosition(int32_t position)
 {
+	if (!hasFocus_)
+		return -ENODEV;
+
 	ControlList lensCtrls(subdev_->controls());
 	lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE, static_cast<int32_t>(position));
 
@@ -95,33 +98,57 @@ int CameraLens::setFocusPosition(int32_t position)
 	return 0;
 }
 
-int CameraLens::validateLensDriver()
+/**
+ * \brief Set the aperture of the lens to a specific position
+ * \param[in] position The iris position, in the units of the lens driver's
+ * V4L2_CID_IRIS_ABSOLUTE control
+ *
+ * The meaning of \a position is driver-specific. Mapping it to a physical
+ * f-number is the job of whoever holds the calibration, normally the IPA.
+ *
+ * \return 0 on success, -ENODEV if the lens has no iris, or -EINVAL otherwise
+ */
+int CameraLens::setIrisPosition(int32_t position)
 {
-	int ret = 0;
-	static constexpr uint32_t mandatoryControls[] = {
-		V4L2_CID_FOCUS_ABSOLUTE,
-	};
+	if (!hasIris_)
+		return -ENODEV;
+
+	ControlList lensCtrls(subdev_->controls());
+	lensCtrls.set(V4L2_CID_IRIS_ABSOLUTE, static_cast<int32_t>(position));
+
+	if (subdev_->setControls(&lensCtrls))
+		return -EINVAL;
 
+	return 0;
+}
+
+int CameraLens::validateLensDriver()
+{
 	const ControlInfoMap &controls = subdev_->controls();
-	for (uint32_t ctrl : mandatoryControls) {
-		if (!controls.count(ctrl)) {
-			LOG(CameraLens, Error)
-				<< "Mandatory V4L2 control " << utils::hex(ctrl)
-				<< " not available";
-			ret = -EINVAL;
-		}
-	}
 
-	if (ret) {
+	hasFocus_ = controls.count(V4L2_CID_FOCUS_ABSOLUTE);
+	hasIris_ = controls.count(V4L2_CID_IRIS_ABSOLUTE);
+
+	/*
+	 * A lens entity is useful if it can move focus, change the aperture,
+	 * or both. Requiring focus unconditionally would reject an aperture
+	 * mechanism that is a separate device from the focus actuator, which
+	 * is how phone modules with a variable aperture are usually wired.
+	 */
+	if (!hasFocus_ && !hasIris_) {
+		LOG(CameraLens, Error)
+			<< "Lens supports neither "
+			<< utils::hex(V4L2_CID_FOCUS_ABSOLUTE) << " (focus) nor "
+			<< utils::hex(V4L2_CID_IRIS_ABSOLUTE) << " (iris)";
 		LOG(CameraLens, Error)
 			<< "The lens kernel driver needs to be fixed";
 		LOG(CameraLens, Error)
 			<< "See Documentation/lens_driver_requirements.rst in"
 			<< " the libcamera sources for more information";
-		return ret;
+		return -EINVAL;
 	}
 
-	return ret;
+	return 0;
 }
 

+++ b/src/ipa/softisp/algorithms/sharpen.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * Sharpening
+ */
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+#include "algorithm.h"
+#include "lux.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Sharpen : public Algorithm
+{
+public:
+	Sharpen() = default;
+	~Sharpen() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	static constexpr unsigned int kLevels = DebayerParams::kSharpenLevels;
+
+	/* The adaptive spatial filter's tuning at one gain region */
+	struct Region {
+		double amplitude;
+		double cap;
+		double clampLow, clampHigh;
+		std::array<double, kLevels> positive;
+		std::array<double, kLevels> negative;
+		std::array<double, kLevels> weight;
+	};
+
+	/* The gain regions' ranges, for blending across the gaps */
+	std::vector<ipa::softisp::LuxRange> ranges_;
+	std::vector<Region> regions_;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */

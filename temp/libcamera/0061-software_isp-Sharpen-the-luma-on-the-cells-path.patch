new file mode 100644
index 000000000..99b689969
--- /dev/null
+++ b/src/ipa/softisp/algorithms/sharpen.cpp
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * Sharpening
+ */
+
+#include "sharpen.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftIspSharpen)
+
+namespace ipa::softisp::algorithms {
+
+/* The main kernel's amplitude, which a scale of 1 stands for */
+static constexpr double kReferenceAmplitude = 2.85;
+
+/**
+ * \class Sharpen
+ * \brief Sharpening by the vendor tuning's adaptive spatial filter
+ *
+ * The GPU debayer adds back the detail of the luma, scaled by a gain (see
+ * DebayerParams::Sharpen). This algorithm sets the gains for each frame from
+ * the vendor tuning's adaptive spatial filter (asf32), by the frame's gain:
+ *
+ *   - Sharpen:
+ *       regions:
+ *         - gain: [ 1, 1.1 ]
+ *           amplitude: 2.85       # the kernel's, 2.85 for the main one
+ *           cap: 1.8              # the largest gain
+ *           clamp: [ -32, 28 ]    # the change's limits, 8-bit luma units
+ *           positive: [ ... ]     # 64 gains of overshoot, by luma level
+ *           negative: [ ... ]     # 64 gains of undershoot
+ *           weight: [ ... ]       # 64 weights, by the detail's activity
+ *
+ * The regions blend across the gaps between their gain ranges.
+ */
+
+int Sharpen::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	for (const ValueNode &node : tuningData["regions"].asList()) {
+		auto gain = node["gain"].get<std::vector<double>>();
+		auto clamp = node["clamp"].get<std::vector<double>>();
+		auto positive = node["positive"].get<std::vector<double>>();
+		auto negative = node["negative"].get<std::vector<double>>();
+		auto weight = node["weight"].get<std::vector<double>>();
+		auto cap = node["cap"].get<double>();
+		auto amplitude = node["amplitude"].get<double>();
+		if (!gain || gain->size() != 2 || !clamp || clamp->size() != 2 ||
+		    !positive || positive->size() != kLevels || !negative || negative->size() != kLevels ||
+		    !weight || weight->size() != kLevels || !cap || !amplitude || *amplitude <= 0.0) {
+			LOG(IPASoftIspSharpen, Error) << "Invalid sharpening region";
+			return -EINVAL;
+		}
+
+		Region r;
+		r.amplitude = *amplitude;
+		r.cap = *cap;
+		r.clampLow = (*clamp)[0];
+		r.clampHigh = (*clamp)[1];
+		std::copy(positive->begin(), positive->end(), r.positive.begin());
+		std::copy(negative->begin(), negative->end(), r.negative.begin());
+		std::copy(weight->begin(), weight->end(), r.weight.begin());
+
+		ranges_.push_back({ (*gain)[0], (*gain)[1] });
+		regions_.push_back(r);
+	}
+
+	if (regions_.empty()) {
+		LOG(IPASoftIspSharpen, Error) << "No sharpening regions";
+		return -EINVAL;
+	}
+
+	LOG(IPASoftIspSharpen, Info)
+		<< "Sharpening, " << regions_.size() << " gain regions";
+
+	return 0;
+}
+
+void Sharpen::prepare(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      IPAFrameContext &frameContext,
+		      DebayerParams *params)
+{
+	const double gain = frameContext.sensor.known ? frameContext.sensor.gain
+						      : context.activeState.agc.again;
+
+	const auto b = ipa::softisp::luxBlend(ranges_, gain);
+	const Region &lo = regions_[b.lo];
+	const Region &hi = regions_[b.hi];
+	const double w = b.lo == b.hi ? 0.0 : b.weight;
+	auto mix = [w](double u, double v) { return u + (v - u) * w; };
+
+	DebayerParams::Sharpen &s = params->sharpen;
+	s.enabled = true;
+	s.scale = mix(lo.amplitude, hi.amplitude) / kReferenceAmplitude;
+	s.clampLow = mix(lo.clampLow, hi.clampLow) / 255.0;
+	s.clampHigh = mix(lo.clampHigh, hi.clampHigh) / 255.0;
+
+	const double cap = mix(lo.cap, hi.cap);
+	auto byte = [](double v) {
+		return static_cast<uint8_t>(std::lround(std::clamp(v, 0.0, 1.0) * 255.0));
+	};
+	for (unsigned int i = 0; i < kLevels; i++) {
+		s.lut[4 * i + 0] = byte(std::min(mix(lo.positive[i], hi.positive[i]), cap) /
+					DebayerParams::kSharpenGainRange);
+		s.lut[4 * i + 1] = byte(std::min(mix(lo.negative[i], hi.negative[i]), cap) /
+					DebayerParams::kSharpenGainRange);
+		s.lut[4 * i + 2] = byte(mix(lo.weight[i], hi.weight[i]));
+		s.lut[4 * i + 3] = 255;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Sharpen, "Sharpen")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */

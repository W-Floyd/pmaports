diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index e1e09d711..e34f90d60 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -103,6 +103,30 @@ struct DebayerParams {
 		float levelLow = 64.0f;
 		float levelHigh = 160.0f;
 	} denoise;
+
+	/*
+	 * Sharpening, applied by the GPU debayer on the cells path (where the
+	 * pixel's cell and the ones around it are at hand): the difference
+	 * between the pixel's filtered luma and the mean of the four taps
+	 * around it, after the tone curve, is the detail, which is added back
+	 * to the luma scaled by a gain: that of overshoot or undershoot at the
+	 * luma's level, weighted by the detail's activity (to leave out noise),
+	 * within the clamps. The gains and the weight are the bytes of a
+	 * kSharpenLevels x 1 RGBA texture: the positive gain and the negative
+	 * gain over kSharpenGainRange by the luma's level, in red and green,
+	 * and the weight by the activity (the detail's magnitude over 4 in
+	 * 8-bit units), in blue. The clamps are in luma units, 0 to 1.
+	 * Off unless enabled.
+	 */
+	static constexpr unsigned int kSharpenLevels = 64;
+	static constexpr float kSharpenGainRange = 4.0f;
+	struct Sharpen {
+		bool enabled = false;
+		float scale = 1.0f;
+		float clampLow = 0.0f;
+		float clampHigh = 0.0f;
+		std::array<uint8_t, kSharpenLevels * 4> lut = {};
+	} sharpen;
 };
 
 } /* namespace libcamera */

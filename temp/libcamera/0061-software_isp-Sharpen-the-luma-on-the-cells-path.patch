@@ -144,10 +144,9 @@ vec3 apply_chroma(vec3 rgb)
 /*
  * The colour processing of a pixel's red, green and blue as the sensor saw
  * them, from 0 to 1 over the 8 high bits' range: black level, lens shading,
- * white balance, colour correction, tone curve, chroma, and the output
- * channel order.
+ * white balance, colour correction, tone curve and chroma.
  */
-vec4 finish(vec3 rgb)
+vec3 process(vec3 rgb)
 {
 	/*
 	 * \todo: Black level normalising, AWB and digital gain could be
@@ -173,8 +172,12 @@ vec4 finish(vec3 rgb)
 	rgb = apply_tone(clamp(rgb, 0.0, 1.0));
 
 	/* Scale the chroma, on the encoded values */
-	rgb = apply_chroma(rgb);
+	return apply_chroma(rgb);
+}
 
+/* A processed pixel in the output's channel order */
+vec4 output_colour(vec3 rgb)
+{
 #if defined (SWAP_BLUE)
 	return vec4(rgb.bgr, 1.0);
 #else
@@ -182,6 +185,12 @@ vec4 finish(vec3 rgb)
 #endif
 }
 
+/* The colour processing of a pixel, as it is written (see process()) */
+vec4 finish(vec3 rgb)
+{
+	return output_colour(process(rgb));
+}
+
 #if defined (CELL_PATH)
 /*
  * The cells path: bayer_cells_bin.frag has binned each 2x2 cell of the frame,
@@ -200,7 +209,17 @@ vec4 finish(vec3 rgb)
  *             10-bit counts
  *
  * A cell's green is the mean of two pixels, which halves its noise variance.
+ *
+ * Sharpening, when on, uses the same values: after the colour processing,
+ * the luma difference between the filtered pixel and the mean of the four
+ * taps around it is the detail, a high-pass band of about the vendor's
+ * kernel's response (1.6 at 0.3 cycles per pixel), which is added back
+ * scaled by a gain by the luma's level and the sign of the detail, and
+ * a weight by its activity that leaves noise out, within the clamps. The
+ * gains and the weight are the red, green and blue of sharpen_lut.
  */
+uniform sampler2D sharpen_lut;
+uniform vec4 sharpen;		/* scale, clamp low, clamp high, and 1 when on */
 uniform sampler2D cell_tex;
 uniform vec2 cell_size;
 uniform vec3 noise;		/* slope, quadratic term and floor of the variance */
@@ -222,6 +241,7 @@ void main(void)
 
 	vec3 sum = c;
 	vec3 weights = vec3(1.0);
+	vec3 ring = vec3(0.0);
 	for (int dy = 0; dy < 2; dy++) {
 		for (int dx = 0; dx < 2; dx++) {
 			vec2 offset = vec2(dx == 0 ? -1.5 : 1.5, dy == 0 ? -1.5 : 1.5) * texel;
@@ -230,10 +250,29 @@ void main(void)
 			vec3 w = exp(-0.5 * d * d);
 			sum += w * n;
 			weights += w;
+			ring += n;
 		}
 	}
 
-	gl_FragColor = finish(sum / weights / 1020.0);
+	vec3 rgb = process(sum / weights / 1020.0);
+
+	if (sharpen.w > 0.0) {
+		const vec3 luma = vec3(0.299, 0.587, 0.114);
+		vec3 low = process(ring * (0.25 / 1020.0));
+		float detail = dot(rgb - low, luma);
+		float y = dot(rgb, luma);
+
+		vec4 levels = texture2D(sharpen_lut,
+					vec2((y * (SHARPEN_LEVELS - 1.0) + 0.5) / SHARPEN_LEVELS, 0.5));
+		float gain = (detail >= 0.0 ? levels.r : levels.g) * SHARPEN_GAIN_RANGE;
+		float activity = abs(detail) * (255.0 / 4.0);
+		float weight = texture2D(sharpen_lut,
+					 vec2((min(activity, SHARPEN_LEVELS - 1.0) + 0.5) / SHARPEN_LEVELS, 0.5)).b;
+		float change = clamp(gain * weight * sharpen.x * detail, sharpen.y, sharpen.z);
+		rgb = clamp(rgb + change, 0.0, 1.0);
+	}
+
+	gl_FragColor = output_colour(rgb);
 }
 #endif /* CELL_PATH */
 

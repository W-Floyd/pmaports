diff --git a/src/ipa/softisp/algorithms/agc.cpp b/src/ipa/softisp/algorithms/agc.cpp
index 5dfdcb872..48d7c67fb 100644
--- a/src/ipa/softisp/algorithms/agc.cpp
+++ b/src/ipa/softisp/algorithms/agc.cpp
@@ -158,6 +158,24 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 	if (mean.has_value() && *mean > 0.0 && *mean < 1.0)
 		meanTarget_ = *mean;
 
+	/*
+	 * lux: a model of the lux index the vendor tuning's regions are keyed
+	 * by (Qualcomm's AEC, whose own is not public), for the algorithms
+	 * that switch their data by it. The scene's brightness is the exposure
+	 * time x gain that brings the frame to the luma target, and the index
+	 * moves by perStop for each stop of it away from refProduct, that of
+	 * lux index 250 (ordinary indoor light):
+	 *
+	 *   lux:
+	 *     refProduct: 40000   # exposure time in us x analogue gain
+	 *     perStop: 36
+	 */
+	const ValueNode &lux = tuningData["lux"];
+	auto luxRef = lux["refProduct"].get<double>();
+	auto luxStop = lux["perStop"].get<double>();
+	if (meanTarget_ && luxRef && *luxRef > 0.0 && luxStop && *luxStop > 0.0)
+		lux_ = LuxTuning{ *luxRef, *luxStop };
+
 	/*
 	 * histogram: adjusts the mean luminance target from the brightest
 	 * pixels, after the histogram luma target of Qualcomm's AEC metering
@@ -666,6 +684,16 @@ void Agc::process(IPAContext &context,
 	agc.lastMean = std::max((meanY - black) / (kYMax - black), 1e-3);
 	agc.lastProduct = frameContext.sensor.exposure * frameContext.sensor.gain;
 
+	if (lux_) {
+		/* The exposure that would put this frame's mean on the target */
+		const double plain = hist_ ? agc.plainTarget : *meanTarget_;
+		const double product = exposureTime.get<std::micro>() *
+				       frameContext.sensor.gain * plain / agc.lastMean;
+		agc.luxIndex = std::clamp(250.0 + lux_->perStop * std::log2(product / lux_->refProduct),
+					  0.0, 900.0);
+		LOG(IPASoftIspExposure, Debug) << "Lux index " << agc.luxIndex;
+	}
+
 	updateExposure(context, frameContext, exposureMSV, meanY, target);
 	applyManual(context, frameContext);
 

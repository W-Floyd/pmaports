+	struct LuxTuning {
+		double refProduct;
+		double perStop;
+	};
+	std::optional<LuxTuning> lux_;
+
 	/* The DRC gain exposure is being set for */
 	double drcDecided_ = 1.0;
 	/* The dark boost the tone curve is being set for */

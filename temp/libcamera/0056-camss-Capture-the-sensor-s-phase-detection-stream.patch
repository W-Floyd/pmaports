+/*
+ * Route the sensor's phase detection stream, next to the image, through the
+ * CSI phy and the CSI decoder to the second RDI, and set its formats. The
+ * image keeps stream 0 of the decoder's first source pad, which is where the
+ * default routing puts it, so the image path is configured as without PD.
+ */
+int CamssCsiCamera::configurePdaf()
+{
+	pdaf_.configured = false;
+
+	if (!pdaf_.link)
+		return 0;
+
+	std::optional<V4L2Subdevice::Stream> meta = sensor_->embeddedDataStream();
+	V4L2SubdeviceFormat metaFormat = sensor_->embeddedDataFormat();
+	if (!meta || !metaFormat.code || metaFormat.size.isNull())
+		return 0;
+
+	uint32_t fourcc;
+	switch (metaFormat.code) {
+	case MEDIA_BUS_FMT_META_8:
+		fourcc = V4L2_META_FMT_GENERIC_8;
+		break;
+	case MEDIA_BUS_FMT_META_10:
+		fourcc = V4L2_META_FMT_GENERIC_CSI2_10;
+		break;
+	case MEDIA_BUS_FMT_META_12:
+		fourcc = V4L2_META_FMT_GENERIC_CSI2_12;
+		break;
+	default:
+		LOG(Camss, Warning)
+			<< "Unsupported PD stream format " << metaFormat;
+		return 0;
+	}
+
+	V4L2Subdevice *phy = links_[SensorPhyLink].sinkSubdev.get();
+	V4L2Subdevice *csid = links_[PhyCsidLink].sinkSubdev.get();
+	const unsigned int phySink = links_[SensorPhyLink].link->sink()->index();
+	const unsigned int phySource = links_[PhyCsidLink].link->source()->index();
+	const unsigned int csidSink = links_[PhyCsidLink].link->sink()->index();
+	const unsigned int csidImage = links_[CsidVfeLink].link->source()->index();
+	const unsigned int csidPdaf = pdaf_.link->source()->index();
+	const unsigned int image = sensor_->imageStream().stream;
+	const uint32_t active = V4L2_SUBDEV_ROUTE_FL_ACTIVE;
+
+	V4L2Subdevice::Routing phyRouting = {
+		{ { phySink, image }, { phySource, image }, active },
+		{ { phySink, meta->stream }, { phySource, meta->stream }, active },
+	};
+	V4L2Subdevice::Routing csidRouting = {
+		{ { csidSink, image }, { csidImage, 0 }, active },
+		{ { csidSink, meta->stream }, { csidPdaf, 0 }, active },
+	};
+
+	int ret = phy->setRouting(&phyRouting);
+	if (!ret)
+		ret = csid->setRouting(&csidRouting);
+	if (ret) {
+		LOG(Camss, Warning)
+			<< "Cannot route the PD stream, phase detection disabled";
+		return 0;
+	}
+
+	ret = phy->setFormat({ phySink, meta->stream }, &metaFormat);
+	if (!ret)
+		ret = csid->setFormat({ csidSink, meta->stream }, &metaFormat);
+	if (!ret)
+		ret = pdaf_.vfe->setFormat(pdaf_.link->sink()->index(), &metaFormat);
+	if (ret)
+		return ret;
+
+	if (!(pdaf_.link->flags() & MEDIA_LNK_FL_ENABLED)) {
+		ret = pdaf_.link->setEnabled(true);
+		if (ret)
+			return ret;
+	}
+
+	V4L2DeviceFormat format;
+	format.fourcc = V4L2PixelFormat(fourcc);
+	format.size = metaFormat.size;
+	format.planesCount = 1;
+	ret = pdaf_.output->setFormat(&format);
+	if (ret)
+		return ret;
+
+	pdaf_.format = format;
+	pdaf_.configured = true;
+
+	LOG(Camss, Debug)
+		<< "PD stream " << metaFormat << " -> " << format;
+
+	return 0;
+}
+
+int CamssCsiCamera::allocatePdafBuffers()
+{
+	return pdaf_.output->allocateBuffers(kPdafBufferCount, &pdaf_.buffers);
+}
+
+int CamssCsiCamera::startPdaf()
+{
+	for (const std::unique_ptr<FrameBuffer> &buffer : pdaf_.buffers) {
+		int ret = pdaf_.output->queueBuffer(buffer.get());
+		if (ret)
+			return ret;
+	}
+
+	int ret = pdaf_.output->streamOn();
+	if (ret)
+		return ret;
+
+	pdaf_.streaming = true;
+	return 0;
+}
+
+void CamssCsiCamera::stopPdafStream()
+{
+	/*
+	 * Clear the flag first: stream off returns the queued buffers, which
+	 * must not be handed on for processing and queued again.
+	 */
+	const bool streaming = pdaf_.streaming;
+	pdaf_.streaming = false;
+
+	if (streaming && pdaf_.output->streamOff())
+		LOG(Camss, Error) << "PD stream off failed";
+}
+
+void CamssCsiCamera::freePdafBuffers()
+{
+	pdaf_.buffers.clear();
+	if (pdaf_.output && pdaf_.output->releaseBuffers())
+		LOG(Camss, Error) << "Failed to release PD buffers";
+}
+
+void CamssCsiCamera::queuePdafBuffer(unsigned int cookie)
+{
+	if (!pdaf_.streaming || cookie >= pdaf_.buffers.size())
+		return;
+
+	pdaf_.output->queueBuffer(pdaf_.buffers[cookie].get());
+}
+
+void CamssCsiCamera::pdafOutputReady(FrameBuffer *buffer)
+{
+	/* Buffers returned by stream off need not go anywhere */
+	if (!pdaf_.streaming)
+		return;
+
+	pdafBufferReady.emit(buffer);
+}
+
 int CamssCsiCamera::exportBuffers(unsigned int count,
 				  std::vector<std::unique_ptr<FrameBuffer>> *buffers)
 {
@@ -562,9 +733,61 @@ std::unique_ptr<CamssCsiCamera> CamssCsi::enumCamera(MediaEntity *phy)
 		<< " decoder " << csid->name()
 		<< " VFE " << vfe->name();
 
+	enumPdaf(cam.get(), csid, vfe);
+
 	csids_.erase(csids_.begin());
 	vfes_.erase(vfes_.begin());
 	return cam;
 }
 
+/*
+ * A sensor with a metadata stream (on this platform, a phase detection
+ * stream) gets a second capture path for it: the CSI decoder's second source
+ * pad to the next RDI of the same VFE, whose video node captures metadata
+ * when opened for it.
+ */
+void CamssCsi::enumPdaf(CamssCsiCamera *cam, MediaEntity *csid, MediaEntity *vfe)
+{
+	if (!cam->sensor_->embeddedDataStream() || csid->pads().size() < 3)
+		return;
+
+	std::string name = vfe->name();
+	if (name.size() < 4 || name.compare(name.size() - 4, 4, "rdi0"))
+		return;
+	name.back() = '1';
+
+	MediaEntity *rdi = camssMediaDev_->getEntityByName(name);
+	if (!rdi || rdi->pads().size() < 2 || rdi->pads()[1]->links().empty())
+		return;
+
+	MediaLink *link = camssMediaDev_->link(csid, 2, rdi, 0);
+	if (!link)
+		return;
+
+	auto subdev = std::make_unique<V4L2Subdevice>(rdi);
+	if (subdev->open())
+		return;
+
+	MediaEntity *node = rdi->pads()[1]->links()[0]->sink()->entity();
+	UniqueFD fd(::open(node->deviceNode().c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC));
+	if (!fd.isValid())
+		return;
+
+	auto output = std::make_unique<V4L2VideoDevice>(node);
+	if (output->open(SharedFD(std::move(fd)), V4L2_BUF_TYPE_META_CAPTURE)) {
+		LOG(Camss, Debug) << node->name() << " cannot capture metadata";
+		return;
+	}
+
+	output->bufferReady.connect(cam, &CamssCsiCamera::pdafOutputReady);
+
+	cam->pdaf_.link = link;
+	cam->pdaf_.vfe = std::move(subdev);
+	cam->pdaf_.output = std::move(output);
+
+	LOG(Camss, Info)
+		<< "Sensor " << cam->sensor_->entity()->name()
+		<< " metadata stream on " << rdi->name();
+}
+
 } /* namespace libcamera */

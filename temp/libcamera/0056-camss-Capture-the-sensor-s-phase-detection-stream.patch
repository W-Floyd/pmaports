+/*
+ * Capture the sensor's phase detection stream, when the CSI side could route
+ * it, for an ISP whose IPA can use it. Phase detection is optional: any
+ * failure leaves the camera running without it.
+ */
+void CamssCameraData::startPdaf()
+{
+	if (!csi_->pdafConfigured())
+		return;
+
+	int ret = csi_->allocatePdafBuffers();
+	if (ret < 0) {
+		LOG(Camss, Warning) << "No PD buffers: " << strerror(-ret);
+		return;
+	}
+
+	const V4L2DeviceFormat &format = csi_->pdafFormat();
+	ret = isp_->mapPdafBuffers(csi_->pdafBuffers(), format.size,
+				   format.planes[0].bpl);
+	if (ret) {
+		LOG(Camss, Debug) << "The ISP does not use the PD stream";
+		csi_->freePdafBuffers();
+		return;
+	}
+
+	ret = csi_->startPdaf();
+	if (ret) {
+		LOG(Camss, Warning) << "PD stream start failed: " << strerror(-ret);
+		csi_->stopPdafStream();
+		isp_->unmapPdafBuffers(csi_->pdafBuffers());
+		csi_->freePdafBuffers();
+	}
+}
+
+void CamssCameraData::stopPdaf()
+{
+	if (csi_->pdafBuffers().empty())
+		return;
+
+	/*
+	 * The IPA processes requests in order, so by the time the unmap
+	 * returns it is done with every buffer it was given.
+	 */
+	csi_->stopPdafStream();
+	isp_->unmapPdafBuffers(csi_->pdafBuffers());
+	csi_->freePdafBuffers();
+}
+
+void CamssCameraData::pdafBufferReady(FrameBuffer *buffer)
+{
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess) {
+		csi_->queuePdafBuffer(buffer->cookie());
+		return;
+	}
+
+	isp_->processPdaf(buffer->metadata().sequence, buffer->cookie());
+}
+
+void CamssCameraData::pdafProcessed(unsigned int bufferId)
+{
+	csi_->queuePdafBuffer(bufferId);
+}

 	/* The longest exposure time (us) to lengthen the frame for, 0 for none */
 	double maxExposureUs_ = 0.0;
+	/* The exposure time (us) the tuning's table has at each gain, and in lines */
+	std::vector<std::pair<double, double>> exposureByGainUs_;
+	std::vector<std::pair<double, double>> exposureByGainLines_;
+
+	int32_t allowedExposure(const IPAContext &context, double gain) const;
 
 	/* The DRC gain exposure is being set for */
 	double drcDecided_ = 1.0;

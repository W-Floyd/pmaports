+/**
+ * \brief Share the buffers of the sensor's phase detection stream with the IPA
+ * \param[in] buffers The PD buffers
+ * \param[in] size The PD stream's size, in samples by lines
+ * \param[in] bytesPerLine The PD buffers' line stride
+ *
+ * Each buffer's cookie is set to its index in \a buffers, which identifies it
+ * to processPdaf() and pdafProcessed.
+ *
+ * \return 0 on success, or a negative error code if the IPA cannot use the
+ * stream
+ */
+int SoftwareIsp::mapPdafBuffers(const std::vector<std::unique_ptr<FrameBuffer>> &buffers,
+				const Size &size, unsigned int bytesPerLine)
+{
+	std::vector<IPABuffer> ipaBuffers;
+
+	for (unsigned int i = 0; i < buffers.size(); i++) {
+		Span<const FrameBuffer::Plane> planes = buffers[i]->planes();
+
+		buffers[i]->setCookie(i);
+		ipaBuffers.emplace_back(i, std::vector<FrameBuffer::Plane>(planes.begin(),
+									  planes.end()));
+	}
+
+	return ipa_->mapPdafBuffers(ipaBuffers, size.width, size.height, bytesPerLine);
+}
+
+/**
+ * \brief Stop sharing the phase detection buffers with the IPA
+ * \param[in] buffers The PD buffers given to mapPdafBuffers()
+ */
+void SoftwareIsp::unmapPdafBuffers(const std::vector<std::unique_ptr<FrameBuffer>> &buffers)
+{
+	std::vector<unsigned int> ids;
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : buffers)
+		ids.push_back(buffer->cookie());
+
+	ipa_->unmapPdafBuffers(ids);
+}
+
+/**
+ * \brief Have the IPA measure the phase in a phase detection buffer
+ * \param[in] frame The frame number the buffer belongs to
+ * \param[in] bufferId The buffer's cookie
+ *
+ * pdafProcessed is emitted once the IPA no longer uses the buffer.
+ */
+void SoftwareIsp::processPdaf(uint32_t frame, unsigned int bufferId)
+{
+	ipa_->processPdaf(frame, bufferId);
+}

@@ -7,6 +7,7 @@
 
 #include "blc.h"
 
+#include <cmath>
 #include <numeric>
 
 #include <libcamera/base/log.h>
@@ -23,16 +24,34 @@ BlackLevel::BlackLevel()
 {
 }
 
+/*
+ * The tuning data's black levels are 16-bit values; the soft ISP works on
+ * 8-bit ones, kept fractional: a 10-bit pedestal of 63 is 15.75, not 15.
+ *
+ *   - BlackLevel:
+ *       blackLevel: 4032
+ *       blackLevelGain: [ 1.0, 4032, 16.0, 3968, 64.0, 3664 ]  # optional
+ *
+ * blackLevelGain, a piecewise linear function of the analogue gain, gives
+ * the level for each frame by the gain it was taken with, for sensors
+ * whose black level drifts with gain; blackLevel is the level otherwise.
+ */
 int BlackLevel::init([[maybe_unused]] IPAContext &context,
 		     const ValueNode &tuningData)
 {
-	auto blackLevel = tuningData["blackLevel"].get<int16_t>();
-	if (blackLevel.has_value()) {
-		/*
-		 * Convert 16 bit values from the tuning file to 8 bit black
-		 * level for the SoftISP.
-		 */
-		definedLevel_ = blackLevel.value() >> 8;
+	auto blackLevel = tuningData["blackLevel"].get<double>();
+	if (blackLevel.has_value())
+		definedLevel_ = blackLevel.value() / 256.0;
+
+	if (tuningData.contains("blackLevelGain")) {
+		auto byGain = tuningData["blackLevelGain"].get<ipa::Pwl>();
+		if (!byGain || byGain->empty()) {
+			LOG(IPASoftBL, Error) << "Failed to parse 'blackLevelGain'";
+			return -EINVAL;
+		}
+		byGain_ = std::move(*byGain);
+		if (!definedLevel_)
+			definedLevel_ = byGain_.eval(byGain_.domain().start) / 256.0;
 	}
 	return 0;
 }
@@ -47,13 +66,25 @@ int BlackLevel::configure(IPAContext &context,
 	return 0;
 }
 
+/* The level for a frame taken at this analogue gain, 8-bit */
+float BlackLevel::levelAt(const IPAContext &context, double gain) const
+{
+	if (byGain_.empty())
+		return context.activeState.blc.level;
+	return byGain_.eval(byGain_.domain().clamp(gain)) / 256.0;
+}
+
 void BlackLevel::prepare(IPAContext &context,
 			 [[maybe_unused]] const uint32_t frame,
-			 [[maybe_unused]] IPAFrameContext &frameContext,
+			 IPAFrameContext &frameContext,
 			 DebayerParams *params)
 {
+	const float level = frameContext.sensor.known
+				    ? levelAt(context, frameContext.sensor.gain)
+				    : context.activeState.blc.level;
+
 	/* Latch the blacklevel gain so GPUISP can apply. */
-	params->blackLevel = RGB<float>(context.activeState.blc.level / 255.0f);
+	params->blackLevel = RGB<float>(level / 255.0f);
 }
 
 void BlackLevel::process(IPAContext &context,
@@ -62,8 +93,15 @@ void BlackLevel::process(IPAContext &context,
 			 const SwIspStats *stats,
 			 ControlList &metadata)
 {
+	/*
+	 * The level of the frame these statistics are of, for the algorithms
+	 * that process them after this one.
+	 */
+	if (!byGain_.empty())
+		context.activeState.blc.level = levelAt(context, frameContext.sensor.gain);
+
 	/* Assign each of the R G G B channels as the same black level. */
-	const int32_t blackLevel = context.activeState.blc.level * 256;
+	const int32_t blackLevel = std::lround(context.activeState.blc.level * 256);
 	const int32_t blackLevels[] = {
 		blackLevel, blackLevel, blackLevel, blackLevel
 	};
@@ -97,7 +135,7 @@ void BlackLevel::process(IPAContext &context,
 	const unsigned int pixelThreshold = ignoredPercentage * total;
 	const unsigned int histogramRatio = 256 / SwIspStats::kYHistogramSize;
 	const unsigned int currentBlackIdx =
-		context.activeState.blc.level / histogramRatio;
+		static_cast<unsigned int>(context.activeState.blc.level) / histogramRatio;
 
 	for (unsigned int i = 0, seen = 0;
 	     i < currentBlackIdx && i < SwIspStats::kYHistogramSize;

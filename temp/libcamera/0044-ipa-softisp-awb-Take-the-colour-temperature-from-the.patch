+Awb::LocusFit Awb::fitLocus(const Vector<double, 2> &ratios) const
 {
-	return awbAlgo_.init(tuningData, context.ctrlMap);
+	double best = std::numeric_limits<double>::infinity();
+	LocusFit fit{};
+	for (size_t i = 0; i + 1 < locus_.size(); i++) {
+		const LocusPoint &p = locus_[i];
+		const LocusPoint &q = locus_[i + 1];
+		const Vector<double, 2> d = q.ratios - p.ratios;
+		const Vector<double, 2> v = ratios - p.ratios;
+		double t = std::clamp(v.dot(d) / d.dot(d), 0.0, 1.0);
+		const Vector<double, 2> onLocus = p.ratios + d * t;
+		const Vector<double, 2> e = ratios - onLocus;
+		double dist = e.dot(e);
+		if (dist >= best)
+			continue;
+		best = dist;
+
+		double mired = (1 - t) * 1e6 / p.ct + t * 1e6 / q.ct;
+		fit.ct = std::lround(1e6 / mired);
+
+		/*
+		 * The segment's normal away from the origin: ratios that way
+		 * are short of green, towards purple.
+		 */
+		Vector<double, 2> normal{ { d[1], -d[0] } };
+		if (normal.dot(p.ratios) < 0)
+			normal = -normal;
+		double len = std::sqrt(dist);
+		const ipa::Pwl &side = e.dot(normal) >= 0 ? transversePos_ : transverseNeg_;
+		double limit = std::max(side.eval(side.domain().clamp(fit.ct)), 0.0);
+		fit.ratios = len > limit ? onLocus + e * (limit / len) : ratios;
+	}
+
+	return fit;
 }
 

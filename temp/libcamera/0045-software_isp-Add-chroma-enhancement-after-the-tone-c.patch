diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 110035d77..f2156ebdc 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -71,6 +71,8 @@ uniform vec3 blacklevel;
 uniform sampler2D tone_lut;
 uniform sampler2D lsc;
 uniform float lsc_enabled;
+uniform vec4 chroma;
+uniform vec4 chroma_shear;
 
 /*
  * Lens shading gains at a position in the image (0 to 1 from corner to
@@ -120,6 +122,25 @@ vec3 apply_tone(vec3 value)
 		    texture2D(tone_lut, vec2(x.b, 0.5)).r);
 }
 
+/*
+ * Chroma enhancement on the encoded values, keeping the BT.601 luma: Cb
+ * becomes chroma.x * (Cb + chroma_shear.x * (R - G)) where it is positive,
+ * .y where it is negative, and Cr likewise with .z and .w and (B - G).
+ */
+vec3 apply_chroma(vec3 rgb)
+{
+	float y = dot(rgb, vec3(0.299, 0.587, 0.114));
+	float cb = (rgb.b - y) * 0.564334;
+	float cr = (rgb.r - y) * 0.713267;
+	vec2 cbk = cb >= 0.0 ? vec2(chroma.x, chroma_shear.x) : vec2(chroma.y, chroma_shear.y);
+	vec2 crk = cr >= 0.0 ? vec2(chroma.z, chroma_shear.z) : vec2(chroma.w, chroma_shear.w);
+	float cb2 = cbk.x * (cb + cbk.y * (rgb.r - rgb.g));
+	float cr2 = crk.x * (cr + crk.y * (rgb.b - rgb.g));
+	return clamp(vec3(y + 1.402 * cr2,
+			  y - 0.344136 * cb2 - 0.714136 * cr2,
+			  y + 1.772 * cb2), 0.0, 1.0);
+}
+
 void main(void)
 {
 	vec3 rgb;
@@ -309,6 +330,9 @@ void main(void)
 	/* Apply the tone curve after colour correction */
 	rgb = apply_tone(clamp(rgb, 0.0, 1.0));
 
+	/* Scale the chroma, on the encoded values */
+	rgb = apply_chroma(rgb);
+
 #if defined (SWAP_BLUE)
 	gl_FragColor = vec4(rgb.bgr, 1.0);
 #else

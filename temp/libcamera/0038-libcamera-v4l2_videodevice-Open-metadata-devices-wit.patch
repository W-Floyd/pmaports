From ffdc45a5046a497845a3490369581f89c5382c32 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 16:52:12 +0000
Subject: libcamera: v4l2_videodevice: Open metadata devices with an explicit
 type

Some capture devices support both video and metadata capture on one video
node and switch between them by the buffer type given to VIDIOC_REQBUFS,
as the IPU6 driver does. open() picks video capture for them, from the
capabilities. Accept the metadata capture and output types in the variant
of open() that takes the buffer type, so that a pipeline handler can
capture metadata from such a node.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/libcamera/v4l2_videodevice.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/libcamera/v4l2_videodevice.cpp b/src/libcamera/v4l2_videodevice.cpp
index 41dc5d0f6..9b779e8bd 100644
--- a/src/libcamera/v4l2_videodevice.cpp
+++ b/src/libcamera/v4l2_videodevice.cpp
@@ -650,7 +650,8 @@ int V4L2VideoDevice::open()
  * handle. Like open(), this function queries the capabilities of the device,
  * but handles it according to the given device \a type instead of determining
  * its type from the capabilities. This can be used to force a given device type
- * for memory-to-memory devices.
+ * for memory-to-memory devices, or for capture devices that support both video
+ * and metadata capture and switch between them by buffer type.
  *
  * The file descriptor \a handle is duplicated, no reference to the original
  * handle is kept.
@@ -709,6 +710,22 @@ int V4L2VideoDevice::open(SharedFD handle, enum v4l2_buf_type type)
 			    ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE
 			    : V4L2_BUF_TYPE_VIDEO_CAPTURE;
 		break;
+	case V4L2_BUF_TYPE_META_CAPTURE:
+		if (!caps_.isMetaCapture()) {
+			LOG(V4L2, Error) << "Device does not support metadata capture";
+			return -EINVAL;
+		}
+		notifierType = EventNotifier::Read;
+		bufferType_ = V4L2_BUF_TYPE_META_CAPTURE;
+		break;
+	case V4L2_BUF_TYPE_META_OUTPUT:
+		if (!caps_.isMetaOutput()) {
+			LOG(V4L2, Error) << "Device does not support metadata output";
+			return -EINVAL;
+		}
+		notifierType = EventNotifier::Write;
+		bufferType_ = V4L2_BUF_TYPE_META_OUTPUT;
+		break;
 	default:
 		LOG(V4L2, Error) << "Unsupported buffer type";
 		return -EINVAL;

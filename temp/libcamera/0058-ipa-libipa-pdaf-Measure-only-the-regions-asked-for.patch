+++ b/src/ipa/libipa/pdaf.h
@@ -53,6 +53,7 @@ public:
 
 	int setShading(const Size &grid, Span<const float> left,
 		       Span<const float> right);
+	int setActiveRegions(const std::vector<bool> &active);
 
 	int process(Span<const uint8_t> buffer, unsigned int bytesPerLine);
 	int process(Span<const uint16_t> samples, unsigned int stride);
@@ -78,6 +79,10 @@ private:
 	/* Shading gain per block, one vector per side, empty if none */
 	std::vector<float> gainLeft_;
 	std::vector<float> gainRight_;
+	/* Regions to measure (all if empty), and the block rows they span */
+	std::vector<bool> active_;
+	unsigned int rowStart_;
+	unsigned int rowEnd_;
 	std::vector<PdafData> regions_;
 };
 

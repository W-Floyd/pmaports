From 9b1e10ee7ca74b010fa3304104fa1665c749aa28 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 17:33:44 +0000
Subject: [PATCH 58/76] ipa: libipa: pdaf: Measure only the regions asked for

Measuring the phase over a whole PD frame takes most of a Cortex-A53 core
at 30 fps, while an autofocus algorithm commonly looks at a few central
regions. Add PdafPhase::setActiveRegions(): only those regions are
measured, the others report no confidence, and only the PD lines of the
block rows they span are unpacked.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/libipa/pdaf.cpp  | 65 ++++++++++++++++++++++++++++++++++++----
 src/ipa/libipa/pdaf.h    |  5 ++++
 test/ipa/libipa/pdaf.cpp | 25 ++++++++++++++++
 3 files changed, 89 insertions(+), 6 deletions(-)

diff --git a/src/ipa/libipa/pdaf.cpp b/src/ipa/libipa/pdaf.cpp
index 877039ed6..38affebb3 100644
--- a/src/ipa/libipa/pdaf.cpp
+++ b/src/ipa/libipa/pdaf.cpp
@@ -143,11 +143,58 @@ Size PdafLayout::bufferSize() const
  */
 PdafPhase::PdafPhase(const PdafLayout &layout, const Size &grid,
 		     unsigned int maxShift)
-	: layout_(layout), grid_(grid), maxShift_(maxShift)
+	: layout_(layout), grid_(grid), maxShift_(maxShift),
+	  rowStart_(0), rowEnd_(layout.blocks.height)
 {
 	regions_.resize(grid_.width * grid_.height, { 0.0, 0.0 });
 }
 
+/**
+ * \brief Limit the measurement to some of the regions
+ * \param[in] active One flag per region, row major, true to measure it
+ *
+ * Measuring the phase costs time in proportion to the area measured, and an
+ * autofocus algorithm commonly looks at a few regions only. Regions left out
+ * report no confidence, and only the PD lines of the block rows the active
+ * regions span are unpacked. An empty vector measures every region again.
+ *
+ * \return 0 on success, or -EINVAL if \a active does not match the grid
+ */
+int PdafPhase::setActiveRegions(const std::vector<bool> &active)
+{
+	const unsigned int rows = layout_.blocks.height;
+
+	if (active.empty()) {
+		active_.clear();
+		rowStart_ = 0;
+		rowEnd_ = rows;
+		return 0;
+	}
+
+	if (active.size() != regions_.size())
+		return -EINVAL;
+
+	active_ = active;
+	rowStart_ = rows;
+	rowEnd_ = 0;
+
+	for (unsigned int ry = 0; ry < grid_.height; ry++) {
+		for (unsigned int rx = 0; rx < grid_.width; rx++) {
+			if (!active_[ry * grid_.width + rx])
+				continue;
+			rowStart_ = std::min(rowStart_, ry * rows / grid_.height);
+			rowEnd_ = std::max(rowEnd_, (ry + 1) * rows / grid_.height);
+		}
+	}
+
+	if (rowStart_ > rowEnd_)
+		rowStart_ = rowEnd_ = 0;
+
+	std::fill(regions_.begin(), regions_.end(), PdafData{ 0.0, 0.0 });
+
+	return 0;
+}
+
 /**
  * \brief Set the shading gains of the left and right PD pixels
  * \param[in] grid The size of the gain grids
@@ -274,8 +321,10 @@ int PdafPhase::process(Span<const uint8_t> buffer, unsigned int bytesPerLine)
 	if (!layout_.isValid() || bytesPerLine * size.height > buffer.size())
 		return -EINVAL;
 
+	/* Only the lines of the block rows that are measured */
+	const unsigned int nlines = layout_.lines.size();
 	unpacked_.resize(size.width * size.height);
-	for (unsigned int y = 0; y < size.height; y++)
+	for (unsigned int y = rowStart_ * nlines; y < rowEnd_ * nlines; y++)
 		unpackCsi2(buffer.subspan(y * bytesPerLine, bytesPerLine),
 			   layout_.bitDepth,
 			   Span<uint16_t>(unpacked_).subspan(y * size.width, size.width));
@@ -299,9 +348,13 @@ int PdafPhase::process(Span<const uint16_t> samples, unsigned int stride)
 
 	buildSignals(samples, stride);
 
-	for (unsigned int ry = 0; ry < grid_.height; ry++)
-		for (unsigned int rx = 0; rx < grid_.width; rx++)
-			regions_[ry * grid_.width + rx] = regionPhase(rx, ry);
+	for (unsigned int ry = 0; ry < grid_.height; ry++) {
+		for (unsigned int rx = 0; rx < grid_.width; rx++) {
+			const unsigned int i = ry * grid_.width + rx;
+			if (active_.empty() || active_[i])
+				regions_[i] = regionPhase(rx, ry);
+		}
+	}
 
 	return 0;
 }
@@ -319,7 +372,7 @@ void PdafPhase::buildSignals(Span<const uint16_t> samples, unsigned int stride)
 	left_.assign(width * rows, 0.0f);
 	right_.assign(width * rows, 0.0f);
 
-	for (unsigned int r = 0; r < rows; r++) {
+	for (unsigned int r = rowStart_; r < rowEnd_; r++) {
 		float *l = &left_[r * width];
 		float *rt = &right_[r * width];
 

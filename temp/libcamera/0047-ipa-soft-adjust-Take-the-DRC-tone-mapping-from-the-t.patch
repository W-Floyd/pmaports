 using ToneLut = std::array<uint8_t, DebayerParams::kToneLutSize>;
 
+class DrcCurve
+{
+public:
+	/* The tuning's anchors at one DRC gain */
+	struct Anchors {
+		double drcGain;
+		double dark, mid, bright;
+		double darkBoost;
+	};
+
+	/* The curve for one DRC gain: linear light in, linear light out */
+	class Mapping
+	{
+	public:
+		Mapping(const DrcCurve &curve, double drcGain);
+		double operator()(double x) const;
+
+	private:
+		static constexpr unsigned int kBezierPoints = 1000;
+
+		std::array<double, 5> kneeX_, kneeY_;
+		double linearGain_;
+		double share_;
+		std::array<double, kBezierPoints> bezierX_, bezierY_;
+	};
+
+	int read(const ValueNode &tuningData);
+	bool empty() const { return anchors_.empty(); }
+
+private:
+	Anchors at(double drcGain) const;
+
+	std::vector<Anchors> anchors_;
+	double maxRatio_ = 16.0;
+	double share_ = 1.0;
+};
+
 ToneLut toneLut(float gamma, float contrastExp, const ipa::Pwl *curve,
-		float drcGain = 1.0f);
+		float drcGain = 1.0f, const DrcCurve *drc = nullptr);
 
 class Adjust : public Algorithm
 {
@@ -60,6 +98,9 @@ private:
 	/* Tone curve from the tuning file, used unless Gamma is set. */
 	ipa::Pwl curve_;
 
+	/* The DRC tone mapping from the tuning file, if any */
+	DrcCurve drcCurve_;
+
 	/* Chroma scales and shears by colour temperature, from the tuning file */
 	std::optional<ipa::Interpolator<Vector<double, 4>>> chroma_;
 	std::optional<ipa::Interpolator<Vector<double, 4>>> chromaShear_;

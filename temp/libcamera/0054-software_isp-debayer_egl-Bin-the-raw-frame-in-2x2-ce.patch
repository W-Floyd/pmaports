+
+	/*
+	 * Noise reduction, applied by the GPU debayer where it bins the raw
+	 * data in 2x2 cells (an output at most about two thirds of the
+	 * input's size): a bilateral filter over the cells whose range kernel
+	 * follows the sensor's noise. The variance of a signal's noise is
+	 * slope * level + quad * level^2 + floor, the level above black in
+	 * 10-bit counts. The
+	 * kernel is exp(-(difference / (width * sigma))^2 / 2), with a width
+	 * for each of red, green and blue between those of the two levels
+	 * given, which are in counts above black: a smaller width filters
+	 * less. Off unless enabled.
+	 */
+	struct Denoise {
+		bool enabled = false;
+		float slope = 0.0f;
+		float quad = 0.0f;
+		float floor = 0.3f;
+		std::array<float, 3> widthLow = { 2.0f, 2.0f, 2.0f };
+		std::array<float, 3> widthHigh = { 2.0f, 2.0f, 2.0f };
+		float levelLow = 64.0f;
+		float levelHigh = 160.0f;
+	} denoise;
 };
 

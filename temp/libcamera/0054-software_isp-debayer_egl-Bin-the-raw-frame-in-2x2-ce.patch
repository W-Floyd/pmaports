+/*
+ * Run the cells path's first pass: bin each cell of the input into a texel of
+ * the cells texture, which stays bound to texture unit 4 for the main pass.
+ */
+int DebayerEGL::renderCells(eGLImage &eglImageIn)
+{
+	static const GLfloat vcoordinates[4][2] = {
+		{ -1.0f, -1.0f },
+		{ -1.0f, +1.0f },
+		{ +1.0f, +1.0f },
+		{ +1.0f, -1.0f },
+	};
+
+	if (!cells_) {
+		cells_ = createCellsTexture(GL_TEXTURE4, 4);
+		if (!cells_) {
+			LOG(Debayer, Error) << "Render targets of the cells fail";
+			return -ENODEV;
+		}
+	}
+
+	if (egl_.attachTextureToFBO(*cells_))
+		return -ENODEV;
+
+	egl_.useProgram(binProgramId_);
+	glEnableVertexAttribArray(binAttributeVertex_);
+	glVertexAttribPointer(binAttributeVertex_, 2, GL_FLOAT, GL_TRUE,
+			      2 * sizeof(GLfloat), vcoordinates);
+
+	/* The frame is a texture of bytes, as many as its stride wide */
+	glUniform1i(binUniformTexY_, eglImageIn.texture_unit_uniform_id_);
+	glUniform2f(binUniformRawSize_, static_cast<GLfloat>(inputConfig_.stride),
+		    static_cast<GLfloat>(height_));
+	glUniform2f(binUniformFirstRed_, firstRed_x_, firstRed_y_);
+
+	glViewport(0, 0, cellsSize_.width, cellsSize_.height);
+	glDrawArrays(GL_TRIANGLE_FAN, 0, DEBAYER_OPENGL_COORDS);
+
+	/* The main pass's program samples the cells on unit 4 */
+	egl_.activateBindTexture(*cells_);
+
+	GLenum err = glGetError();
+	if (err != GL_NO_ERROR) {
+		LOG(eGL, Error) << "Binning the cells fail " << err;
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+/*
+ * Make the main program the one that samples single pixels, or the one that
+ * samples the cells, and read the locations of its variables if it changed.
+ */
+void DebayerEGL::selectProgram(bool cells)
+{
+	if (cells != cellsActive_) {
+		cellsActive_ = cells;
+		programId_ = cells ? cellsMainProgramId_ : singleProgramId_;
+		getShaderVariableLocations();
+	}
+	egl_.useProgram(programId_);
+}

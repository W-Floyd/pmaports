diff --git a/src/libcamera/shaders/bayer_cells_bin.frag b/src/libcamera/shaders/bayer_cells_bin.frag
new file mode 100644
index 000000000..1263ae6f2
--- /dev/null
+++ b/src/libcamera/shaders/bayer_cells_bin.frag
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * bayer_cells_bin.frag - Bins each 2x2 cell of a packed raw Bayer 10-bit
+ * frame into one texel of a 10-bit unorm texture (counts over 1023), at the
+ * full 10 bits of each pixel: the cell's red and blue pixels, and the mean of
+ * its two greens (to the nearest count).
+ *
+ * A cell's four pixels are two adjacent bytes in two adjacent rows, and the
+ * low bits of both rows are two bytes of one column, so two gathers read
+ * them: one over the 2x2 bytes of the 8 high bits, one over the column of
+ * the low bits' bytes. (OpenGL ES 3.1 or later.)
+ */
+
+precision highp float;
+precision highp sampler2D;
+
+#if !defined(RAW10P)
+#error Invalid raw format
+#endif
+
+/* The frame is a texture of bytes, as many as its stride wide */
+uniform sampler2D tex_y;
+uniform vec2 raw_size;
+uniform vec2 tex_bayer_first_red;
+
+out vec4 fragColor;
+
+/* A byte gathered, from 0 to 255 */
+vec4 bytes(vec4 v)
+{
+	return floor(v * 255.0 + 0.5);
+}
+
+void main(void)
+{
+	/* One fragment per cell, whose pixels start at twice its coordinates */
+	vec2 p = floor(gl_FragCoord.xy) * 2.0;
+
+	/*
+	 * A pixel's 8 high bits are the byte at 5 * (x / 4) + x % 4 of its
+	 * row, and its 2 low bits are in the group's fifth byte, 2 bits to a
+	 * pixel, the first pixel's in the lowest. A cell starts at an even x,
+	 * so both its pixels are in one group, at i and i + 1.
+	 */
+	float group = floor(p.x / 4.0);
+	float i = p.x - group * 4.0;
+	float first = group * 5.0 + i;
+	float low = group * 5.0 + 4.0;
+
+	/*
+	 * A gather at the corner shared by four texels returns them as
+	 * (x, y + 1), (x + 1, y + 1), (x + 1, y), (x, y) in its components.
+	 */
+	vec4 hi = bytes(textureGather(tex_y, vec2(first + 1.0, p.y + 1.0) / raw_size, 0));
+	vec4 lo = bytes(textureGather(tex_y, vec2(low + 1.0, p.y + 1.0) / raw_size, 0));
+
+	/* The low bits of the cell's pixels in the top row, then the bottom row */
+	float shift = exp2(2.0 * i);
+	vec2 top_low = vec2(mod(floor(lo.w / shift), 4.0), mod(floor(lo.w / (shift * 4.0)), 4.0));
+	vec2 bottom_low = vec2(mod(floor(lo.x / shift), 4.0), mod(floor(lo.x / (shift * 4.0)), 4.0));
+
+	/* The pixels in the order (0,0), (1,0), (0,1), (1,1) */
+	vec4 v = vec4(hi.w * 4.0 + top_low.x, hi.z * 4.0 + top_low.y,
+		      hi.x * 4.0 + bottom_low.x, hi.y * 4.0 + bottom_low.y);
+
+	vec2 red = tex_bayer_first_red;
+	vec4 is_red = vec4((1.0 - red.x) * (1.0 - red.y), red.x * (1.0 - red.y),
+			   (1.0 - red.x) * red.y, red.x * red.y);
+	vec4 is_blue = is_red.wzyx;
+
+	float r = dot(v, is_red);
+	float b = dot(v, is_blue);
+	float g = v.x + v.y + v.z + v.w - r - b;
+
+	/* 10-bit unorm: counts over 1023, exact for the whole counts */
+	fragColor = vec4(r, g * 0.5, b, 0.0) / 1023.0;
+}

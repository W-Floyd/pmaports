+/*
+ * Whether the context has what the cells path needs: textureGather in the
+ * shaders, which OpenGL ES 3.1 has, and unorm render targets of 10 bits
+ * that filter linearly, which 3.0 has. Take 3.2, the one that was tested.
+ */
+bool DebayerEGL::cellsSupported()
+{
+	const char *version = reinterpret_cast<const char *>(glGetString(GL_VERSION));
+	int major = 0;
+	int minor = 0;
+
+	return version && sscanf(version, "OpenGL ES %d.%d", &major, &minor) == 2 &&
+	       (major > 3 || (major == 3 && minor >= 2));
+}
+
+/*
+ * Build the cells path's programs: the main program of bayer_1x_packed.frag
+ * that samples and filters the cells, and the pass that bins them.
+ */
+int DebayerEGL::initCellsPrograms(const std::vector<std::string> &shaderEnv,
+				  Span<const unsigned char> vertexShaderData,
+				  Span<const unsigned char> fragmentShaderData)
+{
+	/* The main program, with the other path's environment */
+	std::vector<std::string> mainEnv = shaderEnv;
+	egl_.pushEnv(mainEnv, "#define CELL_PATH");
+
+	GLuint vertexShaderId = 0;
+	GLuint fragmentShaderId = 0;
+	if (egl_.compileVertexShader(vertexShaderId, vertexShaderData, mainEnv) ||
+	    egl_.compileFragmentShader(fragmentShaderId, fragmentShaderData, mainEnv)) {
+		LOG(Debayer, Error) << "Compile cells main shaders fail";
+		return -ENODEV;
+	}
+	utils::scope_exit vShaderGuard([&] { glDeleteShader(vertexShaderId); });
+	utils::scope_exit fShaderGuard([&] { glDeleteShader(fragmentShaderId); });
+
+	if (egl_.linkProgram(cellsMainProgramId_, vertexShaderId, fragmentShaderId)) {
+		LOG(Debayer, Error) << "Linking cells main program fail";
+		return -ENODEV;
+	}
+
+	/* The pass that bins the cells */
+	std::vector<std::string> binEnv;
+	egl_.pushEnv(binEnv, "#version 310 es");
+	egl_.pushEnv(binEnv, "#define RAW10P");
+
+	GLuint binVertexShaderId = 0;
+	GLuint binFragmentShaderId = 0;
+	if (egl_.compileVertexShader(binVertexShaderId, cells_vert, binEnv) ||
+	    egl_.compileFragmentShader(binFragmentShaderId, bayer_cells_bin_frag, binEnv)) {
+		LOG(Debayer, Error) << "Compile cells binning shaders fail";
+		return -ENODEV;
+	}
+	utils::scope_exit binVShaderGuard([&] { glDeleteShader(binVertexShaderId); });
+	utils::scope_exit binFShaderGuard([&] { glDeleteShader(binFragmentShaderId); });
+
+	if (egl_.linkProgram(binProgramId_, binVertexShaderId, binFragmentShaderId)) {
+		LOG(Debayer, Error) << "Linking cells binning program fail";
+		return -ENODEV;
+	}
+
+	binAttributeVertex_ = glGetAttribLocation(binProgramId_, "vertexIn");
+	binUniformTexY_ = glGetUniformLocation(binProgramId_, "tex_y");
+	binUniformRawSize_ = glGetUniformLocation(binProgramId_, "raw_size");
+	binUniformFirstRed_ = glGetUniformLocation(binProgramId_, "tex_bayer_first_red");
+
+	cellsSize_ = Size(width_ / 2, height_ / 2);
+
+	LOG(Debayer, Info) << "Noise reduction on 2x2 cells (" << cellsSize_
+			   << ") for the " << outputSize_ << " output";
+
+	return 0;
+}
+
+/*
+ * A 10-bit unorm RGBA texture of the cells' size (a cell's red, green and
+ * blue, in counts over 1023), bound to a texture unit and attached to its own
+ * framebuffer, to render to or to sample with linear filtering.
+ */
+std::unique_ptr<eGLImage> DebayerEGL::createCellsTexture(GLenum unit, uint32_t uniformId)
+{
+	auto image = std::make_unique<eGLImage>(GL_RGBA, cellsSize_.width, cellsSize_.height,
+						cellsSize_.width * 4, unit, uniformId);
+
+	egl_.activateBindTexture(*image);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB10_A2, cellsSize_.width, cellsSize_.height, 0,
+		     GL_RGBA, GL_UNSIGNED_INT_2_10_10_10_REV, nullptr);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);

+/*
+ * The colour processing of a pixel's red, green and blue as the sensor saw
+ * them, from 0 to 1 over the 8 high bits' range: black level, lens shading,
+ * white balance, colour correction, tone curve, chroma, and the output
+ * channel order.
+ */
+vec4 finish(vec3 rgb)
+{
+	/*
+	 * \todo: Black level normalising, AWB and digital gain could be
+	 * reworked into a single multiplication.
+	 */
+	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
+
+	/* Correct lens shading, on the linear data */
+	rgb *= lens_shading(textureOut);
+
+	/*
+	 * Apply AWB gains, and saturate each channel at sensor range. Values
+	 * below black are noise around it: keep them, so that colour
+	 * correction averages the noise out rather than lifting it, tinted
+	 * by the gains, into the shadows; the tone curve clamps at black.
+	 */
+	rgb = min(rgb * awb, vec3(1.0));
+
+	/* Colour Correction Matrix */
+	rgb = ccm * rgb;
+
+	/* Apply the tone curve after colour correction */
+	rgb = apply_tone(clamp(rgb, 0.0, 1.0));
+
+	/* Scale the chroma, on the encoded values */
+	rgb = apply_chroma(rgb);
+
+#if defined (SWAP_BLUE)
+	return vec4(rgb.bgr, 1.0);
+#else
+	return vec4(rgb, 1.0);
+#endif
+}
+
+#if defined (CELL_PATH)
+/*
+ * The cells path: bayer_cells_bin.frag has binned each 2x2 cell of the frame,
+ * at the full 10 bits, into one texel of cell_tex (a 10-bit unorm texture,
+ * counts over 1023), which the hardware's linear filtering interpolates here.
+ * Counts of 1020 stand for 1.0, as the 8 high bits' 255 do on the other path.
+ *
+ * It filters noise by a bilateral filter on five of those interpolated
+ * values, the pixel's own and four around it at 1.5 cells on the diagonals,
+ * each of which averages four cells. Its range kernel follows the sensor's
+ * noise, so that differences of a few noise deviations are averaged and
+ * edges are kept:
+ *
+ *   weight = exp(-(difference / (width * sigma))^2 / 2)
+ *   sigma^2 = slope * level + quad * level^2 + floor, level above black in
+ *             10-bit counts
+ *
+ * A cell's green is the mean of two pixels, which halves its noise variance.
+ */
+uniform sampler2D cell_tex;
+uniform vec2 cell_size;
+uniform vec3 noise;		/* slope, quadratic term and floor of the variance */
+uniform vec3 width_lo;		/* range kernel width of red, green and blue, */
+uniform vec3 width_hi;		/* at and below anchors.x, and at and above anchors.y */
+uniform vec2 anchors;		/* levels, in counts above black */
+
+void main(void)
+{
+	vec2 texel = 1.0 / cell_size;
+	vec3 c = texture2D(cell_tex, textureOut).rgb * 1023.0;
+
+	vec3 level = max(c - blacklevel * 1020.0, 0.0);
+	vec3 sigma = sqrt(noise.x * level + noise.y * level * level + noise.z) *
+		     vec3(1.0, 0.70710678, 1.0);
+	vec3 width = mix(width_lo, width_hi,
+			 clamp((level - anchors.x) / max(anchors.y - anchors.x, 1.0), 0.0, 1.0));
+	vec3 inv = 1.0 / max(width * sigma, 0.001);
+
+	vec3 sum = c;
+	vec3 weights = vec3(1.0);
+	for (int dy = 0; dy < 2; dy++) {
+		for (int dx = 0; dx < 2; dx++) {
+			vec2 offset = vec2(dx == 0 ? -1.5 : 1.5, dy == 0 ? -1.5 : 1.5) * texel;
+			vec3 n = texture2D(cell_tex, textureOut + offset).rgb * 1023.0;
+			vec3 d = (n - c) * inv;
+			vec3 w = exp(-0.5 * d * d);
+			sum += w * n;
+			weights += w;
+		}
+	}
+
+	gl_FragColor = finish(sum / weights / 1020.0);
+}
+#endif /* CELL_PATH */

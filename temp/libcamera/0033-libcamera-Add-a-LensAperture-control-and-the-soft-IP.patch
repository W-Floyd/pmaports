@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd <git@notmy.space>
+ *
+ * Lens aperture control
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include "libipa/pwl.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Aperture : public Algorithm
+{
+public:
+	Aperture();
+	~Aperture() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	int32_t irisCode(double fNumber) const;
+	double nearestAperture(double fNumber) const;
+
+	/*
+	 * Tuning data, kept here rather than in IPAContext::configuration
+	 * because configure() clears that whereas init(), which reads the
+	 * tuning file, runs only once.
+	 */
+
+	/*
+	 * A discrete mechanism lists the f-numbers it can actually select,
+	 * sorted ascending, each paired with the actuator code that selects
+	 * it. Empty for a continuously variable iris.
+	 */
+	std::vector<double> apertures_;
+	std::vector<int32_t> codes_;
+
+	/* Maps f-number to actuator code for a continuous iris. */
+	ipa::Pwl map_;
+
+	double fNumberMin_ = 0.0;
+	double fNumberMax_ = 0.0;
+	double fNumberDef_ = 0.0;
+
+	bool discrete_ = false;
+	bool enabled_ = false;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */

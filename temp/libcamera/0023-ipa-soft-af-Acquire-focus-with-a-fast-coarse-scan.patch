From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 09:11:28 +0000
Subject: [PATCH] ipa: soft: af: Acquire focus with a fast coarse scan

First focus probed a small step either side of the default position and
climbed from there. Far from focus the sharpness curve is broad and
nearly flat, so the climb often stopped at the end of travel on a
defocused image and reported it as focused, and a flat probe fell back
to the old full sweep, which took twelve seconds at 30 fps.

Acquire focus, and handle AfTrigger and a flat probe, with a coarse scan
instead: nine evenly spaced positions, one frame each after the in-flight
requests clear, starting from the end of travel nearer the lens. The
scan stops as soon as sharpness has fallen 40% below the best point two
or more points back, and the best point is then refined with the
existing two-sided probes. Focus acquires in about two seconds.

Also require five frames below the reference, not three, before focus
counts as lost, so hand shake while framing restarts the search less.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/simple/algorithms/af.cpp | 138 ++++++++++++++++---------------
 src/ipa/simple/algorithms/af.h   |  19 +++--
 2 files changed, 86 insertions(+), 71 deletions(-)

diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index 6c8ecf42b..d86f1a977 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -29,8 +29,8 @@ namespace ipa::soft::algorithms {
 /*
  * The AF modes this algorithm implements. AfModeAuto is deliberately absent:
  * it requires a one-shot scan that ends in AfStateFocused and stays there,
- * which the sweep below does not distinguish from continuous operation.
- * AfTrigger remains available to force a fresh sweep in continuous mode.
+ * which the search below does not distinguish from continuous operation.
+ * AfTrigger remains available to force a fresh scan in continuous mode.
  */
 static const std::array<ControlValue, 2> kAfModeValues{
 	ControlValue(static_cast<int32_t>(controls::AfModeManual)),
@@ -63,12 +63,12 @@ static constexpr double kUncalibratedMaxDioptres = 10.0;
 static constexpr double kFallbackDefaultDioptres = 1.0;
 
 /*
- * The sweep starts at 1/50 of the focus range and halves until it is finer
- * than 1/500 of it, which reproduces the coarse-to-fine search the algorithm
- * has always done.
+ * The coarse scan for first focus, AfTrigger and a flat probe: this many
+ * evenly spaced points, stopping early once sharpness has fallen kScanFall
+ * below the best point two or more points back.
  */
-static constexpr double kSweepStepInitial = 1.0 / 50.0;
-static constexpr double kSweepStepFinal = 1.0 / 500.0;
+static constexpr unsigned int kScanPoints = 9;
+static constexpr double kScanFall = 0.40;
 
 /*
  * Hill climbing, all as fractions of the focus range. A change in sharpness
@@ -76,8 +76,7 @@ static constexpr double kSweepStepFinal = 1.0 / 500.0;
  * by brightness, but frame-to-frame noise remains.
  */
 static constexpr double kProbeStepFine = 0.02;	 /* refocus after a small drop */
-static constexpr double kProbeStepCoarse = 0.06; /* first focus, AfTrigger, big drop */
-static constexpr double kProbeStepWide = 0.15;	 /* last probe before a sweep */
+static constexpr double kProbeStepCoarse = 0.06; /* after a big drop */
 static constexpr double kClimbStepMax = 0.15;
 static constexpr double kRefineStepMin = 0.005;
 static constexpr double kNoise = 0.04;
@@ -96,7 +95,7 @@ static constexpr double kPeakDrop = 2 * kNoise;
  */
 static constexpr double kLostDrop = 0.20;
 static constexpr double kBigDrop = 0.50;
-static constexpr unsigned int kLostFrames = 3;
+static constexpr unsigned int kLostFrames = 5;
 
 /*
  * Frames to discard after a move before measuring: requests already in
@@ -223,7 +222,7 @@ void Af::queueRequest(typename Module::Context &context,
 		if (isManual(context) != wasManual) {
 			if (isManual(context)) {
 				/*
-				 * Abandon any sweep in progress and hold the
+				 * Abandon any search in progress and hold the
 				 * position the lens is at, until the
 				 * application supplies one of its own.
 				 */
@@ -297,6 +296,7 @@ void Af::moveTo(IPAContext &context, double dioptres)
 
 	settle_ = std::abs(dioptres - pos) > range * kLargeMove ? kSettleLarge
 								  : kSettleSmall;
+	measureFrames_ = kMeasureFrames;
 	pos = dioptres;
 	acc_ = 0.0;
 	accCount_ = 0;
@@ -304,7 +304,60 @@ void Af::moveTo(IPAContext &context, double dioptres)
 
 void Af::restart(IPAContext &context)
 {
-	startProbe(context, kProbeStepCoarse);
+	startScan(context);
+}
+
+/*
+ * A fast coarse scan: kScanPoints positions across the range, one frame
+ * each, starting from the end nearer the lens. It stops early once
+ * sharpness has fallen well below the best point seen, as the peak is then
+ * behind it, and hands the best point to Refine.
+ */
+void Af::startScan(IPAContext &context)
+{
+	const double pos = context.activeState.knobs.focus_pos.value_or(dioptresDef_);
+
+	scanStep_ = (dioptresMax_ - dioptresMin_) / (kScanPoints - 1);
+	scanDir_ = pos <= (dioptresMin_ + dioptresMax_) / 2 ? 1.0 : -1.0;
+	scanStart_ = scanDir_ > 0 ? dioptresMin_ : dioptresMax_;
+	scanIndex_ = 0;
+	scanBestIndex_ = 0;
+	bestSharp_ = 0.0;
+	bestPos_ = scanStart_;
+	state_ = State::Scan;
+	context.activeState.knobs.focus_sweep = true;
+	moveTo(context, scanStart_);
+	measureFrames_ = 1;
+	LOG(IPASoftAutoFocus, Info) << "Scanning for focus";
+}
+
+void Af::scanStep(IPAContext &context, double sharp)
+{
+	const double pos = context.activeState.knobs.focus_pos.value();
+
+	if (sharp > bestSharp_) {
+		bestSharp_ = sharp;
+		bestPos_ = pos;
+		scanBestIndex_ = scanIndex_;
+	}
+	scanIndex_++;
+
+	const bool pastPeak = scanIndex_ - scanBestIndex_ >= 2 &&
+			      sharp < bestSharp_ * (1.0 - kScanFall);
+	if (scanIndex_ < kScanPoints && !pastPeak) {
+		moveTo(context, scanStart_ + scanDir_ * scanIndex_ * scanStep_);
+		settle_ = kSettleSmall;
+		measureFrames_ = 1;
+		return;
+	}
+
+	LOG(IPASoftAutoFocus, Debug)
+		<< "Scan best " << bestPos_ << " dioptres after "
+		<< scanIndex_ << " points";
+	climbStep_ = scanStep_ / 2.0;
+	probeIndex_ = 1;
+	state_ = State::Refine;
+	moveTo(context, bestPos_ + climbStep_);
 }
 
 void Af::startProbe(IPAContext &context, double stepFraction)
@@ -320,22 +373,6 @@ void Af::startProbe(IPAContext &context, double stepFraction)
 		<< "Probing +-" << probeStep_ << " dioptres around " << centre_;
 }
 
-void Af::startSweep(IPAContext &context)
-{
-	auto &focus = context.configuration.focus;
-
-	focus.focus_max_pos = dioptresMin_;
-	focus.sharpness_max = 0;
-	focus.start = dioptresMin_;
-	focus.stop = dioptresMax_;
-	focus.step = (dioptresMax_ - dioptresMin_) * kSweepStepInitial;
-	state_ = State::Sweep;
-	context.activeState.knobs.focus_sweep = true;
-	moveTo(context, dioptresMin_);
-	settle_ = kSettleLarge;
-	LOG(IPASoftAutoFocus, Info) << "Sharpness is flat here, sweeping";
-}
-
 /* Hold the given position as focused, with its sharpness as reference. */
 void Af::settle(IPAContext &context, double dioptres, double sharp)
 {
@@ -349,35 +386,6 @@ void Af::settle(IPAContext &context, double dioptres, double sharp)
 		<< lensCode(dioptres) << "), sharpness " << sharp;
 }
 
-/* One step of the fallback coarse-to-fine sweep, as the algorithm used to do. */
-void Af::sweepStep(IPAContext &context, double sharp)
-{
-	auto &focus = context.configuration.focus;
-	double pos = context.activeState.knobs.focus_pos.value();
-
-	if (sharp > focus.sharpness_max) {
-		focus.sharpness_max = sharp;
-		focus.focus_max_pos = pos;
-	}
-
-	pos += focus.step;
-	if (pos > focus.start && pos < focus.stop) {
-		moveTo(context, pos);
-		return;
-	}
-
-	focus.start = std::clamp(focus.focus_max_pos - focus.step, dioptresMin_, dioptresMax_);
-	focus.stop = std::clamp(focus.focus_max_pos + focus.step, dioptresMin_, dioptresMax_);
-	focus.step /= 2;
-	if (focus.step > (dioptresMax_ - dioptresMin_) * kSweepStepFinal) {
-		focus.sharpness_max = 0;
-		moveTo(context, focus.start);
-		return;
-	}
-
-	settle(context, focus.focus_max_pos, focus.sharpness_max);
-}
-
 /* A measurement at the current position is complete. */
 void Af::measured(IPAContext &context, double sharp)
 {
@@ -388,8 +396,8 @@ void Af::measured(IPAContext &context, double sharp)
 	case State::Idle:
 		break;
 
-	case State::Sweep:
-		sweepStep(context, sharp);
+	case State::Scan:
+		scanStep(context, sharp);
 		break;
 
 	case State::Probe:
@@ -429,14 +437,12 @@ void Af::measured(IPAContext &context, double sharp)
 				 * centre is the peak.
 				 */
 				settle(context, centre_, centreSharp_);
-			} else if (probeFraction_ < kProbeStepWide) {
-				/* Flat at this step: look wider before sweeping. */
+			} else if (probeFraction_ < kProbeStepCoarse) {
+				/* Flat at a small step: look wider before scanning. */
 				context.activeState.knobs.focus_pos = centre_;
-				startProbe(context, probeFraction_ < kProbeStepCoarse
-							    ? kProbeStepCoarse
-							    : kProbeStepWide);
+				startProbe(context, kProbeStepCoarse);
 			} else {
-				startSweep(context);
+				startScan(context);
 			}
 		}
 		break;
@@ -531,7 +537,7 @@ void Af::step(IPAContext &context, uint64_t sharp)
 	}
 
 	acc_ += static_cast<double>(sharp);
-	if (++accCount_ < kMeasureFrames)
+	if (++accCount_ < measureFrames_)
 		return;
 
 	measured(context, acc_ / accCount_);
diff --git a/src/ipa/simple/algorithms/af.h b/src/ipa/simple/algorithms/af.h
index 0052a2d51..abf27765e 100644
--- a/src/ipa/simple/algorithms/af.h
+++ b/src/ipa/simple/algorithms/af.h
@@ -43,18 +43,19 @@ private:
 	 * Climb:  step in the improving direction until sharpness falls.
 	 * Refine: two-sided probes around the best position, halving the
 	 *         step each round.
-	 * Sweep:  the full coarse-to-fine scan, only when the probe finds
-	 *         the sharpness curve flat (far out of focus).
+	 * Scan:   a fast coarse scan across the range, for first focus,
+	 *         AfTrigger, and when a probe finds the sharpness curve flat
+	 *         (far out of focus); it hands the best point to Refine.
 	 */
-	enum class State { Idle, Probe, Climb, Refine, Sweep };
+	enum class State { Idle, Probe, Climb, Refine, Scan };
 
 	bool isManual(const IPAContext &context) const;
 	int32_t lensCode(double dioptres) const;
 	void updateFocus(IPAContext &context, IPAFrameContext &frameContext, double focus);
 	void step(IPAContext &context, uint64_t sharp);
 	void restart(IPAContext &context);
-	void startSweep(IPAContext &context);
-	void sweepStep(IPAContext &context, double sharp);
+	void startScan(IPAContext &context);
+	void scanStep(IPAContext &context, double sharp);
 	void startProbe(IPAContext &context, double stepFraction);
 	void moveTo(IPAContext &context, double dioptres);
 	void measured(IPAContext &context, double sharp);
@@ -66,6 +67,14 @@ private:
 	unsigned int settle_ = 0;
 	double acc_ = 0.0;
 	unsigned int accCount_ = 0;
+	unsigned int measureFrames_ = 1;
+
+	/* Coarse scan. */
+	double scanStart_ = 0.0;
+	double scanStep_ = 0.0;
+	double scanDir_ = 1.0;
+	unsigned int scanIndex_ = 0;
+	unsigned int scanBestIndex_ = 0;
 
 	/* Hill climbing. */
 	double centre_ = 0.0;		/* position being probed around */

From f7338c74c70beb186ac34023bb5ebbd9c0bcfa27 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 18:02:36 +0000
Subject: [PATCH 64/76] ipa: soft: agc: Regulate onto a mean luminance target
 from the tuning

The AGC aims the mean sample value of a five bin histogram of the raw
image at the middle of its range, which puts the mean linear luminance
around 40-50% of full scale. Vendor AEC tunings aim much lower (a luma
target around a fifth of full scale on Qualcomm's), and a tone curve
taken from such a tuning is made for that exposure: combined with the
default target, anything bright in the scene comes out blown.

Add an optional meanTarget: the linear mean luminance above black, as a
fraction of full scale, to regulate onto instead. The correction is the
ratio in stops, taken straight (damped to 0.85) when more than 0.6 stop
off and half-way within the step limit when closer, with no correction
within 0.1 stop.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/soft/algorithms/agc.cpp | 58 ++++++++++++++++++++++++++++++---
 src/ipa/soft/algorithms/agc.h   |  3 ++
 2 files changed, 56 insertions(+), 5 deletions(-)

diff --git a/src/ipa/soft/algorithms/agc.cpp b/src/ipa/soft/algorithms/agc.cpp
index b12cb5fca..d148a1806 100644
--- a/src/ipa/soft/algorithms/agc.cpp
+++ b/src/ipa/soft/algorithms/agc.cpp
@@ -78,6 +78,13 @@ static constexpr float kDefaultExpMaxRatio = 4.0;
  */
 static constexpr float kAcquireError = 0.5;
 
+/*
+ * With a mean luminance target: no correction within kMeanSatisfactory stops
+ * of it (the hysteresis), and a direct one beyond kMeanAcquire stops.
+ */
+static constexpr double kMeanSatisfactory = 0.1;
+static constexpr double kMeanAcquire = 0.6;
+
 Agc::Agc()
 	: exposureOptimal_(kExposureOptimal),
 	  exposureSatisfactory_(kDefaultExposureSatisfactory),
@@ -116,6 +123,21 @@ int Agc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 	if (ratio.has_value())
 		maxRatio_ = std::max(ratio.value(), 1.0f);
 
+	/*
+	 * meanTarget, 0 to 1: regulate the linear mean luminance above black
+	 * onto it, instead of the mean sample value of the histogram onto
+	 * exposureOptimal. A vendor tuning's AEC luma target is this, and a
+	 * tone curve taken from the same tuning is made for it: the default
+	 * mean sample value target exposes around a stop brighter.
+	 */
+	auto mean = tuningData["meanTarget"].get<double>();
+	if (mean.has_value() && *mean > 0.0 && *mean < 1.0)
+		meanTarget_ = *mean;
+
+	if (meanTarget_)
+		LOG(IPASoftExposure, Info)
+			<< "Regulating the mean luminance onto " << *meanTarget_;
+
 	LOG(IPASoftExposure, Debug)
 		<< "AGC: optimal " << exposureOptimal_
 		<< ", satisfactory " << exposureSatisfactory_
@@ -133,13 +155,39 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 	double &again = frameContext.sensor.gain;
 
 	double error = exposureOptimal_ - exposureMSV;
-
-	if (std::abs(error) <= exposureSatisfactory_)
-		return;
-
 	double factor;
 
-	if (std::abs(error) > kAcquireError) {
+	if (meanTarget_) {
+		/*
+		 * Regulate the linear mean luminance above black onto the
+		 * target. The histogram is of the raw data, before the tone
+		 * curve, so this is the quantity a vendor AEC luma target
+		 * refers to, and the one a tone curve tuned alongside it
+		 * expects in mid-grey.
+		 */
+		const double black = context.activeState.blc.level;
+		const double mean = std::max((meanY - black) / (255.0 - black), 1e-3);
+		const double stops = std::log2(*meanTarget_ / mean);
+
+		error = stops;
+		if (std::abs(stops) <= kMeanSatisfactory)
+			return;
+
+		if (std::abs(stops) > kMeanAcquire) {
+			/*
+			 * Far off: aim straight at the target, a little short,
+			 * as clipped highlights make the mean read low.
+			 */
+			factor = std::exp2(stops * 0.85);
+			factor = std::clamp<double>(factor, 1.0 / maxRatio_, maxRatio_);
+		} else {
+			/* Close: half the way, bounded, to settle without hunting */
+			factor = std::exp2(stops * 0.5);
+			factor = std::clamp<double>(factor, 1.0 - maxStep_, 1.0 + maxStep_);
+		}
+	} else if (std::abs(error) <= exposureSatisfactory_) {
+		return;
+	} else if (std::abs(error) > kAcquireError) {
 		/*
 		 * Far from the target, so aim straight at it rather than
 		 * stepping towards it. The mean luminance is proportional to
diff --git a/src/ipa/soft/algorithms/agc.h b/src/ipa/soft/algorithms/agc.h
index add015c7c..ac5bb2953 100644
--- a/src/ipa/soft/algorithms/agc.h
+++ b/src/ipa/soft/algorithms/agc.h
@@ -7,6 +7,8 @@
 
 #pragma once
 
+#include <optional>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -35,6 +37,7 @@ private:
 	float proportionalGain_;
 	float maxStep_;
 	float maxRatio_;
+	std::optional<double> meanTarget_;
 };
 
 } /* namespace ipa::soft::algorithms */

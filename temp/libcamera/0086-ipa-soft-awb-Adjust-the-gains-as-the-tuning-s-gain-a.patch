From a4b09b33cde535926e6f838fa1a9e33049f98e62 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sun, 27 Sep 2026 15:32:05 +0000
Subject: [PATCH] ipa: soft: awb: Adjust the gains as the tuning's gain
 adjustment says

Grey world, kept to the sensor's locus, neutralises the light it
finds, warm lamps included, which makes a room under 2700 K lamps look
cold, and a little green where its colours pull grey world. Phone
tunings keep some of the light's warmth: Qualcomm's (triglGAV1) with
factors on the red and blue gains over a mesh of white points and by
colour temperature.

Accept a gainAdjust in the tuning: the mesh's vertices (white point,
red and blue factors) and triangles, and optional factors by colour
temperature. The mesh's factors are interpolated across the triangle
the fitted white point falls in, multiplied by the colour
temperature's, and applied to the red and blue gains.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/soft/algorithms/awb.cpp | 100 +++++++++++++++++++++++++++++++-
 src/ipa/soft/algorithms/awb.h   |  14 +++++
 2 files changed, 111 insertions(+), 3 deletions(-)

diff --git a/src/ipa/soft/algorithms/awb.cpp b/src/ipa/soft/algorithms/awb.cpp
index 38b84871a..f11f6f136 100644
--- a/src/ipa/soft/algorithms/awb.cpp
+++ b/src/ipa/soft/algorithms/awb.cpp
@@ -120,9 +120,102 @@ int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 		return -EINVAL;
 	}
 
+	if (tuningData.contains("gainAdjust"))
+		return readGainAdjust(tuningData["gainAdjust"]);
+
+	return 0;
+}
+
+/*
+ * The gain adjustment, as Qualcomm's AWB tunings have it (triglGAV1): factors
+ * on the red and blue gains, by where the white point lies and by colour
+ * temperature, which keep some of a warm light's warmth rather than
+ * neutralise it fully:
+ *
+ *   gainAdjust:
+ *     vertices: [ 0.95, 0.46, 1.045, 0.93, ... ]   # R/G, B/G, red, blue
+ *     triangles: [ 0, 23, 2, ... ]                 # vertex indices
+ *     cctRed: [ 2600, 1.08, 2900, 1.0, ... ]      # optional
+ *     cctBlue: [ 2600, 0.96, 2900, 1.0, ... ]     # optional
+ *
+ * The mesh's factors are interpolated across the triangle the white point
+ * falls in (none outside the mesh), and multiplied by the colour
+ * temperature's.
+ */
+int Awb::readGainAdjust(const ValueNode &node)
+{
+	auto vertices = node["vertices"].get<std::vector<double>>();
+	auto triangles = node["triangles"].get<std::vector<unsigned int>>();
+	if (!vertices || vertices->size() % 4 || !triangles || triangles->size() % 3) {
+		LOG(IPASoftAwb, Error)
+			<< "gainAdjust needs vertices in fours and triangles in threes";
+		return -EINVAL;
+	}
+	for (size_t i = 0; i < vertices->size(); i += 4)
+		adjustVertices_.push_back({ { { (*vertices)[i], (*vertices)[i + 1] } },
+					    (*vertices)[i + 2], (*vertices)[i + 3] });
+	for (size_t i = 0; i < triangles->size(); i += 3) {
+		std::array<unsigned int, 3> t = { (*triangles)[i], (*triangles)[i + 1],
+						  (*triangles)[i + 2] };
+		for (unsigned int v : t) {
+			if (v >= adjustVertices_.size()) {
+				LOG(IPASoftAwb, Error) << "gainAdjust triangle vertex " << v << " out of range";
+				return -EINVAL;
+			}
+		}
+		adjustTriangles_.push_back(t);
+	}
+
+	for (auto [key, pwl] : { std::pair{ "cctRed", &adjustCtRed_ },
+				 std::pair{ "cctBlue", &adjustCtBlue_ } }) {
+		if (!node.contains(key))
+			continue;
+		auto p = node[key].get<ipa::Pwl>();
+		if (!p || p->empty()) {
+			LOG(IPASoftAwb, Error) << "Invalid gainAdjust " << key;
+			return -EINVAL;
+		}
+		*pwl = std::move(*p);
+	}
+
 	return 0;
 }
 
+/* The red and blue gain factors at the white point and colour temperature */
+Vector<double, 2> Awb::gainAdjust(const Vector<double, 2> &ratios, unsigned int ct) const
+{
+	Vector<double, 2> factors{ { 1.0, 1.0 } };
+
+	for (const auto &t : adjustTriangles_) {
+		const AdjustVertex &a = adjustVertices_[t[0]];
+		const AdjustVertex &b = adjustVertices_[t[1]];
+		const AdjustVertex &c = adjustVertices_[t[2]];
+		const Vector<double, 2> v0 = b.ratios - a.ratios;
+		const Vector<double, 2> v1 = c.ratios - a.ratios;
+		const Vector<double, 2> v2 = ratios - a.ratios;
+		const double den = v0[0] * v1[1] - v1[0] * v0[1];
+		if (std::abs(den) < 1e-12)
+			continue;
+		/* Barycentric coordinates of the white point */
+		const double wb = (v2[0] * v1[1] - v1[0] * v2[1]) / den;
+		const double wc = (v0[0] * v2[1] - v2[0] * v0[1]) / den;
+		const double wa = 1.0 - wb - wc;
+		constexpr double eps = -1e-9;
+		if (wa < eps || wb < eps || wc < eps)
+			continue;
+		factors = { { wa * a.red + wb * b.red + wc * c.red,
+			      wa * a.blue + wb * b.blue + wc * c.blue } };
+		break;
+	}
+
+	if (!adjustCtRed_.empty())
+		factors[0] *= adjustCtRed_.eval(adjustCtRed_.domain().clamp(ct));
+	if (!adjustCtBlue_.empty())
+		factors[1] *= adjustCtBlue_.eval(adjustCtBlue_.domain().clamp(ct));
+
+	return factors;
+}
+
 /*
  * Fit R/G, B/G ratios to the locus: the colour temperature of the nearest
  * point on it, interpolated in mired (reciprocal colour temperature, in
@@ -281,12 +374,13 @@ void Awb::process(IPAContext &context,
 		const Vector<double, 2> greyWorld{ { rgbGains.r(), rgbGains.b() } };
 		const LocusFit fit = fitLocus(greyWorld);
 		context.activeState.awb.temperatureK = fit.ct;
-		gains = { { static_cast<float>(1 / fit.ratios[0]), 1.0f,
-			    static_cast<float>(1 / fit.ratios[1]) } };
+		const Vector<double, 2> adjust = gainAdjust(fit.ratios, fit.ct);
+		gains = { { static_cast<float>(adjust[0] / fit.ratios[0]), 1.0f,
+			    static_cast<float>(adjust[1] / fit.ratios[1]) } };
 
 		LOG(IPASoftAwb, Debug)
 			<< "grey world R/G, B/G " << greyWorld << ", on the locus "
-			<< fit.ratios;
+			<< fit.ratios << ", adjusted by " << adjust;
 	}
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
diff --git a/src/ipa/soft/algorithms/awb.h b/src/ipa/soft/algorithms/awb.h
index c3a10e349..8b5235643 100644
--- a/src/ipa/soft/algorithms/awb.h
+++ b/src/ipa/soft/algorithms/awb.h
@@ -7,6 +7,7 @@
 
 #pragma once
 
+#include <array>
 #include <vector>
 
 #include "libcamera/internal/vector.h"
@@ -50,6 +51,19 @@ private:
 	};
 
 	LocusFit fitLocus(const Vector<double, 2> &ratios) const;
+	int readGainAdjust(const ValueNode &tuningData);
+	Vector<double, 2> gainAdjust(const Vector<double, 2> &ratios, unsigned int ct) const;
+
+	/* The gain adjustment mesh: white points and red, blue factors */
+	struct AdjustVertex {
+		Vector<double, 2> ratios;
+		double red, blue;
+	};
+	std::vector<AdjustVertex> adjustVertices_;
+	std::vector<std::array<unsigned int, 3>> adjustTriangles_;
+	/* Red and blue factors by colour temperature; empty without tuning */
+	ipa::Pwl adjustCtRed_;
+	ipa::Pwl adjustCtBlue_;
 
 	/* By increasing colour temperature; empty without tuning */
 	std::vector<LocusPoint> locus_;
-- 

From ccfd317701f63dcf0f315af0c772c9a9ecfe6e93 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sun, 27 Sep 2026 14:55:57 +0000
Subject: [PATCH] ipa: soft: awb: Let the transverse band depend on the colour
 temperature

A sensor's illuminants off its daylight locus are fluorescent tubes,
at around 3800 to 4100 K, but the band grey world is kept within was
one width at every colour temperature: as wide as those tubes need
everywhere. Under a warm lamp, a scene with much green in it then
pulled grey world 0.03 towards green, and the image came out green.

Accept transversePos and transverseNeg as piecewise linear functions
of the colour temperature as well as widths, evaluated at the fit's
colour temperature.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/soft/algorithms/awb.cpp | 38 +++++++++++++++++++++++++++------
 src/ipa/soft/algorithms/awb.h   |  8 ++++---
 2 files changed, 37 insertions(+), 9 deletions(-)

diff --git a/src/ipa/soft/algorithms/awb.cpp b/src/ipa/soft/algorithms/awb.cpp
index a896a49f3..38b84871a 100644
--- a/src/ipa/soft/algorithms/awb.cpp
+++ b/src/ipa/soft/algorithms/awb.cpp
@@ -36,6 +36,9 @@ static constexpr double kMinSignal = 2.5;
 /* Where to start on the locus, before any frame has enough signal */
 static constexpr unsigned int kStartCt = 5000;
 
+/* The transverse band's width without tuning, AwbBayes's default */
+static constexpr double kDefaultTransverse = 0.01;
+
 /**
  * \class Awb
  * \brief Grey world auto white balance
@@ -50,7 +53,8 @@ static constexpr unsigned int kStartCt = 5000;
  *           gains: [ 1.07, 2.16 ]   # red, blue
  *         - ct: 6500
  *           gains: [ 1.74, 1.37 ]
- *       transversePos: 0.017        # optional, default 0.01
+ *       transversePos: 0.017        # optional, default 0.01; or a
+ *                                   # function of CT: [ ct, width, ... ]
  *       transverseNeg: 0.030        # optional, default 0.01
  *
  * the grey world estimate is kept within the band of real illuminants: its
@@ -88,10 +92,31 @@ int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 		return -EINVAL;
 	}
 
-	transversePos_ = tuningData["transversePos"].get<double>(0.01);
-	transverseNeg_ = tuningData["transverseNeg"].get<double>(0.01);
-	if (transversePos_ < 0 || transverseNeg_ < 0) {
-		LOG(IPASoftAwb, Error) << "transversePos/Neg must not be negative";
+	/*
+	 * The band is a width, or a piecewise linear function of the colour
+	 * temperature for sensors whose off-locus illuminants (fluorescent
+	 * tubes) lie at some colour temperatures only.
+	 */
+	auto band = [](const ValueNode &node, ipa::Pwl &out) {
+		if (!node) {
+			out = ipa::Pwl({ { { 0.0, kDefaultTransverse } },
+					 { { 1e5, kDefaultTransverse } } });
+			return true;
+		}
+		if (auto width = node.get<double>()) {
+			out = ipa::Pwl({ { { 0.0, *width } }, { { 1e5, *width } } });
+			return *width >= 0;
+		}
+		auto pwl = node.get<ipa::Pwl>();
+		if (!pwl || pwl->empty())
+			return false;
+		out = std::move(*pwl);
+		return true;
+	};
+	if (!band(tuningData["transversePos"], transversePos_) ||
+	    !band(tuningData["transverseNeg"], transverseNeg_)) {
+		LOG(IPASoftAwb, Error)
+			<< "transversePos/Neg must be a width or a function of the colour temperature";
 		return -EINVAL;
 	}
 
@@ -133,7 +158,8 @@ Awb::LocusFit Awb::fitLocus(const Vector<double, 2> &ratios) const
 		if (normal.dot(p.ratios) < 0)
 			normal = -normal;
 		double len = std::sqrt(dist);
-		double limit = e.dot(normal) >= 0 ? transversePos_ : transverseNeg_;
+		const ipa::Pwl &side = e.dot(normal) >= 0 ? transversePos_ : transverseNeg_;
+		double limit = std::max(side.eval(side.domain().clamp(fit.ct)), 0.0);
 		fit.ratios = len > limit ? onLocus + e * (limit / len) : ratios;
 	}
 
diff --git a/src/ipa/soft/algorithms/awb.h b/src/ipa/soft/algorithms/awb.h
index d4218abb1..c3a10e349 100644
--- a/src/ipa/soft/algorithms/awb.h
+++ b/src/ipa/soft/algorithms/awb.h
@@ -11,6 +11,8 @@
 
 #include "libcamera/internal/vector.h"
 
+#include <libipa/pwl.h>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -51,9 +53,9 @@ private:
 
 	/* By increasing colour temperature; empty without tuning */
 	std::vector<LocusPoint> locus_;
-	/* How far off the locus, towards purple and towards green */
-	double transversePos_ = 0;
-	double transverseNeg_ = 0;
+	/* How far off the locus, towards purple and towards green, by CT */
+	ipa::Pwl transversePos_;
+	ipa::Pwl transverseNeg_;
 };
 
 } /* namespace ipa::soft::algorithms */
-- 

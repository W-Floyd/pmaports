From f8b06a726df615d63e77a3e2b23c7b6471841cb4 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 19:57:15 +0000
Subject: [PATCH 67/76] software_isp: Process each frame with its own
 parameters

process() asked the IPA to compute a frame's parameters, which it does
asynchronously, and queued the frame to the debayer at once with the
parameters as they stood: those of the previous frame. Every frame was
processed one frame late in white balance, colour and tone curve, which
shows as soon as the tone curve has to change in step with the exposure.

Hold each frame until the IPA reports its parameters computed, and
process it then, as the camss OPE backend already does. Also let the
caller pass the controls the sensor used for the frame, which
computeParams() now takes, for parameters that depend on the frame's
exposure; the simple pipeline passes none.

Signed-off-by: William Floyd <git@notmy.space>
---
 .../internal/software_isp/software_isp.h      |  8 +++--
 include/libcamera/ipa/soft.mojom              |  6 +++-
 src/libcamera/software_isp/software_isp.cpp   | 35 +++++++++++++++----
 3 files changed, 39 insertions(+), 10 deletions(-)

diff --git a/include/libcamera/internal/software_isp/software_isp.h b/include/libcamera/internal/software_isp/software_isp.h
index c9169c0a8..1493701ca 100644
--- a/include/libcamera/internal/software_isp/software_isp.h
+++ b/include/libcamera/internal/software_isp/software_isp.h
@@ -83,9 +83,11 @@ public:
 
 	void queueRequest(const uint32_t frame, const ControlList &controls);
 	int queueBuffers(uint32_t frame, FrameBuffer *input,
-			 const std::map<const Stream *, FrameBuffer *> &outputs);
+			 const std::map<const Stream *, FrameBuffer *> &outputs,
+			 const ControlList &sensorControls = ControlList());
 
-	void process(uint32_t frame, FrameBuffer *input, FrameBuffer *output);
+	void process(uint32_t frame, FrameBuffer *input, FrameBuffer *output,
+		     const ControlList &sensorControls = ControlList());
 
 	Signal<FrameBuffer *> inputBufferReady;
 	Signal<FrameBuffer *> outputBufferReady;
@@ -113,6 +115,8 @@ private:
 	std::unique_ptr<ipa::soft::IPAProxySoft> ipa_;
 	std::deque<FrameBuffer *> queuedInputBuffers_;
 	std::deque<FrameBuffer *> queuedOutputBuffers_;
+	/* Frames waiting for the IPA's parameters: input, output */
+	std::map<uint32_t, std::pair<FrameBuffer *, FrameBuffer *>> pendingFrames_;
 };
 
 } /* namespace libcamera */
diff --git a/include/libcamera/ipa/soft.mojom b/include/libcamera/ipa/soft.mojom
index 481de8ee2..129f04e87 100644
--- a/include/libcamera/ipa/soft.mojom
+++ b/include/libcamera/ipa/soft.mojom
@@ -29,7 +29,11 @@ interface IPASoftInterface {
 		=> (int32 ret);
 
 	[async] queueRequest(uint32 frame, libcamera.ControlList sensorControls);
-	[async] computeParams(uint32 frame);
+	/*
+	 * sensorControls: the controls the sensor uses for the frame, if the
+	 * pipeline knows them yet (empty otherwise).
+	 */
+	[async] computeParams(uint32 frame, libcamera.ControlList sensorControls);
 	[async] processStats(uint32 frame,
 			     uint32 bufferId,
 			     libcamera.ControlList sensorControls);
diff --git a/src/libcamera/software_isp/software_isp.cpp b/src/libcamera/software_isp/software_isp.cpp
index dd11766ae..920873ba4 100644
--- a/src/libcamera/software_isp/software_isp.cpp
+++ b/src/libcamera/software_isp/software_isp.cpp
@@ -429,10 +429,13 @@ void SoftwareIsp::queueRequest(const uint32_t frame, const ControlList &controls
  * \param[in] input The input framebuffer
  * \param[in] outputs The container holding the output stream pointers and
  * their respective frame buffer outputs
+ * \param[in] sensorControls The controls the sensor used for the frame, if
+ * known, for the parameters that depend on them
  * \return 0 on success, a negative errno on failure
  */
 int SoftwareIsp::queueBuffers(uint32_t frame, FrameBuffer *input,
-			      const std::map<const Stream *, FrameBuffer *> &outputs)
+			      const std::map<const Stream *, FrameBuffer *> &outputs,
+			      const ControlList &sensorControls)
 {
 	/*
 	 * Validate the outputs as a sanity check: at least one output is
@@ -454,7 +457,7 @@ int SoftwareIsp::queueBuffers(uint32_t frame, FrameBuffer *input,
 
 	for (const auto &[stream, buffer] : outputs) {
 		queuedOutputBuffers_.push_back(buffer);
-		process(frame, input, buffer);
+		process(frame, input, buffer, sensorControls);
 	}
 
 	return 0;
@@ -494,6 +497,9 @@ void SoftwareIsp::stop()
 
 	ipa_->stop();
 
+	/* Frames still waiting for parameters are cancelled below. */
+	pendingFrames_.clear();
+
 	for (auto buffer : queuedOutputBuffers_) {
 		buffer->_d()->cancel();
 		outputBufferReady.emit(buffer);
@@ -512,17 +518,32 @@ void SoftwareIsp::stop()
  * \param[in] frame The frame number
  * \param[in] input The input framebuffer
  * \param[out] output The framebuffer to write the processed frame to
+ * \param[in] sensorControls The controls the sensor used for the frame, if
+ * known
+ *
+ * The frame waits for the IPA to compute its parameters, and is processed
+ * with them when it has (see saveIspParams()): processing it at once would
+ * use the previous frame's.
  */
-void SoftwareIsp::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output)
+void SoftwareIsp::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output,
+			  const ControlList &sensorControls)
 {
-	ipa_->computeParams(frame);
-	debayer_->invokeMethod(&Debayer::process,
-			       ConnectionTypeQueued, frame, input, output, debayerParams_);
+	pendingFrames_[frame] = { input, output };
+	ipa_->computeParams(frame, sensorControls);
 }
 
-void SoftwareIsp::saveIspParams([[maybe_unused]] uint32_t frame)
+void SoftwareIsp::saveIspParams(uint32_t frame)
 {
 	debayerParams_ = *sharedParams_;
+
+	auto it = pendingFrames_.find(frame);
+	if (it == pendingFrames_.end())
+		return;
+
+	auto [input, output] = it->second;
+	pendingFrames_.erase(it);
+	debayer_->invokeMethod(&Debayer::process,
+			       ConnectionTypeQueued, frame, input, output, debayerParams_);
 }
 
 void SoftwareIsp::setSensorCtrls(const ControlList &sensorControls,

From 8075018ec2c0bd1c7ef0bcb8f6dbc1e48deef161 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 14:54:35 +0000
Subject: [PATCH 97/98] pipeline: simple: Delay the vertical blanking control

The software ISP lengthens the frame for longer exposures, and the
exposure has to follow the frame length it depends on: write the blanking
ahead, as the other pipelines do.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index de3367633..916968bd1 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -578,6 +578,12 @@ SimpleCameraData::SimpleCameraData(SimplePipelineHandler *pipe,
 		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
 		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
 	};
+	/*
+	 * The frame length, which the software ISP lengthens for longer
+	 * exposures: written ahead of the exposure that depends on it.
+	 */
+	if (sensor_->device()->controls().count(V4L2_CID_VBLANK))
+		params[V4L2_CID_VBLANK] = { delays.vblankDelay, true };
 	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
 
 	LOG(SimplePipeline, Debug)
-- 

From a9a829307c0f9a1b57d390d70ebd8b11b23a9f53 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 17:27:05 +0000
Subject: [PATCH] software_isp: Weigh the temporal filter once for the three
 channels

The weight followed each channel's own difference, so a moving edge kept
the old red and blue where the green had changed: coloured ghosts. Take it
from the channel that differs most, which also costs one exponential
instead of three, tighten the motion threshold and the strength limit, and
get the sharpening's detail from the toned linear luma, which does not need
a second pass of the colour processing.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ipa/soft/algorithms/denoise.cpp        |  4 +-
 src/libcamera/shaders/bayer_1x_packed.frag | 48 ++++++++++++++++------
 src/libcamera/shaders/bayer_cells_bin.frag | 13 ++++--
 3 files changed, 47 insertions(+), 18 deletions(-)

diff --git a/src/ipa/soft/algorithms/denoise.cpp b/src/ipa/soft/algorithms/denoise.cpp
index 92abcbdee..d444d975b 100644
--- a/src/ipa/soft/algorithms/denoise.cpp
+++ b/src/ipa/soft/algorithms/denoise.cpp
@@ -42,8 +42,8 @@ static constexpr double kDisableGain = 2.0;
  */
 static constexpr double kTemporalBase = 0.8;
 static constexpr double kTemporalPerStop = 0.5;
-static constexpr double kTemporalMax = 2.5;
-static constexpr double kTemporalWidth = 2.0;
+static constexpr double kTemporalMax = 1.8;
+static constexpr double kTemporalWidth = 1.5;
 
 /* The variance of the read noise, in 10-bit counts squared, by gain */
 static constexpr double kReadNoiseBase = 0.3;
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 177f39429..faf20796b 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -142,11 +142,12 @@ vec3 apply_chroma(vec3 rgb)
 }
 
 /*
- * The colour processing of a pixel's red, green and blue as the sensor saw
- * them, from 0 to 1 over the 8 high bits' range: black level, lens shading,
- * white balance, colour correction, tone curve and chroma.
+ * The linear part of the colour processing of a pixel's red, green and blue as
+ * the sensor saw them, from 0 to 1 over the 8 high bits' range: black level,
+ * lens shading (the gains at the pixel, from lens_shading()), white balance and
+ * colour correction.
  */
-vec3 process(vec3 rgb)
+vec3 linear_stage(vec3 rgb, vec3 shading)
 {
 	/*
 	 * \todo: Black level normalising, AWB and digital gain could be
@@ -155,7 +156,7 @@ vec3 process(vec3 rgb)
 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
 	/* Correct lens shading, on the linear data */
-	rgb *= lens_shading(textureOut);
+	rgb *= shading;
 
 	/*
 	 * Apply AWB gains, and saturate each channel at sensor range. Values
@@ -166,13 +167,27 @@ vec3 process(vec3 rgb)
 	rgb = min(rgb * awb, vec3(1.0));
 
 	/* Colour Correction Matrix */
-	rgb = ccm * rgb;
+	return ccm * rgb;
+}
 
-	/* Apply the tone curve after colour correction */
-	rgb = apply_tone(clamp(rgb, 0.0, 1.0));
+/* The tone curve after colour correction, and the chroma, on the encoded values */
+vec3 tone_chroma(vec3 linear)
+{
+	return apply_chroma(apply_tone(clamp(linear, 0.0, 1.0)));
+}
 
-	/* Scale the chroma, on the encoded values */
-	return apply_chroma(rgb);
+/* The tone curve of one value, as apply_tone() of each channel */
+float tone_value(float value)
+{
+	float x = clamp(value, 0.0, 1.0) * ((TONE_LUT_SIZE - 1.0) / TONE_LUT_SIZE) +
+		  0.5 / TONE_LUT_SIZE;
+	return texture2D(tone_lut, vec2(x, 0.5)).r;
+}
+
+/* The colour processing of a pixel's red, green and blue (see linear_stage()) */
+vec3 process(vec3 rgb)
+{
+	return tone_chroma(linear_stage(rgb, lens_shading(textureOut)));
 }
 
 /* A processed pixel in the output's channel order */
@@ -254,12 +269,19 @@ void main(void)
 		}
 	}
 
-	vec3 rgb = process(sum / weights / 1020.0);
+	vec3 shading = lens_shading(textureOut);
+	vec3 lin = linear_stage(sum / weights / 1020.0, shading);
+	vec3 rgb = tone_chroma(lin);
 
 	if (sharpen.w > 0.0) {
 		const vec3 luma = vec3(0.299, 0.587, 0.114);
-		vec3 low = process(ring * (0.25 / 1020.0));
-		float detail = dot(rgb - low, luma);
+		/*
+		 * The detail on the luma only, through the tone curve: the
+		 * linear luma of the filtered pixel and of the taps' mean
+		 * (after the same colour processing), each toned.
+		 */
+		vec3 linLow = linear_stage(ring * (0.25 / 1020.0), shading);
+		float detail = tone_value(dot(lin, luma)) - tone_value(dot(linLow, luma));
 		float y = dot(rgb, luma);
 
 		vec4 levels = texture2D(sharpen_lut,
diff --git a/src/libcamera/shaders/bayer_cells_bin.frag b/src/libcamera/shaders/bayer_cells_bin.frag
index ad80d11af..dee779695 100644
--- a/src/libcamera/shaders/bayer_cells_bin.frag
+++ b/src/libcamera/shaders/bayer_cells_bin.frag
@@ -96,13 +96,20 @@ void main(void)
 
 	if (temporal.x > 0.0) {
 		vec3 prev = texture(prev_cells, gl_FragCoord.xy / vec2(textureSize(prev_cells, 0))).rgb * 1023.0;
+		/*
+		 * One weight for the three channels, from the one that differs
+		 * most: the channels must not be blended by different amounts,
+		 * or a moving edge keeps the old red and blue where the green
+		 * has changed, and leaves a coloured ghost. A cell's green is
+		 * the mean of two pixels, with half the variance.
+		 */
 		vec3 level = max(cell - black, 0.0);
-		/* A cell's green is the mean of two pixels: half the variance */
 		vec3 sigma = sqrt(noise.x * level + noise.y * level * level + noise.z) *
 			     vec3(1.0, 0.70710678, 1.0);
+		vec3 d = abs(cell - prev) / sigma;
 		/* The previous cell is itself filtered, which widens the difference's spread */
-		vec3 d = (cell - prev) / max(temporal.y * sigma * 1.2, 0.001);
-		vec3 w = temporal.x * exp(-0.5 * d * d);
+		float m = max(max(d.x, d.y), d.z) / max(temporal.y * 1.2, 0.001);
+		float w = temporal.x * exp(-0.5 * m * m);
 		cell = (cell + w * prev) / (1.0 + w);
 	}
 

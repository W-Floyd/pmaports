+/**
+ * \brief Set the lens shading correction the debayer applies to the frame
+ * \param[in] params The debayer parameters
+ *
+ * The statistics of frames processed by processFrame() are then gathered as
+ * if on the corrected image: the lens shading gains lift the image corners,
+ * and exposure and white balance must see them lifted.
+ */
+void SwStatsCpu::setLensShading(const DebayerParams &params)
+{
+	lscEnabled_ = params.lscEnabled && !quadBayer_;
+	lscBlack_ = params.blackLevel;
+	if (!lscEnabled_ || params.lsc == lscValues_)
+		return;
+
+	lscValues_ = params.lsc;
+	std::transform(lscValues_.begin(), lscValues_.end(), lscGrid_.begin(),
+		       DebayerParams::lscDecode);
+}
+
+/*
+ * Interpolate the lens shading gains for the samples of the 2x2 block line
+ * at an input row: one sample every 4 pixels from the window's left edge,
+ * the grid's points spanning the input image corner to corner.
+ */
+void SwStatsCpu::prepareLscLine(unsigned int row)
+{
+	constexpr unsigned int kW = DebayerParams::kLscWidth;
+	constexpr unsigned int kH = DebayerParams::kLscHeight;
+	constexpr unsigned int kSampleStep = 4;
+
+	auto position = [](float pixel, unsigned int size, unsigned int points) {
+		float p = std::clamp(pixel / std::max(size, 1u), 0.0f, 1.0f) * (points - 1);
+		unsigned int i = std::min(static_cast<unsigned int>(p), points - 2);
+		return std::make_pair(i, p - i);
+	};
+
+	/* The samples' columns are the same on every line */
+	const unsigned int samples = window_.width / kSampleStep + 1;
+	if (lscColumns_.size() != samples) {
+		lscColumns_.resize(samples);
+		for (unsigned int k = 0; k < samples; k++)
+			lscColumns_[k] = position(window_.x + k * kSampleStep + 1.0f,
+						  inputSize_.width, kW);
+	}
+
+	/* The grid's row at this input row, per point and channel */
+	const auto [gy, fy] = position(row + 1.0f, inputSize_.height, kH);
+	std::array<float, kW * 3> gridRow;
+	for (unsigned int i = 0; i < kW * 3; i++)
+		gridRow[i] = lscGrid_[gy * kW * 3 + i] * (1.0f - fy) +
+			     lscGrid_[(gy + 1) * kW * 3 + i] * fy;
+
+	lscLineGains_.resize(samples);
+	for (unsigned int k = 0; k < samples; k++) {
+		const auto [gx, fx] = lscColumns_[k];
+		const float *a = &gridRow[gx * 3];
+		const float *b = &gridRow[(gx + 1) * 3];
+		lscLineGains_[k] = {
+			a[0] * (1.0f - fx) + b[0] * fx,
+			a[1] * (1.0f - fx) + b[1] * fx,
+			a[2] * (1.0f - fx) + b[2] * fx,
+		};
+	}
+}

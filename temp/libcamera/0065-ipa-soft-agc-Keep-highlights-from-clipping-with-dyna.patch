diff --git a/src/ipa/soft/algorithms/adjust.cpp b/src/ipa/soft/algorithms/adjust.cpp
index 1a95dcfe8..aa342a0a4 100644
--- a/src/ipa/soft/algorithms/adjust.cpp
+++ b/src/ipa/soft/algorithms/adjust.cpp
@@ -32,20 +32,28 @@ LOG_DEFINE_CATEGORY(IPASoftAdjust)
  * \param[in] gamma The display gamma, e.g. 2.2, used when \a curve is null
  * \param[in] contrastExp Exponent of the contrast S-curve, 1 for none
  * \param[in] curve A tone curve mapping [0, 1] to [0, 1], or nullptr
+ * \param[in] drcGain The dynamic range compression gain, 1 for none
  *
- * The contrast S-curve is applied first, then either \a curve or the gamma
- * encoding x^(1/gamma).
+ * Dynamic range compression comes first, on the linear input: when exposure
+ * has been reduced by \a drcGain to keep highlights from clipping, it scales
+ * the shadows and mid-tones back up by that much while leaving white at
+ * white, with x * g / (1 + (g - 1) * x). The contrast S-curve follows, then
+ * either \a curve or the gamma encoding x^(1/gamma).
  *
  * \return The tone lookup table
  */
-ToneLut toneLut(float gamma, float contrastExp, const ipa::Pwl *curve)
+ToneLut toneLut(float gamma, float contrastExp, const ipa::Pwl *curve,
+		float drcGain)
 {
 	ToneLut lut;
 	const double last = lut.size() - 1.0;
+	const double g = std::max(drcGain, 1.0f);
 
 	for (unsigned int i = 0; i < lut.size(); i++) {
 		double x = i / last;
 
+		x = x * g / (1.0 + (g - 1.0) * x);
+
 		/* Simple S-curve around mid-grey */
 		if (x < 0.5)
 			x = 0.5 * std::pow(x / 0.5, contrastExp);
@@ -168,13 +176,16 @@ void Adjust::prepare(IPAContext &context,
 	/* Map contrast 0..2 to an exponent 0..infinity, avoiding tan(pi/2). */
 	const float contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
 	const bool fromCurve = !curve_.empty() && !gammaSet_;
+	/* Rebuild for DRC changes of a percent or more, not every wobble. */
+	const float drc = std::round(std::max(context.activeState.agc.drcGain, 1.0) * 100) / 100;
 
 	if (!lutValid_ || gamma != lutGamma_ || contrastExp != lutContrastExp_ ||
-	    fromCurve != lutFromCurve_) {
-		lut_ = toneLut(gamma, contrastExp, fromCurve ? &curve_ : nullptr);
+	    fromCurve != lutFromCurve_ || drc != lutDrc_) {
+		lut_ = toneLut(gamma, contrastExp, fromCurve ? &curve_ : nullptr, drc);
 		lutGamma_ = gamma;
 		lutContrastExp_ = contrastExp;
 		lutFromCurve_ = fromCurve;
+		lutDrc_ = drc;
 		lutValid_ = true;
 	}
 	params->toneLut = lut_;

+namespace {
+
+/*
+ * The mean level of the pixels ranked between the fractions start and end
+ * of the pixels from the bright end of the histogram, as a fraction of the
+ * range above black. Empty if the range holds no pixels.
+ */
+std::optional<double> brightMean(const SwIspStats *stats, double black,
+				 double start, double end)
+{
+	const auto &hist = stats->yHistogram;
+	constexpr unsigned int kBinWidth = 256 / SwIspStats::kYHistogramSize;
+	double total = 0.0;
+
+	for (unsigned int i = 0; i < hist.size(); i++)
+		total += hist[i];
+
+	const double from = start * total;
+	const double to = end * total;
+	double seen = 0.0, sum = 0.0, count = 0.0;
+
+	for (unsigned int i = hist.size(); i-- > 0 && seen < to;) {
+		const double c = hist[i];
+		const double overlap = std::min(seen + c, to) - std::max(seen, from);
+		if (overlap > 0.0) {
+			const double level = i * kBinWidth + kBinWidth / 2.0;
+			sum += overlap * std::max(level - black, 0.0);
+			count += overlap;
+		}
+		seen += c;
+	}
+
+	if (count <= 0.0)
+		return {};
+
+	return sum / count / (255.0 - black);
+}
+
+} /* namespace */
+
+/*
+ * The mean luminance target, adjusted from the histogram (see init()), and
+ * the DRC gain, updated in the active state. The histogram is of an image
+ * taken with the current DRC gain in effect, so the brightest pixels are
+ * scaled back up by it to judge the scene as the target would expose it.
+ */
+double Agc::histTarget(IPAContext &context, const SwIspStats *stats)
+{
+	const double black = context.activeState.blc.level;
+	const double drcNow = std::max(context.activeState.agc.drcGain, 1.0);
+
+	std::optional<double> sat = brightMean(stats, black, hist_->satStart, hist_->satEnd);
+	if (!sat)
+		return *meanTarget_ / drcNow;
+
+	const double scene = *sat * drcNow;
+	const double want = std::clamp(scene / hist_->satRef, 1.0, hist_->maxDrc);
+	const double drc = hist_->filter * drcNow + (1.0 - hist_->filter) * want;
+	context.activeState.agc.drcGain = drc;
+
+	double adj;
+	if (scene > hist_->satRef) {
+		/* Saturating: the target itself gives little, DRC the rest */
+		adj = std::clamp(hist_->satRef / scene, hist_->minAdj, 1.0);
+	} else {
+		/* A flat scene, with no bright pixels: expose it brighter */
+		std::optional<double> up = brightMean(stats, black, hist_->upStart, hist_->upEnd);
+		adj = up && *up > 0.0
+			      ? std::clamp(hist_->satRef / (*up * drcNow), 1.0, hist_->maxAdj)
+			      : 1.0;
+	}
+
+	LOG(IPASoftExposure, Debug)
+		<< "brightest " << scene << " of " << hist_->satRef
+		<< ": DRC gain " << drc << ", target adjusted by " << adj;
+
+	return *meanTarget_ * adj / drc;
+}
+
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
-			 double exposureMSV, double meanY)
+			 double exposureMSV, double meanY, double meanTarget)
 {
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
@@ -167,7 +285,7 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 		 */
 		const double black = context.activeState.blc.level;
 		const double mean = std::max((meanY - black) / (255.0 - black), 1e-3);
-		const double stops = std::log2(*meanTarget_ / mean);
+		const double stops = std::log2(meanTarget / mean);
 
 		error = stops;
 		if (std::abs(stops) <= kMeanSatisfactory)
@@ -347,7 +465,11 @@ void Agc::process(IPAContext &context,
 	}
 	double meanY = yCount ? static_cast<double>(ySum) / yCount : 0.0;
 
-	updateExposure(context, frameContext, exposureMSV, meanY);
+	double target = 0.0;
+	if (meanTarget_)
+		target = hist_ ? histTarget(context, stats) : *meanTarget_;
+
+	updateExposure(context, frameContext, exposureMSV, meanY, target);
 }
 

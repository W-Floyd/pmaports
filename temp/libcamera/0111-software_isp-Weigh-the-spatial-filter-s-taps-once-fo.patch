From 9e73906c191d09030d118526c53532959c22d84e Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 17:28:17 +0000
Subject: [PATCH] software_isp: Weigh the spatial filter's taps once for the
 three channels

One exponential a tap instead of three, and the channels are no longer
averaged by different amounts at an edge.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/libcamera/shaders/bayer_1x_packed.frag | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index faf20796b..046cb626f 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -219,7 +219,7 @@ vec4 finish(vec3 rgb)
  * noise, so that differences of a few noise deviations are averaged and
  * edges are kept:
  *
- *   weight = exp(-(difference / (width * sigma))^2 / 2)
+ *   weight = exp(-(mean over the channels of (difference / (width * sigma))^2) / 2)
  *   sigma^2 = slope * level + quad * level^2 + floor, level above black in
  *             10-bit counts
  *
@@ -255,14 +255,19 @@ void main(void)
 	vec3 inv = 1.0 / max(width * sigma, 0.001);
 
 	vec3 sum = c;
-	vec3 weights = vec3(1.0);
+	float weights = 1.0;
 	vec3 ring = vec3(0.0);
 	for (int dy = 0; dy < 2; dy++) {
 		for (int dx = 0; dx < 2; dx++) {
 			vec2 offset = vec2(dx == 0 ? -1.5 : 1.5, dy == 0 ? -1.5 : 1.5) * texel;
 			vec3 n = texture2D(cell_tex, textureOut + offset).rgb * 1023.0;
+			/*
+			 * One weight for the tap, from the three channels'
+			 * differences together (their mean square), so that
+			 * the channels are not averaged by different amounts.
+			 */
 			vec3 d = (n - c) * inv;
-			vec3 w = exp(-0.5 * d * d);
+			float w = exp(-(1.0 / 6.0) * dot(d, d));
 			sum += w * n;
 			weights += w;
 			ring += n;
-- 

From 0e0692add26b41701bf8f56d5c02fd2427e2b9ca Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 14:54:35 +0000
Subject: [PATCH 98/98] ipa: soft: agc: Lengthen the frame for longer exposures
 in the dark

The exposure is limited to the sensor's frame at its default vertical
blanking (about 33 ms), where the tuning's exposure table reaches 70 ms.
With a maxExposure in the tuning, once the exposure is at its limit and the
gain a stop above unity, raise the vertical blanking for more exposure time
rather than gain, up to the tuning's longest, and shorten the frame again
as the scene brightens.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ipa/soft/algorithms/agc.cpp | 83 +++++++++++++++++++++++++++++++--
 src/ipa/soft/algorithms/agc.h   |  4 ++
 src/ipa/soft/ipa_context.h      |  9 ++++
 src/ipa/soft/soft_simple.cpp    |  3 ++
 4 files changed, 96 insertions(+), 3 deletions(-)

diff --git a/src/ipa/soft/algorithms/agc.cpp b/src/ipa/soft/algorithms/agc.cpp
index fd61baa7d..39dfe3ede 100644
--- a/src/ipa/soft/algorithms/agc.cpp
+++ b/src/ipa/soft/algorithms/agc.cpp
@@ -13,6 +13,8 @@
 #include <stdint.h>
 #include <vector>
 
+#include <linux/v4l2-controls.h>
+
 #include <libcamera/base/log.h>
 
 #include "control_ids.h"
@@ -90,6 +92,14 @@ static constexpr float kAcquireError = 0.5;
  * of it (the hysteresis), and a direct one beyond kMeanAcquire stops.
  */
 static constexpr double kMeanSatisfactory = 0.1;
+
+/*
+ * The analogue gain from which a longer exposure than the frame allows
+ * lengthens the frame, in the dark, rather than raising the gain further:
+ * one stop of gain first, as the noise of more gain costs more than the
+ * frame rate of a longer frame, in the dark.
+ */
+static constexpr double kExtendGain = 2.0;
 static constexpr double kMeanAcquire = 0.6;
 
 Agc::Agc()
@@ -176,6 +186,16 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 	if (meanTarget_ && luxRef && *luxRef > 0.0 && luxStop && *luxStop > 0.0)
 		lux_ = LuxTuning{ *luxRef, *luxStop };
 
+	/*
+	 * maxExposure: the longest exposure time (us) to lengthen the frame
+	 * (vertical blanking) for, once the exposure is at the frame's
+	 * limit and the gain has risen to a stop above unity. The tuning's
+	 * exposure table reaches it. Without it the frame is never lengthened.
+	 */
+	auto maxExposure = tuningData["maxExposure"].get<double>();
+	if (maxExposure && *maxExposure > 0.0)
+		maxExposureUs_ = *maxExposure;
+
 	/*
 	 * histogram: adjusts the mean luminance target from the brightest
 	 * pixels, after the histogram luma target of Qualcomm's AEC metering
@@ -361,6 +381,39 @@ void Agc::trackDrc(IPAContext &context, const IPAFrameContext &frameContext)
 	}
 }
 
+int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.configuration.agc;
+
+	const auto vblank = configInfo.sensorControls.find(V4L2_CID_VBLANK);
+	const double lineUs = agc.lineDuration.get<std::micro>();
+	if (maxExposureUs_ <= 0.0 || vblank == configInfo.sensorControls.end() || lineUs <= 0.0)
+		return 0;
+
+	/*
+	 * The sensor's exposure limit (exposureMax) is the frame length less
+	 * a margin, at the vertical blanking the sensor starts with, which
+	 * drivers set to the control's default for the mode; each line of
+	 * blanking more is a line more exposure.
+	 */
+	const ControlInfo &info = vblank->second;
+	agc.vblankBase = info.def().get<int32_t>();
+	agc.vblankMax = info.max().get<int32_t>();
+	agc.exposureCap = std::min<int32_t>(std::lround(maxExposureUs_ / lineUs),
+					    agc.exposureMax + (agc.vblankMax - agc.vblankBase));
+	if (agc.exposureCap <= agc.exposureMax) {
+		agc.exposureCap = 0;
+		return 0;
+	}
+	context.activeState.agc.vblank = agc.vblankBase;
+
+	LOG(IPASoftExposure, Info)
+		<< "The frame lengthens for exposures up to " << agc.exposureCap
+		<< " lines, over " << agc.exposureMax;
+
+	return 0;
+}
+
 /* The histogram adjustment of a tuning node (see init()), if it is valid */
 std::optional<Agc::HistTuning> Agc::readHist(const ValueNode &hist)
 {
@@ -589,11 +642,25 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 					  -maxStep_, maxStep_);
 	}
 
+	const auto &cfg = context.configuration.agc;
+	auto &state = context.activeState.agc;
+	/* The longest exposure at the frame length decided */
+	const int32_t limit = cfg.exposureMax + (state.vblank - cfg.vblankBase);
+
 	if (factor > 1.0f) {
-		/* Scene too dark: increase exposure first, then gain. */
-		if (exposure < context.configuration.agc.exposureMax) {
+		/*
+		 * Scene too dark: increase exposure first, then gain, and
+		 * once the gain is above kExtendGain, lengthen the frame for
+		 * more exposure time (which costs frame rate).
+		 */
+		if (exposure < limit) {
 			int32_t next = static_cast<int32_t>(exposure * factor);
 			exposure = std::max(next, exposure + 1);
+		} else if (cfg.exposureCap > limit && again >= kExtendGain) {
+			int32_t next = static_cast<int32_t>(exposure * factor);
+			next = std::clamp(next, exposure + 1, cfg.exposureCap);
+			state.vblank = std::min(cfg.vblankMax, state.vblank + (next - limit));
+			exposure = next;
 		} else {
 			double next = again * factor;
 			if (next - again < context.configuration.agc.againMinStep)
@@ -615,8 +682,18 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 		}
 	}
 
+	/*
+	 * Shorten a lengthened frame to the exposure, with headroom for it
+	 * to rise before the frame has to be lengthened again.
+	 */
+	if (state.vblank > cfg.vblankBase) {
+		const int32_t need = std::max(cfg.exposureMax, exposure + exposure / 8);
+		state.vblank = std::min(state.vblank,
+					cfg.vblankBase + (need - cfg.exposureMax));
+	}
+
 	exposure = std::clamp(exposure, context.configuration.agc.exposureMin,
-			      context.configuration.agc.exposureMax);
+			      cfg.exposureMax + (state.vblank - cfg.vblankBase));
 	again = std::clamp(again, context.configuration.agc.againMin,
 			   context.configuration.agc.againMax);
 

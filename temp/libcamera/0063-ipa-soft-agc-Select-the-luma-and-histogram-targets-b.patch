+/* The histogram adjustment of a tuning node (see init()), if it is valid */
+std::optional<Agc::HistTuning> Agc::readHist(const ValueNode &hist)
+{
+	auto satRef = hist["satRef"].get<double>();
+	auto satRange = hist["satRange"].get<std::vector<double>>();
+	auto upRange = hist["pushupRange"].get<std::vector<double>>();
+	auto adj = hist["targetAdj"].get<std::vector<double>>();
+	if (!satRef || *satRef <= 0.0 || !satRange || satRange->size() != 2 ||
+	    !upRange || upRange->size() != 2 || !adj || adj->size() != 2)
+		return std::nullopt;
+
+	HistTuning h{
+		.satRef = *satRef,
+		.satStart = (*satRange)[0], .satEnd = (*satRange)[1],
+		.upStart = (*upRange)[0], .upEnd = (*upRange)[1],
+		.minAdj = std::min((*adj)[0], 1.0), .maxAdj = std::max((*adj)[1], 1.0),
+		.maxDrc = std::max(hist["maxDrcGain"].get<double>(1.0), 1.0),
+		.filter = std::clamp(hist["filter"].get<double>(0.0), 0.0, 0.99),
+		.darkRef = 0.0, .darkStart = 0.0, .darkEnd = 0.0,
+		.maxDarkBoost = 1.0,
+	};
+
+	auto darkRef = hist["darkRef"].get<double>();
+	auto darkRange = hist["darkRange"].get<std::vector<double>>();
+	auto maxDark = hist["maxDarkBoost"].get<double>();
+	if (darkRef && *darkRef > 0.0 && darkRange && darkRange->size() == 2 &&
+	    (*darkRange)[1] > (*darkRange)[0] && maxDark && *maxDark > 1.0) {
+		h.darkRef = *darkRef;
+		h.darkStart = (*darkRange)[0];
+		h.darkEnd = (*darkRange)[1];
+		h.maxDarkBoost = *maxDark;
+	}
+
+	return h;
+}
+
+/*
+ * The targets by the lux index of the frame before: the blend of the zones
+ * the index lies in or between. A dark scene's targets are lower than a
+ * bright one's (less amplification of noise), and the DRC limits differ.
+ */
+void Agc::selectTargets(double lux)
+{
+	if (lux < 0.0)
+		return;
+
+	if (!meanZones_.empty()) {
+		const auto b = ipa::softisp::luxBlend(meanRanges_, lux);
+		meanTarget_ = meanZones_[b.lo] + (meanZones_[b.hi] - meanZones_[b.lo]) * b.weight;
+	}
+
+	if (!histZones_.empty()) {
+		const auto b = ipa::softisp::luxBlend(histRanges_, lux);
+		const HistTuning &lo = histZones_[b.lo];
+		const HistTuning &hi = histZones_[b.hi];
+		const double w = b.weight;
+		auto mix = [w](double x, double y) { return x + (y - x) * w; };
+
+		HistTuning h = w < 0.5 ? lo : hi;
+		h.satRef = mix(lo.satRef, hi.satRef);
+		h.satStart = mix(lo.satStart, hi.satStart);
+		h.satEnd = mix(lo.satEnd, hi.satEnd);
+		h.upStart = mix(lo.upStart, hi.upStart);
+		h.upEnd = mix(lo.upEnd, hi.upEnd);
+		h.minAdj = mix(lo.minAdj, hi.minAdj);
+		h.maxAdj = mix(lo.maxAdj, hi.maxAdj);
+		h.maxDrc = mix(lo.maxDrc, hi.maxDrc);
+		h.filter = mix(lo.filter, hi.filter);
+		/* A zone with no dark boost has no darkness to blend from */
+		if (lo.maxDarkBoost > 1.0 && hi.maxDarkBoost > 1.0) {
+			h.darkRef = mix(lo.darkRef, hi.darkRef);
+			h.darkStart = mix(lo.darkStart, hi.darkStart);
+			h.darkEnd = mix(lo.darkEnd, hi.darkEnd);
+			h.maxDarkBoost = mix(lo.maxDarkBoost, hi.maxDarkBoost);
+		}
+		hist_ = h;
+	}
+}
+

+/*
+ * The mean level of the pixels ranked between the fractions start and end
+ * of the pixels from the bright end of the histogram, as a fraction of the
+ * range above black. Empty if the range holds no pixels.
+ */
+std::optional<double> brightMean(const SwIspStats *stats, double black,
+				 double start, double end)
+{
+	const auto &hist = stats->yHistogram;
+	constexpr unsigned int kBinWidth = kYBinWidth;
+	double total = 0.0;
+
+	for (unsigned int i = 0; i < hist.size(); i++)
+		total += hist[i];
+
+	const double from = start * total;
+	const double to = end * total;
+	double seen = 0.0, sum = 0.0, count = 0.0;
+
+	for (unsigned int i = hist.size(); i-- > 0 && seen < to;) {
+		const double c = hist[i];
+		const double overlap = std::min(seen + c, to) - std::max(seen, from);
+		if (overlap > 0.0) {
+			const double level = i * kBinWidth + kBinWidth / 2.0;
+			sum += overlap * std::max(level - black, 0.0);
+			count += overlap;
+		}
+		seen += c;
+	}
+
+	if (count <= 0.0)
+		return {};
+
+	return sum / count / (kYMax - black);
+}

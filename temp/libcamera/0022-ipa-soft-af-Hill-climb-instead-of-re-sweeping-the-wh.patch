-	focus_pos = context.configuration.focus.start;
-	context.configuration.focus.step /= 2; // HERE
-	context.configuration.focus.skip = 10; // We need lens to settle after big move
-	if (context.configuration.focus.step > (dioptresMax_ - dioptresMin_) * kSweepStepFinal){
-	  // We want to search for maximum at smaller step, forget maximum from prev step
-	  context.configuration.focus.sharpness_max = 0;
-	  return;
+
+	if (state_ == State::Idle) {
+		/* The first frames after configure(): acquire focus. */
+		const double s = static_cast<double>(sharp);
+
+		if (reference_ == 0.0) {
+			restart(context);
+			return;
+		}
+		if (reference_ < 0.0) {
+			reference_ = s;
+			return;
+		}
+
+		if (s < reference_ * (1.0 - kLostDrop)) {
+			if (++lostFrames_ >= kLostFrames) {
+				const bool big = s < reference_ * (1.0 - kBigDrop);
+				LOG(IPASoftAutoFocus, Info)
+					<< "Focus lost (sharpness " << s << ", was "
+					<< reference_ << "), probing "
+					<< (big ? "wide" : "fine");
+				startProbe(context, big ? kProbeStepCoarse : kProbeStepFine);
+			}
+			return;
+		}
+
+		/* Track slow drift, and a scene that got sharper. */
+		lostFrames_ = 0;
+		reference_ = s > reference_ ? s : 0.9 * reference_ + 0.1 * s;
+		return;
 	}
 
-	//We are done
-	sweep = false;
-	LOG(IPASoftAutoFocus, Info) << "Sweep end. Best focus: " << context.configuration.focus.focus_max_pos << " dioptres (code " << lensCode(context.configuration.focus.focus_max_pos) << ") steps " << steps;
-	// We want to keep context.configuration.focus.sharpness_max, to detect when scene changes (aka focus lost)
-	focus_pos = context.configuration.focus.focus_max_pos;
+	acc_ += static_cast<double>(sharp);
+	if (++accCount_ < kMeasureFrames)
+		return;
+
+	measured(context, acc_ / accCount_);
 }
 

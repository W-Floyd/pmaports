+void Af::restart(IPAContext &context)
+{
+	startProbe(context, kProbeStepCoarse);
+}
+
+void Af::startProbe(IPAContext &context, double stepFraction)
+{
+	probeFraction_ = stepFraction;
+	probeStep_ = (dioptresMax_ - dioptresMin_) * stepFraction;
+	centre_ = context.activeState.knobs.focus_pos.value_or(dioptresDef_);
+	probeIndex_ = 0;
+	state_ = State::Probe;
+	context.activeState.knobs.focus_sweep = true;
+	moveTo(context, centre_);
+	LOG(IPASoftAutoFocus, Debug)
+		<< "Probing +-" << probeStep_ << " dioptres around " << centre_;
+}
+
+void Af::startSweep(IPAContext &context)
+{
+	auto &focus = context.configuration.focus;
+
+	focus.focus_max_pos = dioptresMin_;
+	focus.sharpness_max = 0;
+	focus.start = dioptresMin_;
+	focus.stop = dioptresMax_;
+	focus.step = (dioptresMax_ - dioptresMin_) * kSweepStepInitial;
+	state_ = State::Sweep;
+	context.activeState.knobs.focus_sweep = true;
+	moveTo(context, dioptresMin_);
+	settle_ = kSettleLarge;
+	LOG(IPASoftAutoFocus, Info) << "Sharpness is flat here, sweeping";
+}
+
+/* Hold the given position as focused, with its sharpness as reference. */
+void Af::settle(IPAContext &context, double dioptres, double sharp)
+{
+	state_ = State::Idle;
+	context.activeState.knobs.focus_sweep = false;
+	moveTo(context, dioptres);
+	reference_ = sharp;
+	lostFrames_ = 0;
+	LOG(IPASoftAutoFocus, Info)
+		<< "Focused at " << dioptres << " dioptres (code "
+		<< lensCode(dioptres) << "), sharpness " << sharp;
+}
+
+/* One step of the fallback coarse-to-fine sweep, as the algorithm used to do. */
+void Af::sweepStep(IPAContext &context, double sharp)
+{
+	auto &focus = context.configuration.focus;
+	double pos = context.activeState.knobs.focus_pos.value();
+
+	if (sharp > focus.sharpness_max) {
+		focus.sharpness_max = sharp;
+		focus.focus_max_pos = pos;
+	}
+
+	pos += focus.step;
+	if (pos > focus.start && pos < focus.stop) {
+		moveTo(context, pos);
+		return;
+	}
+
+	focus.start = std::clamp(focus.focus_max_pos - focus.step, dioptresMin_, dioptresMax_);
+	focus.stop = std::clamp(focus.focus_max_pos + focus.step, dioptresMin_, dioptresMax_);
+	focus.step /= 2;
+	if (focus.step > (dioptresMax_ - dioptresMin_) * kSweepStepFinal) {
+		focus.sharpness_max = 0;
+		moveTo(context, focus.start);
+		return;
+	}
+
+	settle(context, focus.focus_max_pos, focus.sharpness_max);
+}
+
+/* A measurement at the current position is complete. */
+void Af::measured(IPAContext &context, double sharp)
+{
+	const double pos = context.activeState.knobs.focus_pos.value();
+	const double range = dioptresMax_ - dioptresMin_;
+
+	switch (state_) {
+	case State::Idle:
+		break;
+
+	case State::Sweep:
+		sweepStep(context, sharp);
+		break;
+
+	case State::Probe:
+		if (probeIndex_ == 0) {
+			centreSharp_ = sharp;
+			probeIndex_ = 1;
+			moveTo(context, centre_ + probeStep_);
+			break;
+		}
+		if (probeIndex_ == 1) {
+			/* At the end of travel there is no plus side to measure. */
+			plusSharp_ = pos > centre_ ? sharp : 0.0;
+			probeIndex_ = 2;
+			moveTo(context, centre_ - probeStep_);
+			break;
+		}
+
+		{
+			const double minusSharp = pos < centre_ ? sharp : 0.0;
+			const double better = centreSharp_ * (1.0 + kNoise);
+			const double worse = centreSharp_ * (1.0 - kPeakDrop);
+
+			if (plusSharp_ > better || minusSharp > better) {
+				const bool plus = plusSharp_ >= minusSharp;
+				dir_ = plus ? 1.0 : -1.0;
+				bestPos_ = std::clamp(centre_ + dir_ * probeStep_,
+						      dioptresMin_, dioptresMax_);
+				bestSharp_ = plus ? plusSharp_ : minusSharp;
+				climbStep_ = probeStep_ * 2.0;
+				state_ = State::Climb;
+				moveTo(context, bestPos_ + dir_ * climbStep_);
+			} else if ((plusSharp_ <= 0.0 || plusSharp_ < worse) &&
+				   (minusSharp <= 0.0 || minusSharp < worse)) {
+				/*
+				 * Clearly worse on every side there is (one
+				 * side is missing at the end of travel): the
+				 * centre is the peak.
+				 */
+				settle(context, centre_, centreSharp_);
+			} else if (probeFraction_ < kProbeStepWide) {
+				/* Flat at this step: look wider before sweeping. */
+				context.activeState.knobs.focus_pos = centre_;
+				startProbe(context, probeFraction_ < kProbeStepCoarse
+							    ? kProbeStepCoarse
+							    : kProbeStepWide);
+			} else {
+				startSweep(context);
+			}
+		}
+		break;
+
+	case State::Climb:
+		if (sharp > bestSharp_) {
+			const bool atEnd = pos <= dioptresMin_ || pos >= dioptresMax_;
+			bestPos_ = pos;
+			bestSharp_ = sharp;
+			if (atEnd) {
+				settle(context, bestPos_, bestSharp_);
+				break;
+			}
+			climbStep_ = std::min(climbStep_ * 1.5, range * kClimbStepMax);
+			moveTo(context, pos + dir_ * climbStep_);
+			break;
+		}
+
+		/* Past the peak: it lies within a step either side of bestPos_. */
+		climbStep_ /= 2.0;
+		probeIndex_ = 1;
+		state_ = State::Refine;
+		moveTo(context, bestPos_ + climbStep_);
+		break;
+
+	case State::Refine:
+		if (sharp > bestSharp_) {
+			bestSharp_ = sharp;
+			bestPos_ = pos;
+		}
+		if (probeIndex_ == 1) {
+			probeIndex_ = 2;
+			moveTo(context, bestPos_ - climbStep_);
+			break;
 		}
-		return;			
+
+		climbStep_ /= 2.0;
+		if (climbStep_ < range * kRefineStepMin) {
+			settle(context, bestPos_, bestSharp_);
+			break;
+		}
+		probeIndex_ = 1;
+		moveTo(context, bestPos_ + climbStep_);
+		break;
 	}
-	if (sharp > context.configuration.focus.sharpness_max) {
-		context.configuration.focus.sharpness_max = sharp;
-		context.configuration.focus.focus_max_pos = focus_pos;
+}

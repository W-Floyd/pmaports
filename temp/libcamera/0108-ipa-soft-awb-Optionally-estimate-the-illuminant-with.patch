diff --git a/src/ipa/soft/algorithms/awb_model.cpp b/src/ipa/soft/algorithms/awb_model.cpp
new file mode 100644
index 000000000..3b74f3020
--- /dev/null
+++ b/src/ipa/soft/algorithms/awb_model.cpp
@@ -0,0 +1,265 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * A learned illuminant estimate for the auto white balance
+ */
+
+#include "awb_model.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+#if defined(HAVE_ONNXRUNTIME)
+#include <onnxruntime_cxx_api.h>
+#endif
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(IPASoftAwb)
+
+namespace ipa::soft::algorithms {
+
+#if defined(HAVE_ONNXRUNTIME)
+
+/* The illuminant's ratios are within these, or the model is not trusted */
+static constexpr double kMinRatio = 0.05;
+static constexpr double kMaxRatio = 20.0;
+
+static constexpr unsigned int kZoneCount = SwIspStats::kZonesX * SwIspStats::kZonesY;
+
+struct AwbModel::Impl {
+	Ort::Env env{ ORT_LOGGING_LEVEL_WARNING, "libcamera-awb" };
+	std::unique_ptr<Ort::Session> session;
+	Ort::MemoryInfo memory = Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+
+	/* The inputs in the model's order, and which of them the zones are */
+	std::array<std::string, 2> inputNames;
+	unsigned int zonesIndex = 0;
+	std::string outputName;
+	std::vector<int64_t> sceneShape;
+
+	/* 3 or 4 channels of zones, as the model's zones input has */
+	unsigned int channels = 3;
+	std::array<float, 4 * kZoneCount> zones;
+	float scene = 0.0f;
+};
+
+/* The elements of a shape, a dynamic batch of -1 counting as 1 */
+static int64_t elementCount(const std::vector<int64_t> &shape)
+{
+	int64_t n = 1;
+	for (int64_t d : shape)
+		n *= d < 0 ? 1 : d;
+	return n;
+}
+
+AwbModel::AwbModel()
+	: impl_(std::make_unique<Impl>())
+{
+}
+
+AwbModel::~AwbModel() = default;
+
+bool AwbModel::load(const std::string &path)
+{
+	try {
+		Ort::SessionOptions options;
+		options.SetIntraOpNumThreads(1);
+		options.SetInterOpNumThreads(1);
+		options.SetGraphOptimizationLevel(GraphOptimizationLevel::ORT_ENABLE_ALL);
+		impl_->session = std::make_unique<Ort::Session>(impl_->env, path.c_str(), options);
+
+		Ort::Session &session = *impl_->session;
+		Ort::AllocatorWithDefaultOptions allocator;
+
+		if (session.GetInputCount() != 2 || session.GetOutputCount() != 1) {
+			LOG(IPASoftAwb, Warning)
+				<< path << " has " << session.GetInputCount() << " inputs and "
+				<< session.GetOutputCount() << " outputs, not 2 and 1";
+			return false;
+		}
+
+		bool haveZones = false;
+		bool haveScene = false;
+		for (unsigned int i = 0; i < 2; i++) {
+			const std::string name = session.GetInputNameAllocated(i, allocator).get();
+			/* The shape info borrows from the type info: keep it alive */
+			Ort::TypeInfo typeInfo = session.GetInputTypeInfo(i);
+			auto info = typeInfo.GetTensorTypeAndShapeInfo();
+			const std::vector<int64_t> shape = info.GetShape();
+			impl_->inputNames[i] = name;
+
+			if (info.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT) {
+				LOG(IPASoftAwb, Warning)
+					<< path << ": input " << name << " is not a float tensor";
+				return false;
+			}
+
+			if (shape.size() == 4) {
+				if ((shape[0] != 1 && shape[0] != -1) ||
+				    (shape[1] != 3 && shape[1] != 4) ||
+				    shape[2] != static_cast<int64_t>(SwIspStats::kZonesY) ||
+				    shape[3] != static_cast<int64_t>(SwIspStats::kZonesX)) {
+					LOG(IPASoftAwb, Warning)
+						<< path << ": the zones input " << name
+						<< " is not N x 3 or 4 x " << SwIspStats::kZonesY
+						<< " x " << SwIspStats::kZonesX;
+					return false;
+				}
+				impl_->channels = shape[1];
+				impl_->zonesIndex = i;
+				haveZones = true;
+			} else if (elementCount(shape) == 1) {
+				if (name.find("lux") != std::string::npos)
+					scene_ = Scene::LuxIndex;
+				else if (name.find("gain") != std::string::npos)
+					scene_ = Scene::Gain;
+				else {
+					LOG(IPASoftAwb, Warning)
+						<< path << ": the scene input " << name
+						<< " has neither \"gain\" nor \"lux\" in its name";
+					return false;
+				}
+				impl_->sceneShape = shape;
+				for (int64_t &d : impl_->sceneShape)
+					d = d < 0 ? 1 : d;
+				haveScene = true;
+			} else {
+				LOG(IPASoftAwb, Warning)
+					<< path << ": input " << name << " is neither the zones nor one value";
+				return false;
+			}
+		}
+		if (!haveZones || !haveScene) {
+			LOG(IPASoftAwb, Warning) << path << " needs one zones and one scene input";
+			return false;
+		}
+
+		Ort::TypeInfo outType = session.GetOutputTypeInfo(0);
+		auto outInfo = outType.GetTensorTypeAndShapeInfo();
+		if (outInfo.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT ||
+		    elementCount(outInfo.GetShape()) != 2) {
+			LOG(IPASoftAwb, Warning)
+				<< path << ": the output is not 2 floats (R/G, B/G)";
+			return false;
+		}
+		impl_->outputName = session.GetOutputNameAllocated(0, allocator).get();
+	} catch (const Ort::Exception &e) {
+		LOG(IPASoftAwb, Warning) << "Cannot load " << path << ": " << e.what();
+		impl_->session.reset();
+		return false;
+	}
+
+	LOG(IPASoftAwb, Info)
+		<< "Illuminant model " << path << ", scene input is the "
+		<< (scene_ == Scene::Gain ? "gain" : "lux index");
+	return true;
+}
+
+bool AwbModel::estimate(const SwIspStats &stats, double blackLevel, double sceneValue,
+			Vector<double, 2> *ratios)
+{
+	if (!impl_->session)
+		return false;
+
+	/*
+	 * The samples a zone has when none of them is saturated: all the
+	 * window's, which the histogram counts, over the zones.
+	 */
+	uint64_t sampled = 0;
+	for (uint32_t bin : stats.yHistogram)
+		sampled += bin;
+	const double nominal = std::max(static_cast<double>(sampled) / kZoneCount, 1.0);
+
+	/* Channel-major, as the tensor is: all of red, then green, then blue */
+	const double range = SwIspStats::kYLevels - blackLevel;
+	for (unsigned int i = 0; i < kZoneCount; i++) {
+		const SwIspStats::Zone &z = stats.zones[i];
+		float r = 0.0f, g = 0.0f, b = 0.0f, valid = 0.0f;
+		if (z.count) {
+			auto level = [&](uint64_t sum) {
+				const double mean = static_cast<double>(sum) / z.count - blackLevel;
+				return static_cast<float>(std::max(mean, 0.0) / range);
+			};
+			r = level(z.r);
+			g = level(z.g);
+			b = level(z.b);
+			valid = static_cast<float>(std::min(z.count / nominal, 1.0));
+		}
+		impl_->zones[i] = r;
+		impl_->zones[kZoneCount + i] = g;
+		impl_->zones[2 * kZoneCount + i] = b;
+		impl_->zones[3 * kZoneCount + i] = valid;
+	}
+	impl_->scene = static_cast<float>(sceneValue);
+
+	try {
+		const std::array<int64_t, 4> zonesShape = { 1, impl_->channels, SwIspStats::kZonesY,
+							     SwIspStats::kZonesX };
+		Ort::Value zones = Ort::Value::CreateTensor<float>(impl_->memory, impl_->zones.data(),
+								   impl_->channels * kZoneCount,
+								   zonesShape.data(), zonesShape.size());
+		Ort::Value scene = Ort::Value::CreateTensor<float>(impl_->memory, &impl_->scene, 1,
+								   impl_->sceneShape.data(),
+								   impl_->sceneShape.size());
+
+		std::array<Ort::Value, 2> inputs{ Ort::Value(nullptr), Ort::Value(nullptr) };
+		inputs[impl_->zonesIndex] = std::move(zones);
+		inputs[1 - impl_->zonesIndex] = std::move(scene);
+		const std::array<const char *, 2> inputNames = { impl_->inputNames[0].c_str(),
+								 impl_->inputNames[1].c_str() };
+		const char *outputName = impl_->outputName.c_str();
+
+		auto out = impl_->session->Run(Ort::RunOptions{ nullptr }, inputNames.data(),
+					       inputs.data(), inputs.size(), &outputName, 1);
+		const float *v = out[0].GetTensorData<float>();
+		const double rg = v[0];
+		const double bg = v[1];
+		if (!std::isfinite(rg) || !std::isfinite(bg) || rg < kMinRatio || rg > kMaxRatio ||
+		    bg < kMinRatio || bg > kMaxRatio) {
+			LOG(IPASoftAwb, Warning)
+				<< "The illuminant model gave R/G " << rg << ", B/G " << bg;
+			return false;
+		}
+		*ratios = { { rg, bg } };
+	} catch (const Ort::Exception &e) {
+		LOG(IPASoftAwb, Warning) << "The illuminant model failed: " << e.what();
+		return false;
+	}
+
+	return true;
+}
+
+#else /* !HAVE_ONNXRUNTIME */
+
+struct AwbModel::Impl {
+};
+
+AwbModel::AwbModel() = default;
+AwbModel::~AwbModel() = default;
+
+bool AwbModel::load(const std::string &path)
+{
+	LOG(IPASoftAwb, Warning)
+		<< "Not loading " << path << ": built without onnxruntime";
+	return false;
+}
+
+bool AwbModel::estimate([[maybe_unused]] const SwIspStats &stats,
+			[[maybe_unused]] double blackLevel,
+			[[maybe_unused]] double sceneValue,
+			[[maybe_unused]] Vector<double, 2> *ratios)
+{
+	return false;
+}
+
+#endif /* HAVE_ONNXRUNTIME */
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */

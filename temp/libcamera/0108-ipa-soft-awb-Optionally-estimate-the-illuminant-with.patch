@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * A learned illuminant estimate for the auto white balance
+ */
+
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+#include "libcamera/internal/vector.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+/*
+ * An ONNX model that estimates the illuminant from the statistics' zones,
+ * which stands in for grey world in Awb. Without onnxruntime (the
+ * softisp-awb-onnx build option) load() always fails, and Awb keeps grey world.
+ *
+ * The model has two inputs, in either order of its list:
+ *
+ *  - the zones: a float tensor of N x C x kZonesY x kZonesX with C of 3 or 4
+ *    and N of 1 (or dynamic): the red, green and blue means of each zone,
+ *    (mean - black level) / (full scale - black level) over the 8-bit
+ *    range, 0 for a zone with no unsaturated samples; and with C of 4 a
+ *    fourth channel, the zone's number of unsaturated samples over the
+ *    number a zone has when none is saturated (0 to 1);
+ *  - the scene: a float tensor of one value (of shape [N] or [N, 1] with N
+ *    of 1 or dynamic), which is the analogue gain if the input's name
+ *    contains "gain", or the lux index (0 to 900, as Agc estimates it) if
+ *    it contains "lux".
+ *
+ * and one output of two floats (N x 2): the illuminant's R/G and B/G, as
+ * grey world's are. Any other shape or type, or an output out of range, is a
+ * mismatch.
+ */
+class AwbModel
+{
+public:
+	/* What the scene input is */
+	enum class Scene {
+		Gain,
+		LuxIndex,
+	};
+
+	AwbModel();
+	~AwbModel();
+
+	/* Load the model; false if it cannot be used, with the reason logged */
+	bool load(const std::string &path);
+	Scene scene() const { return scene_; }
+
+	/*
+	 * Estimate the illuminant's R/G and B/G of a frame's statistics, with
+	 * the black level (8-bit units) and the scene input's value; false if
+	 * the model does not give a usable one.
+	 */
+	bool estimate(const SwIspStats &stats, double blackLevel, double sceneValue,
+		      Vector<double, 2> *ratios);
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> impl_;
+	Scene scene_ = Scene::Gain;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */

diff --git a/src/libcamera/shaders/bayer_cells_bin.frag b/src/libcamera/shaders/bayer_cells_bin.frag
new file mode 100644
index 000000000..7145560a0
--- /dev/null
+++ b/src/libcamera/shaders/bayer_cells_bin.frag
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * bayer_cells_bin.frag - Bins each 2x2 cell of a packed raw Bayer 10-bit
+ * frame into one texel of a half-float texture, at the full 10 bits of each
+ * pixel, in counts: the cell's red and blue pixels, and the mean of its two
+ * greens. A cell's four pixels are read with six byte fetches: the 8 high
+ * bits of each, and the low bits' byte of each row.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+#if !defined(RAW10P)
+#error Invalid raw format
+#endif
+
+/* The frame is a texture of bytes, as many as its stride wide */
+uniform sampler2D tex_y;
+uniform vec2 raw_size;
+uniform vec2 tex_bayer_first_red;
+
+float byte_at(float x, float y)
+{
+	return floor(texture2D(tex_y, vec2((x + 0.5) / raw_size.x, (y + 0.5) / raw_size.y)).r * 255.0 + 0.5);
+}
+
+/*
+ * A pixel's 8 high bits are the byte at 5 * (x / 4) + x % 4 of its row, and
+ * its 2 low bits are in the group's fifth byte, 2 bits to a pixel, the first
+ * pixel's in the lowest. A cell starts at an even x, so both its pixels are
+ * in one group, at i and i + 1.
+ */
+vec2 row_pair(float x, float y)
+{
+	float group = floor(x / 4.0);
+	float i = x - group * 4.0;
+	float first = group * 5.0 + i;
+	float low = byte_at(group * 5.0 + 4.0, y);
+	float a = byte_at(first, y) * 4.0 + mod(floor(low / exp2(2.0 * i)), 4.0);
+	float b = byte_at(first + 1.0, y) * 4.0 + mod(floor(low / exp2(2.0 * i + 2.0)), 4.0);
+	return vec2(a, b);
+}
+
+void main(void)
+{
+	/* One fragment per cell, whose pixels start at twice its coordinates */
+	vec2 p = floor(gl_FragCoord.xy) * 2.0;
+	vec2 top = row_pair(p.x, p.y);
+	vec2 bottom = row_pair(p.x, p.y + 1.0);
+
+	/* The pixels in the order (0,0), (1,0), (0,1), (1,1) */
+	vec4 v = vec4(top, bottom);
+	vec2 red = tex_bayer_first_red;
+	vec4 is_red = vec4((1.0 - red.x) * (1.0 - red.y), red.x * (1.0 - red.y),
+			   (1.0 - red.x) * red.y, red.x * red.y);
+	vec4 is_blue = is_red.wzyx;
+
+	float r = dot(v, is_red);
+	float b = dot(v, is_blue);
+	float g = v.x + v.y + v.z + v.w - r - b;
+
+	gl_FragColor = vec4(r, g * 0.5, b, 0.0);
+}
diff --git a/src/libcamera/shaders/bayer_cells_denoise.frag b/src/libcamera/shaders/bayer_cells_denoise.frag
new file mode 100644
index 000000000..a709ac8ab
--- /dev/null
+++ b/src/libcamera/shaders/bayer_cells_denoise.frag
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * bayer_cells_denoise.frag - Filters the 2x2 cells that bayer_cells_bin.frag
+ * made, in counts, with a bilateral filter over each cell's 3x3
+ * neighbourhood. Its range kernel follows the sensor's noise, so that
+ * differences of a few noise deviations are averaged and edges are kept:
+ *
+ *   weight = exp(-(difference / (width * sigma))^2 / 2)
+ *   sigma^2 = slope * level + quad * level^2 + floor, level above black in
+ *             10-bit counts
+ *
+ * A cell's green is the mean of two pixels, which halves its noise variance.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+uniform sampler2D cells;
+uniform vec2 cell_size;
+uniform vec3 blacklevel;	/* from 0 to 1, where 1.0 stands for 1020 counts */
+uniform vec3 noise;		/* slope, quadratic term and floor of the variance */
+uniform vec3 width_lo;		/* range kernel width of red, green and blue, */
+uniform vec3 width_hi;		/* at and below anchors.x, and at and above anchors.y */
+uniform vec2 anchors;		/* levels, in counts above black */
+
+vec3 fetch(vec2 index)
+{
+	vec2 i = clamp(index, vec2(0.0), cell_size - 1.0);
+	return texture2D(cells, (i + 0.5) / cell_size).rgb;
+}
+
+void main(void)
+{
+	vec2 cell = floor(gl_FragCoord.xy);
+	vec3 c = fetch(cell);
+
+	vec3 level = max(c - blacklevel * 1020.0, 0.0);
+	vec3 sigma = sqrt(noise.x * level + noise.y * level * level + noise.z) *
+		     vec3(1.0, 0.70710678, 1.0);
+	vec3 width = mix(width_lo, width_hi,
+			 clamp((level - anchors.x) / max(anchors.y - anchors.x, 1.0), 0.0, 1.0));
+	vec3 inv = 1.0 / max(width * sigma, 0.001);
+
+	vec3 sum = c;
+	vec3 weights = vec3(1.0);
+	for (int dy = -1; dy <= 1; dy++) {
+		for (int dx = -1; dx <= 1; dx++) {
+			if (dx == 0 && dy == 0)
+				continue;
+			vec3 n = fetch(cell + vec2(float(dx), float(dy)));
+			vec3 d = (n - c) * inv;
+			vec3 w = exp(-0.5 * d * d);
+			sum += w * n;
+			weights += w;
+		}
+	}
+
+	gl_FragColor = vec4(sum / weights, 0.0);
+}

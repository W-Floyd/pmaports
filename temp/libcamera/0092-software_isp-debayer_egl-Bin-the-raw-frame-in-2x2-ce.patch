 			  const std::vector<std::reference_wrapper<const StreamConfiguration>> &outputCfgs,
 			  [[maybe_unused]] bool ccmEnabled)
@@ -584,6 +725,18 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform4f(chromaShearUniform_, params.chromaShear[0], params.chromaShear[1],
 		    params.chromaShear[2], params.chromaShear[3]);
 
+	if (cellsPath_) {
+		const DebayerParams::Denoise &d = params.denoise;
+
+		glUniform1i(cellTexUniform_, cells_->texture_unit_uniform_id_);
+		glUniform2f(cellSizeUniform_, cellsSize_.width, cellsSize_.height);
+		glUniform1f(denoiseOnUniform_, d.enabled ? 1.0f : 0.0f);
+		glUniform2f(noiseUniform_, d.slope, d.floor);
+		glUniform3f(widthLowUniform_, d.widthLow[0], d.widthLow[1], d.widthLow[2]);
+		glUniform3f(widthHighUniform_, d.widthHigh[0], d.widthHigh[1], d.widthHigh[2]);
+		glUniform2f(anchorsUniform_, d.levelLow, d.levelHigh);
+	}
+
 	return;
 }
 
@@ -687,6 +840,9 @@ int DebayerEGL::debayerGPU(FrameBuffer *input, FrameBuffer *output, const Debaye

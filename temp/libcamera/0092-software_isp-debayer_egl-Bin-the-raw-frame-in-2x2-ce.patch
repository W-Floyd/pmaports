diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index a31b66a1e..6c33b3b2e 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -141,6 +141,131 @@ vec3 apply_chroma(vec3 rgb)
 			  y + 1.772 * cb2), 0.0, 1.0);
 }
 
+/*
+ * The colour processing of a pixel's red, green and blue as the sensor saw
+ * them, from 0 to 1 over the 8 high bits' range: black level, lens shading,
+ * white balance, colour correction, tone curve, chroma, and the output
+ * channel order.
+ */
+vec4 finish(vec3 rgb)
+{
+	/*
+	 * \todo: Black level normalising, AWB and digital gain could be
+	 * reworked into a single multiplication.
+	 */
+	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
+
+	/* Correct lens shading, on the linear data */
+	rgb *= lens_shading(textureOut);
+
+	/*
+	 * Apply AWB gains, and saturate each channel at sensor range. Values
+	 * below black are noise around it: keep them, so that colour
+	 * correction averages the noise out rather than lifting it, tinted
+	 * by the gains, into the shadows; the tone curve clamps at black.
+	 */
+	rgb = min(rgb * awb, vec3(1.0));
+
+	/* Colour Correction Matrix */
+	rgb = ccm * rgb;
+
+	/* Apply the tone curve after colour correction */
+	rgb = apply_tone(clamp(rgb, 0.0, 1.0));
+
+	/* Scale the chroma, on the encoded values */
+	rgb = apply_chroma(rgb);
+
+#if defined (SWAP_BLUE)
+	return vec4(rgb.bgr, 1.0);
+#else
+	return vec4(rgb, 1.0);
+#endif
+}
+
+#if defined (CELL_PATH)
+/*
+ * The cells path: bayer_cells_pack.frag has binned each 2x2 cell of the
+ * frame, at the full 10 bits, into one texel of cell_tex (see there for the
+ * packing). Each output pixel reads the 4x4 cells around its position,
+ * filters the 2x2 nearest ones with a bilateral filter over their 3x3
+ * neighbourhoods, and blends those four by the position. The filter takes
+ * its range kernel from the sensor's noise model, so that differences of a
+ * few noise deviations are averaged and edges are kept:
+ *
+ *   weight = exp(-(difference / (width * sigma))^2 / 2)
+ *   sigma^2 = slope * level + floor, level above black in 10-bit counts
+ *
+ * The two greens of a cell add up, which halves their noise variance.
+ * Counts of 1020 stand for 1.0, as the 8 high bits' 255 do on the other path.
+ */
+uniform sampler2D cell_tex;
+uniform vec2 cell_size;
+uniform float denoise_on;
+uniform vec2 noise;		/* slope, floor of the variance model */
+uniform vec3 width_lo;		/* range kernel width, at and below anchors.x */
+uniform vec3 width_hi;		/* and at and above anchors.y */
+uniform vec2 anchors;		/* levels, in counts above black */
+
+vec3 unpack_cell(vec2 index)
+{
+	vec2 i = clamp(index, vec2(0.0), cell_size - 1.0);
+	vec4 t = floor(texture2D(cell_tex, (i + 0.5) / cell_size) * 255.0 + 0.5);
+	float r = t.x + 256.0 * mod(t.y, 4.0);
+	float g = floor(t.y / 4.0) + 64.0 * mod(t.z, 32.0);
+	float b = floor(t.z / 32.0) + 8.0 * t.w;
+	return vec3(r, g * 0.5, b);
+}
+
+void main(void)
+{
+	vec2 p = textureOut * cell_size - 0.5;
+	vec2 first = floor(p);
+	vec2 frac = p - first;
+	vec3 black = blacklevel * 1020.0;
+
+	vec3 v[16];
+	for (int y = 0; y < 4; y++)
+		for (int x = 0; x < 4; x++)
+			v[y * 4 + x] = unpack_cell(first + vec2(float(x) - 1.0, float(y) - 1.0));
+
+	vec3 f[4];
+	for (int cy = 0; cy < 2; cy++) {
+		for (int cx = 0; cx < 2; cx++) {
+			vec3 c = v[(cy + 1) * 4 + cx + 1];
+			if (denoise_on < 0.5) {
+				f[cy * 2 + cx] = c;
+				continue;
+			}
+
+			vec3 level = max(c - black, 0.0);
+			vec3 sigma = sqrt(noise.x * level + noise.y) * vec3(1.0, 0.70710678, 1.0);
+			vec3 width = mix(width_lo, width_hi,
+					 clamp((level - anchors.x) / max(anchors.y - anchors.x, 1.0), 0.0, 1.0));
+			vec3 inv = 1.0 / max(width * sigma, 0.001);
+
+			vec3 sum = c;
+			vec3 weights = vec3(1.0);
+			for (int dy = 0; dy < 3; dy++) {
+				for (int dx = 0; dx < 3; dx++) {
+					if (dx == 1 && dy == 1)
+						continue;
+					vec3 n = v[(cy + dy) * 4 + cx + dx];
+					vec3 d = (n - c) * inv;
+					vec3 w = exp(-0.5 * d * d);
+					sum += w * n;
+					weights += w;
+				}
+			}
+			f[cy * 2 + cx] = sum / weights;
+		}
+	}
+
+	vec3 rgb = mix(mix(f[0], f[1], frac.x), mix(f[2], f[3], frac.x), frac.y);
+	gl_FragColor = finish(rgb / 1020.0);
+}
+#endif /* CELL_PATH */
+
+#if !defined (CELL_PATH)
 void main(void)
 {
 	vec3 rgb;
@@ -312,35 +437,6 @@ void main(void)
 			vec3(patterns.y, C, patterns.x) :
 			vec3(patterns.wz, C));
 
-	/*
-	 * \todo: Black level normalising, AWB and digital gain could be
-	 * reworked into a single multiplication.
-	 */
-	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
-
-	/* Correct lens shading, on the linear data */
-	rgb *= lens_shading(textureOut);
-
-	/*
-	 * Apply AWB gains, and saturate each channel at sensor range. Values
-	 * below black are noise around it: keep them, so that colour
-	 * correction averages the noise out rather than lifting it, tinted
-	 * by the gains, into the shadows; the tone curve clamps at black.
-	 */
-	rgb = min(rgb * awb, vec3(1.0));
-
-	/* Colour Correction Matrix */
-	rgb = ccm * rgb;
-
-	/* Apply the tone curve after colour correction */
-	rgb = apply_tone(clamp(rgb, 0.0, 1.0));
-
-	/* Scale the chroma, on the encoded values */
-	rgb = apply_chroma(rgb);
-
-#if defined (SWAP_BLUE)
-	gl_FragColor = vec4(rgb.bgr, 1.0);
-#else
-	gl_FragColor = vec4(rgb, 1.0);
-#endif
+	gl_FragColor = finish(rgb);
 }
+#endif /* !CELL_PATH */
diff --git a/src/libcamera/shaders/bayer_cells_pack.frag b/src/libcamera/shaders/bayer_cells_pack.frag
new file mode 100644
index 000000000..af9595287
--- /dev/null
+++ b/src/libcamera/shaders/bayer_cells_pack.frag
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * bayer_cells_pack.frag - Bins each 2x2 cell of a packed raw Bayer 10-bit
+ * frame into one texel, at the full 10 bits of each pixel.
+ *
+ * The cell's red and blue pixels are kept, and its two greens are added. The
+ * three values are packed into the four bytes of an RGBA8 texel as 10, 11 and
+ * 10 bits, for bayer_1x_packed.frag (CELL_PATH) to filter and sample:
+ *
+ *   byte 0: red bits 7..0
+ *   byte 1: red bits 9..8, green bits 5..0 (of the sum of the two greens)
+ *   byte 2: green bits 10..6, blue bits 2..0
+ *   byte 3: blue bits 9..3
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+#if !defined(RAW10P)
+#error Invalid raw format
+#endif
+
+/* The frame is a texture of bytes, as many as its stride wide */
+uniform sampler2D tex_y;
+uniform vec2 raw_size;
+uniform vec2 tex_bayer_first_red;
+
+/*
+ * The value of the pixel at integer coordinates p: its 8 high bits are the
+ * byte at 5 * (x / 4) + x % 4 of the row, and its 2 low bits are in the
+ * group's fifth byte, 2 bits to a pixel, the first pixel's in the lowest.
+ */
+float raw10(vec2 p)
+{
+	float group = floor(p.x / 4.0);
+	float i = p.x - group * 4.0;
+	float v = (p.y + 0.5) / raw_size.y;
+	float hi = floor(texture2D(tex_y, vec2((group * 5.0 + i + 0.5) / raw_size.x, v)).r * 255.0 + 0.5);
+	float lo = floor(texture2D(tex_y, vec2((group * 5.0 + 4.0 + 0.5) / raw_size.x, v)).r * 255.0 + 0.5);
+	return hi * 4.0 + mod(floor(lo / exp2(2.0 * i)), 4.0);
+}
+
+void main(void)
+{
+	/* One fragment per cell, whose pixels start at twice its coordinates */
+	vec2 p = floor(gl_FragCoord.xy) * 2.0;
+	vec2 red = tex_bayer_first_red;
+
+	float r = raw10(p + red);
+	float b = raw10(p + vec2(1.0) - red);
+	float g = raw10(p + vec2(red.x, 1.0 - red.y)) +
+		  raw10(p + vec2(1.0 - red.x, red.y));
+
+	gl_FragColor = vec4(mod(r, 256.0),
+			    floor(r / 256.0) + 4.0 * mod(g, 64.0),
+			    floor(g / 64.0) + 32.0 * mod(b, 8.0),
+			    floor(b / 8.0)) / 255.0;
+}

+			return lo;
+		const Anchors hi = luxCurves_[b.hi].at(drcGain);
+		auto mix = [&b](double u, double v) { return u + (v - u) * b.weight; };
+		return { drcGain, mix(lo.dark, hi.dark), mix(lo.mid, hi.mid),
+			 mix(lo.bright, hi.bright), mix(lo.darkBoost, hi.darkBoost),
+			 mix(lo.darkBoostRatio, hi.darkBoostRatio) };
+	}
+
 	if (drcGain <= anchors_.front().drcGain)
 		return anchors_.front();
 	if (drcGain >= anchors_.back().drcGain)

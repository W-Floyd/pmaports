+/*
+ * drcCurveLux: the same by lux index region, as the tuning's tmc12 has them.
+ * The curves of the regions around the lux index in use (setLux()) blend:
+ *
+ *   drcCurveLux:
+ *     - lux: [ 1, 180 ]
+ *       drcCurve: ...    # as drcCurve
+ */
+int DrcCurve::readLux(const ValueNode &tuningData)
+{
+	for (const ValueNode &node : tuningData.asList()) {
+		auto lux = node["lux"].get<std::vector<double>>();
+		DrcCurve curve;
+		if (!lux || lux->size() != 2 || curve.read(node["drcCurve"]) < 0) {
+			LOG(IPASoftIspAdjust, Error) << "Invalid drcCurveLux";
+			return -EINVAL;
+		}
+		luxRanges_.push_back({ (*lux)[0], (*lux)[1] });
+		luxCurves_.push_back(std::move(curve));
+	}
+	return 0;
+}
+
+ipa::softisp::LuxBlend DrcCurve::luxBlend() const
+{
+	return ipa::softisp::luxBlend(luxRanges_, lux_);
+}
+
+double DrcCurve::maxRatio() const
+{
+	if (luxCurves_.empty() || lux_ < 0)
+		return maxRatio_;
+	const auto b = luxBlend();
+	return luxCurves_[b.lo].maxRatio_ * (1.0 - b.weight) + luxCurves_[b.hi].maxRatio_ * b.weight;
+}
+
+double DrcCurve::share() const
+{
+	if (luxCurves_.empty() || lux_ < 0)
+		return share_;
+	const auto b = luxBlend();
+	return luxCurves_[b.lo].share_ * (1.0 - b.weight) + luxCurves_[b.hi].share_ * b.weight;
+}
+

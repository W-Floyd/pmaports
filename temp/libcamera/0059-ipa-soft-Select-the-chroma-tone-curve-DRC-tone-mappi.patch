+int Adjust::readChroma(const ValueNode &list, ChromaSet *set)
+{
+	int ret = set->scale.readYaml(list, "ct", "scale");
+	if (ret < 0)
+		return ret;
+	for (const auto &[ct, s] : set->scale.data()) {
+		for (unsigned int i = 0; i < 4; i++) {
+			if (s[i] < 0) {
+				LOG(IPASoftIspAdjust, Error)
+					<< "Chroma scales at " << ct << " K must not be negative";
+				return -EINVAL;
+			}
 		}
 	}
 

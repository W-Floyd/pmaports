+/*
+ * Record the range of the focus actuator in the IPA configuration, or a zero
+ * range when the sensor has no actuator at all. Called both from init(), so
+ * that algorithms can query it while registering their controls, and from
+ * configure(), which clears the configuration.
+ */
+void IPASoftSimple::updateFocusRange()
+{
+	const auto it = lensInfoMap_.find(V4L2_CID_FOCUS_ABSOLUTE);
+
+	if (it == lensInfoMap_.end()) {
+		LOG(IPASoft, Debug) << "No focus lens, focus control disabled";
+		context_.configuration.focus.focus_min = 0;
+		context_.configuration.focus.focus_max = 0;
+		return;
+	}
+
+	context_.configuration.focus.focus_min = it->second.min().get<int32_t>();
+	context_.configuration.focus.focus_max = it->second.max().get<int32_t>();
+	LOG(IPASoft, Info) << "Focus lens range ["
+			   << context_.configuration.focus.focus_min << ", "
+			   << context_.configuration.focus.focus_max << "]";
+}

+
+/*
+ * The tone mapping of HDR: the merge is in the units of the short exposure,
+ * the ratio (hdr_map.x, over 1 when on) darker than the long one that the tone
+ * curve is made for. Scaled up by the ratio it is the long exposure's image
+ * to the point where the highlights it clipped begin; up to hdr_map.y of the
+ * range it goes through as it is, and above that the luma is compressed into
+ * what remains, smoothly (the slope is 1 where it starts), with the channels'
+ * ratios kept so that the colour is.
+ */
+#if defined(HDR)
+uniform vec2 hdr_map;
+
+vec3 hdr_tonemap(vec3 linear)
+{
+	vec3 p = linear * hdr_map.x;
+	float y = dot(p, vec3(0.299, 0.587, 0.114));
+	float knee = hdr_map.y;
+	if (y > knee) {
+		float room = 1.0 - knee;
+		float compressed = knee + room * (1.0 - exp(-(y - knee) / room));
+		p *= compressed / y;
+	}
+	return p;
+}
+#endif
+
 uniform sampler2D cell_tex;
 uniform vec2 cell_size;
 uniform vec3 noise;		/* slope, quadratic term and floor of the variance */

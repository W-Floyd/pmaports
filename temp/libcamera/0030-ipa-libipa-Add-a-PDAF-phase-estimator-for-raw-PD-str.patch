+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * Phase detection autofocus: phase from a sensor's raw PD pixel stream
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/base/span.h>
+
+#include <libcamera/geometry.h>
+
+namespace libcamera {
+
+namespace ipa {
+
+struct PdafLayout {
+	enum class Side {
+		Left,
+		Right,
+	};
+
+	struct Line {
+		Side side;
+		unsigned int pair;
+		Point position;
+	};
+
+	Size blocks;
+	Size blockSize;
+	Point offset;
+	std::vector<Line> lines;
+	unsigned int bitDepth;
+
+	bool isValid() const;
+	Size bufferSize() const;
+};
+
+struct PdafData {
+	double phase;
+	double conf;
+};
+
+class PdafPhase
+{
+public:
+	PdafPhase(const PdafLayout &layout, const Size &grid,
+		  unsigned int maxShift = 6);
+
+	int setShading(const Size &grid, Span<const float> left,
+		       Span<const float> right);
+	int setActiveRegions(const std::vector<bool> &active);
+
+	int process(Span<const uint8_t> buffer, unsigned int bytesPerLine);
+	int process(Span<const uint16_t> samples, unsigned int stride);
+
+	const Size &grid() const { return grid_; }
+	const std::vector<PdafData> &regions() const { return regions_; }
+	PdafData combined(double minConf = 0.0) const;
+
+	static void unpackCsi2(Span<const uint8_t> line, unsigned int bitDepth,
+			       Span<uint16_t> samples);
+
+private:
+	void buildSignals(Span<const uint16_t> samples, unsigned int stride);
+	PdafData regionPhase(unsigned int rx, unsigned int ry) const;
+
+	PdafLayout layout_;
+	Size grid_;
+	unsigned int maxShift_;
+
+	std::vector<uint16_t> unpacked_;
+	std::vector<float> left_;
+	std::vector<float> right_;
+	/* Shading gain per block, one vector per side, empty if none */
+	std::vector<float> gainLeft_;
+	std::vector<float> gainRight_;
+	/*
+	 * Regions to measure (all if empty), and the block rows and sample
+	 * columns (with the margin the search and the filter need) they span
+	 */
+	std::vector<bool> active_;
+	unsigned int rowStart_;
+	unsigned int rowEnd_;
+	unsigned int colStart_;
+	unsigned int colEnd_;
+	std::vector<PdafData> regions_;
+};
+
+} /* namespace ipa */
+
+} /* namespace libcamera */

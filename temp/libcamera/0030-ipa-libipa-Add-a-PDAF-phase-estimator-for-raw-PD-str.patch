+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * Phase detection autofocus: phase from a sensor's raw PD pixel stream
+ */
+
+#include "pdaf.h"
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+
+#include <libcamera/base/log.h>
+
+/**
+ * \file pdaf.h
+ * \brief Phase detection autofocus helpers
+ *
+ * Sensors with phase detection (PD) pixels either compute the phase
+ * difference on chip and report it (the Sony IMX708 does, in its embedded
+ * data), or send the raw values of their PD pixels and leave the computation
+ * to the host (Samsung and OmniVision sensors commonly do, as a separate
+ * CSI-2 stream). This file handles the second kind: it describes where the
+ * samples of such a stream come from (PdafLayout, provided by the sensor
+ * helper) and computes the phase difference per region of the image
+ * (PdafPhase), as a grid of phase and confidence values that an autofocus
+ * algorithm can use the same way whatever the sensor.
+ */
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(Pdaf)
+
+namespace ipa {
+
+/**
+ * \struct PdafLayout
+ * \brief Layout of a sensor's raw phase detection data stream
+ *
+ * The PD pixels of a sensor sit on a grid of blocks. The stream sends one
+ * sample per block per line: a line holds the same PD pixel of every block
+ * in a block row, and each block row takes lines.size() lines, one for each
+ * PD pixel of a block, in the order given by \a lines.
+ *
+ * \var PdafLayout::blocks
+ * \brief Number of PD blocks across and down, the stream's width being
+ * blocks.width samples
+ *
+ * \var PdafLayout::blockSize
+ * \brief Size of a PD block in image pixels (the horizontal pitch of the
+ * samples of a line)
+ *
+ * \var PdafLayout::offset
+ * \brief Image position of the top left pixel of the first block
+ *
+ * \var PdafLayout::lines
+ * \brief What each line of a block row holds, in stream order
+ *
+ * \var PdafLayout::bitDepth
+ * \brief Bits per sample
+ */
+
+/**
+ * \enum PdafLayout::Side
+ * \brief The half of the lens pupil a PD pixel sees
+ * \var PdafLayout::Side::Left
+ * \brief The PD pixel is shielded to see the left half of the pupil
+ * \var PdafLayout::Side::Right
+ * \brief The PD pixel is shielded to see the right half of the pupil
+ */
+
+/**
+ * \struct PdafLayout::Line
+ * \brief The PD pixel a line of a block row holds
+ * \var PdafLayout::Line::side
+ * \brief The pupil half the pixel sees
+ * \var PdafLayout::Line::pair
+ * \brief The L/R pair of the block the pixel belongs to
+ * \var PdafLayout::Line::position
+ * \brief Position of the pixel inside its block, in image pixels
+ */
+
+/**
+ * \brief Tell whether the layout describes a usable stream
+ * \return True if it has blocks and both left and right lines
+ */
+bool PdafLayout::isValid() const
+{
+	bool left = false, right = false;
+
+	for (const Line &line : lines) {
+		left |= line.side == Side::Left;
+		right |= line.side == Side::Right;
+	}
+
+	return !blocks.isNull() && left && right && bitDepth >= 8 && bitDepth <= 16;
+}
+
+/**
+ * \brief Compute the size of the PD stream in samples
+ * \return The width and height of the stream
+ */
+Size PdafLayout::bufferSize() const
+{
+	return { blocks.width, blocks.height * static_cast<unsigned int>(lines.size()) };
+}
+
+/**
+ * \struct PdafData
+ * \brief The phase difference measured in one region
+ *
+ * \var PdafData::phase
+ * \brief Displacement of the left pupil image relative to the right one, in
+ * PD samples (block widths). It is proportional to the defocus of the
+ * region and changes sign across focus; the factor from phase to lens
+ * movement is a property of the module, calibrated in the tuning file.
+ *
+ * \var PdafData::conf
+ * \brief Confidence in the phase, from 0 (unusable: no texture, or no clear
+ * match) upwards, growing with the texture in the region and the quality of
+ * the match
+ */
+
+/**
+ * \class PdafPhase
+ * \brief Compute the phase difference from a raw PD stream, per region
+ *
+ * The image is divided in a grid of regions. In each block row of a region
+ * the left and right samples (the pairs of a block averaged) form two
+ * signals, which see the scene through opposite halves of the lens pupil
+ * and are displaced horizontally from one another by an amount proportional
+ * to the defocus. After a high-pass filter, the displacement is the shift
+ * that maximises their normalised cross-correlation, summed over the block
+ * rows of the region, refined to a fraction of a sample.
+ */
+
+/**
+ * \brief Construct a phase estimator
+ * \param[in] layout The layout of the PD stream
+ * \param[in] grid The number of regions across and down
+ * \param[in] maxShift The largest displacement searched, in samples
+ */
+PdafPhase::PdafPhase(const PdafLayout &layout, const Size &grid,
+		     unsigned int maxShift)
+	: layout_(layout), grid_(grid), maxShift_(maxShift),
+	  rowStart_(0), rowEnd_(layout.blocks.height),
+	  colStart_(0), colEnd_(layout.blocks.width)
+{
+	regions_.resize(grid_.width * grid_.height, { 0.0, 0.0 });
+}
+
+/**
+ * \brief Limit the measurement to some of the regions
+ * \param[in] active One flag per region, row major, true to measure it
+ *
+ * Measuring the phase costs time in proportion to the area measured, and an
+ * autofocus algorithm commonly looks at a few regions only. Regions left out
+ * report no confidence, and only the PD lines of the block rows the active
+ * regions span are unpacked. An empty vector measures every region again.
+ *
+ * \return 0 on success, or -EINVAL if \a active does not match the grid
+ */
+int PdafPhase::setActiveRegions(const std::vector<bool> &active)
+{
+	const unsigned int rows = layout_.blocks.height;
+	const unsigned int width = layout_.blocks.width;
+
+	if (active.empty()) {
+		active_.clear();
+		rowStart_ = 0;
+		rowEnd_ = rows;
+		colStart_ = 0;
+		colEnd_ = width;
+		return 0;
+	}
+
+	if (active.size() != regions_.size())
+		return -EINVAL;
+
+	active_ = active;
+	rowStart_ = rows;
+	rowEnd_ = 0;
+	colStart_ = width;
+	colEnd_ = 0;
+
+	for (unsigned int ry = 0; ry < grid_.height; ry++) {
+		for (unsigned int rx = 0; rx < grid_.width; rx++) {
+			if (!active_[ry * grid_.width + rx])
+				continue;
+			rowStart_ = std::min(rowStart_, ry * rows / grid_.height);
+			rowEnd_ = std::max(rowEnd_, (ry + 1) * rows / grid_.height);
+			colStart_ = std::min(colStart_, rx * width / grid_.width);
+			colEnd_ = std::max(colEnd_, (rx + 1) * width / grid_.width);
+		}
+	}
+
+	if (rowStart_ > rowEnd_) {
+		rowStart_ = rowEnd_ = 0;
+		colStart_ = colEnd_ = 0;
+	} else {
+		/*
+		 * The search reaches maxShift_ samples beyond a region, and the
+		 * high-pass filter 4 beyond that. Start on a multiple of 4, so
+		 * that unpacking starts at a CSI-2 packing group.
+		 */
+		const unsigned int margin = maxShift_ + 8;
+		colStart_ = (colStart_ > margin ? colStart_ - margin : 0) & ~3u;
+		colEnd_ = std::min(colEnd_ + margin, width);
+	}
+
+	std::fill(regions_.begin(), regions_.end(), PdafData{ 0.0, 0.0 });
+
+	return 0;
+}
+
+/**
+ * \brief Set the shading gains of the left and right PD pixels
+ * \param[in] grid The size of the gain grids
+ * \param[in] left The gains for the pixels that see the left pupil half
+ * \param[in] right The gains for the pixels that see the right pupil half
+ *
+ * Each half of the lens pupil vignettes differently across the image, so the
+ * two signals of a region differ in level and slope as well as in position.
+ * Module calibration commonly measures a gain map per pixel side that
+ * flattens this (Qualcomm's PDAF calibration does, as a 17x13 grid). The
+ * grids are row major, with their points spread evenly from the image's top
+ * left corner to its bottom right one; each block takes the gain
+ * interpolated at its centre.
+ *
+ * \return 0 on success, or -EINVAL if the grids do not match \a grid
+ */
+int PdafPhase::setShading(const Size &grid, Span<const float> left,
+			  Span<const float> right)
+{
+	const size_t n = static_cast<size_t>(grid.width) * grid.height;
+
+	if (grid.width < 2 || grid.height < 2 || left.size() != n ||
+	    right.size() != n)
+		return -EINVAL;
+
+	const unsigned int width = layout_.blocks.width;
+	const unsigned int rows = layout_.blocks.height;
+	const double imageWidth = width * layout_.blockSize.width + 2.0 * layout_.offset.x;
+	const double imageHeight = rows * layout_.blockSize.height + 2.0 * layout_.offset.y;
+
+	auto sample = [&](Span<const float> map, double gx, double gy) {
+		unsigned int x0 = std::min<unsigned int>(gx, grid.width - 2);
+		unsigned int y0 = std::min<unsigned int>(gy, grid.height - 2);
+		double fx = gx - x0, fy = gy - y0;
+		const float *r0 = &map[y0 * grid.width + x0];
+		const float *r1 = r0 + grid.width;
+
+		return (r0[0] * (1 - fx) + r0[1] * fx) * (1 - fy) +
+		       (r1[0] * (1 - fx) + r1[1] * fx) * fy;
+	};
+
+	gainLeft_.resize(width * rows);
+	gainRight_.resize(width * rows);
+
+	for (unsigned int r = 0; r < rows; r++) {
+		double cy = layout_.offset.y + (r + 0.5) * layout_.blockSize.height;
+		double gy = cy / (imageHeight - 1) * (grid.height - 1);
+
+		for (unsigned int x = 0; x < width; x++) {
+			double cx = layout_.offset.x + (x + 0.5) * layout_.blockSize.width;
+			double gx = cx / (imageWidth - 1) * (grid.width - 1);
+
+			gainLeft_[r * width + x] = sample(left, gx, gy);
+			gainRight_[r * width + x] = sample(right, gx, gy);
+		}
+	}
+
+	return 0;
+}
+
+/**
+ * \brief Unpack one line of CSI-2 packed samples
+ * \param[in] line The packed line
+ * \param[in] bitDepth Bits per sample (8, 10, 12 or 14)
+ * \param[out] samples The unpacked samples, as many as it holds
+ *
+ * CSI-2 packs 10, 12 and 14 bit samples by putting the 8 most significant
+ * bits of each in a byte of their own, followed by the least significant
+ * bits of a group of samples (4, 2 and 4 samples respectively).
+ */
+void PdafPhase::unpackCsi2(Span<const uint8_t> line, unsigned int bitDepth,
+			   Span<uint16_t> samples)
+{
+	size_t n = samples.size();
+
+	switch (bitDepth) {
+	case 8:
+		for (size_t i = 0; i < n && i < line.size(); i++)
+			samples[i] = line[i];
+		break;
+	case 10:
+		for (size_t i = 0; i < n; i++) {
+			size_t g = (i / 4) * 5;
+			unsigned int k = i % 4;
+			if (g + 4 >= line.size())
+				break;
+			samples[i] = (line[g + k] << 2) | ((line[g + 4] >> (2 * k)) & 3);
+		}
+		break;
+	case 12:
+		for (size_t i = 0; i < n; i++) {
+			size_t g = (i / 2) * 3;
+			unsigned int k = i % 2;
+			if (g + 2 >= line.size())
+				break;
+			samples[i] = (line[g + k] << 4) | ((line[g + 2] >> (4 * k)) & 15);
+		}
+		break;
+	case 14:
+		for (size_t i = 0; i < n; i++) {
+			size_t g = (i / 4) * 7;
+			unsigned int k = i % 4;
+			if (g + 6 >= line.size())
+				break;
+			uint32_t lsb = line[g + 4] | (line[g + 5] << 8) | (line[g + 6] << 16);
+			samples[i] = (line[g + k] << 6) | ((lsb >> (6 * k)) & 63);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+/**
+ * \brief Compute the phase in every region from a CSI-2 packed PD buffer
+ * \param[in] buffer The PD buffer as captured (line based, CSI-2 packed)
+ * \param[in] bytesPerLine The buffer's line stride
+ * \return 0 on success, or -EINVAL if the buffer is too small for the layout
+ */
+int PdafPhase::process(Span<const uint8_t> buffer, unsigned int bytesPerLine)
+{
+	const Size size = layout_.bufferSize();
+
+	if (!layout_.isValid() || bytesPerLine * size.height > buffer.size())
+		return -EINVAL;
+
+	/*
+	 * Only the samples that are measured: the lines of the block rows,
+	 * and the columns, which start on a packing group (colStart_ is a
+	 * multiple of 4, and so a whole number of bytes in).
+	 */
+	const unsigned int nlines = layout_.lines.size();
+	const unsigned int skip = colStart_ * layout_.bitDepth / 8;
+	unpacked_.resize(size.width * size.height);
+	for (unsigned int y = rowStart_ * nlines; y < rowEnd_ * nlines; y++)
+		unpackCsi2(buffer.subspan(y * bytesPerLine + skip, bytesPerLine - skip),
+			   layout_.bitDepth,
+			   Span<uint16_t>(unpacked_).subspan(y * size.width + colStart_,
+							     colEnd_ - colStart_));
+
+	return process(unpacked_, size.width);
+}
+
+/**
+ * \brief Compute the phase in every region from unpacked PD samples
+ * \param[in] samples The samples, one per element
+ * \param[in] stride The number of elements from one line to the next
+ * \return 0 on success, or -EINVAL if there are too few samples
+ */
+int PdafPhase::process(Span<const uint16_t> samples, unsigned int stride)
+{
+	const Size size = layout_.bufferSize();
+
+	if (!layout_.isValid() || grid_.isNull() || stride < size.width ||
+	    samples.size() < stride * (size.height - 1) + size.width)
+		return -EINVAL;
+
+	buildSignals(samples, stride);
+
+	for (unsigned int ry = 0; ry < grid_.height; ry++) {
+		for (unsigned int rx = 0; rx < grid_.width; rx++) {
+			const unsigned int i = ry * grid_.width + rx;
+			if (active_.empty() || active_[i])
+				regions_[i] = regionPhase(rx, ry);
+		}
+	}
+
+	return 0;
+}
+
+void PdafPhase::buildSignals(Span<const uint16_t> samples, unsigned int stride)
+{
+	const unsigned int width = layout_.blocks.width;
+	const unsigned int rows = layout_.blocks.height;
+	const unsigned int nlines = layout_.lines.size();
+	unsigned int nleft = 0, nright = 0;
+
+	for (const PdafLayout::Line &line : layout_.lines)
+		(line.side == PdafLayout::Side::Left ? nleft : nright)++;
+
+	/*
+	 * The measured rows and columns; the signals are not read outside
+	 * them (see setActiveRegions()), so only they are computed.
+	 */
+	const unsigned int x0 = colStart_;
+	const unsigned int x1 = colEnd_;
+
+	left_.resize(width * rows);
+	right_.resize(width * rows);
+	std::vector<float> in(width);
+
+	for (unsigned int r = rowStart_; r < rowEnd_; r++) {
+		float *l = &left_[r * width];
+		float *rt = &right_[r * width];
+
+		std::fill(l + x0, l + x1, 0.0f);
+		std::fill(rt + x0, rt + x1, 0.0f);
+
+		for (unsigned int j = 0; j < nlines; j++) {
+			const uint16_t *s = &samples[(r * nlines + j) * stride];
+			float *dst = layout_.lines[j].side == PdafLayout::Side::Left ? l : rt;
+
+			for (unsigned int x = x0; x < x1; x++)
+				dst[x] += s[x];
+		}
+
+		for (unsigned int x = x0; x < x1; x++) {
+			l[x] /= nleft;
+			rt[x] /= nright;
+		}
+
+		if (!gainLeft_.empty()) {
+			for (unsigned int x = x0; x < x1; x++) {
+				l[x] *= gainLeft_[r * width + x];
+				rt[x] *= gainRight_[r * width + x];
+			}
+		}
+
+		/*
+		 * High-pass both signals, subtracting a 9 sample running mean:
+		 * the correlation must follow edges and texture, not the
+		 * brightness difference of the two pupil halves.
+		 */
+		for (float *sig : { l, rt }) {
+			std::copy(sig + x0, sig + x1, in.begin() + x0);
+			for (unsigned int x = x0; x < x1; x++) {
+				unsigned int a = x >= x0 + 4 ? x - 4 : x0;
+				unsigned int b = std::min(x + 4, x1 - 1);
+				float sum = 0.0f;
+				for (unsigned int k = a; k <= b; k++)
+					sum += in[k];
+				sig[x] = in[x] - sum / (b - a + 1);
+			}
+		}
+	}
+}
+
+PdafData PdafPhase::regionPhase(unsigned int rx, unsigned int ry) const
+{
+	const unsigned int width = layout_.blocks.width;
+	const unsigned int rows = layout_.blocks.height;
+	const int M = maxShift_;
+
+	unsigned int x0 = rx * width / grid_.width;
+	unsigned int x1 = (rx + 1) * width / grid_.width;
+	unsigned int y0 = ry * rows / grid_.height;
+	unsigned int y1 = (ry + 1) * rows / grid_.height;
+
+	/* Keep the shifted window inside the stream, and away from its edges */
+	int xs = std::max<int>(x0, M + 4);
+	int xe = std::min<int>(x1, width - M - 4);
+	if (xe - xs < 8)
+		return { 0.0, 0.0 };
+
+	std::vector<double> num(2 * M + 1, 0.0), ll(2 * M + 1, 0.0);
+	double rr = 0.0;
+	unsigned int count = 0;
+
+	for (unsigned int y = y0; y < y1; y++) {
+		const float *l = &left_[y * width];
+		const float *r = &right_[y * width];
+
+		for (int x = xs; x < xe; x++) {
+			rr += r[x] * r[x];
+			for (int s = -M; s <= M; s++) {
+				num[s + M] += l[x + s] * r[x];
+				ll[s + M] += l[x + s] * l[x + s];
+			}
+		}
+		count += xe - xs;
+	}
+
+	if (!count || rr <= 0.0)
+		return { 0.0, 0.0 };
+
+	std::vector<double> ncc(2 * M + 1);
+	for (int i = 0; i <= 2 * M; i++)
+		ncc[i] = ll[i] > 0.0 ? num[i] / std::sqrt(ll[i] * rr) : 0.0;
+
+	int best = std::max_element(ncc.begin(), ncc.end()) - ncc.begin();
+	if (best == 0 || best == 2 * M || ncc[best] < 0.5)
+		return { 0.0, 0.0 };
+
+	double y_1 = ncc[best - 1], y0v = ncc[best], y1v = ncc[best + 1];
+	double den = y_1 - 2 * y0v + y1v;
+	double frac = den < 0.0 ? 0.5 * (y_1 - y1v) / den : 0.0;
+
+	/*
+	 * Confidence: the quality of the match, times how much texture there
+	 * is compared to the noise of a sample (about one least significant
+	 * bit of a 10 bit sample).
+	 */
+	double noise = std::ldexp(1.0, static_cast<int>(layout_.bitDepth) - 10);
+	double energy = rr / count;
+	double conf = y0v * energy / (energy + 4.0 * noise * noise);
+
+	return { best - M + frac, conf };
+}
+
+/**
+ * \brief Combine the regions into one phase
+ * \param[in] minConf The confidence below which a region is ignored
+ * \return The confidence-weighted mean phase, and the mean confidence of the
+ * regions used, or a confidence of 0 if none was usable
+ */
+PdafData PdafPhase::combined(double minConf) const
+{
+	double sumPc = 0.0, sumC = 0.0;
+	unsigned int n = 0;
+
+	for (const PdafData &d : regions_) {
+		if (d.conf <= minConf)
+			continue;
+		sumPc += d.phase * d.conf;
+		sumC += d.conf;
+		n++;
+	}
+
+	if (!n || sumC <= 0.0)
+		return { 0.0, 0.0 };
+
+	return { sumPc / sumC, sumC / n };
+}
+
+} /* namespace ipa */
+
+} /* namespace libcamera */

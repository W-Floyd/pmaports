+/*
+ * HDR, from frames of alternating exposure: the cells of this frame are
+ * brought to the units of the short exposure (merge.x, its scale; 1 for the
+ * short frames), and blended with the estimate the previous frames made, in
+ * the units of their reference (merge.y brings it to this one's), by their
+ * inverse variances (the noise model's, a long exposure's scaled down by its
+ * scale), where the two agree within a few deviations: moving parts are the
+ * latest frame's alone, and a saturated cell is left out for the estimate's.
+ * merge.z is 1 when merging and merge.w that there is a previous frame.
+ */
+uniform vec4 merge;
+
 out vec4 fragColor;
 
 /* A byte gathered, from 0 to 255 */
@@ -94,8 +106,40 @@ void main(void)
 
 	vec3 cell = vec3(r, g * 0.5, b);
 
-	if (temporal.x > 0.0) {
+	if (merge.z > 0.0) {
+		vec3 cur = black + (cell - black) * merge.x;
+		if (merge.w > 0.0) {
+			vec3 prev = texture(prev_cells, gl_FragCoord.xy / vec2(textureSize(prev_cells, 0))).rgb * 1023.0;
+			prev = black + (prev - black) * merge.y;
+
+			/* A cell of a saturated channel has the wrong colour, of all three */
+			bool valid = max(max(cell.r, cell.g), cell.b) < 992.0;
+
+			/* A cell's green is the mean of two pixels: half the variance */
+			vec3 half_green = vec3(1.0, 0.5, 1.0);
+			vec3 level = max(cell - black, 0.0);
+			vec3 var_cur = (noise.x * level + noise.y * level * level + noise.z) *
+				       half_green * (merge.x * merge.x);
+			vec3 level_prev = max(prev - black, 0.0);
+			/* The estimate has the variance of some frames' mean */
+			vec3 var_prev = (noise.x * level_prev + noise.y * level_prev * level_prev + noise.z) *
+					half_green * 0.6;
+
+			/* One gate for the three channels, from the one that differs most */
+			vec3 d = abs(cur - prev) / sqrt(var_cur + var_prev);
+			float m = max(max(d.x, d.y), d.z) / max(temporal.y, 0.001);
+			float gate = valid ? exp(-0.5 * m * m) : 1.0;
+
+			vec3 w_cur = valid ? 1.0 / max(var_cur, 1e-3) : vec3(0.0);
+			vec3 w_prev = gate / max(var_prev, 1e-3);
+			cell = (w_cur * cur + w_prev * prev) / (w_cur + w_prev);
+		} else {
+			cell = cur;
+		}
+	} else if (temporal.x > 0.0) {
 		vec3 prev = texture(prev_cells, gl_FragCoord.xy / vec2(textureSize(prev_cells, 0))).rgb * 1023.0;
+		/* The exposure may have changed since: the previous cell in this frame's units */
+		prev = black + (prev - black) * merge.y;
 		/*
 		 * One weight for the three channels, from the one that differs
 		 * most: the channels must not be blended by different amounts,

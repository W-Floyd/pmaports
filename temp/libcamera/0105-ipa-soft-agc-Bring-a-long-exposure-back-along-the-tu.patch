From 3d3cf1f35b1c60b08c14a84f76d29d91c7a47eff Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 15:18:36 +0000
Subject: [PATCH] ipa: soft: agc: Bring a long exposure back along the tuning's
 exposure by gain

When the scene brightens within the exposure's tolerance nothing moved the
exposure, which stayed longer than the tuning has at its gain, and the
frame stayed long. Trade the excess for gain at the same brightness and
shorten the frame to it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ipa/soft/algorithms/agc.cpp | 33 ++++++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/ipa/soft/algorithms/agc.cpp b/src/ipa/soft/algorithms/agc.cpp
index d0ad5eb31..5ee10fcf5 100644
--- a/src/ipa/soft/algorithms/agc.cpp
+++ b/src/ipa/soft/algorithms/agc.cpp
@@ -619,6 +619,36 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
 
+	/*
+	 * A lengthened frame whose exposure is longer than the tuning's table
+	 * has at the gain (the scene brightened, with the exposure still
+	 * within its tolerance, so that nothing moved it): trade the excess
+	 * for gain at the same brightness, the way along the table, and
+	 * shorten the frame to it.
+	 */
+	{
+		const auto &cfg = context.configuration.agc;
+		auto &state = context.activeState.agc;
+
+		if (cfg.exposureCap && state.vblank > cfg.vblankBase) {
+			for (int i = 0; i < 4; i++) {
+				const int32_t allowed = allowedExposure(context, again);
+				if (exposure <= allowed || again >= cfg.againMax)
+					break;
+				const double product = exposure * again;
+				exposure = allowed;
+				again = std::min(cfg.againMax, product / exposure);
+			}
+			const int32_t need = exposure > cfg.exposureMax ? exposure + exposure / 8
+								: cfg.exposureMax;
+			state.vblank = std::min(state.vblank,
+						cfg.vblankBase + (need - cfg.exposureMax));
+			exposure = std::min(exposure, cfg.exposureMax + (state.vblank - cfg.vblankBase));
+			state.exposure = exposure;
+			state.again = again;
+		}
+	}
+
 	double error = exposureOptimal_ - exposureMSV;
 	double factor;
 
@@ -742,7 +772,8 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 	 * to rise before the frame has to be lengthened again.
 	 */
 	if (state.vblank > cfg.vblankBase) {
-		const int32_t need = std::max(cfg.exposureMax, exposure + exposure / 8);
+		const int32_t need = exposure > cfg.exposureMax ? exposure + exposure / 8
+								: cfg.exposureMax;
 		state.vblank = std::min(state.vblank,
 					cfg.vblankBase + (need - cfg.exposureMax));
 	}

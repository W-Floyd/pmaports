diff --git a/src/libcamera/software_isp/software_isp.cpp b/src/libcamera/software_isp/software_isp.cpp
index 56cadad50..22b2867af 100644
--- a/src/libcamera/software_isp/software_isp.cpp
+++ b/src/libcamera/software_isp/software_isp.cpp
@@ -219,10 +219,26 @@ SoftwareIsp::SoftwareIsp(PipelineHandler *pipe, CameraSensor *sensor,
 
 SoftwareIsp::~SoftwareIsp()
 {
+	/* A debayer started ahead, for a camera that was configured and never started */
+	if (ispWorkerThread_.isRunning())
+		stopWorker();
+
 	/* make sure to destroy the DebayerCpu before the ispWorkerThread_ is gone */
 	debayer_.reset();
 }
 
+/*
+ * Stop the debayer and its thread, not the frames waiting for them (see
+ * stop()).
+ */
+void SoftwareIsp::stopWorker()
+{
+	debayer_->invokeMethod(&Debayer::stop, ConnectionTypeBlocking);
+
+	ispWorkerThread_.exit();
+	ispWorkerThread_.wait();
+}
+
 /**
  * \fn int SoftwareIsp::loadConfiguration([[maybe_unused]] const std::string &filename)
  * \brief Load a configuration from a file
@@ -384,9 +400,41 @@ int SoftwareIsp::configure(const StreamConfiguration &inputCfg,
 	if (ret < 0)
 		return ret;
 
-	ret = debayer_->configure(inputCfg, outputCfgs, ccmEnabled_);
-	if (ret < 0)
-		return ret;
+	/*
+	 * What the debayer is configured with, to leave it alone (and what it
+	 * has started, see below) when the same is asked for again, as
+	 * applications do, and not to configure it under its thread.
+	 */
+	std::optional<DebayerConfig> config;
+	if (!outputCfgs.empty()) {
+		const StreamConfiguration &out = outputCfgs.front();
+		config = DebayerConfig{ inputCfg.pixelFormat, inputCfg.size, inputCfg.stride,
+					out.pixelFormat, out.size, out.stride };
+	}
+	const bool running = ispWorkerThread_.isRunning();
+	const bool same = running && config && debayerConfig_ && *config == *debayerConfig_;
+
+	if (!same) {
+		if (running)
+			stopWorker();
+		debayerConfig_.reset();
+
+		ret = debayer_->configure(inputCfg, outputCfgs, ccmEnabled_);
+		if (ret < 0)
+			return ret;
+	}
+
+	/*
+	 * Start what takes long to start (the GL context and the shaders of
+	 * the GPU debayer) now, on the debayer's thread, in the time the
+	 * application takes to get from configuring the camera to starting
+	 * it: start() waits for the result.
+	 */
+	if (!same && config && debayer_->startsAhead()) {
+		debayerConfig_ = config;
+		ispWorkerThread_.start();
+		debayer_->invokeMethod(&Debayer::start, ConnectionTypeQueued);
+	}
 
 	LOG(SoftwareIsp, Info)
 		<< "Input " << inputCfg.size
@@ -476,7 +524,9 @@ int SoftwareIsp::start()
 	if (ret)
 		return ret;
 
-	ispWorkerThread_.start();
+	/* Already running if the debayer was started ahead, when configured */
+	if (!ispWorkerThread_.isRunning())
+		ispWorkerThread_.start();
 
 	return debayer_->invokeMethod(&Debayer::start,
 				      ConnectionTypeBlocking);
@@ -495,11 +545,8 @@ void SoftwareIsp::stop()
 	if (!ispWorkerThread_.isRunning())
 		return;
 
-	debayer_->invokeMethod(&Debayer::stop,
-			       ConnectionTypeBlocking);
-
-	ispWorkerThread_.exit();
-	ispWorkerThread_.wait();
+	stopWorker();
+	debayerConfig_.reset();
 
 	/*
 	 * Frames still waiting for parameters are cancelled below. Forget them

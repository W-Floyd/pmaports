 src/libcamera/software_isp/debayer.h          |  6 ++
 src/libcamera/software_isp/debayer_egl.cpp    | 16 +++++
 src/libcamera/software_isp/debayer_egl.h      |  5 ++
 src/libcamera/software_isp/software_isp.cpp   | 65 ++++++++++++++++---
 5 files changed, 106 insertions(+), 9 deletions(-)


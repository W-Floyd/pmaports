@@ -106,6 +107,28 @@ private:
 	void statsReady(uint32_t frame, uint32_t bufferId);
 	void inputReady(FrameBuffer *input);
 	void outputReady(FrameBuffer *output);
+	void stopWorker();
+
+	/*
+	 * The configuration the debayer was configured, and started ahead,
+	 * with: the same one again leaves it alone.
+	 */
+	struct DebayerConfig {
+		PixelFormat inputFormat;
+		Size inputSize;
+		unsigned int inputStride;
+		PixelFormat outputFormat;
+		Size outputSize;
+		unsigned int outputStride;
+
+		bool operator==(const DebayerConfig &o) const
+		{
+			return inputFormat == o.inputFormat && inputSize == o.inputSize &&
+			       inputStride == o.inputStride && outputFormat == o.outputFormat &&
+			       outputSize == o.outputSize && outputStride == o.outputStride;
+		}
+	};
+	std::optional<DebayerConfig> debayerConfig_;
 	std::unique_ptr<Debayer> debayer_;
 	Thread ispWorkerThread_;
 	SharedMemObject<DebayerParams> sharedParams_;

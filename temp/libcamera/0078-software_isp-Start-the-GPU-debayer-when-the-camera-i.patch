+/*
+ * Started ahead of the camera, when it is configured, so that the context and
+ * the shaders are ready by the time its first frame is: what the start that
+ * comes with the camera's gets is the result of that one.
+ */
 int DebayerEGL::start()
+{
+	if (!started_) {
+		startRet_ = startContext();
+		started_ = true;
+	}
+
+	return startRet_;
+}
+
+int DebayerEGL::startContext()
 {
 	GLint maxTextureImageUnits;
 
@@ -1211,6 +1226,7 @@ void DebayerEGL::stop()
 
 	/* Everything above lives in the context, which goes now */
 	egl_.resetEGLContext();
+	started_ = false;
 }
 
 SizeRange DebayerEGL::sizes(PixelFormat inputFormat, const Size &inputSize)

 	/* Map contrast 0..2 to an exponent 0..infinity, avoiding tan(pi/2). */
 	const float contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
 	const bool fromCurve = !curve_.empty() && !gammaSet_;
-	/* Rebuild for DRC changes of a percent or more, not every wobble. */
-	const float drc = std::round(std::max(context.activeState.agc.drcGain, 1.0) * 100) / 100;
+	/* Rebuild for DRC changes of half a percent or more. */
+	const float drc = std::round(drcGain(context, frameContext) * 200) / 200;
 
 	if (!lutValid_ || gamma != lutGamma_ || contrastExp != lutContrastExp_ ||
 	    fromCurve != lutFromCurve_ || drc != lutDrc_) {

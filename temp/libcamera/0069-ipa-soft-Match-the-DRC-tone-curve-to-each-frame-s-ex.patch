+/*
+ * The DRC gain for a frame's tone curve: what brings the frame's mean up to
+ * the target without DRC, predicted from the last frame with statistics and
+ * the two frames' exposure x gain, and at most the DRC gain the frame's
+ * exposure was decided for. Following the frame's actual exposure makes the
+ * curve change in the same frame as the exposure, whatever steps the
+ * exposure loop takes, so the image does not pulse; the cap keeps it from
+ * acting as extra digital gain when the exposure falls short for other
+ * reasons.
+ */
+double Adjust::drcGain(const IPAContext &context, const IPAFrameContext &frameContext)
+{
+	const auto &agc = context.activeState.agc;
+
+	if (agc.drcHistory.empty() || agc.lastProduct <= 0.0 || agc.plainTarget <= 0.0)
+		return std::max(agc.drcGain, 1.0);
+
+	const double product = frameContext.sensor.known
+				       ? frameContext.sensor.exposure * frameContext.sensor.gain
+				       : agc.lastProduct;
+
+	double cap = agc.drcGain;
+	for (auto it = agc.drcHistory.rbegin(); it != agc.drcHistory.rend(); ++it) {
+		if (std::abs(it->first - product) <= 0.02 * product) {
+			cap = it->second;
+			break;
+		}
+	}
+
+	if (cap <= 1.0)
+		return 1.0;
+
+	const double expected = agc.lastMean * product / agc.lastProduct;
+	return std::clamp(agc.plainTarget / expected, 1.0, cap);
+}
+

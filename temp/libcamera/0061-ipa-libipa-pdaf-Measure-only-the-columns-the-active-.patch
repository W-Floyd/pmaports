From c5ddc55a8b2f4d4b13d00bfd7b5ff8d4b20e1fd0 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 17:43:15 +0000
Subject: [PATCH 61/76] ipa: libipa: pdaf: Measure only the columns the active
 regions need

Active regions limited the rows unpacked and filtered, but every one of
them was still processed across the whole stream width. Limit the
columns too, to the active regions with the margin the shift search and
the high-pass filter need, starting on a CSI-2 packing group, and fill
only that part of the signals. The central 2x2 regions of an 8x6 grid
take a ninth of the time of the whole frame, with the same results.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/libipa/pdaf.cpp | 64 ++++++++++++++++++++++++++++++++---------
 src/ipa/libipa/pdaf.h   |  7 ++++-
 2 files changed, 56 insertions(+), 15 deletions(-)

diff --git a/src/ipa/libipa/pdaf.cpp b/src/ipa/libipa/pdaf.cpp
index 38affebb3..3e3598975 100644
--- a/src/ipa/libipa/pdaf.cpp
+++ b/src/ipa/libipa/pdaf.cpp
@@ -144,7 +144,8 @@ Size PdafLayout::bufferSize() const
 PdafPhase::PdafPhase(const PdafLayout &layout, const Size &grid,
 		     unsigned int maxShift)
 	: layout_(layout), grid_(grid), maxShift_(maxShift),
-	  rowStart_(0), rowEnd_(layout.blocks.height)
+	  rowStart_(0), rowEnd_(layout.blocks.height),
+	  colStart_(0), colEnd_(layout.blocks.width)
 {
 	regions_.resize(grid_.width * grid_.height, { 0.0, 0.0 });
 }
@@ -163,11 +164,14 @@ PdafPhase::PdafPhase(const PdafLayout &layout, const Size &grid,
 int PdafPhase::setActiveRegions(const std::vector<bool> &active)
 {
 	const unsigned int rows = layout_.blocks.height;
+	const unsigned int width = layout_.blocks.width;
 
 	if (active.empty()) {
 		active_.clear();
 		rowStart_ = 0;
 		rowEnd_ = rows;
+		colStart_ = 0;
+		colEnd_ = width;
 		return 0;
 	}
 
@@ -177,6 +181,8 @@ int PdafPhase::setActiveRegions(const std::vector<bool> &active)
 	active_ = active;
 	rowStart_ = rows;
 	rowEnd_ = 0;
+	colStart_ = width;
+	colEnd_ = 0;
 
 	for (unsigned int ry = 0; ry < grid_.height; ry++) {
 		for (unsigned int rx = 0; rx < grid_.width; rx++) {
@@ -184,11 +190,24 @@ int PdafPhase::setActiveRegions(const std::vector<bool> &active)
 				continue;
 			rowStart_ = std::min(rowStart_, ry * rows / grid_.height);
 			rowEnd_ = std::max(rowEnd_, (ry + 1) * rows / grid_.height);
+			colStart_ = std::min(colStart_, rx * width / grid_.width);
+			colEnd_ = std::max(colEnd_, (rx + 1) * width / grid_.width);
 		}
 	}
 
-	if (rowStart_ > rowEnd_)
+	if (rowStart_ > rowEnd_) {
 		rowStart_ = rowEnd_ = 0;
+		colStart_ = colEnd_ = 0;
+	} else {
+		/*
+		 * The search reaches maxShift_ samples beyond a region, and the
+		 * high-pass filter 4 beyond that. Start on a multiple of 4, so
+		 * that unpacking starts at a CSI-2 packing group.
+		 */
+		const unsigned int margin = maxShift_ + 8;
+		colStart_ = (colStart_ > margin ? colStart_ - margin : 0) & ~3u;
+		colEnd_ = std::min(colEnd_ + margin, width);
+	}
 
 	std::fill(regions_.begin(), regions_.end(), PdafData{ 0.0, 0.0 });
 
@@ -321,13 +340,19 @@ int PdafPhase::process(Span<const uint8_t> buffer, unsigned int bytesPerLine)
 	if (!layout_.isValid() || bytesPerLine * size.height > buffer.size())
 		return -EINVAL;
 
-	/* Only the lines of the block rows that are measured */
+	/*
+	 * Only the samples that are measured: the lines of the block rows,
+	 * and the columns, which start on a packing group (colStart_ is a
+	 * multiple of 4, and so a whole number of bytes in).
+	 */
 	const unsigned int nlines = layout_.lines.size();
+	const unsigned int skip = colStart_ * layout_.bitDepth / 8;
 	unpacked_.resize(size.width * size.height);
 	for (unsigned int y = rowStart_ * nlines; y < rowEnd_ * nlines; y++)
-		unpackCsi2(buffer.subspan(y * bytesPerLine, bytesPerLine),
+		unpackCsi2(buffer.subspan(y * bytesPerLine + skip, bytesPerLine - skip),
 			   layout_.bitDepth,
-			   Span<uint16_t>(unpacked_).subspan(y * size.width, size.width));
+			   Span<uint16_t>(unpacked_).subspan(y * size.width + colStart_,
+							     colEnd_ - colStart_));
 
 	return process(unpacked_, size.width);
 }
@@ -369,28 +394,39 @@ void PdafPhase::buildSignals(Span<const uint16_t> samples, unsigned int stride)
 	for (const PdafLayout::Line &line : layout_.lines)
 		(line.side == PdafLayout::Side::Left ? nleft : nright)++;
 
-	left_.assign(width * rows, 0.0f);
-	right_.assign(width * rows, 0.0f);
+	/*
+	 * The measured rows and columns; the signals are not read outside
+	 * them (see setActiveRegions()), so only they are computed.
+	 */
+	const unsigned int x0 = colStart_;
+	const unsigned int x1 = colEnd_;
+
+	left_.resize(width * rows);
+	right_.resize(width * rows);
+	std::vector<float> in(width);
 
 	for (unsigned int r = rowStart_; r < rowEnd_; r++) {
 		float *l = &left_[r * width];
 		float *rt = &right_[r * width];
 
+		std::fill(l + x0, l + x1, 0.0f);
+		std::fill(rt + x0, rt + x1, 0.0f);
+
 		for (unsigned int j = 0; j < nlines; j++) {
 			const uint16_t *s = &samples[(r * nlines + j) * stride];
 			float *dst = layout_.lines[j].side == PdafLayout::Side::Left ? l : rt;
 
-			for (unsigned int x = 0; x < width; x++)
+			for (unsigned int x = x0; x < x1; x++)
 				dst[x] += s[x];
 		}
 
-		for (unsigned int x = 0; x < width; x++) {
+		for (unsigned int x = x0; x < x1; x++) {
 			l[x] /= nleft;
 			rt[x] /= nright;
 		}
 
 		if (!gainLeft_.empty()) {
-			for (unsigned int x = 0; x < width; x++) {
+			for (unsigned int x = x0; x < x1; x++) {
 				l[x] *= gainLeft_[r * width + x];
 				rt[x] *= gainRight_[r * width + x];
 			}
@@ -402,10 +438,10 @@ void PdafPhase::buildSignals(Span<const uint16_t> samples, unsigned int stride)
 		 * brightness difference of the two pupil halves.
 		 */
 		for (float *sig : { l, rt }) {
-			std::vector<float> in(sig, sig + width);
-			for (unsigned int x = 0; x < width; x++) {
-				unsigned int a = x >= 4 ? x - 4 : 0;
-				unsigned int b = std::min(x + 4, width - 1);
+			std::copy(sig + x0, sig + x1, in.begin() + x0);
+			for (unsigned int x = x0; x < x1; x++) {
+				unsigned int a = x >= x0 + 4 ? x - 4 : x0;
+				unsigned int b = std::min(x + 4, x1 - 1);
 				float sum = 0.0f;
 				for (unsigned int k = a; k <= b; k++)
 					sum += in[k];
diff --git a/src/ipa/libipa/pdaf.h b/src/ipa/libipa/pdaf.h
index a4531049a..6d61c6c59 100644
--- a/src/ipa/libipa/pdaf.h
+++ b/src/ipa/libipa/pdaf.h
@@ -79,10 +79,15 @@ private:
 	/* Shading gain per block, one vector per side, empty if none */
 	std::vector<float> gainLeft_;
 	std::vector<float> gainRight_;
-	/* Regions to measure (all if empty), and the block rows they span */
+	/*
+	 * Regions to measure (all if empty), and the block rows and sample
+	 * columns (with the margin the search and the filter need) they span
+	 */
 	std::vector<bool> active_;
 	unsigned int rowStart_;
 	unsigned int rowEnd_;
+	unsigned int colStart_;
+	unsigned int colEnd_;
 	std::vector<PdafData> regions_;
 };
 

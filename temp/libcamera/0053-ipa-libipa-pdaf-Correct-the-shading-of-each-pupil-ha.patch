+/**
+ * \brief Set the shading gains of the left and right PD pixels
+ * \param[in] grid The size of the gain grids
+ * \param[in] left The gains for the pixels that see the left pupil half
+ * \param[in] right The gains for the pixels that see the right pupil half
+ *
+ * Each half of the lens pupil vignettes differently across the image, so the
+ * two signals of a region differ in level and slope as well as in position.
+ * Module calibration commonly measures a gain map per pixel side that
+ * flattens this (Qualcomm's PDAF calibration does, as a 17x13 grid). The
+ * grids are row major, with their points spread evenly from the image's top
+ * left corner to its bottom right one; each block takes the gain
+ * interpolated at its centre.
+ *
+ * \return 0 on success, or -EINVAL if the grids do not match \a grid
+ */
+int PdafPhase::setShading(const Size &grid, Span<const float> left,
+			  Span<const float> right)
+{
+	const size_t n = static_cast<size_t>(grid.width) * grid.height;
+
+	if (grid.width < 2 || grid.height < 2 || left.size() != n ||
+	    right.size() != n)
+		return -EINVAL;
+
+	const unsigned int width = layout_.blocks.width;
+	const unsigned int rows = layout_.blocks.height;
+	const double imageWidth = width * layout_.blockSize.width + 2.0 * layout_.offset.x;
+	const double imageHeight = rows * layout_.blockSize.height + 2.0 * layout_.offset.y;
+
+	auto sample = [&](Span<const float> map, double gx, double gy) {
+		unsigned int x0 = std::min<unsigned int>(gx, grid.width - 2);
+		unsigned int y0 = std::min<unsigned int>(gy, grid.height - 2);
+		double fx = gx - x0, fy = gy - y0;
+		const float *r0 = &map[y0 * grid.width + x0];
+		const float *r1 = r0 + grid.width;
+
+		return (r0[0] * (1 - fx) + r0[1] * fx) * (1 - fy) +
+		       (r1[0] * (1 - fx) + r1[1] * fx) * fy;
+	};
+
+	gainLeft_.resize(width * rows);
+	gainRight_.resize(width * rows);
+
+	for (unsigned int r = 0; r < rows; r++) {
+		double cy = layout_.offset.y + (r + 0.5) * layout_.blockSize.height;
+		double gy = cy / (imageHeight - 1) * (grid.height - 1);
+
+		for (unsigned int x = 0; x < width; x++) {
+			double cx = layout_.offset.x + (x + 0.5) * layout_.blockSize.width;
+			double gx = cx / (imageWidth - 1) * (grid.width - 1);
+
+			gainLeft_[r * width + x] = sample(left, gx, gy);
+			gainRight_[r * width + x] = sample(right, gx, gy);
+		}
+	}
+
+	return 0;
+}
+

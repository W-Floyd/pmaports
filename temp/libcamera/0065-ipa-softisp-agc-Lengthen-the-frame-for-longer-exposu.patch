+int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.configuration.agc;
+
+	const auto vblank = configInfo.sensorControls.find(V4L2_CID_VBLANK);
+	const double lineUs = agc.lineDuration.get<std::micro>();
+	double maxUs = maxExposureUs_;
+	if (maxUs <= 0.0 && !exposureByGainUs_.empty())
+		maxUs = exposureByGainUs_.back().second;
+	if (maxUs <= 0.0 || vblank == configInfo.sensorControls.end() || lineUs <= 0.0)
+		return 0;
+
+	exposureByGainLines_.clear();
+	for (const auto &[gain, us] : exposureByGainUs_)
+		exposureByGainLines_.emplace_back(gain, us / lineUs);
+
+	/*
+	 * The sensor's exposure limit (exposureMax) is the frame length less
+	 * a margin, at the vertical blanking the sensor starts with, which
+	 * drivers set to the control's default for the mode; each line of
+	 * blanking more is a line more exposure.
+	 */
+	const ControlInfo &info = vblank->second;
+	agc.vblankBase = info.def().get<int32_t>();
+	agc.vblankMax = info.max().get<int32_t>();
+	agc.exposureCap = std::min<int32_t>(std::lround(maxUs / lineUs),
+					    agc.exposureMax + (agc.vblankMax - agc.vblankBase));
+	if (agc.exposureCap <= agc.exposureMax) {
+		agc.exposureCap = 0;
+		return 0;
+	}
+	context.activeState.agc.vblank = agc.vblankBase;
+
+	LOG(IPASoftIspExposure, Info)
+		<< "The frame lengthens for exposures up to " << agc.exposureCap
+		<< " lines, over " << agc.exposureMax;
+
+	return 0;
+}
+
+/*
+ * The longest exposure (lines) the frame may be lengthened to at a gain: the
+ * tuning's exposure table's, between the frame the sensor starts with and
+ * the longest exposure to lengthen it for. Between two entries of the table,
+ * as the vendor's AEC does, it follows the gain's logarithm.
+ */
+int32_t Agc::allowedExposure(const IPAContext &context, double gain) const
+{
+	const auto &cfg = context.configuration.agc;
+	const auto &path = exposureByGainLines_;
+	if (path.empty())
+		return cfg.exposureCap;
+
+	/*
+	 * The vendor's table goes on with more gain than the sensor's analogue
+	 * gain, which there is none of here: the exposure makes up for it.
+	 */
+	if (gain >= cfg.againMax)
+		return cfg.exposureCap;
+
+	double lines;
+	if (gain <= path.front().first) {
+		lines = path.front().second;
+	} else if (gain >= path.back().first) {
+		lines = path.back().second;
+	} else {
+		auto hi = std::upper_bound(path.begin(), path.end(), gain,
+					   [](double g, const auto &p) { return g < p.first; });
+		auto lo = hi - 1;
+		const double t = std::log2(gain / lo->first) / std::log2(hi->first / lo->first);
+		lines = lo->second + (hi->second - lo->second) * t;
+	}
+
+	return std::clamp<int32_t>(std::lround(lines), cfg.exposureMax, cfg.exposureCap);
+}

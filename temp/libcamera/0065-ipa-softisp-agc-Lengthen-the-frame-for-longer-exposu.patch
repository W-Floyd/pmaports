+	/*
+	 * A lengthened frame whose exposure is longer than the tuning's table
+	 * has at the gain (the scene brightened, with the exposure still
+	 * within its tolerance, so that nothing moved it): trade the excess
+	 * for gain at the same brightness, the way along the table, and
+	 * shorten the frame to it.
+	 */
+	{
+		const auto &cfg = context.configuration.agc;
+		auto &state = context.activeState.agc;
+
+		if (cfg.exposureCap && state.vblank > cfg.vblankBase) {
+			for (int i = 0; i < 4; i++) {
+				const int32_t allowed = allowedExposure(context, again);
+				if (exposure <= allowed || again >= cfg.againMax)
+					break;
+				const double product = exposure * again;
+				exposure = allowed;
+				again = std::min(cfg.againMax, product / exposure);
+			}
+			const int32_t need = exposure > cfg.exposureMax ? exposure + exposure / 8
+								: cfg.exposureMax;
+			state.vblank = std::min(state.vblank,
+						cfg.vblankBase + (need - cfg.exposureMax));
+			exposure = std::min(exposure, cfg.exposureMax + (state.vblank - cfg.vblankBase));
+			state.exposure = exposure;
+			state.again = again;
+		}
+	}
+

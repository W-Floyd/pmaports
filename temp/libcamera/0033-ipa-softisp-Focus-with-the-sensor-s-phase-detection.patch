+/*
+ * Phase detection tuning: the module's calibration, read by the Af algorithm
+ * from the tuning file in init(). It lives outside IPASessionConfiguration,
+ * which configure() clears, as the tuning file is read only once.
+ */
+struct IPAPdafTuning {
+	/* Shading gain grids per pupil side, points corner to corner */
+	Size gainGrid;
+	std::vector<float> gainLeft;
+	std::vector<float> gainRight;
+	/*
+	 * Defocus conversion per region: lens movement in actuator codes
+	 * per image pixel of phase. The regions tile the image; the phase
+	 * is computed on the same grid.
+	 */
+	Size dccGrid;
+	std::vector<double> dcc;
+	/* The regions the algorithms use, the only ones measured */
+	std::vector<bool> regions;
+};

+/*
+ * Phase detection, with defocus as a fraction of the actuator's code range.
+ * A defocus beyond kPdafFar moves the lens straight to where the phase puts
+ * focus: at once during a contrast search, and from Idle once seen for
+ * kPdafFarFrames readings with the scene held for kPdafStableFrames (the
+ * phase does not mistake motion for defocus the way contrast does, but a
+ * moving subject is not worth chasing). The jump repeats until the defocus
+ * is within kPdafNear, at most kPdafMaxJumps times, and focus holds there:
+ * a contrast probe after it would only make the lens breathe.
+ */
+static constexpr double kPdafFar = 0.07;
+static constexpr double kPdafNear = 0.02;
+static constexpr unsigned int kPdafMaxJumps = 3;
+static constexpr unsigned int kPdafFarFrames = 3;
+static constexpr unsigned int kPdafStableFrames = 3;
+/* Regions below this confidence are ignored, unless the tuning says */
+static constexpr double kPdafMinConfidence = 0.5;
+/* The regions used: those whose centres lie in this central window */
+static constexpr double kPdafWindowStart = 0.35;
+static constexpr double kPdafWindowEnd = 0.65;

+/*
+ * The module's phase detection calibration, as vendor EEPROMs carry it:
+ *
+ *   pdaf:
+ *     gainMap:            # shading gain per pupil side, 1.0 = none
+ *       size: [ 17, 13 ]  # grid points, corner to corner of the image
+ *       left: [ ... ]     # pixels seeing the left pupil half
+ *       right: [ ... ]
+ *     dcc:                # defocus conversion per region
+ *       size: [ 8, 6 ]    # regions tiling the image
+ *       values: [ ... ]   # actuator codes per image pixel of phase
+ *     offset: 0.0         # added to the phase, in image pixels
+ *     minConfidence: 0.5  # regions below it are not used
+ *
+ * The maps are optional. Without dcc, phase detection is not used for
+ * focusing, as there is no way to turn a phase into a lens movement.
+ */
+void Af::parsePdaf(IPAContext &context, const ValueNode &pdaf)
+{
+	IPAPdafTuning &tuning = context.pdafTuning;
+	tuning = {};
+
+	pdafOffset_ = pdaf["offset"].get<double>(0.0);
+	pdafMinConf_ = pdaf["minConfidence"].get<double>(kPdafMinConfidence);
+
+	auto grid = [](const ValueNode &node, Size *size) {
+		auto s = node["size"].get<std::vector<uint32_t>>();
+		if (!s || s->size() != 2 || !(*s)[0] || !(*s)[1])
+			return false;
+		*size = Size((*s)[0], (*s)[1]);
+		return true;
+	};
+
+	const ValueNode &gainMap = pdaf["gainMap"];
+	Size gainGrid;
+	auto left = gainMap["left"].get<std::vector<double>>();
+	auto right = gainMap["right"].get<std::vector<double>>();
+	if (grid(gainMap, &gainGrid) && left && right &&
+	    left->size() == gainGrid.width * gainGrid.height &&
+	    right->size() == left->size()) {
+		tuning.gainGrid = gainGrid;
+		tuning.gainLeft.assign(left->begin(), left->end());
+		tuning.gainRight.assign(right->begin(), right->end());
+	} else if (gainMap.isDictionary()) {
+		LOG(IPASoftIspAutoFocus, Warning) << "Invalid PDAF gain map, ignored";
+	}
+
+	const ValueNode &dcc = pdaf["dcc"];
+	Size dccGrid;
+	auto values = dcc["values"].get<std::vector<double>>();
+	if (grid(dcc, &dccGrid) && values &&
+	    values->size() == dccGrid.width * dccGrid.height) {
+		tuning.dccGrid = dccGrid;
+		tuning.dcc = std::move(*values);
+	} else if (dcc.isDictionary()) {
+		LOG(IPASoftIspAutoFocus, Warning) << "Invalid PDAF DCC map, ignored";
+	}
+
+	if (!tuning.dcc.empty() && inverseMap_.empty()) {
+		LOG(IPASoftIspAutoFocus, Warning)
+			<< "The focus map is not invertible, phase detection unused";
+		tuning.dcc.clear();
+	}
+
+	/* Only the central window is used, so only it is measured. */
+	for (unsigned int ry = 0; ry < tuning.dccGrid.height && !tuning.dcc.empty(); ry++) {
+		const double cy = (ry + 0.5) / tuning.dccGrid.height;
+		for (unsigned int rx = 0; rx < tuning.dccGrid.width; rx++) {
+			const double cx = (rx + 0.5) / tuning.dccGrid.width;
+			tuning.regions.push_back(cx >= kPdafWindowStart && cx <= kPdafWindowEnd &&
+						 cy >= kPdafWindowStart && cy <= kPdafWindowEnd);
+		}
+	}
+
+	if (!tuning.dcc.empty())
+		LOG(IPASoftIspAutoFocus, Info)
+			<< "Phase detection calibration: DCC " << tuning.dccGrid
+			<< (tuning.gainLeft.empty() ? "" : ", shading gains")
+			<< ", phase offset " << pdafOffset_;
+}

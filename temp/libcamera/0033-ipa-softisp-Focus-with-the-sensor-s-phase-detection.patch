+int IPASoftIsp::mapPdafBuffers(const std::vector<IPABuffer> &buffers,
+				  const uint32_t width, const uint32_t height,
+				  const uint32_t bytesPerLine)
+{
+	if (!camHelper_ || !camHelper_->pdafLayout()) {
+		LOG(IPASoftIsp, Error) << "No PDAF layout known for this sensor";
+		return -ENOTSUP;
+	}
+
+	/* Without a defocus conversion nothing uses the phase: don't measure it */
+	if (context_.pdafTuning.dcc.empty()) {
+		LOG(IPASoftIsp, Info) << "No PDAF calibration, phase detection unused";
+		return -ENOTSUP;
+	}
+
+	const PdafLayout &layout = *camHelper_->pdafLayout();
+	const Size size = layout.bufferSize();
+	if (width < size.width || height < size.height ||
+	    bytesPerLine < (size.width * layout.bitDepth + 7) / 8) {
+		LOG(IPASoftIsp, Error)
+			<< "PD buffers " << width << "x" << height << " ("
+			<< bytesPerLine << " bytes per line) do not fit the "
+			<< size << " PDAF layout";
+		return -EINVAL;
+	}
+
+	for (const IPABuffer &buffer : buffers) {
+		const FrameBuffer fb(buffer.planes);
+		MappedFrameBuffer mapped(&fb, MappedFrameBuffer::MapFlag::Read);
+		if (!mapped.isValid()) {
+			LOG(IPASoftIsp, Error) << "Failed to map PD buffer " << buffer.id;
+			return -ENOMEM;
+		}
+		pdafBuffers_.emplace(buffer.id, std::move(mapped));
+	}
+
+	pdafBytesPerLine_ = bytesPerLine;
+
+	/*
+	 * Measure the phase on the grid of the module's defocus conversion
+	 * map, so that each region has its own coefficient; without one, on
+	 * a coarse grid of its own.
+	 */
+	const IPAPdafTuning &tuning = context_.pdafTuning;
+	const Size grid = tuning.dcc.empty() ? Size(4, 3) : tuning.dccGrid;
+	pdafPhase_ = std::make_unique<PdafPhase>(layout, grid);
+
+	if (!tuning.gainLeft.empty() &&
+	    pdafPhase_->setShading(tuning.gainGrid, tuning.gainLeft, tuning.gainRight))
+		LOG(IPASoftIsp, Warning) << "Ignoring the PDAF shading gains";
+
+	/* Measure only the regions the algorithms use, it is costly */
+	if (!tuning.regions.empty())
+		pdafPhase_->setActiveRegions(tuning.regions);
+
+	LOG(IPASoftIsp, Info)
+		<< "Phase detection on " << buffers.size() << " buffers, "
+		<< grid << " regions" << (tuning.gainLeft.empty() ? "" : ", shading corrected");
+
+	return 0;
+}
+
+void IPASoftIsp::unmapPdafBuffers(const std::vector<unsigned int> &ids)
+{
+	for (unsigned int id : ids)
+		pdafBuffers_.erase(id);
+
+	if (pdafBuffers_.empty())
+		pdafPhase_.reset();
+}
+
+void IPASoftIsp::processPdaf(const uint32_t frame, const uint32_t bufferId)
+{
+	auto it = pdafBuffers_.find(bufferId);
+
+	if (it != pdafBuffers_.end() && pdafPhase_) {
+		const auto start = std::chrono::steady_clock::now();
+		Span<uint8_t> data = it->second.planes()[0];
+		int ret = pdafPhase_->process(Span<const uint8_t>(data.data(), data.size()),
+					      pdafBytesPerLine_);
+		const auto took = std::chrono::steady_clock::now() - start;
+
+		auto &pdaf = context_.activeState.pdaf;
+		pdaf.valid = !ret;
+		pdaf.frame = frame;
+		pdaf.grid = pdafPhase_->grid();
+		pdaf.regions = pdafPhase_->regions();
+		pdaf.pitch = camHelper_->pdafLayout()->blockSize.width;
+
+		PdafData all = pdafPhase_->combined();
+		LOG(IPASoftIsp, Debug)
+			<< "PD frame " << frame << ": phase " << all.phase
+			<< " conf " << all.conf << ", measured in "
+			<< std::chrono::duration_cast<std::chrono::microseconds>(took).count()
+			<< " us";
+	}
+
+	pdafProcessed.emit(bufferId);
+}

From a81dbf9311fd5a5a6a59f2ea3f57c52a185a9162 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sat, 26 Sep 2026 17:33:44 +0000
Subject: [PATCH 59/76] camss: Give the IPA one phase detection buffer at a
 time

The IPA measures the phase in the thread that also processes the
statistics. Queueing every PD buffer to it lets a backlog build up
whenever measuring takes longer than a frame, delaying exposure, white
balance and focus behind results that are stale by then. Hand it a
buffer only when it has none, and queue the ones that complete meanwhile
straight back to the device.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/libcamera/pipeline/camss/camss.cpp | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/libcamera/pipeline/camss/camss.cpp b/src/libcamera/pipeline/camss/camss.cpp
index e1f6f40c5..c5d99949a 100644
--- a/src/libcamera/pipeline/camss/camss.cpp
+++ b/src/libcamera/pipeline/camss/camss.cpp
@@ -83,6 +83,9 @@ public:
 	/* The last focus position sent to the lens, for parking it at stop. */
 	std::optional<int32_t> lastFocusPosition_;
 
+	/* A PD buffer is with the IPA: newer ones are skipped meanwhile. */
+	bool pdafInFlight_ = false;
+
 	/* Requests for which no buffer has been queued to the CSI receiver yet. */
 	std::queue<Request *> pendingRequests_;
 };
@@ -494,20 +497,30 @@ void CamssCameraData::stopPdaf()
 	csi_->stopPdafStream();
 	isp_->unmapPdafBuffers(csi_->pdafBuffers());
 	csi_->freePdafBuffers();
+	pdafInFlight_ = false;
 }
 
+/*
+ * The IPA gets one PD buffer at a time, the newest: one that completes while
+ * it is still busy is skipped. Measuring the phase is costly, and a backlog
+ * would delay the statistics the IPA processes in the same thread, and with
+ * them exposure and white balance, for results that are stale anyway.
+ */
 void CamssCameraData::pdafBufferReady(FrameBuffer *buffer)
 {
-	if (buffer->metadata().status != FrameMetadata::FrameSuccess) {
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess ||
+	    pdafInFlight_) {
 		csi_->queuePdafBuffer(buffer->cookie());
 		return;
 	}
 
+	pdafInFlight_ = true;
 	isp_->processPdaf(buffer->metadata().sequence, buffer->cookie());
 }
 
 void CamssCameraData::pdafProcessed(unsigned int bufferId)
 {
+	pdafInFlight_ = false;
 	csi_->queuePdafBuffer(bufferId);
 }
 

index 62c7bba2e..110035d77 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -69,6 +69,23 @@ uniform vec3 awb;
 uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform sampler2D tone_lut;
+uniform sampler2D lsc;
+uniform float lsc_enabled;
+
+/*
+ * Lens shading gains at a position in the image (0 to 1 from corner to
+ * corner): the LSC_WIDTH x LSC_HEIGHT grid's points sit at its texel
+ * centres, interpolated by linear filtering. A texel reads 0 to 1 (the
+ * stored value over the storage type's maximum) for gains of 1 to
+ * 1 + LSC_GAIN_RANGE.
+ */
+vec3 lens_shading(vec2 pos)
+{
+	vec2 grid = vec2(LSC_WIDTH, LSC_HEIGHT);
+	vec2 uv = (clamp(pos, 0.0, 1.0) * (grid - 1.0) + 0.5) / grid;
+	vec3 gain = 1.0 + texture2D(lsc, uv).rgb * LSC_GAIN_RANGE;
+	return mix(vec3(1.0), gain, lsc_enabled);
+}
 
 #if defined (QUAD_BAYER)

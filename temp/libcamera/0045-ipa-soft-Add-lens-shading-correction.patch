@@ -151,6 +153,15 @@ int DebayerEGL::initBayerShaders(PixelFormat inputFormat, PixelFormat outputForm
 					std::to_string(DebayerParams::kToneLutSize) + ".0";
 	egl_.pushEnv(shaderEnv, toneLutSize.c_str());
 
+	/* The lens shading grid's size and gain encoding */
+	const std::string lscDefines[] = {
+		"#define LSC_WIDTH " + std::to_string(DebayerParams::kLscWidth) + ".0",
+		"#define LSC_HEIGHT " + std::to_string(DebayerParams::kLscHeight) + ".0",
+		"#define LSC_GAIN_RANGE " + std::to_string(DebayerParams::kLscGainMax - 1.0f),
+	};
+	for (const std::string &define : lscDefines)
+		egl_.pushEnv(shaderEnv, define.c_str());
+
 	/*
 	 * Tell shaders how to re-order output taking account of how the pixels
 	 * are actually stored by EGL.
@@ -512,6 +523,29 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	egl_.activateBindTexture(*toneLut_);
 	glUniform1i(toneLutUniform_, toneLut_->texture_unit_uniform_id_);
 
+	/*
+	 * Lens shading: a grid-sized RGB texture, uploaded when it changes and
+	 * sampled with linear filtering for the interpolation between grid
+	 * points. Rows are 3 bytes per point, so drop the 4 byte alignment.
+	 */
+	if (!lsc_) {
+		lscData_ = params.lsc;
+		lsc_ = std::make_unique<eGLImage>(GL_RGB, DebayerParams::kLscWidth,
+						  DebayerParams::kLscHeight,
+						  DebayerParams::kLscWidth * 3, GL_TEXTURE3, 3);
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+		egl_.createTexture2D(*lsc_, lscData_.data());
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	} else if (params.lscEnabled && params.lsc != lscData_) {
+		lscData_ = params.lsc;
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+		egl_.updateTexture2D(*lsc_, lscData_.data());
+	}
+	egl_.activateBindTexture(*lsc_);
+	glUniform1i(lscUniform_, lsc_->texture_unit_uniform_id_);
+	glUniform1f(lscEnabledUniform_, params.lscEnabled ? 1.0f : 0.0f);
+
 	return;
 }
 

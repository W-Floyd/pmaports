+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * Noise reduction
+ */
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "algorithm.h"
+#include "lux.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Denoise : public Algorithm
+{
+public:
+	Denoise() = default;
+	~Denoise() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	/* The adaptive Bayer filter's tuning at one gain region */
+	struct Region {
+		double noise;
+		std::array<double, 2> strengthLo;
+		std::array<double, 2> strengthHi;
+		double anchorLo;
+		double anchorHi;
+	};
+
+	/* The gain regions' ranges, for blending across the gaps */
+	std::vector<ipa::soft::LuxRange> ranges_;
+	std::vector<Region> regions_;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */

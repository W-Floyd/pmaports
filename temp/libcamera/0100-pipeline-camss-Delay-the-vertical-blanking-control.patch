From 4dbc55e6d731e4a9b489216332f463e3ac17c618 Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 15:01:39 +0000
Subject: [PATCH 100/101] pipeline: camss: Delay the vertical blanking control

The software ISP lengthens the frame for longer exposures, and the
exposure has to follow the frame length it depends on: write the blanking
ahead, as the other pipelines do.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/libcamera/pipeline/camss/camss.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/libcamera/pipeline/camss/camss.cpp b/src/libcamera/pipeline/camss/camss.cpp
index cec8b7e96..398e89d30 100644
--- a/src/libcamera/pipeline/camss/camss.cpp
+++ b/src/libcamera/pipeline/camss/camss.cpp
@@ -680,6 +680,12 @@ bool PipelineHandlerCamss::match(DeviceEnumerator *enumerator)
 			{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
 			{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
 		};
+		/*
+		 * The frame length, which the software ISP lengthens for longer
+		 * exposures: written ahead of the exposure that depends on it.
+		 */
+		if (sensor->device()->controls().count(V4L2_CID_VBLANK))
+			params[V4L2_CID_VBLANK] = { delays.vblankDelay, true };
 
 		data->delayedCtrls_ =
 			std::make_unique<DelayedControls>(sensor->device(), params);
-- 

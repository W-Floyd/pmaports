From 098430ccd7045389da40adf167c2e78c1c43fedf Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Thu, 8 Oct 2026 15:12:22 +0000
Subject: [PATCH] ipa: soft: agc: Allow the longest exposure at the maximum
 gain

The tuning's exposure table goes on to more gain than the sensor's analogue
gain, and to longer exposures with it. Where the gain is at its maximum
there is none left to raise, so the exposure takes the rest of the way.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ipa/soft/algorithms/agc.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/ipa/soft/algorithms/agc.cpp b/src/ipa/soft/algorithms/agc.cpp
index c32a069fb..d0ad5eb31 100644
--- a/src/ipa/soft/algorithms/agc.cpp
+++ b/src/ipa/soft/algorithms/agc.cpp
@@ -439,6 +439,13 @@ int32_t Agc::allowedExposure(const IPAContext &context, double gain) const
 	if (path.empty())
 		return cfg.exposureCap;
 
+	/*
+	 * The vendor's table goes on with more gain than the sensor's analogue
+	 * gain, which there is none of here: the exposure makes up for it.
+	 */
+	if (gain >= cfg.againMax)
+		return cfg.exposureCap;
+
 	double lines;
 	if (gain <= path.front().first) {
 		lines = path.front().second;
-- 

-int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+/**
+ * \brief Build the debayer's tone lookup table
+ * \param[in] gamma The display gamma, e.g. 2.2, used when \a curve is null
+ * \param[in] contrastExp Exponent of the contrast S-curve, 1 for none
+ * \param[in] curve A tone curve mapping [0, 1] to [0, 1], or nullptr
+ *
+ * The contrast S-curve is applied first, then either \a curve or the gamma
+ * encoding x^(1/gamma).
+ *
+ * \return The tone lookup table
+ */
+ToneLut toneLut(float gamma, float contrastExp, const ipa::Pwl *curve)
+{
+	ToneLut lut;
+	const double last = lut.size() - 1.0;
+
+	for (unsigned int i = 0; i < lut.size(); i++) {
+		double x = i / last;
+
+		/* Simple S-curve around mid-grey */
+		if (x < 0.5)
+			x = 0.5 * std::pow(x / 0.5, contrastExp);
+		else
+			x = 1.0 - 0.5 * std::pow((1.0 - x) / 0.5, contrastExp);
+
+		double y = curve ? curve->eval(curve->domain().clamp(x))
+				 : std::pow(x, 1.0 / gamma);
+		lut[i] = std::lround(std::clamp(y, 0.0, 1.0) * UINT8_MAX);
+	}
+
+	return lut;
+}
+
+/**
+ * \brief Initialise the Adjust algorithm
+ *
+ * The tuning data may contain a tone curve, "toneCurve", as a piecewise
+ * linear function in libipa's Pwl format: a flat list of x, y pairs, both
+ * in [0, 1], mapping linear light (after colour correction) to the encoded
+ * output value. It replaces the gamma encoding unless the application sets
+ * the Gamma control.
+ */
+int Adjust::init(IPAContext &context, const ValueNode &tuningData)
 {
 	context.ctrlMap[&controls::Gamma] =
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
@@ -33,6 +78,15 @@ int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningDa
 	if (context.ccmEnabled)
 		context.ctrlMap[&controls::Saturation] =
 			ControlInfo(0.0f, 2.0f, kDefaultSaturation);
+
+	auto curve = tuningData["toneCurve"].get<ipa::Pwl>();
+	if (curve && !curve->empty()) {
+		curve_ = std::move(*curve);
+		LOG(IPASoftIspAdjust, Info)
+			<< "Using the tuning file's tone curve ("
+			<< curve_.size() << " points)";
+	}
+
 	return 0;
 }
 
@@ -42,6 +96,8 @@ int Adjust::configure(IPAContext &context,
 	context.activeState.knobs.gamma = kDefaultGamma;
 	context.activeState.knobs.contrast = std::optional<float>();
 	context.activeState.knobs.saturation = std::optional<float>();
+	gammaSet_ = false;
+	lutValid_ = false;
 
 	return 0;
 }
@@ -54,6 +110,7 @@ void Adjust::queueRequest(typename Module::Context &context,
 	const auto &gamma = controls.get(controls::Gamma);
 	if (gamma.has_value()) {

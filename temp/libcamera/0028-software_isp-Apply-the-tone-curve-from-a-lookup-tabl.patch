+		gammaSet_ = true;
 		LOG(IPASoftIspAdjust, Debug) << "Setting gamma to " << gamma.value();
 	}
 
@@ -106,9 +163,21 @@ void Adjust::prepare(IPAContext &context,
 		frameContext.saturation = saturation;
 	}
 
-	params->gamma = 1.0 / context.activeState.knobs.gamma;
+	const float gamma = context.activeState.knobs.gamma;
 	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
-	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+	/* Map contrast 0..2 to an exponent 0..infinity, avoiding tan(pi/2). */
+	const float contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+	const bool fromCurve = !curve_.empty() && !gammaSet_;
+
+	if (!lutValid_ || gamma != lutGamma_ || contrastExp != lutContrastExp_ ||
+	    fromCurve != lutFromCurve_) {
+		lut_ = toneLut(gamma, contrastExp, fromCurve ? &curve_ : nullptr);
+		lutGamma_ = gamma;
+		lutContrastExp_ = contrastExp;
+		lutFromCurve_ = fromCurve;
+		lutValid_ = true;
+	}
+	params->toneLut = lut_;
 }
 

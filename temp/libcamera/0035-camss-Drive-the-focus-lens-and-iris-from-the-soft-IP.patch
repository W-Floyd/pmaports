-void CamssCameraData::setSensorControls(const ControlList &sensorControls)
+void CamssCameraData::setSensorControls(const ControlList &sensorControls,
+					const ControlList &lensControls,
+					const ControlList &irisControls)
 {
 	delayedCtrls_->push(sensorControls);
 
+	/*
+	 * The focus lens and the iris are separate sub-devices, not subject to
+	 * the delayed controls the sensor needs, so drive them directly.
+	 */
+	CameraLens *focusLens = csi_->sensor()->focusLens();
+	if (focusLens && lensControls.contains(V4L2_CID_FOCUS_ABSOLUTE)) {
+		lastFocusPosition_ = lensControls.get(V4L2_CID_FOCUS_ABSOLUTE).get<int32_t>();
+		focusLens->setFocusPosition(*lastFocusPosition_);
+	}
+
+	CameraLens *irisLens = csi_->sensor()->irisLens();
+	if (irisLens && irisControls.contains(V4L2_CID_IRIS_ABSOLUTE))
+		irisLens->setIrisPosition(
+			irisControls.get(V4L2_CID_IRIS_ABSOLUTE).get<int32_t>());
+
 	/*
 	 * Directly apply controls now if there is no frameStart signal.
 	 *

+/*
+ * Park the focus lens. The lens subdevice stays open for as long as the
+ * camera manager lives, so a VCM driver never runtime-suspends and a lens
+ * left mid-travel keeps drawing coil current until the next capture. The IPA
+ * is stopped by now and cannot move it again.
+ *
+ * Ramp down rather than jump: at the bottom of its travel a VCM has no coil
+ * current, and a lens dropped there from mid-travel lands on its end stop
+ * with an audible click.
+ */
+void CamssCameraData::parkFocusLens()
+{
+	CameraLens *focusLens = csi_->sensor()->focusLens();
+	if (!focusLens)
+		return;
+
+	const ControlInfoMap &lensInfo = focusLens->controls();
+	auto it = lensInfo.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == lensInfo.end())
+		return;
+
+	const int32_t park = it->second.min().get<int32_t>();
+	constexpr int32_t kParkStep = 16;
+	int32_t pos = lastFocusPosition_.value_or(park);
+
+	while (pos - kParkStep > park) {
+		pos -= kParkStep;
+		focusLens->setFocusPosition(pos);
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+	focusLens->setFocusPosition(park);
+	lastFocusPosition_ = park;
+}

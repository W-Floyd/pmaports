+/**
+ * \brief Collect the control maps the soft IPA drives for a sensor
+ * \param[in] sensor The camera sensor
+ *
+ * The focus lens and the iris are separate sub-devices with their own
+ * control maps. A sensor without them gets empty maps, so that the IPA does
+ * not offer their controls.
+ */
+ipa::softisp::IPAConfigInfo camssSoftIpaConfigInfo(CameraSensor *sensor)
+{
+	ipa::softisp::IPAConfigInfo info;
+
+	info.sensorControls = sensor->controls();
+	CameraLens *focusLens = sensor->focusLens();
+	info.lensControls = focusLens ? focusLens->controls() : ControlInfoMap();
+	CameraLens *irisLens = sensor->irisLens();
+	info.irisControls = irisLens ? irisLens->controls() : ControlInfoMap();
+
+	return info;
+}
+
 } /* namespace libcamera */

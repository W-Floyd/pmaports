diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
new file mode 100644
index 000000000..478a9429e
--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -0,0 +1,675 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2025 Vasiliy Doylov <nekodevelopper@gmail.com>
+ *
+ * Auto focus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <stdint.h>
+#include <utility>
+
+#include <libcamera/base/log.h>
+#include "libcamera/base/utils.h"
+
+#include "libipa/pwl.h"
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftIspAutoFocus)
+
+namespace ipa::softisp::algorithms {
+
+/*
+ * The AF modes this algorithm implements. AfModeAuto is deliberately absent:
+ * it requires a one-shot scan that ends in AfStateFocused and stays there,
+ * which the search below does not distinguish from continuous operation.
+ * AfTrigger remains available to force a fresh scan in continuous mode.
+ */
+static const std::array<ControlValue, 2> kAfModeValues{
+	ControlValue(static_cast<int32_t>(controls::AfModeManual)),
+	ControlValue(static_cast<int32_t>(controls::AfModeContinuous)),
+};
+
+static const std::array<ControlValue, 2> kAfTriggerValues{
+	ControlValue(static_cast<int32_t>(controls::AfTriggerStart)),
+	ControlValue(static_cast<int32_t>(controls::AfTriggerCancel)),
+};
+
+/*
+ * All focus positions in this algorithm are in dioptres (reciprocal metres),
+ * as controls::LensPosition specifies: 0 is infinity and larger values focus
+ * closer. They are converted to actuator codes only in updateFocus(), through
+ * the piecewise-linear map_ read from the tuning file. This follows the
+ * Raspberry Pi IPA, whose tuning files use the same "map" schema.
+ */
+
+/*
+ * Fallback used when the tuning file supplies no map. The actuator's full
+ * travel is assumed to span infinity to 10 cm, linearly. This is a guess: real
+ * modules usually cannot reach infinity at one end of the travel, so distances
+ * reported under this default are not trustworthy. Calibrate and put a "map"
+ * in the sensor's tuning file to fix that.
+ */
+static constexpr double kUncalibratedMaxDioptres = 10.0;
+
+/* A general-purpose resting position, used if the tuning file names none. */
+static constexpr double kFallbackDefaultDioptres = 1.0;
+
+/*
+ * The coarse scan for first focus, AfTrigger and a flat probe: this many
+ * evenly spaced points, stopping early once sharpness has fallen kScanFall
+ * below the best point two or more points back.
+ */
+static constexpr unsigned int kScanPoints = 9;
+static constexpr double kScanFall = 0.40;
+
+/*
+ * Hill climbing, all as fractions of the focus range. A change in sharpness
+ * counts only when it exceeds kNoise, relative: the statistic is normalised
+ * by brightness, but frame-to-frame noise remains.
+ */
+static constexpr double kProbeStepFine = 0.02;	 /* refocus after a small drop */
+static constexpr double kProbeStepCoarse = 0.06; /* after a big drop */
+static constexpr double kClimbStepMax = 0.15;
+static constexpr double kRefineStepMin = 0.005;
+static constexpr double kNoise = 0.04;
+
+/*
+ * A probe calls the centre a peak only if both sides fall by twice the
+ * noise: well out of focus the curve is broad, and a small step either
+ * side of a defocused lens otherwise reads as "both a little worse".
+ */
+static constexpr double kPeakDrop = 2 * kNoise;
+
+/*
+ * Focus is lost when sharpness stays kLostDrop below the reference; a drop
+ * beyond kBigDrop starts with the coarse probe, as the lens is likely far
+ * from the new peak.
+ */
+static constexpr double kLostDrop = 0.20;
+static constexpr double kBigDrop = 0.50;
+static constexpr unsigned int kLostFrames = 5;
+
+/*
+ * Contrast AF cannot tell defocus from motion or an exposure step, so, as
+ * contrast continuous-AF implementations generally do, a drop or a scene
+ * change only arms a refocus, which runs once the scene has held still
+ * (frame-to-frame signature change under kSceneStill) for kStableFrames.
+ * A scene counts as changed from the focused one beyond kSceneChanged.
+ * For kCooldownFrames after focusing only a big drop arms a refocus. The
+ * reference follows slow drift at kReferenceRate a frame.
+ */
+static constexpr double kSceneStill = 0.03;
+static constexpr double kSceneChanged = 0.25;
+static constexpr unsigned int kStableFrames = 10;
+static constexpr unsigned int kCooldownFrames = 30;
+static constexpr double kReferenceRate = 0.05;
+
+/*
+ * Frames to discard after a move before measuring: requests already in
+ * flight were exposed at the old position. A move larger than
+ * kLargeMove also needs the lens itself to settle.
+ */
+static constexpr unsigned int kSettleSmall = 3;
+static constexpr unsigned int kSettleLarge = 5;
+static constexpr double kLargeMove = 0.08;
+static constexpr unsigned int kMeasureFrames = 2;
+
+Af::Af()
+{
+}
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const int32_t codeMin = context.configuration.focus.focus_min;
+	const int32_t codeMax = context.configuration.focus.focus_max;
+
+	/*
+	 * Don't advertise any focus control when the sensor has no actuator,
+	 * so that applications hide their focus UI instead of offering a
+	 * slider that cannot move anything.
+	 */
+	if (codeMax <= codeMin) {
+		LOG(IPASoftIspAutoFocus, Info)
+			<< "No focus actuator, not registering focus controls";
+		return 0;
+	}
+
+	/*
+	 * The map takes dioptres to actuator codes. Its format matches the
+	 * Raspberry Pi IPA's "rpi.af" map, a flat list of x,y pairs, so a
+	 * calibration measured for one can be transcribed to the other.
+	 */
+	auto map = tuningData["map"].get<ipa::Pwl>();
+	if (map.has_value() && !map->empty()) {
+		map_ = std::move(map.value());
+	} else {
+		LOG(IPASoftIspAutoFocus, Warning)
+			<< "No focus map in the tuning file, assuming the actuator"
+			<< " spans infinity to " << 100.0 / kUncalibratedMaxDioptres
+			<< "cm linearly; reported focus distances will be wrong";
+		map_.append(0.0, codeMin);
+		map_.append(kUncalibratedMaxDioptres, codeMax);
+	}
+
+	dioptresMin_ = map_.domain().start;
+	dioptresMax_ = map_.domain().end;
+	dioptresDef_ = std::clamp(kFallbackDefaultDioptres, dioptresMin_, dioptresMax_);
+
+	/* An explicit range overrides the map's own domain. */
+	const ValueNode &range = tuningData["range"];
+	auto min = range["min"].get<double>();
+	auto max = range["max"].get<double>();
+	if (min.has_value() && max.has_value() && max.value() > min.value()) {
+		dioptresMin_ = min.value();
+		dioptresMax_ = max.value();
+	}
+	auto def = range["default"].get<double>();
+	dioptresDef_ = std::clamp(def.value_or(dioptresDef_),
+				  dioptresMin_, dioptresMax_);
+
+	LOG(IPASoftIspAutoFocus, Info)
+		<< "Focus range " << dioptresMin_ << ".." << dioptresMax_
+		<< " dioptres (actuator codes " << lensCode(dioptresMin_)
+		<< ".." << lensCode(dioptresMax_) << "), default " << dioptresDef_;
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(kAfModeValues,
+			    ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(static_cast<float>(dioptresMin_),
+			    static_cast<float>(dioptresMax_),
+			    static_cast<float>(dioptresDef_));
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(kAfTriggerValues,
+			    ControlValue(static_cast<int32_t>(controls::AfTriggerStart)));
+	return 0;
+}
+
+/* Convert a position in dioptres to an actuator code. */
+int32_t Af::lensCode(double dioptres) const
+{
+	return static_cast<int32_t>(std::lround(map_.eval(map_.domain().clamp(dioptres))));
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	context.activeState.knobs.focus_sweep = false;
+	context.activeState.knobs.focus_pos = dioptresDef_;
+	context.activeState.knobs.af_mode = controls::AfModeContinuous;
+	context.configuration.focus.skip = 10;
+
+	/* Acquire focus from the first frames (reference_ 0, see step()). */
+	state_ = State::Idle;
+	settle_ = kSettleLarge;
+	reference_ = 0.0;
+	lostFrames_ = 0;
+	sinceFocus_ = 0;
+	armed_ = false;
+	stableFrames_ = 0;
+	exposure_ = 0.0;
+	hist_.fill(0.0);
+	return 0;
+}
+
+bool Af::isManual(const IPAContext &context) const
+{
+	return context.activeState.knobs.af_mode.value_or(controls::AfModeContinuous) ==
+	       controls::AfModeManual;
+}
+
+void Af::queueRequest(typename Module::Context &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] typename Module::FrameContext &frameContext,
+		      const ControlList &controls)
+{
+	const auto &af_mode = controls.get(controls::AfMode);
+	const auto &focus_pos = controls.get(controls::LensPosition);
+	const auto &af_trigger = controls.get(controls::AfTrigger);
+
+	if (af_mode.has_value()) {
+		const bool wasManual = isManual(context);
+		context.activeState.knobs.af_mode = af_mode.value();
+
+		if (isManual(context) != wasManual) {
+			if (isManual(context)) {
+				/*
+				 * Abandon any search in progress and hold the
+				 * position the lens is at, until the
+				 * application supplies one of its own.
+				 */
+				context.activeState.knobs.focus_sweep = false;
+				context.configuration.focus.skip = 10;
+				state_ = State::Idle;
+				LOG(IPASoftIspAutoFocus, Info) << "Switched to manual focus";
+			} else {
+				LOG(IPASoftIspAutoFocus, Info) << "Switched to continuous focus";
+				restart(context);
+			}
+		}
+	}
+
+	if (focus_pos.has_value()) {
+		const double pos = std::clamp(static_cast<double>(focus_pos.value()),
+					      dioptresMin_, dioptresMax_);
+		context.activeState.knobs.focus_pos = pos;
+		context.configuration.focus.skip = 10;
+		LOG(IPASoftIspAutoFocus, Debug)
+			<< "Setting focus position to " << pos << " dioptres (code "
+			<< lensCode(pos) << ")";
+	}
+
+	/*
+	 * AfTrigger is specified to apply to AfModeAuto only, which this
+	 * algorithm does not implement. Honour it in continuous mode anyway,
+	 * where forcing a fresh scan is useful, and ignore it in manual mode
+	 * as the specification requires.
+	 */
+	if (af_trigger.has_value() && !isManual(context)) {
+		if (af_trigger.value() == controls::AfTriggerStart) {
+			if (!context.activeState.knobs.focus_sweep.value_or(false))
+				restart(context);
+		} else {
+			/*
+			 * Cancel: hold wherever the lens currently is, and
+			 * take the next frame as the new reference.
+			 */
+			context.activeState.knobs.focus_sweep = false;
+			state_ = State::Idle;
+			reference_ = -1.0;
+			LOG(IPASoftIspAutoFocus, Info) << "Focus scan cancelled";
+		}
+	}
+}
+
+  /*
+    megapixels:
+
+    if sharpness goes to >2* best or <0.6* best, we restart
+
+    we step by 10. if sharpness goes to <0.8* or we go to the end of range, we return to the best point (-10)
+  */
+
+void Af::updateFocus([[maybe_unused]] IPAContext &context, [[maybe_unused]] IPAFrameContext &frameContext, [[maybe_unused]] double exposureMSV)
+{
+	const double pos = context.activeState.knobs.focus_pos.value_or(dioptresDef_);
+
+	frameContext.lens.focus_pos =
+		std::clamp(lensCode(pos),
+			   context.configuration.focus.focus_min,
+			   context.configuration.focus.focus_max);
+}
+
+void Af::moveTo(IPAContext &context, double dioptres)
+{
+	const double range = dioptresMax_ - dioptresMin_;
+	double &pos = context.activeState.knobs.focus_pos.value();
+	dioptres = std::clamp(dioptres, dioptresMin_, dioptresMax_);
+
+	settle_ = std::abs(dioptres - pos) > range * kLargeMove ? kSettleLarge
+								  : kSettleSmall;
+	measureFrames_ = kMeasureFrames;
+	pos = dioptres;
+	acc_ = 0.0;
+	accCount_ = 0;
+}
+
+void Af::restart(IPAContext &context)
+{
+	startScan(context);
+}
+
+/*
+ * A fast coarse scan: kScanPoints positions across the range, one frame
+ * each, starting from the end nearer the lens. It stops early once
+ * sharpness has fallen well below the best point seen, as the peak is then
+ * behind it, and hands the best point to Refine.
+ */
+void Af::startScan(IPAContext &context)
+{
+	const double pos = context.activeState.knobs.focus_pos.value_or(dioptresDef_);
+
+	scanStep_ = (dioptresMax_ - dioptresMin_) / (kScanPoints - 1);
+	scanDir_ = pos <= (dioptresMin_ + dioptresMax_) / 2 ? 1.0 : -1.0;
+	scanStart_ = scanDir_ > 0 ? dioptresMin_ : dioptresMax_;
+	scanIndex_ = 0;
+	scanBestIndex_ = 0;
+	bestSharp_ = 0.0;
+	bestPos_ = scanStart_;
+	state_ = State::Scan;
+	context.activeState.knobs.focus_sweep = true;
+	moveTo(context, scanStart_);
+	measureFrames_ = 1;
+	LOG(IPASoftIspAutoFocus, Info) << "Scanning for focus";
+}
+
+void Af::scanStep(IPAContext &context, double sharp)
+{
+	const double pos = context.activeState.knobs.focus_pos.value();
+
+	if (sharp > bestSharp_) {
+		bestSharp_ = sharp;
+		bestPos_ = pos;
+		scanBestIndex_ = scanIndex_;
+	}
+	scanIndex_++;
+
+	const bool pastPeak = scanIndex_ - scanBestIndex_ >= 2 &&
+			      sharp < bestSharp_ * (1.0 - kScanFall);
+	if (scanIndex_ < kScanPoints && !pastPeak) {
+		moveTo(context, scanStart_ + scanDir_ * scanIndex_ * scanStep_);
+		settle_ = kSettleSmall;
+		measureFrames_ = 1;
+		return;
+	}
+
+	LOG(IPASoftIspAutoFocus, Debug)
+		<< "Scan best " << bestPos_ << " dioptres after "
+		<< scanIndex_ << " points";
+	climbStep_ = scanStep_ / 2.0;
+	probeIndex_ = 1;
+	state_ = State::Refine;
+	moveTo(context, bestPos_ + climbStep_);
+}
+
+void Af::startProbe(IPAContext &context, double stepFraction)
+{
+	probeFraction_ = stepFraction;
+	probeStep_ = (dioptresMax_ - dioptresMin_) * stepFraction;
+	centre_ = context.activeState.knobs.focus_pos.value_or(dioptresDef_);
+	probeIndex_ = 0;
+	state_ = State::Probe;
+	context.activeState.knobs.focus_sweep = true;
+	moveTo(context, centre_);
+	LOG(IPASoftIspAutoFocus, Debug)
+		<< "Probing +-" << probeStep_ << " dioptres around " << centre_;
+}
+
+/* Hold the given position as focused, with its sharpness as reference. */
+void Af::settle(IPAContext &context, double dioptres, double sharp)
+{
+	state_ = State::Idle;
+	context.activeState.knobs.focus_sweep = false;
+	moveTo(context, dioptres);
+	reference_ = sharp;
+	lostFrames_ = 0;
+	sinceFocus_ = 0;
+	armed_ = false;
+	focusHist_ = hist_;
+	focusExposure_ = exposure_;
+	LOG(IPASoftIspAutoFocus, Info)
+		<< "Focused at " << dioptres << " dioptres (code "
+		<< lensCode(dioptres) << "), sharpness " << sharp;
+}
+
+/* A measurement at the current position is complete. */
+void Af::measured(IPAContext &context, double sharp)
+{
+	const double pos = context.activeState.knobs.focus_pos.value();
+	const double range = dioptresMax_ - dioptresMin_;
+
+	switch (state_) {
+	case State::Idle:
+		break;
+
+	case State::Scan:
+		scanStep(context, sharp);
+		break;
+
+	case State::Probe:
+		if (probeIndex_ == 0) {
+			centreSharp_ = sharp;
+			probeIndex_ = 1;
+			moveTo(context, centre_ + probeStep_);
+			break;
+		}
+		if (probeIndex_ == 1) {
+			/* At the end of travel there is no plus side to measure. */
+			plusSharp_ = pos > centre_ ? sharp : 0.0;
+			probeIndex_ = 2;
+			moveTo(context, centre_ - probeStep_);
+			break;
+		}
+
+		{
+			const double minusSharp = pos < centre_ ? sharp : 0.0;
+			const double better = centreSharp_ * (1.0 + kNoise);
+			const double worse = centreSharp_ * (1.0 - kPeakDrop);
+
+			if (plusSharp_ > better || minusSharp > better) {
+				const bool plus = plusSharp_ >= minusSharp;
+				dir_ = plus ? 1.0 : -1.0;
+				bestPos_ = std::clamp(centre_ + dir_ * probeStep_,
+						      dioptresMin_, dioptresMax_);
+				bestSharp_ = plus ? plusSharp_ : minusSharp;
+				climbStep_ = probeStep_ * 2.0;
+				state_ = State::Climb;
+				moveTo(context, bestPos_ + dir_ * climbStep_);
+			} else if ((plusSharp_ <= 0.0 || plusSharp_ < worse) &&
+				   (minusSharp <= 0.0 || minusSharp < worse)) {
+				/*
+				 * Clearly worse on every side there is (one
+				 * side is missing at the end of travel): the
+				 * centre is the peak.
+				 */
+				settle(context, centre_, centreSharp_);
+			} else if (probeFraction_ < kProbeStepCoarse) {
+				/* Flat at a small step: look wider before scanning. */
+				context.activeState.knobs.focus_pos = centre_;
+				startProbe(context, kProbeStepCoarse);
+			} else {
+				startScan(context);
+			}
+		}
+		break;
+
+	case State::Climb:
+		if (sharp > bestSharp_) {
+			const bool atEnd = pos <= dioptresMin_ || pos >= dioptresMax_;
+			bestPos_ = pos;
+			bestSharp_ = sharp;
+			if (atEnd) {
+				settle(context, bestPos_, bestSharp_);
+				break;
+			}
+			climbStep_ = std::min(climbStep_ * 1.5, range * kClimbStepMax);
+			moveTo(context, pos + dir_ * climbStep_);
+			break;
+		}
+
+		/* Past the peak: it lies within a step either side of bestPos_. */
+		climbStep_ /= 2.0;
+		probeIndex_ = 1;
+		state_ = State::Refine;
+		moveTo(context, bestPos_ + climbStep_);
+		break;
+
+	case State::Refine:
+		if (sharp > bestSharp_) {
+			bestSharp_ = sharp;
+			bestPos_ = pos;
+		}
+		if (probeIndex_ == 1) {
+			probeIndex_ = 2;
+			moveTo(context, bestPos_ - climbStep_);
+			break;
+		}
+
+		climbStep_ /= 2.0;
+		if (climbStep_ < range * kRefineStepMin) {
+			settle(context, bestPos_, bestSharp_);
+			break;
+		}
+		probeIndex_ = 1;
+		moveTo(context, bestPos_ + climbStep_);
+		break;
+	}
+}
+
+/*
+ * Track the scene signature: frame-to-frame stability, and the distance
+ * from the scene held when focus was last found. The distance measure is
+ * half the L1 distance between normalised luma histograms (0 identical, 1
+ * disjoint) plus the relative change of exposure x gain, so a pan, a new
+ * subject or an exposure step all register, while sensor noise does not.
+ */
+void Af::updateScene(const IPAContext &context, const SwIspStats *stats)
+{
+	std::array<double, SwIspStats::kYHistogramSize> hist;
+	double total = 0.0;
+	for (unsigned int i = 0; i < hist.size(); i++)
+		total += stats->yHistogram[i];
+	for (unsigned int i = 0; i < hist.size(); i++)
+		hist[i] = total > 0.0 ? stats->yHistogram[i] / total : 0.0;
+
+	const double exposure = context.activeState.agc.exposure *
+				context.activeState.agc.again;
+
+	auto distance = [&](const std::array<double, SwIspStats::kYHistogramSize> &ref,
+			    double refExposure) {
+		double d = 0.0;
+		for (unsigned int i = 0; i < hist.size(); i++)
+			d += std::abs(hist[i] - ref[i]);
+		d /= 2.0;
+		if (refExposure > 0.0)
+			d += std::abs(exposure - refExposure) / refExposure;
+		return d;
+	};
+
+	if (distance(hist_, exposure_) < kSceneStill)
+		stableFrames_++;
+	else
+		stableFrames_ = 0;
+
+	sceneChange_ = distance(focusHist_, focusExposure_);
+	hist_ = hist;
+	exposure_ = exposure;
+}
+
+void Af::step(IPAContext &context, const SwIspStats *stats)
+{
+	updateScene(context, stats);
+
+	/*
+	 * In manual mode the position is entirely the application's to choose.
+	 * Return before the focus-loss check below, which would otherwise start a
+	 * scan and drag the lens away from where the user put it.
+	 */
+	if (isManual(context))
+		return;
+
+	if (settle_) {
+		settle_--;
+		return;
+	}
+
+	const double s = static_cast<double>(stats->sharpness);
+
+	if (state_ == State::Idle) {
+		/* The first frames after configure(): acquire focus. */
+		if (reference_ == 0.0) {
+			restart(context);
+			return;
+		}
+		if (reference_ < 0.0) {
+			reference_ = s;
+			return;
+		}
+
+		sinceFocus_++;
+
+		/*
+		 * Arm a refocus on a sustained sharpness drop or on a changed
+		 * scene. Right after focusing, only a big drop counts: the
+		 * reference was measured at a single moment and settles.
+		 */
+		const bool drop = s < reference_ * (1.0 - kLostDrop);
+		const bool big = s < reference_ * (1.0 - kBigDrop);
+		lostFrames_ = drop ? lostFrames_ + 1 : 0;
+
+		if (!armed_ &&
+		    ((lostFrames_ >= kLostFrames && (big || sinceFocus_ > kCooldownFrames)) ||
+		     sceneChange_ > kSceneChanged)) {
+			armed_ = true;
+			armedBig_ = big || sceneChange_ > kSceneChanged;
+			LOG(IPASoftIspAutoFocus, Debug)
+				<< "Refocus armed (sharpness " << s << ", reference "
+				<< reference_ << ", scene change " << sceneChange_ << ")";
+		}
+
+		/* Sharpness came back while waiting: nothing to do. */
+		if (armed_ && !drop && sceneChange_ <= kSceneChanged) {
+			armed_ = false;
+			lostFrames_ = 0;
+		}
+
+		/* Search only once the scene has held still. */
+		if (armed_ && stableFrames_ >= kStableFrames) {
+			armed_ = false;
+			LOG(IPASoftIspAutoFocus, Info)
+				<< "Focus lost (sharpness " << s << ", was "
+				<< reference_ << ", scene change " << sceneChange_
+				<< "), probing " << (armedBig_ ? "wide" : "fine");
+			startProbe(context, armedBig_ ? kProbeStepCoarse : kProbeStepFine);
+			return;
+		}
+
+		/*
+		 * Follow slow drift, symmetrically and only while the scene is
+		 * still, so neither a single sharp frame nor motion blur moves
+		 * the bar.
+		 */
+		if (!armed_ && stableFrames_ >= kStableFrames)
+			reference_ = (1.0 - kReferenceRate) * reference_ + kReferenceRate * s;
+		return;
+	}
+
+	acc_ += s;
+	if (++accCount_ < measureFrames_)
+		return;
+
+	measured(context, acc_ / accCount_);
+}
+
+void Af::process([[maybe_unused]] IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 [[maybe_unused]] const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	step(context, stats);
+	updateFocus(context, frameContext, 0);
+
+	const int32_t mode =
+		context.activeState.knobs.af_mode.value_or(controls::AfModeContinuous);
+
+	metadata.set(controls::FocusFoM,
+		     static_cast<int32_t>(std::min<uint64_t>(stats->sharpness, INT32_MAX)));
+	metadata.set(controls::LensPosition,
+		     static_cast<float>(context.activeState.knobs.focus_pos.value_or(0.0)));
+	metadata.set(controls::AfMode, mode);
+	/*
+	 * AfState is defined to be AfStateIdle whenever AfMode is
+	 * AfModeManual, as the algorithm is not converging on anything.
+	 */
+	metadata.set(controls::AfState,
+		     isManual(context)
+			     ? controls::AfStateIdle
+		     : context.activeState.knobs.focus_sweep.value_or(false)
+			     ? controls::AfStateScanning
+			     : controls::AfStateFocused);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */

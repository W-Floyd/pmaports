+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2025 Vasiliy Doylov <nekodevelopper@gmail.com>
+ *
+ * Auto focus
+ */
+
+#pragma once
+
+#include <array>
+#include <stdint.h>
+
+#include "libipa/pwl.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af();
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls)
+		override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	/*
+	 * Idle:   holding focus, watching for a sustained sharpness drop.
+	 * Probe:  measure the current position and one small step either
+	 *         side, to find which way sharpness improves.
+	 * Climb:  step in the improving direction until sharpness falls.
+	 * Refine: two-sided probes around the best position, halving the
+	 *         step each round.
+	 * Scan:   a fast coarse scan across the range, for first focus,
+	 *         AfTrigger, and when a probe finds the sharpness curve flat
+	 *         (far out of focus); it hands the best point to Refine.
+	 */
+	enum class State { Idle, Probe, Climb, Refine, Scan };
+
+	bool isManual(const IPAContext &context) const;
+	int32_t lensCode(double dioptres) const;
+	void updateFocus(IPAContext &context, IPAFrameContext &frameContext, double focus);
+	void step(IPAContext &context, const SwIspStats *stats);
+	void updateScene(const IPAContext &context, const SwIspStats *stats);
+	void restart(IPAContext &context);
+	void startScan(IPAContext &context);
+	void scanStep(IPAContext &context, double sharp);
+	void startProbe(IPAContext &context, double stepFraction);
+	void moveTo(IPAContext &context, double dioptres);
+	void measured(IPAContext &context, double sharp);
+	void settle(IPAContext &context, double dioptres, double sharp);
+
+	State state_ = State::Idle;
+
+	/* The pending measurement: frames still to skip, and the average. */
+	unsigned int settle_ = 0;
+	double acc_ = 0.0;
+	unsigned int accCount_ = 0;
+	unsigned int measureFrames_ = 1;
+
+	/* Coarse scan. */
+	double scanStart_ = 0.0;
+	double scanStep_ = 0.0;
+	double scanDir_ = 1.0;
+	unsigned int scanIndex_ = 0;
+	unsigned int scanBestIndex_ = 0;
+
+	/* Hill climbing. */
+	double centre_ = 0.0;		/* position being probed around */
+	double centreSharp_ = 0.0;
+	double plusSharp_ = 0.0;
+	unsigned int probeIndex_ = 0;	/* 0 centre, 1 plus, 2 minus */
+	double probeStep_ = 0.0;
+	double probeFraction_ = 0.0;
+	double dir_ = 1.0;
+	double climbStep_ = 0.0;
+	double bestPos_ = 0.0;
+	double bestSharp_ = 0.0;
+
+	/* Idle monitoring. */
+	double reference_ = 0.0;
+	unsigned int lostFrames_ = 0;
+	unsigned int sinceFocus_ = 0;	/* frames since the last focus */
+	bool armed_ = false;		/* a refocus is due once the scene is stable */
+	bool armedBig_ = false;
+
+	/*
+	 * Scene signature: the luma histogram normalised to sum 1, its mean,
+	 * and exposure x gain. Compared frame to frame for stability, and
+	 * against the signature held when focus was last found.
+	 */
+	std::array<double, SwIspStats::kYHistogramSize> hist_{};
+	std::array<double, SwIspStats::kYHistogramSize> focusHist_{};
+	double exposure_ = 0.0;
+	double focusExposure_ = 0.0;
+	unsigned int stableFrames_ = 0;
+	double sceneChange_ = 0.0;	/* distance from the focused scene */
+
+	/*
+	 * Tuning data, kept here rather than in IPAContext::configuration
+	 * because configure() clears that whereas init(), which reads the
+	 * tuning file, runs only once.
+	 */
+	ipa::Pwl map_;
+	double dioptresMin_ = 0.0;
+	double dioptresMax_ = 0.0;
+	double dioptresDef_ = 0.0;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */

From 34ac9aaf7ab395cad85b4a057c1c45db3136fe1b Mon Sep 17 00:00:00 2001
From: William Floyd <git@notmy.space>
Date: Sun, 27 Sep 2026 19:59:46 +0000
Subject: [PATCH] ipa: soft: agc: Add manual exposure time and gain

The soft IPA offers no exposure controls: an application cannot fix the
exposure, for a bracket or a long exposure, or read which one it
asked for.

Add ExposureTimeMode, AnalogueGainMode, ExposureTime and AnalogueGain,
as the other IPAs have them: where a mode is manual, the frame is
taken with the application's value, within the sensor's range, in
place of the loop's; the loop's state follows it, so that it carries
on from there when set back to auto.

Signed-off-by: William Floyd <git@notmy.space>
---
 src/ipa/soft/algorithms/agc.cpp | 59 ++++++++++++++++++++++++++++++++-
 src/ipa/soft/algorithms/agc.h   | 11 ++++++
 2 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/src/ipa/soft/algorithms/agc.cpp b/src/ipa/soft/algorithms/agc.cpp
index bb6c5c64e..4d0ddcdb5 100644
--- a/src/ipa/soft/algorithms/agc.cpp
+++ b/src/ipa/soft/algorithms/agc.cpp
@@ -108,8 +108,25 @@ Agc::Agc()
  * frames the sensor takes to apply a new exposure -- too high and the loop
  * overshoots into clipping on a bright scene, too low and it ramps visibly.
  */
-int Agc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+int Agc::init(IPAContext &context, const ValueNode &tuningData)
 {
+	/*
+	 * Manual exposure, as the other IPAs have it: each of the exposure
+	 * time and the gain is set by the application when its mode is
+	 * manual, and by the loop otherwise. The ranges are the widest the
+	 * sensors here take; values are clamped to the sensor's at use.
+	 */
+	context.ctrlMap[&controls::ExposureTimeMode] =
+		ControlInfo({ { ControlValue(controls::ExposureTimeModeAuto),
+				ControlValue(controls::ExposureTimeModeManual) } },
+			    ControlValue(controls::ExposureTimeModeAuto));
+	context.ctrlMap[&controls::AnalogueGainMode] =
+		ControlInfo({ { ControlValue(controls::AnalogueGainModeAuto),
+				ControlValue(controls::AnalogueGainModeManual) } },
+			    ControlValue(controls::AnalogueGainModeAuto));
+	context.ctrlMap[&controls::ExposureTime] = ControlInfo(1, 1000000, 33333);
+	context.ctrlMap[&controls::AnalogueGain] = ControlInfo(1.0f, 256.0f, 1.0f);
+
 	auto optimal = tuningData["exposureOptimal"].get<float>();
 	if (optimal.has_value())
 		exposureOptimal_ = optimal.value();
@@ -503,6 +520,43 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 		<< " exp " << exposure << " again " << again;
 }
 
+void Agc::queueRequest([[maybe_unused]] typename Module::Context &context,
+			[[maybe_unused]] const uint32_t frame,
+			[[maybe_unused]] typename Module::FrameContext &frameContext,
+			const ControlList &controls)
+{
+	if (const auto &mode = controls.get(controls::ExposureTimeMode))
+		manualExposure_ = *mode == controls::ExposureTimeModeManual;
+	if (const auto &mode = controls.get(controls::AnalogueGainMode))
+		manualGain_ = *mode == controls::AnalogueGainModeManual;
+	if (const auto &t = controls.get(controls::ExposureTime))
+		exposureTime_ = *t;
+	if (const auto &g = controls.get(controls::AnalogueGain))
+		analogueGain_ = *g;
+}
+
+/*
+ * The application's exposure time and gain in place of the loop's, where
+ * their modes are manual, within the sensor's range. The loop's state
+ * follows, so that it carries on from them when set back to auto.
+ */
+void Agc::applyManual(IPAContext &context, IPAFrameContext &frameContext) const
+{
+	const auto &agc = context.configuration.agc;
+
+	if (manualExposure_ && exposureTime_ > 0 && agc.lineDuration.get<std::micro>() > 0) {
+		const double lines = exposureTime_ / agc.lineDuration.get<std::micro>();
+		frameContext.sensor.exposure =
+			std::clamp(static_cast<int32_t>(std::lround(lines)),
+				   agc.exposureMin, agc.exposureMax);
+		context.activeState.agc.exposure = frameContext.sensor.exposure;
+	}
+	if (manualGain_) {
+		frameContext.sensor.gain = std::clamp(analogueGain_, agc.againMin, agc.againMax);
+		context.activeState.agc.again = frameContext.sensor.gain;
+	}
+}
+
 void Agc::process(IPAContext &context,
 		  [[maybe_unused]] const uint32_t frame,
 		  IPAFrameContext &frameContext,
@@ -543,6 +597,7 @@ void Agc::process(IPAContext &context,
 		 */
 		frameContext.sensor.exposure = context.activeState.agc.exposure;
 		frameContext.sensor.gain = context.activeState.agc.again;
+		applyManual(context, frameContext);
 		return;
 	}
 
@@ -565,6 +620,7 @@ void Agc::process(IPAContext &context,
 	if (yHistValsPerBin == 0) {
 		LOG(IPASoftExposure, Debug)
 			<< "Not adjusting exposure due to insufficient histogram data";
+		applyManual(context, frameContext);
 		return;
 	}
 
@@ -611,6 +667,7 @@ void Agc::process(IPAContext &context,
 	agc.lastProduct = frameContext.sensor.exposure * frameContext.sensor.gain;
 
 	updateExposure(context, frameContext, exposureMSV, meanY, target);
+	applyManual(context, frameContext);
 
 	/* Remember which DRC gain the exposure now set goes with */
 	if (hist_) {
diff --git a/src/ipa/soft/algorithms/agc.h b/src/ipa/soft/algorithms/agc.h
index 3a6f5e483..10346ad2c 100644
--- a/src/ipa/soft/algorithms/agc.h
+++ b/src/ipa/soft/algorithms/agc.h
@@ -23,6 +23,10 @@ public:
 
 	int init(IPAContext &context, const ValueNode &tuningData) override;
 
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
 	void process(IPAContext &context, const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
@@ -64,6 +68,13 @@ private:
 	double drcDecided_ = 1.0;
 	/* The dark boost the tone curve is being set for */
 	double darkDecided_ = 1.0;
+
+	/* Manual exposure time (us) and gain, when their modes are manual */
+	bool manualExposure_ = false;
+	bool manualGain_ = false;
+	int32_t exposureTime_ = 0;
+	double analogueGain_ = 1.0;
+	void applyManual(IPAContext &context, IPAFrameContext &frameContext) const;
 };
 
 } /* namespace ipa::soft::algorithms */
-- 

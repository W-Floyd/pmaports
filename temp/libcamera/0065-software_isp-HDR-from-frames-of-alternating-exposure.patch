+/*
+ * HDR from frames of alternating exposure (see DebayerParams::Hdr). The
+ * exposure decided is the short one the DRC holds below the target, and the
+ * long one is the ratio times it, which the exposure the target asks for is
+ * about: while the DRC gain is high enough and the long exposure fits the
+ * frame, every other frame asked for gets the long one. The frames with
+ * statistics (every few frames, so always of the same parity) are steered
+ * to the short ones in process(), where the loop measures the exposure
+ * and the scene as it would without HDR.
+ */
+void Agc::applyHdr(IPAContext &context, IPAFrameContext &frameContext)
+{
+	auto &agc = context.activeState.agc;
+	auto &hdr = agc.hdr;
+	const auto &cfg = context.configuration.agc;
+
+	/* Not with manual exposure, nor without the DRC that decides the ratio */
+	if (!hist_ || manualExposure_ || manualGain_) {
+		hdr.active = false;
+		return;
+	}
+
+	if (hdrOn_ <= 0.0) {
+		hdr.active = false;
+		return;
+	}
+
+	if (hdrForce_ > 1.0)
+		hdrWanted_ = std::min(hdrForce_, kHdrMax);
+	if (hdrCooldown_)
+		hdrCooldown_--;
+
+	const int32_t limit = cfg.exposureMax + (agc.vblank - cfg.vblankBase);
+
+	/*
+	 * The exposure times gain of the long frame is the plain exposure's,
+	 * the one the target asks for: the loop's, which holds it below by the
+	 * DRC gain, or by the ratio with HDR. The long frame is split as the
+	 * loop does, exposure first and gain for the rest; the short one has
+	 * the same gain and the exposure shorter by the ratio, so that its
+	 * highlights have that much headroom whatever the gain.
+	 */
+	const double plain = agc.exposure * agc.again * (hdr.active ? hdr.ratio : drcDecided_);
+
+	int32_t exposureLong = 0;
+	double gainLong = 0.0;
+	auto split = [&](double ratio) {
+		const double product = plain;
+		exposureLong = std::clamp<int32_t>(std::lround(product / cfg.againMin),
+						   cfg.exposureMin, limit);
+		gainLong = product / exposureLong;
+		/* The gain is out of range, or the short exposure below the sensor's */
+		return gainLong >= cfg.againMin && gainLong <= cfg.againMax &&
+		       exposureLong / ratio >= cfg.exposureMin;
+	};
+	/* The loop's exposure and gain for a product, exposure first */
+	auto decide = [&](double product) {
+		agc.exposure = std::clamp<int32_t>(std::lround(product / cfg.againMin),
+						   cfg.exposureMin, limit);
+		agc.again = std::clamp(product / agc.exposure, cfg.againMin, cfg.againMax);
+	};
+
+	if (!hdr.active) {
+		if (hdrWanted_ >= hdrOn_ && !hdrCooldown_ && split(hdrWanted_)) {
+			/* The short frames are held below the plain exposure by the ratio, not the DRC gain */
+			hdr.active = true;
+			hdr.longNext = false;
+			hdr.ratio = hdrWanted_;
+			decide(plain / hdr.ratio);
+			drcDecided_ = 1.0;
+			darkDecided_ = 1.0;
+			agc.darkBoost = 1.0;
+			hdrBelow_ = 0;
+			LOG(IPASoftIspExposure, Info) << "HDR on, the long exposure "
+						   << hdr.ratio << " times the short";
+		}
+	} else if (!split(hdr.ratio) ||
+		   (hdrWanted_ < hdrOff_ && ++hdrBelow_ >= kHdrHold)) {
+		/* The ratio wanted has to stay low for a while, or HDR flaps on and off */
+		hdr.active = false;
+		hdrBelow_ = 0;
+		hdrCooldown_ = kHdrCooldown;
+		drcDecided_ = std::clamp(hdrWanted_, 1.0, hist_->maxDrc);
+		decide(plain / drcDecided_);
+		LOG(IPASoftIspExposure, Info) << "HDR off";
+	} else if (hdrWanted_ >= hdrOff_) {
+		hdrBelow_ = 0;
+	}
+
+	/*
+	 * The ratio follows the one wanted, a little each frame, at the same
+	 * plain exposure
+	 */
+	if (hdr.active) {
+		const double next = hdr.ratio * std::clamp(hdrWanted_ / hdr.ratio, kHdrRatioFall, kHdrRatioRise);
+		if (std::abs(next / hdr.ratio - 1.0) > 1e-4 && split(next)) {
+			hdr.ratio = next;
+			decide(plain / hdr.ratio);
+		}
+	}
+
+	if (!hdr.active)
+		return;
+
+	/*
+	 * The frames are asked for these by computeParams(), one of them on
+	 * each frame as it arrives: this runs when the statistics are done,
+	 * which is late for the frames after the one the CPU computes them on,
+	 * and the exposures asked for then miss their frames and repeat.
+	 */
+	split(hdr.ratio);
+	hdr.reference = agc.exposure * agc.again;
+	hdr.plan.longExposure = exposureLong;
+	hdr.plan.shortExposure = std::clamp<int32_t>(std::lround(exposureLong / hdr.ratio),
+						     cfg.exposureMin, exposureLong);
+	hdr.plan.gain = gainLong;
+	(void)frameContext;
+}
+
+void Agc::prepare(IPAContext &context, const uint32_t frame,
+		  IPAFrameContext &frameContext, DebayerParams *params)
+{
+	const auto &hdr = context.activeState.agc.hdr;
+	const double product = frameContext.sensor.exposure * frameContext.sensor.gain;
+
+	params->hdr.enabled = hdr.active && frameContext.sensor.known && hdr.reference > 0.0;
+	params->hdr.product = product;
+	/* Without HDR a frame is its own reference: cells in the units they were taken in */
+	params->hdr.reference = params->hdr.enabled ? hdr.reference : product;
+	params->hdr.ratio = params->hdr.enabled ? hdr.ratio : 1.0;
+
+	if (hdr.active)
+		LOG(IPASoftIspExposure, Debug)
+			<< "HDR frame " << frame << ": " << (params->hdr.enabled ? "on" : "OFF")
+			<< ", known " << frameContext.sensor.known << ", product " << product
+			<< ", reference " << hdr.reference << ", ratio " << hdr.ratio;
+}

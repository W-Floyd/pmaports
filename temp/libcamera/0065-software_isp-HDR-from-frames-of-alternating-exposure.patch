@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * bayer_cells_ratio.frag - Measures how much brighter the cells the previous
+ * frames' merge made are than this raw frame, for the HDR merge to tell from
+ * the data which of the alternating exposures the frame has, as the exposures
+ * the pipeline reports for the frames are not always the ones the sensor used
+ * (the sensor takes a write at a time that varies by a frame), and how the
+ * exposure varies down the frame: the first rows of a frame began their
+ * exposure before the change to the new one, and have another.
+ *
+ * The result is a column of texels, one for each of a few bands of rows of the
+ * cells the merge covers: x is the sum, over a grid of cells of the band where
+ * this frame is well below saturation, of the estimate's level above black
+ * over the frame's, which is 1 for a frame of the estimate's units (the short
+ * exposure) and 1 / ratio for a long one; y is the fraction of the band's grid
+ * that counted. The frame's cells are read as bayer_cells_bin.frag does, from
+ * the 8 high bits of their four pixels.
+ */
+
+precision highp float;
+precision highp sampler2D;
+
+#if !defined(RAW10P)
+#error Invalid raw format
+#endif
+
+uniform sampler2D tex_y;
+uniform vec2 raw_size;
+uniform sampler2D prev_cells;
+uniform vec3 black;		/* black level of red, green and blue, in counts */
+uniform vec2 area;		/* the cells the frame's merge covers */
+uniform float bands;		/* how many bands the covered rows are split in */
+
+out vec4 fragColor;
+
+const int kColumns = 32;
+const int kRows = 2;
+
+void main(void)
+{
+	float black_sum = black.r + 2.0 * black.g + black.b;
+	float sum_prev = 0.0;
+	float sum_cur = 0.0;
+	float counted = 0.0;
+	float band = floor(gl_FragCoord.y);
+
+	for (int j = 0; j < kRows; j++) {
+		for (int i = 0; i < kColumns; i++) {
+			vec2 grid = (vec2(float(i), float(j)) + 0.5) / vec2(float(kColumns), float(kRows));
+			vec2 cell = floor(vec2(grid.x * area.x, (band + grid.y) / bands * area.y));
+			vec2 p = cell * 2.0;
+			float group = floor(p.x / 4.0);
+			float first = group * 5.0 + (p.x - group * 4.0);
+
+			ivec4 hi = ivec4(textureGather(tex_y, vec2(first + 1.0, p.y + 1.0) / raw_size, 0) * 255.0 + 0.5);
+			int top = max(max(hi.x, hi.y), max(hi.z, hi.w));
+			/* The four pixels' counts, to within the low bits */
+			float cur = 4.0 * float(hi.x + hi.y + hi.z + hi.w) - black_sum;
+
+			vec3 p3 = texelFetch(prev_cells, ivec2(cell), 0).rgb * 1023.0;
+			float prev = p3.r + 2.0 * p3.g + p3.b - black_sum;
+
+			if (top < 190 && cur > 200.0 && prev > 0.0) {
+				sum_prev += prev;
+				sum_cur += cur;
+				counted += 1.0;
+			}
+		}
+	}
+
+	fragColor = vec4(sum_cur > 0.0 ? sum_prev / sum_cur : 0.0,
+			 counted / float(kColumns * kRows), 0.0, 1.0);
+}

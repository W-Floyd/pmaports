@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, William Floyd
+ *
+ * bayer_cells_base.frag - The base of the local tone map of HDR: the
+ * brightness of each place's surroundings, as a small, smooth texture, from
+ * the cells the merge made.
+ *
+ * Two passes of this program make it. The first (mode 0) averages the cells
+ * a texel of the small texture stands for (an area of them, by a grid of
+ * taps whose bilinear filtering averages the cells between), and the others
+ * (mode 1) blur it along a direction, a horizontal pass and then a vertical
+ * one, by a Gaussian, so that the main pass's one filtered fetch of it has no
+ * blocks, where the coarse level of a mip chain is a box filter and shows a
+ * lamp's surroundings as rectangles.
+ */
+
+precision highp float;
+precision highp sampler2D;
+
+uniform sampler2D src;
+uniform vec2 dst_size;		/* the texture being drawn */
+uniform vec2 bin_frac;		/* the part of the cells texture the cells were binned in */
+uniform float mode;		/* 0: average the cells, 1: blur */
+uniform vec2 dir;		/* the blur's step, in texels of src */
+
+out vec4 fragColor;
+
+void main(void)
+{
+	vec2 uv = gl_FragCoord.xy / dst_size;
+
+	if (mode < 0.5) {
+		/* The cells this texel stands for: its part of the binned area */
+		vec2 origin = (gl_FragCoord.xy - 0.5) / dst_size * bin_frac;
+		vec2 span = bin_frac / dst_size;
+		vec3 sum = vec3(0.0);
+		for (int j = 0; j < 8; j++) {
+			for (int i = 0; i < 8; i++) {
+				vec2 at = origin + span * ((vec2(float(i), float(j)) + 0.5) / 8.0);
+				sum += texture(src, at).rgb;
+			}
+		}
+		fragColor = vec4(sum / 64.0, 1.0);
+		return;
+	}
+
+	/* A Gaussian of 4 texels' reach on each side, of a sigma of 1.7 */
+	const float w[5] = float[5](0.2315, 0.1990, 0.1170, 0.0470, 0.0125);
+	vec3 sum = texture(src, uv).rgb * w[0];
+	float total = w[0];
+	for (int k = 1; k < 5; k++) {
+		sum += (texture(src, uv + dir * float(k)).rgb + texture(src, uv - dir * float(k)).rgb) * w[k];
+		total += 2.0 * w[k];
+	}
+	fragColor = vec4(sum / total, 1.0);
+}

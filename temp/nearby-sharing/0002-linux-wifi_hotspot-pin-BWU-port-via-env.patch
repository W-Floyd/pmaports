+  // Same story as WifiLanMedium::ListenForService: the peer joins our SoftAP
+  // and then connects *inbound* to this socket. Port 0 means an ephemeral
+  // port that no static firewall rule can name, so on a default-deny host the
+  // peer's SYN is dropped and the upgrade is reported as a failure - leaving
+  // the transfer on Bluetooth. NEARBY_WIFI_HOTSPOT_PORT pins it.
+  if (port == 0) {
+    if (const char* env = std::getenv("NEARBY_WIFI_HOTSPOT_PORT")) {
+      int configured = std::atoi(env);
+      if (configured > 0 && configured <= 65535) {
+        port = configured;
+      } else {
+        LOG(WARNING) << __func__
+                     << ": ignoring invalid NEARBY_WIFI_HOTSPOT_PORT='" << env
+                     << "'";
+      }
+    }
+  }

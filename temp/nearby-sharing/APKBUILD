# Maintainer: William Floyd <git@notmy.space>
pkgname=nearby-sharing
# kidfromjupiter's Linux port of google/nearby. No releases; upstream calls
# itself "under construction", so this is pinned to a tested commit.
pkgver=0_git20260801
pkgrel=0
_commit="6887b0983200c6c8c29e614ea2633d13bf18315d"
# Submodules, pinned to what $_commit records.
_gloop="87b6913daba4e398f7ed6f11777002e4916c33a7"
_json="bc889afb4c5bf1c0d8ee29ef35eaaf4c8bef8a5d"
_protobuf="5a5c44c0cfb4926249e2ae6024acdda513cbd3ff"
_smhasher="61a0530f28277f2e850bfc39600ce61d02b518de"
_ukey2="34c625a1476cfe04e5372be9af175fec74b6339b"
pkgdesc="Quick Share (Android Nearby Share) CLI, built on Google's Nearby library"
url="https://github.com/kidfromjupiter/nearby"
# Only built where it has been tested; the build is very heavy.
arch="aarch64"
license="Apache-2.0"
depends="
	bluez
	postmarketos-config-nftables-mdns
	"
makedepends="
	bazel
	bluez-dev
	clang21
	cmake
	curl-dev
	m4
	make
	openssl-dev
	protobuf-dev
	sdbus-cpp-dev
	systemd-dev
	"
source="$pkgname-$_commit.tar.gz::https://github.com/kidfromjupiter/nearby/archive/$_commit.tar.gz
	gloop-$_gloop.tar.gz::https://github.com/abseil/gloop/archive/$_gloop.tar.gz
	json-$_json.tar.gz::https://github.com/nlohmann/json/archive/$_json.tar.gz
	protobuf-$_protobuf.tar.gz::https://github.com/protocolbuffers/protobuf/archive/$_protobuf.tar.gz
	smhasher-$_smhasher.tar.gz::https://github.com/aappleby/smhasher/archive/$_smhasher.tar.gz
	ukey2-$_ukey2.tar.gz::https://github.com/google/ukey2/archive/$_ukey2.tar.gz
	50_nearby.nft
	0000-nearby-musl-build-fixes.patch
	0001-linux-wifi_lan-pin-BWU-port-via-env.patch
	0002-linux-wifi_hotspot-pin-BWU-port-via-env.patch
	gloop-musl.patch
	"
builddir="$srcdir/nearby-$_commit"
# net: Bazel resolves its module dependencies from the Bazel Central Registry
# at build time. !check: the test suite needs hardware radios.
options="net !check !pmb:crossdirect"

prepare() {
	# The submodules must be in place before default_prepare, because
	# gloop-musl.patch patches inside third_party/gloop.
	cd "$builddir"
	rmdir third_party/gloop third_party/json/json third_party/protobuf \
		third_party/smhasher/smhasher third_party/ukey2/ukey2 2>/dev/null || true
	mv "$srcdir"/gloop-$_gloop third_party/gloop
	mv "$srcdir"/json-$_json third_party/json/json
	mv "$srcdir"/protobuf-$_protobuf third_party/protobuf
	mv "$srcdir"/smhasher-$_smhasher third_party/smhasher/smhasher
	mv "$srcdir"/ukey2-$_ukey2 third_party/ukey2/ukey2

	default_prepare
}

build() {
	# Keep the build out of ~/.cache/bazel: sharing an output base with a
	# developer's own Bazel means fighting over its server process, and a
	# package build should not pollute (or depend on) that cache.
	local bazel_root="$srcdir/.bazel"

	# Two musl workarounds in the flags below:
	#  - rules_foreign_cc otherwise downloads prebuilt glibc cmake/make
	#    binaries to build sdbus-c++, which cannot execute here; use the
	#    system ones instead.
	#  - gloop refuses to compile against anything but glibc + libc++. Its
	#    only use on Linux is a time/proto helper, so gloop-musl.patch
	#    relaxes the guard and these copts acknowledge it in upstream's own
	#    terms.
	# Left to itself Bazel schedules against the host's core count and will
	# exhaust memory on a builder this size; the C++ link steps are large.
	bazel --output_user_root="$bazel_root" \
		--host_jvm_args=-Xmx2g \
		build \
		--jobs=4 \
		--extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_cmake_toolchain \
		--extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_make_toolchain \
		--copt=-DGLOOP_I_ACKNOWLEDGE_THAT_GLOOP_DOES_NOT_SUPPORT_LIBSTDCXX \
		--copt=-DGLOOP_I_ACKNOWLEDGE_THAT_GLOOP_DOES_NOT_SUPPORT_MUSL \
		//sharing/linux:nearby_sharing_cli

	# Ask the server to go away rather than leave it holding the build tree.
	# This is a courtesy and must not fail the build: in a container with no
	# reaper, the killed JVM lingers as a zombie, /proc/<pid> still exists,
	# and Bazel concludes the server "did not die in a timely fashion" and
	# exits FATAL. The startup options have to match the build invocation
	# too, or Bazel decides the server needs replacing before it even tries.
	bazel --output_user_root="$bazel_root" \
		--host_jvm_args=-Xmx2g \
		shutdown || true
}

package() {
	install -Dm755 bazel-bin/sharing/linux/nearby_sharing_cli \
		"$pkgdir"/usr/bin/nearby-sharing-cli

	# Without this the bandwidth upgrade cannot be reached and transfers
	# fall back to Bluetooth at ~10 KB/s. The port must match
	# NEARBY_WIFI_LAN_PORT when running the binary.
	install -Dm644 "$srcdir"/50_nearby.nft \
		-t "$pkgdir"/etc/nftables.d
}


# Forked from Alpine: add RedPocket Mobile (MVNO on AT&T, GID1 4201, APN
# ERESELLER; lets mmsd-tng auto-configure MMS). Patch from
# ~/mobile-broadband-provider-info branch us-att-ereseller (upstream !165).
maintainer="William Floyd <git@notmy.space>"
pkgname=mobile-broadband-provider-info
pkgver=20261111
pkgrel=1
pkgdesc="Mobile broadband settings for various service providers"
url="https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/"
arch="noarch"
license="CC-PDDC"
makedepends="libxml2-utils libxslt meson"
source="https://download.gnome.org/sources/mobile-broadband-provider-info/$pkgver/mobile-broadband-provider-info-$pkgver.tar.xz
	0001-us-add-RedPocket-Mobile.patch
	"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


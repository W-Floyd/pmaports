+    /// Points the focus popover at `camera`, or hides it when passed `None`.
+    ///
+    /// Pass `None` whenever the viewfinder is not `Ready`: the driver
+    /// discards controls set on a camera that is not streaming, so there is
+    /// nothing useful the popover could do before then.
+    pub fn set_focus_camera(&self, camera: Option<&aperture::Camera>) {
+        let imp = self.imp();
+
+        if imp.focus_camera.borrow().as_ref() == camera {
+            return;
+        }
+        imp.focus_camera.replace(camera.cloned());
+
+        // A camera with no autofocus, or one whose controls we could not
+        // reach, gets no focus button at all rather than one that does
+        // nothing.
+        let controls = camera.and_then(|camera| {
+            let af_mode = camera.control("AfMode")?;
+            let lens_position = camera.control("LensPosition")?;
+            Some((camera.clone(), af_mode, lens_position))
+        });
+
+        let Some((camera, af_mode, lens_position)) = controls else {
+            imp.af_mode.replace(None);
+            imp.lens_position.replace(None);
+            imp.focus_menu_button.set_popover(None::<&gtk::Popover>);
+            imp.focus_menu_button.set_visible(false);
+            return;
+        };
+
+        log::debug!(
+            "Camera {} can focus, showing focus controls",
+            camera.display_name()
+        );
+        imp.af_mode.replace(Some(af_mode.clone()));
+        imp.lens_position.replace(Some(lens_position.clone()));
+
+        let manual = af_mode
+            .choices()
+            .iter()
+            .find(|choice| choice.label() == "AfModeManual")
+            .map(|choice| choice.value());
+        let continuous = af_mode
+            .choices()
+            .iter()
+            .find(|choice| choice.label() == "AfModeContinuous")
+            .map(|choice| choice.value());
+
+        let Some((manual, continuous)) = manual.zip(continuous) else {
+            log::debug!("AfMode has no manual/continuous pair, hiding focus controls");
+            imp.focus_menu_button.set_visible(false);
+            return;
+        };
+
+        let container = gtk::Box::new(gtk::Orientation::Vertical, 12);
+        container.set_margin_top(12);
+        container.set_margin_bottom(12);
+        container.set_margin_start(12);
+        container.set_margin_end(12);
+        container.set_width_request(240);
+
+        let row = gtk::Box::new(gtk::Orientation::Horizontal, 12);
+        let label = gtk::Label::new(Some(&gettext("Manual Focus")));
+        label.set_xalign(0.0);
+        label.set_hexpand(true);
+        let switch = gtk::Switch::new();
+        switch.set_valign(gtk::Align::Center);
+        row.append(&label);
+        row.append(&switch);
+
+        // LensPosition is in dioptres: 0 is infinity and larger values focus
+        // closer, so the scale runs from far to near.
+        let step = (lens_position.maximum() - lens_position.minimum()) / 100.0;
+        let scale = gtk::Scale::with_range(
+            gtk::Orientation::Horizontal,
+            lens_position.minimum(),
+            lens_position.maximum(),
+            step.max(f64::EPSILON),
+        );
+        // Controls cannot be read back, so the default is the only honest
+        // starting point.
+        scale.set_value(lens_position.default_value());
+        scale.set_draw_value(false);
+        scale.set_hexpand(true);
+        scale.set_sensitive(false);
+        scale.add_mark(
+            lens_position.minimum(),
+            gtk::PositionType::Bottom,
+            Some(&gettext("Far")),
+        );
+        scale.add_mark(
+            lens_position.maximum(),
+            gtk::PositionType::Bottom,
+            Some(&gettext("Near")),
+        );
+
+        switch.connect_active_notify(glib::clone!(
+            #[weak]
+            scale,
+            #[strong]
+            camera,
+            #[strong]
+            af_mode,
+            #[strong]
+            lens_position,
+            move |switch| {
+                let is_manual = switch.is_active();
+                scale.set_sensitive(is_manual);
+
+                let mode = if is_manual { manual } else { continuous };
+                if let Err(err) = camera.set_control(&af_mode, mode) {
+                    log::warn!("Could not set AfMode: {err}");
+                    return;
+                }
+
+                // Entering manual mode leaves the lens wherever the autofocus
+                // stopped, which will not match the slider, so push the
+                // slider's value straight away.
+                if is_manual && let Err(err) = camera.set_control(&lens_position, scale.value()) {
+                    log::warn!("Could not set LensPosition: {err}");
+                }
+            }
+        ));
+
+        // A drag emits value-changed continuously. Send at most one position
+        // per FOCUS_THROTTLE, always the most recent one, so that neither the
+        // socket nor the camera's own settling logic is swamped -- the IPA
+        // waits a fixed number of frames after each move before trusting its
+        // sharpness reading again.
+        let pending: Rc<Cell<Option<f64>>> = Rc::new(Cell::new(None));
+        let scheduled: Rc<Cell<bool>> = Rc::new(Cell::new(false));
+
+        scale.connect_value_changed(glib::clone!(
+            #[weak]
+            switch,
+            #[strong]
+            camera,
+            #[strong]
+            lens_position,
+            #[strong]
+            pending,
+            #[strong]
+            scheduled,
+            move |scale| {
+                if !switch.is_active() {
+                    return;
+                }
+                pending.set(Some(scale.value()));
+
+                // A send is already queued; it will pick up the new value.
+                if scheduled.replace(true) {
+                    return;
+                }
+
+                glib::timeout_add_local_once(
+                    FOCUS_THROTTLE,
+                    glib::clone!(
+                        #[strong]
+                        camera,
+                        #[strong]
+                        lens_position,
+                        #[strong]
+                        pending,
+                        #[strong]
+                        scheduled,
+                        move || {
+                            scheduled.set(false);
+                            if let Some(value) = pending.take()
+                                && let Err(err) = camera.set_control(&lens_position, value)
+                            {
+                                log::warn!("Could not set LensPosition: {err}");
+                            }
+                        }
+                    ),
+                );
+            }
+        ));
+
+        container.append(&row);
+        container.append(&scale);
+
+        let popover = gtk::Popover::new();
+        popover.set_child(Some(&container));
+        imp.focus_menu_button.set_popover(Some(&popover));
+        imp.focus_menu_button.set_visible(true);
+    }
+

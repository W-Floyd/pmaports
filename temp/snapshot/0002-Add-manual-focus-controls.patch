+    /// Offer the focus controls only while a camera is actually streaming.
+    ///
+    /// The driver discards controls set on an idle camera, so the popover has
+    /// nothing useful to do until the viewfinder is `Ready`. The camera and
+    /// the state are separate properties that settle in either order, so this
+    /// is driven from both of their notifications.
+    fn update_focus_controls(&self) {
+        let imp = self.imp();
+
+        let camera = matches!(imp.viewfinder.state(), aperture::ViewfinderState::Ready)
+            .then(|| imp.viewfinder.camera())
+            .flatten();
+
+        log::debug!(
+            "Focus controls: state {:?}, camera {:?}",
+            imp.viewfinder.state(),
+            camera.as_ref().map(|camera| camera.display_name())
+        );
+
+        imp.camera_controls.set_focus_camera(camera.as_ref());
+    }

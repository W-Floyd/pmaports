@@ -0,0 +1,422 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Camera controls, such as focus and exposure.
+//!
+//! GStreamer's `pipewiresrc` streams from a PipeWire node but does not expose
+//! that node's parameters, so controls cannot be reached through the pipeline.
+//! We therefore bind the node ourselves, using the id the device provider
+//! already gives us, and talk to it directly.
+//!
+//! Controls are discovered from `SPA_PARAM_PropInfo` and written with
+//! `SPA_PARAM_Props`. `Props` is declared write-only by the libcamera plugin,
+//! so there is no read-back and no change notification: a caller owns the
+//! values it sets and should seed its UI from
+//! [`CameraControl::default_value`].
+
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::time::{Duration, Instant};
+
+use pipewire as pw;
+use pw::spa;
+use spa::param::ParamType;
+use spa::pod::deserialize::PodDeserializer;
+use spa::pod::serialize::PodSerializer;
+use spa::pod::{ChoiceValue, Object, Pod, Property, PropertyFlags, Value};
+use spa::utils::ChoiceEnum;
+
+use crate::ControlError;
+
+/// PipeWire has well-known property ids for a handful of common controls and
+/// maps everything else to `SPA_PROP_START_CUSTOM + <libcamera control id>`.
+/// Those ids are therefore only stable for a given libcamera version, which is
+/// why controls are matched on their name rather than their id.
+const SPA_PROP_START_CUSTOM: u32 = 0x1000000;
+
+/// How long to wait for the server to answer during discovery.
+const DISCOVERY_TIMEOUT: Duration = Duration::from_millis(1000);
+
+/// One of the alternatives of an enumerated [`CameraControl`].
+#[derive(Debug, Clone, PartialEq)]
+pub struct CameraControlChoice {
+    value: f64,
+    label: String,
+}
+
+impl CameraControlChoice {
+    /// The value to pass to [`Camera::set_control`][crate::Camera::set_control].
+    pub fn value(&self) -> f64 {
+        self.value
+    }
+
+    /// A human-readable name for this alternative, as reported by the driver.
+    pub fn label(&self) -> &str {
+        &self.label
+    }
+}
+
+/// A control exposed by a camera, such as focus, exposure or white balance.
+///
+/// Obtained from [`Camera::supported_controls`][crate::Camera::supported_controls].
+/// A control is either continuous, in which case [`minimum`][Self::minimum] and
+/// [`maximum`][Self::maximum] bound it, or enumerated, in which case
+/// [`choices`][Self::choices] lists the alternatives.
+#[derive(Debug, Clone, PartialEq)]
+pub struct CameraControl {
+    prop_id: u32,
+    name: String,
+    minimum: f64,
+    maximum: f64,
+    default_value: f64,
+    choices: Vec<CameraControlChoice>,
+    /// `Props` carries no type information, so the value has to be written
+    /// back with the same scalar type `PropInfo` advertised.
+    is_float: bool,
+}
+
+impl CameraControl {
+    /// The name of the control, as reported by the driver.
+    ///
+    /// For cameras driven by libcamera this is the libcamera control name, such
+    /// as `LensPosition` or `AfMode`.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// The smallest accepted value.
+    pub fn minimum(&self) -> f64 {
+        self.minimum
+    }
+
+    /// The largest accepted value.
+    pub fn maximum(&self) -> f64 {
+        self.maximum
+    }
+
+    /// The value the control has before anything sets it.
+    ///
+    /// Because controls cannot be read back, this is what a UI should show
+    /// until the user changes it.
+    pub fn default_value(&self) -> f64 {
+        self.default_value
+    }
+
+    /// The alternatives for an enumerated control, or empty if it is
+    /// continuous.
+    pub fn choices(&self) -> &[CameraControlChoice] {
+        &self.choices
+    }
+
+    /// Whether this control takes one of a fixed set of values.
+    pub fn is_enum(&self) -> bool {
+        !self.choices.is_empty()
+    }
+
+    /// Whether this control came from the driver rather than one of PipeWire's
+    /// well-known properties.
+    pub fn is_driver_specific(&self) -> bool {
+        self.prop_id >= SPA_PROP_START_CUSTOM
+    }
+}
+
+fn as_f64(value: &Value) -> Option<f64> {
+    match value {
+        Value::Float(v) => Some(*v as f64),
+        Value::Double(v) => Some(*v),
+        Value::Int(v) => Some(*v as f64),
+        Value::Long(v) => Some(*v as f64),
+        Value::Id(v) => Some(v.0 as f64),
+        Value::Bool(v) => Some(*v as i32 as f64),
+        _ => None,
+    }
+}
+
+/// Flatten a choice into `(default, minimum, maximum, is_float)`.
+fn choice_bounds(choice: &ChoiceValue) -> Option<(f64, f64, f64, bool)> {
+    macro_rules! bounds {
+        ($choice:expr, $is_float:expr) => {{
+            let spa::utils::Choice(_flags, body) = $choice;
+            let values: Vec<f64> = match body {
+                ChoiceEnum::None(default) => vec![*default as f64],
+                ChoiceEnum::Range { default, min, max }
+                | ChoiceEnum::Step {
+                    default, min, max, ..
+                } => vec![*default as f64, *min as f64, *max as f64],
+                ChoiceEnum::Enum {
+                    default,
+                    alternatives,
+                } => {
+                    let mut values = vec![*default as f64];
+                    values.extend(alternatives.iter().map(|value| *value as f64));
+                    values
+                }
+                ChoiceEnum::Flags { default, flags } => {
+                    let mut values = vec![*default as f64];
+                    values.extend(flags.iter().map(|value| *value as f64));
+                    values
+                }
+            };
+            (values, $is_float)
+        }};
+    }
+
+    let (values, is_float) = match choice {
+        ChoiceValue::Int(choice) => bounds!(choice, false),
+        ChoiceValue::Long(choice) => bounds!(choice, false),
+        ChoiceValue::Float(choice) => bounds!(choice, true),
+        ChoiceValue::Double(choice) => bounds!(choice, true),
+        ChoiceValue::Id(choice) => {
+            let spa::utils::Choice(_flags, body) = choice;
+            let values = match body {
+                ChoiceEnum::None(default) => vec![default.0 as f64],
+                ChoiceEnum::Enum {
+                    default,
+                    alternatives,
+                } => {
+                    let mut values = vec![default.0 as f64];
+                    values.extend(alternatives.iter().map(|value| value.0 as f64));
+                    values
+                }
+                _ => return None,
+            };
+            (values, false)
+        }
+        _ => return None,
+    };
+
+    let default = *values.first()?;
+    let minimum = values.get(1).copied().unwrap_or(default);
+    let maximum = values.get(2).copied().unwrap_or(default);
+
+    Some((default, minimum, maximum, is_float))
+}
+
+/// Build a [`CameraControl`] from one `PropInfo` object.
+fn parse_prop_info(object: &Object) -> Option<CameraControl> {
+    let mut prop_id = None;
+    let mut name = None;
+    let mut bounds = None;
+    let mut choices = Vec::new();
+
+    for property in &object.properties {
+        match property.key {
+            spa::sys::SPA_PROP_INFO_id => {
+                if let Value::Id(id) = &property.value {
+                    prop_id = Some(id.0);
+                }
+            }
+            spa::sys::SPA_PROP_INFO_description => {
+                if let Value::String(description) = &property.value {
+                    name = Some(description.clone());
+                }
+            }
+            spa::sys::SPA_PROP_INFO_type => {
+                if let Value::Choice(choice) = &property.value {
+                    bounds = choice_bounds(choice);
+                }
+            }
+            spa::sys::SPA_PROP_INFO_labels => {
+                // A flat [value, label, value, label, ...] struct.
+                if let Value::Struct(items) = &property.value {
+                    let mut items = items.iter();
+                    while let (Some(value), Some(label)) = (items.next(), items.next()) {
+                        if let (Some(value), Value::String(label)) = (as_f64(value), label) {
+                            choices.push(CameraControlChoice {
+                                value,
+                                label: label.clone(),
+                            });
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+
+    let (default_value, minimum, maximum, is_float) = bounds?;
+
+    Some(CameraControl {
+        prop_id: prop_id?,
+        name: name?,
+        minimum,
+        maximum,
+        default_value,
+        choices,
+        is_float,
+    })
+}
+
+/// A connection to one camera's PipeWire node, used to read its control list
+/// and write control values.
+///
+/// The loop is driven only around operations rather than being wired into the
+/// GLib main context, which is enough because `Props` is write-only and there
+/// is nothing to listen for once discovery is done. Reading control state back
+/// would need proper main-loop integration.
+pub(crate) struct ControlSession {
+    // Declaration order is drop order: the proxy has to go before the core and
+    // the loop that own its connection.
+    node: pw::node::Node,
+    controls: Vec<CameraControl>,
+    _core: pw::core::CoreRc,
+    _context: pw::context::ContextRc,
+    mainloop: pw::main_loop::MainLoopRc,
+}
+
+impl std::fmt::Debug for ControlSession {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ControlSession")
+            .field("controls", &self.controls.len())
+            .finish()
+    }
+}
+
+impl ControlSession {
+    pub(crate) fn new(node_id: u32) -> Result<Self, ControlError> {
+        static INIT: std::sync::Once = std::sync::Once::new();
+        INIT.call_once(pw::init);
+
+        let mainloop =
+            pw::main_loop::MainLoopRc::new(None).map_err(|_| ControlError::Unavailable)?;
+        let context =
+            pw::context::ContextRc::new(&mainloop, None).map_err(|_| ControlError::Unavailable)?;
+        let core = context
+            .connect_rc(None)
+            .map_err(|_| ControlError::Unavailable)?;
+        let registry = core
+            .get_registry_rc()
+            .map_err(|_| ControlError::Unavailable)?;
+
+        let node_cell: Rc<RefCell<Option<pw::node::Node>>> = Rc::new(RefCell::new(None));
+        let node_cell_cb = node_cell.clone();
+        let registry_cb = registry.clone();
+
+        let listener = registry
+            .add_listener_local()
+            .global(move |global| {
+                if global.id != node_id || global.type_ != pw::types::ObjectType::Node {
+                    return;
+                }
+                match registry_cb.bind::<pw::node::Node, _>(global) {
+                    Ok(node) => *node_cell_cb.borrow_mut() = Some(node),
+                    Err(err) => log::warn!("Could not bind camera node {node_id}: {err}"),
+                }
+            })
+            .register();
+
+        Self::pump(&mainloop, DISCOVERY_TIMEOUT, || {
+            node_cell.borrow().is_some()
+        });
+        drop(listener);
+
+        let node = node_cell
+            .borrow_mut()
+            .take()
+            .ok_or(ControlError::Unavailable)?;
+
+        // Enumerate the controls the node offers.
+        let controls: Rc<RefCell<Vec<CameraControl>>> = Rc::new(RefCell::new(Vec::new()));
+        let controls_cb = controls.clone();
+        let done = Rc::new(std::cell::Cell::new(false));
+        let done_cb = done.clone();
+
+        let node_listener = node
+            .add_listener_local()
+            .param(move |_seq, id, _index, next, param| {
+                if id != ParamType::PropInfo {
+                    return;
+                }
+                let Some(param) = param else {
+                    done_cb.set(true);
+                    return;
+                };
+                match PodDeserializer::deserialize_any_from(param.as_bytes()) {
+                    Ok((_, Value::Object(object))) => {
+                        if let Some(control) = parse_prop_info(&object) {
+                            controls_cb.borrow_mut().push(control);
+                        }
+                    }
+                    _ => log::debug!("Ignoring unparseable PropInfo"),
+                }
+                if next == 0 {
+                    done_cb.set(true);
+                }
+            })
+            .register();
+
+        node.enum_params(0, Some(ParamType::PropInfo), 0, u32::MAX);
+        Self::pump(&mainloop, DISCOVERY_TIMEOUT, || done.get());
+        drop(node_listener);
+
+        let controls = Rc::try_unwrap(controls)
+            .map(RefCell::into_inner)
+            .unwrap_or_default();
+
+        log::debug!(
+            "Camera node {node_id} exposes {} control(s): {:?}",
+            controls.len(),
+            controls.iter().map(CameraControl::name).collect::<Vec<_>>()
+        );
+
+        Ok(Self {
+            node,
+            controls,
+            _core: core,
+            _context: context,
+            mainloop,
+        })
+    }
+
+    pub(crate) fn controls(&self) -> &[CameraControl] {
+        &self.controls
+    }
+
+    pub(crate) fn set(&self, control: &CameraControl, value: f64) -> Result<(), ControlError> {
+        let value = value.clamp(control.minimum, control.maximum);
+        let value = if control.is_float {
+            Value::Float(value as f32)
+        } else {
+            Value::Int(value.round() as i32)
+        };
+
+        let pod = PodSerializer::serialize(
+            std::io::Cursor::new(Vec::new()),
+            &Value::Object(Object {
+                type_: spa::sys::SPA_TYPE_OBJECT_Props,
+                id: spa::sys::SPA_PARAM_Props,
+                properties: vec![Property {
+                    key: control.prop_id,
+                    flags: PropertyFlags::empty(),
+                    value,
+                }],
+            }),
+        )
+        .map_err(|_| ControlError::NotSupported)?
+        .0
+        .into_inner();
+
+        let pod = Pod::from_bytes(&pod).ok_or(ControlError::NotSupported)?;
+        self.node.set_param(ParamType::Props, 0, pod);
+
+        // Flush the request and drain anything the server sent, without ever
+        // waiting: this runs on the main loop, and a caller dragging a slider
+        // calls it continuously. Blocking here stalls the whole UI, video
+        // included.
+        self.mainloop.loop_().iterate(pw::loop_::Timeout::None);
+
+        Ok(())
+    }
+
+    /// Drive the PipeWire loop until `finished` returns true or `timeout`
+    /// elapses.
+    fn pump(mainloop: &pw::main_loop::MainLoopRc, timeout: Duration, finished: impl Fn() -> bool) {
+        let deadline = Instant::now() + timeout;
+        while Instant::now() < deadline {
+            mainloop
+                .loop_()
+                .iterate(pw::loop_::Timeout::Finite(Duration::from_millis(10)));
+            if finished() {
+                return;
+            }
+        }
+    }
+}

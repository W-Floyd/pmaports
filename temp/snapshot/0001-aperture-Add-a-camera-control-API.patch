+    /// Gets the PipeWire node id of the camera represented by `self`.
+    ///
+    /// This is the object the camera's controls live on.
+    fn node_id(&self) -> Option<u32> {
+        let properties = self.device().properties()?;
+        let value = properties.value("object.id").ok()?;
+
+        // PipeWire properties are strings, but GStreamer may already have
+        // parsed this one into an integer.
+        if let Ok(id) = value.get::<u32>() {
+            Some(id)
+        } else if let Ok(id) = value.get::<i32>() {
+            u32::try_from(id).ok()
+        } else {
+            value.get::<&str>().ok()?.parse().ok()
+        }
+    }
+
+    fn control_session(&self) -> Result<Rc<ControlSession>, ControlError> {
+        if let Some(session) = self.imp().controls.borrow().as_ref() {
+            return Ok(session.clone());
+        }
+
+        let node_id = self.node_id().ok_or(ControlError::Unavailable)?;
+        let session = Rc::new(ControlSession::new(node_id)?);
+        *self.imp().controls.borrow_mut() = Some(session.clone());
+
+        Ok(session)
+    }
+
+    /// Gets the controls the camera represented by `self` supports, such as
+    /// focus or exposure.
+    ///
+    /// The list is fixed for the lifetime of the camera. It is empty when the
+    /// camera exposes no controls, or when they could not be queried, so a UI
+    /// built from it degrades to showing nothing on hardware that cannot be
+    /// adjusted.
+    ///
+    /// # Returns
+    ///
+    /// the available [`CameraControl`][crate::CameraControl]s.
+    pub fn supported_controls(&self) -> Vec<CameraControl> {
+        match self.control_session() {
+            Ok(session) => session.controls().to_vec(),
+            Err(err) => {
+                log::debug!("No controls for {}: {err}", self.display_name());
+                Vec::new()
+            }
+        }
+    }
+
+    /// Looks up one of the camera's controls by name.
+    ///
+    /// # Returns
+    ///
+    /// the [`CameraControl`][crate::CameraControl] if the camera has one by
+    /// that name.
+    pub fn control(&self, name: &str) -> Option<CameraControl> {
+        self.supported_controls()
+            .into_iter()
+            .find(|control| control.name() == name)
+    }
+
+    /// Sets a control on the camera represented by `self`.
+    ///
+    /// The value is clamped to the control's range.
+    ///
+    /// Controls only take effect while the camera is streaming; setting one on
+    /// an idle camera is silently discarded by the driver. Callers should
+    /// therefore wait until the
+    /// [`Viewfinder`][crate::Viewfinder] is
+    /// [`Ready`][crate::ViewfinderState::Ready].
+    ///
+    /// There is no way to read a control back, so the caller owns the current
+    /// value and should start from
+    /// [`CameraControl::default_value`][crate::CameraControl::default_value].
+    pub fn set_control(&self, control: &CameraControl, value: f64) -> Result<(), ControlError> {
+        self.control_session()?.set(control, value)
+    }
+

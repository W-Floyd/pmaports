+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Exercise the camera control API against real hardware.
+//!
+//! Lists every camera the device provider finds and the controls it exposes,
+//! then, if one of them has a focus control, streams from it and drives the
+//! lens through its range.
+//!
+//! Run it inside a graphical session, since `aperture::init` initialises GTK:
+//!
+//! ```sh
+//! WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 ./controls
+//! ```
+
+use std::time::{Duration, Instant};
+
+use gst::prelude::*;
+use gtk::gio::prelude::ListModelExt;
+use gtk::glib;
+
+/// Let the GLib main context run for a while so the device provider can
+/// deliver cameras and the pipeline can get going.
+fn pump(duration: Duration) {
+    let context = glib::MainContext::default();
+    let deadline = Instant::now() + duration;
+    while Instant::now() < deadline {
+        while context.iteration(false) {}
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+/// Read the focus actuator directly, so the example checks itself rather than
+/// just reporting that a write did not fail.
+fn actuator_position() -> String {
+    let subdev = std::process::Command::new("sh")
+        .arg("-c")
+        .arg(
+            "media-ctl -d /dev/media0 -p 2>/dev/null \
+             | grep -A3 'entity.*ak7375' | grep 'device node name' | awk '{print $NF}'",
+        )
+        .output()
+        .map(|out| String::from_utf8_lossy(&out.stdout).trim().to_string())
+        .unwrap_or_default();
+
+    if subdev.is_empty() {
+        return "<no ak7375 on this machine>".into();
+    }
+
+    std::process::Command::new("v4l2-ctl")
+        .args(["-d", &subdev, "-C", "focus_absolute"])
+        .output()
+        .map(|out| String::from_utf8_lossy(&out.stdout).trim().to_string())
+        .unwrap_or_else(|_| "<v4l2-ctl failed>".into())
+}
+
+fn main() {
+    aperture::init("org.gnome.Snapshot.ControlsExample");
+
+    let provider = aperture::DeviceProvider::instance();
+    provider
+        .start()
+        .expect("could not start the device provider");
+    pump(Duration::from_secs(3));
+
+    let mut focus_camera = None;
+
+    for position in 0..provider.n_items() {
+        let Some(camera) = provider.camera(position) else {
+            continue;
+        };
+
+        println!("\n=== {} ===", camera.display_name());
+        let controls = camera.supported_controls();
+        if controls.is_empty() {
+            println!("  (no controls)");
+            continue;
+        }
+
+        for control in &controls {
+            if control.is_enum() {
+                let choices: Vec<String> = control
+                    .choices()
+                    .iter()
+                    .map(|choice| format!("{}={}", choice.label(), choice.value()))
+                    .collect();
+                println!("  {:<14} enum [{}]", control.name(), choices.join(", "));
+            } else {
+                println!(
+                    "  {:<14} {}..{} default {}",
+                    control.name(),
+                    control.minimum(),
+                    control.maximum(),
+                    control.default_value()
+                );
+            }
+        }
+
+        if camera.control("LensPosition").is_some() && focus_camera.is_none() {
+            focus_camera = Some(camera);
+        }
+    }
+
+    let Some(camera) = focus_camera else {
+        println!("\nNo camera with a LensPosition control; nothing more to do.");
+        return;
+    };
+
+    // The node id is what the control API binds to. It is also what we need to
+    // point a pipeline at, and it comes straight out of the device properties.
+    let node_id = camera
+        .properties()
+        .get("object.id")
+        .and_then(|value| value.get::<&str>().ok().map(str::to_string))
+        .expect("camera has no object.id");
+
+    println!(
+        "\n=== streaming from {} (node {node_id}) ===",
+        camera.display_name()
+    );
+    let pipeline = gst::parse::launch(&format!(
+        "pipewiresrc path={node_id} ! videoconvert ! fakesink"
+    ))
+    .expect("could not build the pipeline");
+    pipeline
+        .set_state(gst::State::Playing)
+        .expect("could not start the pipeline");
+
+    // Controls are discarded while the camera is idle, so wait for frames.
+    pump(Duration::from_secs(10));
+    println!("autofocus left the lens at {}", actuator_position());
+
+    let af_mode = camera.control("AfMode").expect("AfMode disappeared");
+    let manual = af_mode
+        .choices()
+        .iter()
+        .find(|choice| choice.label() == "AfModeManual")
+        .map(|choice| choice.value())
+        .expect("no AfModeManual choice");
+
+    println!("\nset AfMode = AfModeManual ({manual})");
+    camera
+        .set_control(&af_mode, manual)
+        .expect("could not set AfMode");
+    pump(Duration::from_secs(3));
+
+    let lens = camera
+        .control("LensPosition")
+        .expect("LensPosition disappeared");
+    for fraction in [0.0, 0.25, 0.5, 1.0] {
+        let value = lens.minimum() + (lens.maximum() - lens.minimum()) * fraction;
+        camera
+            .set_control(&lens, value)
+            .expect("could not set LensPosition");
+        pump(Duration::from_secs(4));
+        println!("set LensPosition = {value:<5} -> {}", actuator_position());
+    }
+
+    // Hand the lens back to the autofocus rather than leaving it parked.
+    println!("\nrestoring continuous autofocus");
+    if let Some(continuous) = af_mode
+        .choices()
+        .iter()
+        .find(|choice| choice.label() == "AfModeContinuous")
+    {
+        let _ = camera.set_control(&af_mode, continuous.value());
+        pump(Duration::from_secs(6));
+        println!("autofocus took over again at {}", actuator_position());
+    }
+
+    let _ = pipeline.set_state(gst::State::Null);
+}

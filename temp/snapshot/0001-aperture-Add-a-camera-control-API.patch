+/// Describes the possible errors when reading or setting a
+/// [`CameraControl`][crate::CameraControl].
+#[derive(Debug, Eq, PartialEq, Clone, Copy, glib::ErrorDomain)]
+#[error_domain(name = "ApertureControlError")]
+pub enum ControlError {
+    /// The camera does not expose controls, or they could not be reached.
+    Unavailable,
+    /// The driver rejected the value.
+    NotSupported,
+}
+
+impl std::error::Error for ControlError {}
+
+impl std::fmt::Display for ControlError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unavailable => f.write_str("Camera controls are not available"),
+            Self::NotSupported => f.write_str("The camera rejected the control value"),
+        }
+    }
+}

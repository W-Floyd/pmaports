diff --git a/src/widgets/camera_controls.rs b/src/widgets/camera_controls.rs
index 83250af..582f156 100644
--- a/src/widgets/camera_controls.rs
+++ b/src/widgets/camera_controls.rs
@@ -13,6 +13,15 @@ use crate::enums::ControlsLayout;
 /// Longest a focus position may sit unsent while the slider is being dragged.
 const FOCUS_THROTTLE: Duration = Duration::from_millis(50);
 
+/// Render an f-number the way lenses are marked: f/1.5, f/2.4, f/11.
+fn format_f_number(value: f64) -> String {
+    if (value - value.round()).abs() < 0.05 {
+        format!("{:.0}", value)
+    } else {
+        format!("{:.1}", value)
+    }
+}
+
 mod imp {
     use std::cell::{Cell, OnceCell, RefCell};
     use std::sync::LazyLock;
@@ -46,12 +55,18 @@ mod imp {
         pub gallery_button_stack: TemplateChild<gtk::Stack>,
         #[template_child]
         pub focus_menu_button: TemplateChild<gtk::MenuButton>,
+        #[template_child]
+        pub aperture_menu_button: TemplateChild<gtk::MenuButton>,
 
         /// The camera whose focus controls the popover currently drives, and
         /// the controls themselves. All `None` for a camera that cannot focus.
         pub focus_camera: RefCell<Option<aperture::Camera>>,
         pub af_mode: RefCell<Option<aperture::CameraControl>>,
         pub lens_position: RefCell<Option<aperture::CameraControl>>,
+
+        /// The same, for the aperture. `None` for a camera with a fixed one.
+        pub aperture_camera: RefCell<Option<aperture::Camera>>,
+        pub lens_aperture: RefCell<Option<aperture::CameraControl>>,
     }
 
     #[glib::object_subclass]
@@ -378,6 +393,177 @@ impl CameraControls {
         imp.focus_menu_button.set_visible(true);
     }
 
+    /// Points the aperture popover at `camera`, or hides it when passed
+    /// `None`. Same reasoning as [`Self::set_focus_camera`]: controls set on
+    /// a camera that is not streaming are discarded.
+    pub fn set_aperture_camera(&self, camera: Option<&aperture::Camera>) {
+        let imp = self.imp();
+
+        if imp.aperture_camera.borrow().as_ref() == camera {
+            return;
+        }
+        imp.aperture_camera.replace(camera.cloned());
+
+        // A camera with a fixed aperture advertises no control at all, and
+        // gets no button rather than one that does nothing.
+        let control = camera.and_then(|camera| {
+            let lens_aperture = camera.control("LensAperture")?;
+            Some((camera.clone(), lens_aperture))
+        });
+
+        let Some((camera, lens_aperture)) = control else {
+            imp.lens_aperture.replace(None);
+            imp.aperture_menu_button
+                .set_popover(None::<&gtk::Popover>);
+            imp.aperture_menu_button.set_visible(false);
+            return;
+        };
+
+        log::debug!(
+            "Camera {} has an aperture control, showing it",
+            camera.display_name()
+        );
+        imp.lens_aperture.replace(Some(lens_aperture.clone()));
+
+        let container = gtk::Box::new(gtk::Orientation::Vertical, 12);
+        container.set_margin_top(12);
+        container.set_margin_bottom(12);
+        container.set_margin_start(12);
+        container.set_margin_end(12);
+        container.set_width_request(240);
+
+        let label = gtk::Label::new(Some(&gettext("Aperture")));
+        label.set_xalign(0.0);
+        container.append(&label);
+
+        if lens_aperture.is_enum() {
+            // A lens with fixed stops, such as a two-position blade
+            // mechanism. Offer exactly those, not a slider over a range it
+            // cannot actually reach.
+            let row = gtk::Box::new(gtk::Orientation::Horizontal, 6);
+            row.set_homogeneous(true);
+            row.add_css_class("linked");
+
+            let mut group: Option<gtk::ToggleButton> = None;
+            for choice in lens_aperture.choices() {
+                let value = choice.value();
+                // f-numbers read as f/1.5; the driver sends no label for a
+                // control whose values are plain numbers.
+                let text = if choice.label().is_empty() {
+                    format!("f/{}", format_f_number(value))
+                } else {
+                    choice.label().to_string()
+                };
+
+                let button = gtk::ToggleButton::with_label(&text);
+                if let Some(first) = group.as_ref() {
+                    button.set_group(Some(first));
+                }
+                if group.is_none() {
+                    group = Some(button.clone());
+                }
+
+                button.set_active(
+                    (value - lens_aperture.default_value()).abs() < f64::EPSILON,
+                );
+
+                button.connect_toggled(glib::clone!(
+                    #[strong]
+                    camera,
+                    #[strong]
+                    lens_aperture,
+                    move |button| {
+                        if !button.is_active() {
+                            return;
+                        }
+                        if let Err(err) = camera.set_control(&lens_aperture, value) {
+                            log::warn!("Could not set LensAperture: {err}");
+                        }
+                    }
+                ));
+
+                row.append(&button);
+            }
+
+            container.append(&row);
+        } else {
+            // A continuously variable iris.
+            let step = (lens_aperture.maximum() - lens_aperture.minimum()) / 100.0;
+            let scale = gtk::Scale::with_range(
+                gtk::Orientation::Horizontal,
+                lens_aperture.minimum(),
+                lens_aperture.maximum(),
+                step.max(f64::EPSILON),
+            );
+            scale.set_value(lens_aperture.default_value());
+            scale.set_draw_value(false);
+            scale.set_hexpand(true);
+            scale.add_mark(
+                lens_aperture.minimum(),
+                gtk::PositionType::Bottom,
+                Some(&format!("f/{}", format_f_number(lens_aperture.minimum()))),
+            );
+            scale.add_mark(
+                lens_aperture.maximum(),
+                gtk::PositionType::Bottom,
+                Some(&format!("f/{}", format_f_number(lens_aperture.maximum()))),
+            );
+
+            // Same throttling as the focus slider: a drag emits
+            // value-changed continuously.
+            let pending: Rc<Cell<Option<f64>>> = Rc::new(Cell::new(None));
+            let scheduled: Rc<Cell<bool>> = Rc::new(Cell::new(false));
+
+            scale.connect_value_changed(glib::clone!(
+                #[strong]
+                camera,
+                #[strong]
+                lens_aperture,
+                #[strong]
+                pending,
+                #[strong]
+                scheduled,
+                move |scale| {
+                    pending.set(Some(scale.value()));
+
+                    if scheduled.replace(true) {
+                        return;
+                    }
+
+                    glib::timeout_add_local_once(
+                        FOCUS_THROTTLE,
+                        glib::clone!(
+                            #[strong]
+                            camera,
+                            #[strong]
+                            lens_aperture,
+                            #[strong]
+                            pending,
+                            #[strong]
+                            scheduled,
+                            move || {
+                                scheduled.set(false);
+                                if let Some(value) = pending.take()
+                                    && let Err(err) =
+                                        camera.set_control(&lens_aperture, value)
+                                {
+                                    log::warn!("Could not set LensAperture: {err}");
+                                }
+                            }
+                        ),
+                    );
+                }
+            ));
+
+            container.append(&scale);
+        }
+
+        let popover = gtk::Popover::new();
+        popover.set_child(Some(&container));
+        imp.aperture_menu_button.set_popover(Some(&popover));
+        imp.aperture_menu_button.set_visible(true);
+    }
+
     pub fn connect_camera_switched<F: Fn(&Self) + 'static>(&self, f: F) {
         self.connect_closure(
             "camera-switched",

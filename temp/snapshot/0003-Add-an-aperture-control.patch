 data/resources/ui/camera_controls.ui |  14 ++
 src/widgets/camera.rs                |   6 +-
 src/widgets/camera_controls.rs       | 186 +++++++++++++++++++++++++++
 4 files changed, 276 insertions(+), 15 deletions(-)

diff --git a/aperture/src/camera_control.rs b/aperture/src/camera_control.rs
index 2e42c69..1652a43 100644
--- a/aperture/src/camera_control.rs
+++ b/aperture/src/camera_control.rs
@@ -130,11 +130,23 @@ fn as_f64(value: &Value) -> Option<f64> {

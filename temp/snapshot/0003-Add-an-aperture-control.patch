 }
 
-/// Flatten a choice into `(default, minimum, maximum, is_float)`.
-fn choice_bounds(choice: &ChoiceValue) -> Option<(f64, f64, f64, bool)> {
+/// What a `PropInfo` type choice says about a control's range.
+pub(crate) struct ChoiceBounds {
+    pub default: f64,
+    pub minimum: f64,
+    pub maximum: f64,
+    pub is_float: bool,
+    /// Every value the control accepts, when the driver enumerated a fixed
+    /// set rather than giving a range. Empty for a continuous control.
+    pub alternatives: Vec<f64>,
+}
+
+/// Flatten a choice into its bounds and, for an enumeration, its values.
+fn choice_bounds(choice: &ChoiceValue) -> Option<ChoiceBounds> {
     macro_rules! bounds {
         ($choice:expr, $is_float:expr) => {{
             let spa::utils::Choice(_flags, body) = $choice;
+            let mut is_enum = false;
             let values: Vec<f64> = match body {
                 ChoiceEnum::None(default) => vec![*default as f64],
                 ChoiceEnum::Range { default, min, max }
@@ -145,6 +157,7 @@ fn choice_bounds(choice: &ChoiceValue) -> Option<(f64, f64, f64, bool)> {
                     default,
                     alternatives,
                 } => {
+                    is_enum = true;
                     let mut values = vec![*default as f64];
                     values.extend(alternatives.iter().map(|value| *value as f64));
                     values
@@ -155,39 +168,69 @@ fn choice_bounds(choice: &ChoiceValue) -> Option<(f64, f64, f64, bool)> {
                     values
                 }
             };
-            (values, $is_float)
+            (values, $is_float, is_enum)
         }};
     }
 
-    let (values, is_float) = match choice {
+    let (values, is_float, is_enum) = match choice {
         ChoiceValue::Int(choice) => bounds!(choice, false),
         ChoiceValue::Long(choice) => bounds!(choice, false),
         ChoiceValue::Float(choice) => bounds!(choice, true),
         ChoiceValue::Double(choice) => bounds!(choice, true),
         ChoiceValue::Id(choice) => {
             let spa::utils::Choice(_flags, body) = choice;
+            let mut is_enum = false;
             let values = match body {
                 ChoiceEnum::None(default) => vec![default.0 as f64],
                 ChoiceEnum::Enum {
                     default,
                     alternatives,
                 } => {
+                    is_enum = true;
                     let mut values = vec![default.0 as f64];
                     values.extend(alternatives.iter().map(|value| value.0 as f64));
                     values
                 }
                 _ => return None,
             };
-            (values, false)
+            (values, false, is_enum)
         }
         _ => return None,
     };
 
     let default = *values.first()?;
-    let minimum = values.get(1).copied().unwrap_or(default);
-    let maximum = values.get(2).copied().unwrap_or(default);
 
-    Some((default, minimum, maximum, is_float))
+    if is_enum {
+        // An enumeration lists every accepted value after the default. Its
+        // bounds are the extremes of that set, not the first two entries.
+        let alternatives: Vec<f64> = values[1..].to_vec();
+        let minimum = alternatives
+            .iter()
+            .copied()
+            .fold(f64::INFINITY, f64::min)
+            .min(default);
+        let maximum = alternatives
+            .iter()
+            .copied()
+            .fold(f64::NEG_INFINITY, f64::max)
+            .max(default);
+
+        return Some(ChoiceBounds {
+            default,
+            minimum,
+            maximum,
+            is_float,
+            alternatives,
+        });
+    }
+
+    Some(ChoiceBounds {
+        default,
+        minimum: values.get(1).copied().unwrap_or(default),
+        maximum: values.get(2).copied().unwrap_or(default),
+        is_float,
+        alternatives: Vec::new(),
+    })
 }
 
 /// Build a [`CameraControl`] from one `PropInfo` object.
@@ -232,16 +275,32 @@ fn parse_prop_info(object: &Object) -> Option<CameraControl> {
         }
     }
 
-    let (default_value, minimum, maximum, is_float) = bounds?;
+    let bounds = bounds?;
+
+    // A driver only sends labels for controls whose values have names, such
+    // as an enumeration of modes. A control that enumerates plain numbers,
+    // like the apertures of a lens with fixed stops, arrives without them.
+    // Those values are still the only ones the control accepts, so surface
+    // them as choices and let the caller decide how to present a bare number.
+    if choices.is_empty() {
+        choices = bounds
+            .alternatives
+            .iter()
+            .map(|value| CameraControlChoice {
+                value: *value,
+                label: String::new(),
+            })
+            .collect();
+    }
 
     Some(CameraControl {
         prop_id: prop_id?,
         name: name?,
-        minimum,
-        maximum,
-        default_value,
+        minimum: bounds.minimum,
+        maximum: bounds.maximum,
+        default_value: bounds.default,
         choices,
-        is_float,
+        is_float: bounds.is_float,
     })
 }
 

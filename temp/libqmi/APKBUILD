b4a3a326a6d98a24d96e7314ad3a25730740010b85b1c33c912bc192e25d57abe7fb023733ab7fc5ccc7f8058d71fdebc3dce95c412136d623857488d213a7cb  0001-voice-add-the-pre-alerting-call-state.patch

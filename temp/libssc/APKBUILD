a2ac1cc84994f2d540622d9e0f2ba7f83cafc5e4cb597231c2d6a95eb6af2504e3571f8b14ae7f2df66d5a4fc03a02048aed6c73e2cf11da119d133976b59cb5  0001-sensor-compass-fall-back-to-the-geomagnetic-rotation.patch
"

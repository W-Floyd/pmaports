@@ -214,6 +218,12 @@ static int translate_readwrite(const char *file, int flags)
  * using the modem_pr relative path (e.g., maps to READONLY_FW_BASE/<fw_dir>/modem_pr/...).
  * Strips /readonly/vendor/firmware/ and /readonly/vendor/firmware_mnt/image/
  * and searches among remoteproc firmware.
+ * Strips /readonly/vendor/ from /readonly/vendor/fsg/ and /readonly/ from
+ * /readonly/fsg/, keeping the fsg/ component, so both resolve to fsg/... next
+ * to the remoteproc firmware. Android mounts the fsg partition at /vendor/fsg
+ * or at /fsg depending on the release, and the modem's RFS tree symlinks
+ * readonly/vendor/fsg and readonly/fsg at it respectively; serving both under
+ * one fsg/ directory means the host only has to expose it once.
  * Replaces /readwrite/ with a persistent directory.
  */
 int translate_open(const char *path, int flags)

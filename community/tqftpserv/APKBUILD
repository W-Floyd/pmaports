# Maintainer: Luca Weiss <luca@lucaweiss.eu>
#
# fogona overlay: adds 0001-translate-serve-the-fsg-partition.patch. Otherwise
# identical to Alpine community/tqftpserv. Drop this override once the patch
# (or an equivalent) is upstream in linux-msm/tqftpserv -- see
# https://github.com/linux-msm/tqftpserv/issues/25.
pkgname=tqftpserv
pkgver=1.2
# Keep this AHEAD of whatever Alpine ships. r3 collided with the mirror's own
# 1.2-r3: same version, different contents, so apk saw no upgrade and a
# reinstall silently landed the unpatched build. That costs the SIM -- the
# modem is refused /readwrite/datablock/id_00, mot_rfs/imei_sv and friends,
# its USIM application never leaves 'detected', and ModemManager reports
# sim-missing.
pkgrel=4
pkgdesc="Trivial File Transfer Protocol server over AF_QIPCRTR"
url="https://github.com/linux-msm/tqftpserv"
arch="all"
license="BSD-3-Clause"
makedepends="meson qrtr-dev zstd-dev"
source="https://github.com/linux-msm/tqftpserv/archive/v$pkgver/tqftpserv-v$pkgver.tar.gz
	tqftpserv.initd
	0001-translate-serve-the-fsg-partition.patch
	populate-readwrite.sh
	tqftpserv-populate-readwrite.service
	"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd:systemd"
options="!check" # No test suite

build() {
	abuild-meson \
		-Dsystemd-unit-prefix=/usr/lib/systemd/system/ \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/COPYING
	install -Dm755 "$srcdir"/tqftpserv.initd "$pkgdir"/etc/init.d/tqftpserv

	# Backported from upstream PR #53, which is merged but in no release yet.
	# Motorola modems read per-device state (datablock/, mot_rfs/imei_sv, the
	# hob/dhob reports) out of the readwrite tree, and without it the SIM's
	# application never leaves "detected".
	install -Dm755 "$srcdir"/populate-readwrite.sh \
		"$pkgdir"/usr/bin/populate-readwrite.sh
	install -Dm644 "$srcdir"/tqftpserv-populate-readwrite.service \
		"$pkgdir"/usr/lib/systemd/system/tqftpserv-populate-readwrite.service
}

systemd() {
	# post-upgrade too: apk only runs post-install on a fresh install, so
	# without it an upgrade leaves the unit disabled and the modem unfixed.
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	default_systemd
}


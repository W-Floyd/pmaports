# Maintainer: William Floyd <git@notmy.space>
pkgname=go-chromatix2libcamera
pkgver=0_git20260927
pkgrel=13
_commit="ef6c6a1a0cceb926f03bc92f1408a563a9f51e64"
pkgdesc="Generate libcamera tuning files from Qualcomm CamX Chromatix tuning"
url="https://github.com/W-Floyd/go-chromatix2libcamera"
arch="all"
license="MIT"
makedepends="go"
subpackages="$pkgname-systemd"
# The project is not published yet: a git archive of $_commit.
source="go-chromatix2libcamera-$_commit.tar.gz
	go-chromatix2libcamera.service
	"
builddir="$srcdir/go-chromatix2libcamera-$_commit"

build() {
	go build -o bin/go-chromatix2libcamera ./cmd/go-chromatix2libcamera
}

check() {
	go test ./...
}

package() {
	install -Dm755 bin/go-chromatix2libcamera -t "$pkgdir"/usr/bin
	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname

	# Generates the tuning at boot on devices that install a config
	install -Dm644 "$srcdir"/go-chromatix2libcamera.service \
		-t "$pkgdir"/usr/lib/systemd/system
}


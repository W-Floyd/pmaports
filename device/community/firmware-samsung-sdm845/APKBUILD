maintainer="Dzmitry Sankouski <dsankouski@gmail.com>"
pkgname=firmware-samsung-sdm845
pkgver=20260323
pkgrel=3
pkgdesc="Firmware for Samsung Galaxy S9 series phones based on SDM845 SoC"
url="https://github.com/dsankouski/firmware-samsung-sdm845"
arch="aarch64"
license="proprietary"
subpackages="$pkgname-brcm:brcm $pkgname-brcm-bt:brcm_bt"
options="!check !strip !spdx !archcheck !tracedeps textrels pmb:cross-native"

_version="538a9464ebd63d6b65ba9f217f6056762b93150d"

source="$pkgname-$_version.tar.gz::$url/archive/$_version.tar.gz
	sensors.files
	brcm-vendor-fw.sh
	brcm-vendor-fw.service
	btattach-bcm.service
"

package() {
	while IFS="" read -r _i || [ -n "$_i" ]; do
		[ ! -d $(dirname $_i) ] && mkdir -p $(dirname $_i)
		install -Dm644 "$srcdir/$pkgname-$_version/$_i" "$pkgdir/$_i"
	done < "$srcdir/sensors.files"
}

brcm() {
	pkgdesc="BCM4361 WiFi/Bluetooth firmware links for the Galaxy S9"
	depends="msm-firmware-loader"
	install_if="$pkgname=$pkgver-r$pkgrel"

	# No firmware is shipped. The BCM4361 blobs already exist on the phone's
	# own vendor partition, which msm-firmware-loader mounts, so they are
	# symlinked into its target directory (firmware_class.path) under the
	# names the kernel asks for. See brcm-vendor-fw.sh.
	install -Dm755 "$srcdir"/brcm-vendor-fw.sh \
		"$subpkgdir"/usr/libexec/brcm-vendor-fw
	install -Dm644 "$srcdir"/brcm-vendor-fw.service \
		"$subpkgdir"/usr/lib/systemd/system/brcm-vendor-fw.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../brcm-vendor-fw.service \
		"$subpkgdir"/usr/lib/systemd/system/sysinit.target.wants/brcm-vendor-fw.service
}

brcm_bt() {
	pkgdesc="BCM4361 Bluetooth attach service for the Galaxy S9"
	depends="bluez $pkgname-brcm=$pkgver-r$pkgrel"

	# Attached with btattach rather than serdev: the DTB for this device
	# deliberately has no bluetooth node so /dev/ttyHS1 stays free. btbcm maps
	# the HCI subversion (0x4309) to BCM4361B2 and requests
	# brcm/BCM4361B2.hcd, which brcm-vendor-fw links from the vendor
	# partition; that needs a kernel carrying the BCM4361B2 entry in
	# bcm_uart_subver_table.
	#
	# Not install_if: pulling in bluez should be a deliberate choice, and this
	# depends on DTS details that may change.
	install -Dm644 "$srcdir"/btattach-bcm.service \
		"$subpkgdir"/usr/lib/systemd/system/btattach-bcm.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../btattach-bcm.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/btattach-bcm.service
}


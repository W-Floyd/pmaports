# Reference: <https://postmarketos.org/devicepkg>
maintainer="Dzmitry Sankouski <dsankouski@gmail.com>"
pkgname=device-samsung-starqltechn
pkgdesc="Samsung Galaxy S9 SM-G9600"
pkgver=14
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-sdm845
	dtc
	firmware-samsung-sdm845
	hexagonrpcd>=0.3.2-r3
	linux-postmarketos-qcom-sdm845
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	u-boot-starqltechn
	u-boot-tools
	unl0kr-fbforcerefresh
	"
makedepends="devicepkg-dev dtc"
source="
	50-dwc3-runtime-pm.rules
	50-libcamera.conf
	52-iris-camera.conf
	81-libssc-samsung-starqltechn.rules
	boot_image.its
	bootscript.sh
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	payload_mock.dts
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	mkdir -p "$pkgdir"/usr/share/u-boot/starqltechn/
	mkdir "$builddir"
	payload_mock_dtb="$builddir/payload_mock.dtb"
	dtc -I dts -O dtb -o "$payload_mock_dtb" "$srcdir/payload_mock.dts"
	install -D -m644 "$payload_mock_dtb" \
		"$pkgdir"/usr/share/u-boot/starqltechn/payload_mock.dtb
	install -D -m644 "$srcdir/"*.its \
		"$pkgdir"/usr/share/u-boot/starqltechn/
	install -D -m644 "$srcdir/"bootscript.sh \
		"$pkgdir"/usr/share/u-boot/starqltechn/

	install -D -m644 "$srcdir"/50-dwc3-runtime-pm.rules \
		"$pkgdir"/usr/lib/udev/rules.d/50-dwc3-runtime-pm.rules

	install -D -m644 "$srcdir"/81-libssc-samsung-starqltechn.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-samsung-starqltechn.rules

	install -D -m644 -t "$pkgdir"/etc/wireplumber/wireplumber.conf.d/ \
		"$srcdir"/50-libcamera.conf \
		"$srcdir"/52-iris-camera.conf
}



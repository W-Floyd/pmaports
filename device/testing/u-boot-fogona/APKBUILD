# Maintainer: William Floyd <git@notmy.space>
#
# U-Boot for fogona, chainloaded by ABL.
#
# WHY THIS EXISTS
#
# fogona's ABL will not boot a mainline kernel. It refuses every non-stock
# devicetree in any shape (see the patch's commit message, and
# /repo/investigations/boot-chain.md), does not publish the ramdisk location, and
# applies dtbo overlays that fault against a non-stock base DTB. U-Boot gets past
# all of it by carrying its own DT and its own FIT, so ABL never has to parse
# anything of ours.
#
# THE POST-LINK FIXUP IS NOT OPTIONAL
#
# ABL validates text_offset in the arm64 image header. CONFIG_POSITION_INDEPENDENT
# makes U-Boot report its link-time VA (0xffffffff80000000) where a kernel reports
# 0, and ABL cannot use that -- the symptom is a black screen and a bootloop back
# to fastboot, indistinguishable from a dozen other failures. Zeroing those 8
# bytes at offset 0x08 is the difference between that and U-Boot running. It is a
# post-link step, so it lives in package() rather than in the patch.
#
# Note we ship u-boot-nodtb.bin, NOT u-boot.bin: no control DTB is embedded, so
# U-Boot takes its FDT from ABL. (u-boot.bin is 118 KiB larger because it has one
# appended -- mistaking the two costs a boot.)
pkgname=u-boot-fogona
pkgver=2026.10_rc4
_realver=2026.10-rc4
pkgrel=0
pkgdesc="U-Boot for the Motorola Moto G Play (2024), chainloaded by ABL"
url="https://www.denx.de/wiki/U-Boot"
arch="aarch64"
license="GPL-2.0-or-later"
makedepends="
	bash
	bc
	bison
	dtc
	flex
	openssl-dev
	python3
	swig
	"
options="!check !strip !tracedeps"
source="u-boot-$_realver.tar.gz::https://github.com/u-boot/u-boot/archive/refs/tags/v$_realver.tar.gz
	0001-qcom-fogona-bringup-config.patch
	"
builddir="$srcdir/u-boot-$_realver"

build() {
	# qcom_defconfig is the generic Qualcomm phone target; fogona.config is the
	# board fragment added by the patch.
	# qcom-phone.config is NOT optional: it sets
	# CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/qcom-phone.env", which is
	# where fogona's bootcmd (the FIT address probe) lives. Without it the build
	# succeeds and produces a U-Boot with the generic env and no way to find our
	# FIT -- silently wrong, and indistinguishable from every other boot failure
	# on this device. It also brings CONSOLE_RECORD + FASTBOOT_CMD_OEM_CONSOLE,
	# the only diagnostic channel U-Boot has here.
	make O=.output qcom_defconfig
	cat board/qualcomm/qcom-phone.config >> .output/.config
	cat board/qualcomm/fogona.config >> .output/.config
	# mkeficapsule needs gnutls and we never use it; building it just drags a
	# dependency in for a host tool that has nothing to do with booting.
	echo '# CONFIG_TOOLS_MKEFICAPSULE is not set' >> .output/.config
	make O=.output olddefconfig
	make O=.output
}

package() {
	install -d "$pkgdir"/usr/share/u-boot/fogona

	# u-boot-nodtb.bin + zeroed text_offset == the binary that boots. Verified
	# byte-exact against the previously hand-built artifact.
	python3 -c "
import sys
p = '$builddir/.output/u-boot-nodtb.bin'
d = bytearray(open(p, 'rb').read())
if d[0x38:0x3c] != b'ARM\x64':
    sys.exit('no arm64 image magic at 0x38 -- wrong file?')
d[8:16] = b'\0' * 8
open('$pkgdir/usr/share/u-boot/fogona/u-boot-txt0.bin', 'wb').write(bytes(d))
"
}
sha512sums="

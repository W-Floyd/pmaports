1349f6402198cddc96955d424c662111cd27c95e81310429cfdb44f0a7567a1e744134c1fdb79d07f98141186c24eea578fa2d3ae93968856ce53848f9d23a21  0001-qcom-fogona-bringup-config.patch
"

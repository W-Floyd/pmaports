# Maintainer: William Floyd <git@notmy.space>
#
# U-Boot for fogona, chainloaded by ABL.
#
# WHY THIS EXISTS
#
# Not because ABL refuses our devicetree -- that claim was retracted, see
# /repo/investigations/boot-chain.md. The real reason is the ramdisk: ABL's
# RamdiskLoadAddress PCD is overridden per platform here, so a directly-booted
# kernel cannot find its initramfs. U-Boot sidesteps that by loading the
# kernel, DTB and initramfs itself.
#
# Since 2026-09-14 it loads them from the rootfs (UFS -> blkmap over userdata
# -> the ESP subpartition holding /boot), so there is no FIT welded into the
# payload any more. See the commits in the pinned tree.
#
# THE POST-LINK FIXUP IS NOT OPTIONAL
#
# ABL validates text_offset in the arm64 image header. CONFIG_POSITION_INDEPENDENT
# makes U-Boot report its link-time VA (0xffffffff80000000) where a kernel reports
# 0, and ABL cannot use that -- the symptom is a black screen and a bootloop back
# to fastboot, indistinguishable from a dozen other failures. Zeroing those 8
# bytes at offset 0x08 is the difference between that and U-Boot running. It is a
# post-link step, so it lives in package() rather than in the tree.
#
# TWO ARTIFACTS, AND THE DIFFERENCE MATTERS
#
# u-boot-txt0.bin      u-boot-nodtb.bin with text_offset zeroed. No control DTB,
#                      so U-Boot takes its FDT from ABL -- which means none of
#                      our devicetree applies.
# u-boot-fogona.bin    the above with U-Boot's OWN sm6225-motorola-fogona.dtb
#                      appended. This is the one that carries the snps femto USB
#                      PHY, the sm8150 UFS PHY tables and the PM6125 side keys,
#                      and it is what every image tested on hardware has been.
#
# Use u-boot-fogona.bin. u-boot-txt0.bin is kept only because
# fogona-mkboot.sh still defaults to it; that default should move.
#
# Ships u-boot-nodtb.bin, NOT u-boot.bin: the latter is 118 KiB larger because
# it already has a DTB appended, and mistaking the two costs a boot.
pkgname=u-boot-fogona
pkgver=2026.10_rc4
pkgrel=1
pkgdesc="U-Boot for the Motorola Moto G Play (2024), chainloaded by ABL"
url="https://github.com/W-Floyd/u-boot"
arch="aarch64"
license="GPL-2.0-or-later"
makedepends="
	bash
	bc
	bison
	dtc
	flex
	openssl-dev
	python3
	swig
	"
options="!check !strip !tracedeps"

# Tip of `fogona-uboot`, the board layer of the three-branch stack in ~/uboot
# (upstream-fixes-uboot -> sm6225-uboot -> fogona-uboot). Bump on every rebase.
#
# Pin a commit, never a branch: abuild checksums the tarball and a moving
# branch breaks its own checksum. See /repo/aports/README.md.
_commit="ce7a1dcb1267526ea93efcb3f013a67e90b68817"

source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/u-boot-$_commit"

build() {
	# qcom_defconfig is the generic Qualcomm phone target; fogona.config is the
	# board fragment carried in the pinned tree.
	# qcom-phone.config is NOT optional: it sets
	# CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/qcom-phone.env", which is
	# where fogona's bootcmd, the blkmap setup and the boot menu live. Without
	# it the build succeeds and produces a U-Boot with the generic env that
	# cannot find the rootfs -- silently wrong, and indistinguishable from
	# every other boot failure on this device. It also brings CONSOLE_RECORD +
	# FASTBOOT_CMD_OEM_CONSOLE, the only diagnostic channel U-Boot has here.
	make O=.output qcom_defconfig
	cat board/qualcomm/qcom-phone.config >> .output/.config
	cat board/qualcomm/fogona.config >> .output/.config
	# mkeficapsule needs gnutls and we never use it; building it just drags a
	# dependency in for a host tool that has nothing to do with booting.
	echo '# CONFIG_TOOLS_MKEFICAPSULE is not set' >> .output/.config
	make O=.output olddefconfig
	make O=.output
}

package() {
	install -d "$pkgdir"/usr/share/u-boot/fogona

	local _dtb="$builddir/.output/dts/upstream/src/arm64/qcom/sm6225-motorola-fogona.dtb"
	[ -f "$_dtb" ] || die "U-Boot's own fogona DTB was not built: $_dtb"

	python3 -c "
import sys
p = '$builddir/.output/u-boot-nodtb.bin'
d = bytearray(open(p, 'rb').read())
if d[0x38:0x3c] != b'ARM\x64':
    sys.exit('no arm64 image magic at 0x38 -- wrong file?')
d[8:16] = b'\0' * 8
open('$pkgdir/usr/share/u-boot/fogona/u-boot-txt0.bin', 'wb').write(bytes(d))
"
	# The bootable artifact: text_offset-zeroed U-Boot with its own DTB
	# appended. Without the DTB, U-Boot inherits ABL's and none of the board
	# devicetree applies.
	cat "$pkgdir"/usr/share/u-boot/fogona/u-boot-txt0.bin "$_dtb" \
		> "$pkgdir"/usr/share/u-boot/fogona/u-boot-fogona.bin
}
sha512sums="
db1c872cbbffe898cd17d4bb24201827a701a0332fd5d65ef4f1343b9e8ee39f14e5d6c2cffe9cd5dfcaead69329d9782d9771822bd9279f721fb7fe92aa3b22  u-boot-fogona-ce7a1dcb1267526ea93efcb3f013a67e90b68817.tar.gz
"

[Unit]
Description=Answer the head unit's micom
After=local-fs.target

[Service]
# Only one: skip if a micomd is already running.
ExecCondition=/bin/sh -c '! pidof micomd >/dev/null'
ExecStart=/usr/bin/micomd -dev /dev/ttyAMA2 -stats 0
# A starved or killed daemon makes the micom reset the unit: keep it off the
# OOM killer's list, ahead of the desktop for CPU, and restarted when it dies.
OOMScoreAdjust=-900
Nice=-10
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target

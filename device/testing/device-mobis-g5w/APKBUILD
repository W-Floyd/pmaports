# Reference: <https://postmarketos.org/devicepkg>
maintainer="William Floyd <git@notmy.space>"
pkgname=device-mobis-g5w
pkgdesc="Mobis DAudio Plus Gen5 Wide head unit (Telechips TCC8031)"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	go-msm-firmware-loader
	linux-tcc803x
	micomd
	postmarketos-base
	postmarketos-mkinitfs
"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-openrc:openrc
	$pkgname-systemd:systemd
	"
source="
	deviceinfo
	mobis-g5w-firmware.sh
	mobis-g5w-firmware.service
	mobis-g5w-firmware.initd
	nura-loop.sh
	nura-stick.sh
	30-nura.modules
	40-micomd.files
	mobis-g5w-micomd.service
	mobis-g5w-logs.sh
	mobis-g5w-logs.service
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/mobis-g5w-firmware.sh \
		"$pkgdir"/usr/libexec/mobis-g5w-firmware

	# Boot from an image file on a FAT USB stick (see nura-loop.sh): an initramfs
	# hook, and the drivers it needs, picked up by postmarketos-mkinitfs.
	install -Dm644 "$srcdir"/nura-loop.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/nura-loop.sh
	install -Dm644 "$srcdir"/30-nura.modules \
		"$pkgdir"/usr/share/mkinitfs/modules/30-nura.modules
	# micomd goes into the initramfs, which starts it before the grow.
	install -Dm644 "$srcdir"/40-micomd.files \
		"$pkgdir"/usr/share/mkinitfs/files/40-micomd.files
	# The last step before the switch: the stick stays reachable from the system.
	install -Dm644 "$srcdir"/nura-stick.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks-cleanup/nura-stick.sh
	install -Dm755 "$srcdir"/mobis-g5w-logs.sh \
		"$pkgdir"/usr/libexec/mobis-g5w-logs
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="openrc"
	install -Dm755 "$srcdir"/mobis-g5w-firmware.initd \
		"$subpkgdir"/etc/init.d/mobis-g5w-firmware
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/mobis-g5w-firmware.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-firmware.service
	install -Dm644 "$srcdir"/mobis-g5w-micomd.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-micomd.service
	install -Dm644 "$srcdir"/mobis-g5w-logs.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-logs.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	for u in mobis-g5w-firmware mobis-g5w-micomd mobis-g5w-logs; do
		ln -s ../$u.service \
			"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/$u.service
	done
}

sha512sums=""

# Reference: <https://postmarketos.org/devicepkg>
maintainer="William Floyd <git@notmy.space>"
pkgname=device-mobis-g5w
pkgdesc="Mobis DAudio Plus Gen5 Wide head unit (Telechips TCC8031)"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
# rsync and gpsd-clients are for testing only: updates to the running unit over
# Wi-Fi (usb/sync -w), and gpspipe/cgps to look at what gpsd serves.
depends="
	go-msm-firmware-loader
	gpsd
	gpsd-clients
	hippod
	linux-tcc803x
	micom-livi
	micomd
	postmarketos-base
	postmarketos-mkinitfs
	rsync
"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-openrc:openrc
	$pkgname-systemd:systemd
	"
source="
	deviceinfo
	mobis-g5w-firmware.sh
	mobis-g5w-firmware.service
	mobis-g5w-firmware.initd
	nura-loop.sh
	nura-stick.sh
	30-nura.modules
	40-micomd.files
	mobis-g5w-micomd.service
	mobis-g5w-micom-livi.service
	mobis-g5w-hippod.service
	mobis-g5w-gpsd.service
	mobis-g5w-logs.sh
	mobis-g5w-logs.service
	mobis-g5w-modprobe.conf
	mobis-g5w-amp.sh
	mobis-g5w-amp.service
	mobis-g5w-tmp.conf
	50-mobis-g5w.json
	50_mobis-g5w.gschema.override
	monitors.xml
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/mobis-g5w-firmware.sh \
		"$pkgdir"/usr/libexec/mobis-g5w-firmware

	# Boot from an image file on a FAT USB stick (see nura-loop.sh): an initramfs
	# hook, and the drivers it needs, picked up by postmarketos-mkinitfs.
	install -Dm644 "$srcdir"/nura-loop.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/nura-loop.sh
	install -Dm644 "$srcdir"/30-nura.modules \
		"$pkgdir"/usr/share/mkinitfs/modules/30-nura.modules
	# micomd goes into the initramfs, which starts it before the grow.
	install -Dm644 "$srcdir"/40-micomd.files \
		"$pkgdir"/usr/share/mkinitfs/files/40-micomd.files
	# The last step before the switch: the stick stays reachable from the system.
	install -Dm644 "$srcdir"/nura-stick.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks-cleanup/nura-stick.sh
	install -Dm755 "$srcdir"/mobis-g5w-logs.sh \
		"$pkgdir"/usr/libexec/mobis-g5w-logs
	install -Dm644 "$srcdir"/mobis-g5w-modprobe.conf \
		"$pkgdir"/usr/lib/modprobe.d/mobis-g5w.conf
	install -Dm755 "$srcdir"/mobis-g5w-amp.sh \
		"$pkgdir"/usr/libexec/mobis-g5w-amp
	# LIVI's first-run settings for this head unit (its preset.d, see
	# livi-core config_file.rs): wlan0 as a 5 GHz access point, which wireless
	# Android Auto needs; hippod's GNSS pty; key bindings matching micomd's
	# keymap; kiosk mode; the panel's size. The car's own values belong to its
	# variant, not here, except the 2024 EV6 Long Range's, for Android Auto's
	# energy model: CCS1 and J1772, 10.9 kW AC and 240 kW DC (kiamedia.com 2024
	# EV6 specifications); road load from the EPA 2024 test car list, Long Range
	# AWD 19-inch, target coefficients 23.992 lbf, 0.22890 lbf/mph,
	# 0.020912 lbf/mph² in N, N/(m/s), N/(m/s)²; the 77.4 kWh pack's DC
	# charging curve from evkx.net's EV6 Long Range (GEN1) page, 1 to 100 %
	# (github.com/evkx/evkx.github.io eec0f1f2,
	# content/models/kia/ev6/ev6_long_range_awd_gen1/chargingcurve.md).
	install -Dm644 "$srcdir"/50-mobis-g5w.json \
		"$pkgdir"/usr/share/livi/preset.d/50-mobis-g5w.json
	# GNOME on a head unit: no lock screen, blanking or idle suspend.
	install -Dm644 "$srcdir"/50_mobis-g5w.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/50_mobis-g5w.gschema.override
	# The panel at scale 1, mutter's system-wide default. From the panel's real
	# size (293x110 mm, 166 dpi) mutter picks 1.25 on its own, and every client
	# then renders at 1536x576 and is stretched to 1920x720.
	install -Dm644 "$srcdir"/monitors.xml "$pkgdir"/etc/xdg/monitors.xml
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="openrc"
	install -Dm755 "$srcdir"/mobis-g5w-firmware.initd \
		"$subpkgdir"/etc/init.d/mobis-g5w-firmware
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/mobis-g5w-firmware.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-firmware.service
	install -Dm644 "$srcdir"/mobis-g5w-micomd.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-micomd.service
	install -Dm644 "$srcdir"/mobis-g5w-micom-livi.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-micom-livi.service
	install -Dm644 "$srcdir"/mobis-g5w-hippod.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-hippod.service
	install -Dm644 "$srcdir"/mobis-g5w-gpsd.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-gpsd.service
	install -Dm644 "$srcdir"/mobis-g5w-logs.service \
		"$subpkgdir"/usr/lib/systemd/system/mobis-g5w-logs.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	for u in mobis-g5w-firmware mobis-g5w-micomd mobis-g5w-micom-livi mobis-g5w-hippod mobis-g5w-gpsd mobis-g5w-logs; do
		ln -s ../$u.service \
			"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/$u.service
	done
	# /tmp in RAM. The root file system is ext4 in an image file on the FAT USB
	# stick: a large file written to /tmp there saturated the stick and stalled
	# the desktop. postmarketos-base-systemd keeps tmp.mount off below 2 GB of
	# RAM (10-min-memory.conf); this unit has 1.6 GB, with zram swap behind it.
	install -Dm644 "$srcdir"/mobis-g5w-tmp.conf \
		"$subpkgdir"/usr/lib/systemd/system/tmp.mount.d/50-mobis-g5w.conf
	# Per session: it follows that session's sound server.
	install -Dm644 "$srcdir"/mobis-g5w-amp.service \
		"$subpkgdir"/usr/lib/systemd/user/mobis-g5w-amp.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/user/default.target.wants
	ln -s ../mobis-g5w-amp.service \
		"$subpkgdir"/usr/lib/systemd/user/default.target.wants/mobis-g5w-amp.service
}

sha512sums=""

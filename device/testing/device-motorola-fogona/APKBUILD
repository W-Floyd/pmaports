# Reference: <https://postmarketos.org/devicepkg>
# Background and hardware notes live in /repo; keep this file to what a reader
# needs in order to change it safely.
maintainer="William Floyd <git@notmy.space>"
pkgname=device-motorola-fogona
pkgdesc="Motorola Moto G Play (2024)"
pkgver=0
pkgrel=52
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"

# The two oneshot units this package ships have to be *enabled*, and Alpine's
# preset policy does not do it -- installing the unit file is not enough. See
# the post-install script: a fresh install left both disabled, which cost WiFi
# entirely. post-upgrade as well, because apk runs post-install only on a fresh
# install.
install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="$pkgname-audio:audio"

# android-tools       mkbootimg/avbtool for boot-deploy's header_version 4 path
# bluez-btmgmt        `btmgmt public-addr`, which is how fogona-bt-addr hands
#                     the controller this handset's own Bluetooth address. It
#                     is NOT in the `bluez` package, and neither is it in
#                     `bluez-deprecated` (that one has hciconfig/hcitool) --
#                     postmarketOS's own bootmac depends on it for the same
#                     call. Without it the controller stays HCI_UNCONFIGURED
#                     and BlueZ reports no controller at all.
# make-dynpart-mappings  maps vendor and modem out of the dynamic `super`
# mesa-vulkan-freedreno  Turnip; the only Vulkan ICD for the A610
# msm-firmware-loader    mounts vendor and links 292 blobs into the fw search
#                        path: modem PIL + wlanmdsp, WLAN board data, zap shader
# qbootctl               marks the A/B slot successful on each good boot. Its
#                        -systemd subpackage carries install_if, so do not list
#                        that. Without it the slot stays Successful=0, ABL
#                        decrements its retry counter every boot, and since
#                        slot _b is not bootable, exhausting _a means the
#                        handset stops booting at all.
# qca-swiss-army-knife   ath10k-fwencoder here, ath10k-bdencoder at runtime
# qrtr                   qrtr-lookup, which is how you tell whether the modem
#                        finished RF bring-up -- `qrtr-lookup | awk '$1==41'`
#                        is the whole test, and service 41 is absent on every
#                        failing boot. `qrtr-libs` arrives on its own as a
#                        libqmi dependency and ships no binaries, so the tools
#                        were hand-installed and a reinstall lost them. No
#                        -openrc/-systemd subpackage exists, so this does not
#                        collide with the in-kernel qrtr-ns.
# qmi-utils              qmicli. The QMI-side counterpart to qrtr-lookup, and
#                        the only way to see why a SIM is not coming up:
#                        `--uim-get-card-status` shows the USIM application
#                        stuck at 'detected' instead of 'ready', and
#                        `--pdc-list-configs=software` shows whether the modem
#                        has any carrier config at all. Note the binary is in
#                        `qmi-utils`, NOT in `libqmi`, which ships only the
#                        library and qmi-proxy. Give PDC calls a bounded
#                        `timeout` -- see TRAPS.md.
# hexagonrpcd,           FastRPC to the ADSP, which is how the sensors are
# hexagonrpcd-systemd,   reached. Like qcom-diag, its -systemd and -udev
# hexagonrpcd-udev       subpackages carry no install_if, so list them or the
#                        units and rules never land. The **rootpd** service
#                        works as-is. **sensorspd** needs a filesystem to
#                        serve -- what FP4/FP5 ship as a -hexagonfs firmware
#                        subpackage -- or the sensor registry cannot read
#                        sns_reg_version and the ADSP crash-loops. fogona's
#                        is built at boot from the handset's own vendor and
#                        persist partitions by fogona-hexagonfs (not
#                        redistributable, so not a firmware package), and a
#                        drop-in points sensorspd at it. None of this touches
#                        the modem; it was added for sensors and measured not
#                        to change RF.
# 81voltd,               the QMI IMS data service the modem's IMS stack asks
# 81voltd-systemd        the AP for. Without it IMS never registers, and on a
#                        VoLTE-only network (AT&T) every incoming call goes
#                        straight to voicemail; with it calls ring. What
#                        soc-qcom devices pull in. Its -systemd subpackage
#                        carries no install_if and nothing enables the unit,
#                        so both are listed and the post-install enables it.
# qcom-diag,             diag-router: the modem's DIAG channel, and the only
# qcom-diag-systemd      instrument that gets anything out of the modem itself
#                        (EFS, NV, F3). Unlike rmtfs and tqftpserv, qcom-diag's
#                        subpackages carry NO install_if, so -systemd has to be
#                        listed explicitly or the unit never lands -- and
#                        nothing enables it either, so the post-install does.
# systemd-boot           supplies the EFI app boot-deploy's add_systemd_boot()
#                        installs as /boot/EFI/BOOT/BOOTAA64.EFI, plus the
#                        bootloader-spec entries beside it. Without the package
#                        boot-deploy logs "systemd-boot EFI app or powervm-boot
#                        not found, skipping" and writes neither. U-Boot loads
#                        that app by path, so no EFI variable store is needed --
#                        EFI/BOOT/BOOTAA64.EFI is the removable-media fallback,
#                        found by convention rather than via BootOrder.
# rmtfs, tqftpserv       the modem's EFS and firmware servers; without rmtfs the
#                        modem watchdogs ~40 s in. Their -openrc/-systemd
#                        subpackages carry install_if, so do not list them.
# u-boot-fogona          the payload boot-deploy wraps into the boot image
depends="
	linux-motorola-fogona
	81voltd
	81voltd-systemd
	android-tools
	bluez-btmgmt
	linux-firmware-ath10k
	make-dynpart-mappings
	mesa-vulkan-freedreno
	msm-firmware-loader
	postmarketos-base
	hexagonrpcd
	hexagonrpcd-systemd
	hexagonrpcd-udev
	qbootctl
	qca-swiss-army-knife
	qcom-diag
	qcom-diag-systemd
	qmi-utils
	qrtr
	rmtfs
	systemd-boot
	tqftpserv
	u-boot-fogona
"
makedepends="alsa-utils devicepkg-dev qca-swiss-army-knife"
source="deviceinfo
	kernel-cmdline.conf
	50-fogona-mesa.conf
	50-fogona-mesa.sh
	fogona-video.conf
	fogona-wlan-bdf.sh
	fogona-wlan-bdf.service
	fogona-modem-efs.sh
	fogona-modem-efs.service
	fogona-ssreq-stub.py
	fogona-ssreq-stub.service
	fogona-mmi-radio.py
	fogona-mmi-radio.service
	fogona-bt-addr.py
	fogona-bt-addr@.service
	fogona-bt-addr.rules
	fogona-hexagonfs.sh
	fogona-hexagonfs.service
	hexagonrpcd-sensorspd-hexagonfs.conf
	81-libssc-motorola-fogona.rules
	rmtfs-writable-efs.conf
	sshd-early.service
	50-fogona-vmlinuz-efi.sh
	Moto-G-Play-2024-tplg.conf
	ucm-Moto-G-Play-2024.conf
	ucm-HiFi.conf
	"

build() {
	devicepkg_build $startdir $pkgname

	# Stand-in for the ramdisk slot in the chainloadable boot image, which
	# U-Boot never reads -- see deviceinfo_bootimg_override_initramfs.
	fallocate -l 4k dummy-initramfs

	# firmware-5.bin is a 60-byte metadata container, not firmware -- the real
	# image is wlanmdsp on the modem DSP. Two feature flags are load-bearing
	# and absent from linux-firmware's copy:
	#   mfp-support                  ath10k only forwards a peer's PMF flag to
	#                                the firmware if the file declares it;
	#                                without it 802.11w APs never get block-ack
	#   single-chan-info-per-channel this firmware sends one chan_info event per
	#                                channel; the paired handler misreads them
	ath10k-fwencoder --create \
		--features=wowlan,no-nwifi-decap-4addr-padding,mfp-support,allows-mesh-bcast,mgmt-tx-by-ref,non-bmi,single-chan-info-per-channel \
		--set-wmi-op-version=tlv --set-htt-op-version=tlv \
		--set-fw-api=5

	# The AudioReach topology for the speakers. Built from source: it is
	# ours, not a vendor blob. The file's comments say why each value is
	# what it is.
	alsatplg -c "$srcdir"/Moto-G-Play-2024-tplg.conf \
		-o Moto-G-Play-2024-tplg.bin
}

package() {
	devicepkg_package $startdir $pkgname

	# mkinitfs stages /usr/share/u-boot/$uboot_boardname into boot-deploy's
	# work dir, which is how boot-deploy finds this by name.
	install -Dm644 dummy-initramfs \
		"$pkgdir"/usr/share/u-boot/fogona/dummy-initramfs

	# Both channels are needed: environment.d reaches phoc under the systemd
	# user manager, profile.d covers login shells. pam_env is not in this
	# distro's base-session stack, so /etc/environment would not work.
	install -Dm644 "$srcdir"/50-fogona-mesa.conf \
		"$pkgdir"/usr/lib/environment.d/50-fogona-mesa.conf
	install -Dm644 "$srcdir"/50-fogona-mesa.sh \
		"$pkgdir"/etc/profile.d/50-fogona-mesa.sh

	# Both venus and iris match video-codec@5a00000; without this, which one
	# binds depends on module load order. See the file for why iris is the one.
	install -Dm644 "$srcdir"/fogona-video.conf \
		"$pkgdir"/etc/modprobe.d/fogona-video.conf

	# postmarketos/ rather than firmware/ath10k/: msm-firmware-loader links
	# this directory into the firmware search root, which is consulted first,
	# so these override the vendor partition and linux-firmware-ath10k without
	# owning any of its paths -- leaving it installed as the fallback.
	# board-2.bin is not here; fogona-wlan-bdf builds it at boot from the
	# handset's own calibration blob, which is not redistributable.
	install -Dm644 firmware-5.bin \
		-t "$pkgdir"/usr/lib/firmware/postmarketos/ath10k/WCN3990/hw1.0/
	install -Dm755 "$srcdir"/fogona-wlan-bdf.sh \
		"$pkgdir"/usr/sbin/fogona-wlan-bdf
	install -Dm644 "$srcdir"/fogona-wlan-bdf.service \
		"$pkgdir"/usr/lib/systemd/system/fogona-wlan-bdf.service

	# The modem cannot persist anything through rmtfs as upstream ships it:
	# -r keeps every write in a RAM shadow buffer and reports success. That
	# is why the carrier MCFG activated and then read "Pending" forever. Copy
	# the EFS to writable files and point rmtfs at those, without ever opening
	# the real partitions for writing -- reasoning in the script's header.
	install -Dm755 "$srcdir"/fogona-modem-efs.sh \
		"$pkgdir"/usr/sbin/fogona-modem-efs
	install -Dm644 "$srcdir"/fogona-modem-efs.service \
		"$pkgdir"/usr/lib/systemd/system/fogona-modem-efs.service

	# The modem logs "Failed to connect to SSREQ server instance:16" without
	# this. It does NOT fix RF init -- re-confirmed 2026-09-22 with the stub
	# running before the modem started and service 41 still absent -- but
	# stock's AP does publish 53/16, and that is the only AP-side service we
	# know we were missing. Packaged rather than hand-installed because it was
	# already lost once, in the reinstall that also took out WiFi and the EFS
	# copies.
	install -Dm755 "$srcdir"/fogona-ssreq-stub.py \
		"$pkgdir"/usr/sbin/fogona-ssreq-stub
	install -Dm644 "$srcdir"/fogona-ssreq-stub.service \
		"$pkgdir"/usr/lib/systemd/system/fogona-ssreq-stub.service
	install -Dm644 "$srcdir"/rmtfs-writable-efs.conf \
		"$pkgdir"/usr/lib/systemd/system/rmtfs.service.d/10-writable-efs.conf

	# The modem's RF hardware id depends on the radio SKU (ATT or RET),
	# which ABL detects per unit and never passes to us. This reads ABL's
	# result from the hw partition into the kernel's mmi-unit-info block
	# before rmtfs starts the modem; the rmtfs drop-in above pulls it in.
	# Without it RF init fails on HWID 0 and the modem stays offline.
	install -Dm755 "$srcdir"/fogona-mmi-radio.py \
		"$pkgdir"/usr/sbin/fogona-mmi-radio
	install -Dm644 "$srcdir"/fogona-mmi-radio.service \
		"$pkgdir"/usr/lib/systemd/system/fogona-mmi-radio.service

	# Bluetooth comes up HCI_UNCONFIGURED because WCN3988 has no per-device
	# address -- it reports the shared default out of its NVM file, and the
	# real one is in Motorola's utags partition. Unlike the units above this
	# one is udev-activated rather than enabled, because it has to run when
	# the controller appears (~25 s in) and not when bluetooth.target is first
	# pulled; the unit file says why at length. Templated on the controller
	# name, so the rule passes %k.
	install -Dm755 "$srcdir"/fogona-bt-addr.py \
		"$pkgdir"/usr/sbin/fogona-bt-addr
	install -Dm644 "$srcdir"/fogona-bt-addr@.service \
		"$pkgdir"/usr/lib/systemd/system/fogona-bt-addr@.service
	install -Dm644 "$srcdir"/fogona-bt-addr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-fogona-bt-addr.rules

	# The ADSP sensors (accelerometer, light, proximity via libssc): build
	# the hexagonfs tree sensorspd serves, and point sensorspd at it. No
	# enable needed: hexagonrpcd-systemd enables sensorspd, and the drop-in's
	# Requires= pulls fogona-hexagonfs in. The udev rule gives
	# iio-sensor-proxy the accelerometer's mount matrix.
	install -Dm755 "$srcdir"/fogona-hexagonfs.sh \
		"$pkgdir"/usr/sbin/fogona-hexagonfs
	install -Dm644 "$srcdir"/fogona-hexagonfs.service \
		"$pkgdir"/usr/lib/systemd/system/fogona-hexagonfs.service
	install -Dm644 "$srcdir"/hexagonrpcd-sensorspd-hexagonfs.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-fogona-hexagonfs.conf
	install -Dm644 "$srcdir"/81-libssc-motorola-fogona.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	# TEMPORARY, paired with the unfixed panel bring-up stall. sshd is
	# normally ordered After=network.target, which puts it behind
	# NetworkManager -- and the stall wedges NetworkManager, so a stalled
	# handset answers ping (the initramfs address on usb0 survives) while
	# refusing every TCP port. That is why a stall leaves no journal and no
	# way in. See /repo/investigations/display-vblank-boot-stall.md.
	#
	# /etc rather than /usr/lib because openssh owns the path there and two
	# packages cannot own one file; and a whole unit rather than a drop-in
	# because Before=/After= cannot be reset -- see the file's own header.
	# Drop both this and the file once the stall is fixed.
	install -Dm644 "$srcdir"/sshd-early.service \
		"$pkgdir"/etc/systemd/system/sshd.service

	# STOPGAP, see the file. boot-deploy runs hooks from here before it
	# writes the bootloader-spec entry, which is what lets this keep
	# /boot/vmlinuz.efi in step with /boot/vmlinuz. Drop it once a kernel
	# shipping its own vmlinuz.efi has been built.
	install -Dm755 "$srcdir"/50-fogona-vmlinuz-efi.sh \
		"$pkgdir"/usr/share/boot-deploy/hooks/50-fogona-vmlinuz-efi

	# Speakers: the topology the sound card requests by its DT model name,
	# and the UCM profile the sound server needs to enable the route (moved
	# to -audio). UCM finds the profile by driver name (sm6225) and card
	# long name.
	install -Dm644 Moto-G-Play-2024-tplg.bin \
		-t "$pkgdir"/usr/lib/firmware/qcom/sm6225/
	install -Dm644 "$srcdir"/ucm-Moto-G-Play-2024.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm6225/Moto-G-Play-2024.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm6225/Moto-G-Play-2024/HiFi.conf
}

# PipeWire rather than the default PulseAudio: through PulseAudio the
# speakers crackle and stutter, while the same audio played direct to the
# hardware or through PipeWire is clean (not tsched; tsched=0 still
# crackles). As xiaomi-nabu does.
audio() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio"
	depends="
		alsa-ucm-conf
		postmarketos-base-ui-audio-backend-pipewire
	"

	amove usr/share/alsa/ucm2/conf.d/sm6225
	amove usr/share/alsa/ucm2/Qualcomm/sm6225
}


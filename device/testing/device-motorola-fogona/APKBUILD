# Reference: <https://postmarketos.org/devicepkg>
maintainer="William Floyd <git@notmy.space>"
pkgname=device-motorola-fogona
pkgdesc="Motorola Moto G Play (2024)"
pkgver=0
pkgrel=29
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# android-tools rather than the standalone mkbootimg: at header_version 4
# boot-deploy uses modern mkbootimg's --vendor_boot/--vendor_ramdisk syntax,
# which the mkbootimg fork does not have.
# make-dynpart-mappings maps the logical partitions out of `super`, which is
# how vendor and modem are reachable at all.
#
# msm-firmware-loader is back, and this time it works. It was dropped in
# pkgrel 12 because its unit walks the vendor partition, which is EROFS, and any
# lookup there wedged unkillably -- starving systemd-udevd so boot ended in
# emergency mode. That was never an erofs bug: iomap's IOMAP_INLINE path failed
# to advance its iterator, so the caller's loop spun forever. Fixed in the
# kernel; see TODO.md.
#
# Verified on hardware after that fix: the loader completes, mounts vendor as
# EROFS without wedging, and assembles 292 files into the firmware search path.
# What it provides:
#   modem/image/modem.mdt + wlanmdsp      - modem PIL, and WiFi behind it
#   modem/image/bdwlan_fogona_ipa.bin     - this handset's WLAN board data
#   modem/image/a610_zap.mdt              - GPU zap shader; resolves, though
#                                           the A610 needs more DTS work first
#
# Not everything depends on it: touch firmware ships on the rootfs at
# /lib/firmware/postmarketos/chipone_firmware.bin, and the CW2217 fuel gauge
# takes its battery profile from the device tree.
# mesa-vulkan-freedreno is Turnip, the Vulkan driver for the Adreno 610. It is
# not required for the session -- wlroots and GTK render with GLES via
# freedreno's gallium driver -- but without it the device has no Vulkan ICD at
# all, so wlroots' Vulkan fallback path dead-ends and zink (present in
# mesa-dri-gallium) has nothing to sit on. Added once the GPU actually worked;
# it would have been dead weight before that.
# linux-motorola-fogona is our own 7.3 tree. This used to be
# linux-postmarketos-qcom-sm6225 (TQMatvey's 6.1) -- a packaged kernel that was
# never the one the phone ran, which is how /lib/modules ended up hand-copied.
# Note the apk does not produce the bootable image: this bootloader ignores a
# staged kernel, so /repo/tools/mkboot.sh still builds the U-Boot FIT you
# `fastboot boot`. What the package buys is that modules are versioned and
# cannot drift out of sync with the Image.
# u-boot-tools is for mkimage, which fogona-mkboot.sh needs to build the FIT on
# the device, and dtc is what mkimage shells out to in order to compile the .its
# -- without it mkimage fails with a bare "dtc: not found". android-tools already
# covers mkbootimg and avbtool. Together they let the handset assemble and write
# its own boot image, so a kernel update is `apk upgrade && reboot` rather than a
# manual fastboot cycle -- the same thing boot-deploy does for 47 other devices,
# except fogona's boot image is a U-Boot+FIT payload and needs its own assembly
# step. u-boot-fogona supplies the payload those scripts weld the FIT onto;
# fogona-mkboot exits with "missing: /usr/share/u-boot/fogona/u-boot-txt0.bin"
# without it.
depends="
	linux-motorola-fogona
	android-tools
	make-dynpart-mappings
	mesa-vulkan-freedreno
	msm-firmware-loader
	postmarketos-base
	u-boot-tools
	u-boot-fogona
	dtc
"
makedepends="devicepkg-dev"
source="deviceinfo
	kernel-cmdline.conf
	50-fogona-mesa.conf
	50-fogona-mesa.sh
	fogona-mkboot.sh
	fogona-flash-boot.sh
	fogona-video.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Both channels are needed, and neither is redundant. environment.d is
	# what reaches phoc, which runs under a systemd user manager -- note
	# pam_env is not in this distro's base-session stack, so /etc/environment
	# is not a reliable channel here (and belongs to linux-pam anyway).
	# profile.d covers login shells, matching how other pmaports devices ship
	# their Mesa and wlroots overrides.
	install -Dm644 "$srcdir"/50-fogona-mesa.conf \
		"$pkgdir"/usr/lib/environment.d/50-fogona-mesa.conf
	install -Dm644 "$srcdir"/50-fogona-mesa.sh \
		"$pkgdir"/etc/profile.d/50-fogona-mesa.sh

	# On-device boot image assembly + flashing. See the scripts for why fogona
	# cannot use boot-deploy's bootimg_override_* path (that layout puts the FIT
	# in the ramdisk slot, which this bootloader does not hand over).
	install -Dm755 "$srcdir"/fogona-mkboot.sh \
		"$pkgdir"/usr/sbin/fogona-mkboot
	install -Dm755 "$srcdir"/fogona-flash-boot.sh \
		"$pkgdir"/usr/sbin/fogona-flash-boot

	# Both venus and iris match video-codec@5a00000; without this, which one
	# binds depends on module load order. See the file for why iris is the one.
	install -Dm644 "$srcdir"/fogona-video.conf \
		"$pkgdir"/etc/modprobe.d/fogona-video.conf
}


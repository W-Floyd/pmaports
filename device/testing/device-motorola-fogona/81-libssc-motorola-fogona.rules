# iio-sensor-proxy with libssc: accelerometer mount matrix. The SSC sensors
# report in a frame rotated 180 degrees about Z from the screen (libssc falls
# back to identity because the registry's own matrix is all zeros). Z is
# already right -- +1 g face up -- so unlike the -1 -1 -1 most libssc devices
# carry, only X and Y are negated.

SUBSYSTEM=="misc", KERNEL=="fastrpc-*", ENV{ACCEL_MOUNT_MATRIX}+="-1, 0, 0; 0, -1, 0; 0, 0, 1"

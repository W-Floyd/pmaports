# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
#
# Originally written from the LineageOS device tree
# (naf419/android_device_motorola_fogona, BoardConfig.mk) and device-lenovo-tb128fu,
# before anything booted. That header is no longer true: fogona boots mainline,
# and the boot geometry below has since been verified against the stock
# vendor_boot header read off this handset. Individual values say which are
# confirmed and which are still inherited guesses.

deviceinfo_format_version="0"
deviceinfo_name="Motorola Moto G Play (2024)"
deviceinfo_manufacturer="Motorola"
deviceinfo_codename="motorola-fogona"
deviceinfo_year="2024"
# One DTB per panel variant, as device-motorola-dubai does: fogona is
# dual-sourced, so the panel cannot be assumed. This unit is the Tianma
# ICNL9916C; csot/nt36528 and txd/ili9883c are not written yet.
#
# This must match a DTB the kernel package actually ships. Until 2026-09-12 the
# tree built only `sm6225-motorola-fogona.dtb` while this asked for the
# -icnl9916c name, so boot-deploy packed a stray 6 KiB DTB from elsewhere in
# /boot/dtbs instead of fogona's 58 KiB one, and vendor_boot described the wrong
# board. Fixed by naming the DTS for its panel, not by dropping the suffix.
deviceinfo_dtb="qcom/sm6225-motorola-fogona-icnl9916c"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1600"

# Bootloader related
deviceinfo_flash_method="fastboot"
# fogona has a 6.4 GB dynamic `super` (system system_ext vendor product
# system_dlkm vendor_dlkm). Writing a raw rootfs over it destroys the logical
# partition metadata, so the stock system is gone afterwards and the other A/B
# slot is the way back. `vbmeta` must be flashed with --disable-verity
# --disable-verification or AVB rejects an unsigned kernel.
# UNRESOLVED: `fastboot getvar all` shows a real raw `userdata` of 0xCCC9FB000
# (51.2 GiB) -- eight times `super`, and no logical-partition metadata to
# destroy. Writing the rootfs there instead would leave stock Android intact on
# both slots. See README, "This makes the rootfs target an open question".
# Bootloader reports max-download-size:0x10000000.
deviceinfo_flash_fastboot_max_size="256"
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
# CHANGED to userdata -- flagged for review. `super` destroys the dynamic
# partition metadata and takes stock Android with it, and the only restore
# package available is the wrong carrier channel with a downgraded vbmeta
# rollback index. `userdata` is 51.2 GiB, raw, holds nothing of value, and
# leaves stock bootable on slot A throughout. One line to change back.
deviceinfo_flash_fastboot_partition_rootfs="userdata"
deviceinfo_generate_bootimg="true"

# The boot partition holds U-Boot, not a kernel: ABL never publishes the
# ramdisk location, so U-Boot is chainloaded and loads the kernel, DTB and
# initramfs from /boot over UFS itself. A kernel upgrade needs no reflash.
# Same mechanism as device-samsung-starqltechn:
#   uboot_boardname          mkinitfs stages /usr/share/u-boot/fogona/* into
#                            boot-deploy's work dir
#   bootimg_override_payload that file replaces vmlinuz in the boot image. No
#                            compression -- ABL wants a raw arm64 image
#   flash_kernel_on_update   boot-deploy resolves the A/B slot and dd's it
# boot-deploy's ab_get_slot() greps /proc/cmdline for androidboot.slot_suffix,
# so U-Boot must keep passing it (bootargs_disk in qcom-phone.env) or findfs
# looks for a partition called plain `boot` and the apk transaction fails.
#
# bootimg_override_payload is LOAD-BEARING: it is what puts U-Boot in the boot
# image instead of a kernel. What keeps boot-deploy away from vendor_boot is a
# separate thing -- header_version being left undeclared, further down.
deviceinfo_uboot_boardname="fogona"
deviceinfo_bootimg_override_payload="u-boot-fogona.bin"
deviceinfo_flash_kernel_on_update="true"
# Staging for the standard U-Boot boot path. Writes /boot/extlinux/extlinux.conf
# with the generated cmdline, kernel and dtb. Nothing reads it yet -- bootcmd in
# qcom-phone.env still runs the hand-rolled bootdisk chain -- so this is inert
# until that is switched to bootstd, and exists so the two can be compared.
deviceinfo_generate_extlinux_config="true"
deviceinfo_rootfs_image_sector_size="4096"
deviceinfo_flash_pagesize="4096"
# Downstream builds BOARD_BOOT_HEADER_VERSION := 4 and this bootloader appears
# to require it: a v2 image flashes to `boot` without complaint but the
# bootloader then reports "Boot Failed" with no kernel output at all -- not even
# earlycon or fbcon -- which points at a failure before handoff rather than a
# kernel problem. Tried twice.
#
# At >= 3 boot-deploy builds boot.img as kernel-only and puts the dtb, ramdisk
# and cmdline in vendor_boot.img. That matters here beyond format correctness:
# it never touches `init_boot`, which this bootloader refuses to accept modified
# images for. Both `boot` and `vendor_boot` are flashable.
# header_version is deliberately NOT declared here, and the version is passed
# to mkbootimg through bootimg_custom_args instead. device-jolla-c2 does the
# same thing for the same reason; see its deviceinfo.
#
# boot-deploy's >= 3 path builds boot.img and vendor_boot.img as a matched pair
# and flashes both. fogona owns only `boot`: ABL runs first, builds its
# devicetree by selecting a stock qcom,khaje base DTB out of vendor_boot and
# applying the dtbo overlays to it, and only then hands off to the chainloaded
# U-Boot. A mainline-derived vendor_boot gives those overlays a base they
# cannot apply to, so ABL never hands off and the A/B counter drains.
#
# Retested 2026-09-16, including the suggestion that clearing dtbo would make a
# mainline vendor_boot acceptable: mainline vendor_boot + zeroed dtbo does not
# boot either. The stock pair has to survive untouched. Proven earlier from
# ABL's own logfs -- see /repo/investigations/boot-chain.md.
#
# Leaving header_version undeclared keeps boot-deploy on its pre-v3 path, which
# builds no vendor_boot at all, while --header_version 4 below still produces
# the v4 image this bootloader requires. Verified: the resulting boot.img
# reports "boot image header version: 4" and vendor_boot is untouched.
#
# Revisit if boot-deploy!117 lands -- that would let this be declared honestly.
# VERIFIED against the stock vendor_boot.img header (CC U1TF34.100-35):
#   kernel_addr=0x8000  ramdisk_addr=0x1000000  tags_addr=0x100
#   dtb_addr=0x1f00000  page_size=4096
# All four offsets and the pagesize match exactly. Previously guesses from the
# LineageOS BoardConfig; now confirmed against real firmware.
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_offset_dtb="0x01f00000"

# boot-deploy's header_version >= 3 path does NOT pass --base to mkbootimg, and
# ignores deviceinfo_flash_offset_base (that is only used by the v2 path). Modern
# mkbootimg then defaults --base to 0x10000000, which put every address in
# vendor_boot 0x10000000 above stock's:
#
#   ours   kernel 0x10008000  ramdisk 0x11000000  tags 0x10000100  dtb 0x11f00000
#   stock  kernel 0x00008000  ramdisk 0x01000000  tags 0x00000100  dtb 0x01f00000
#
# mkbootimg's default per-field offsets already match this device, so only the
# base needs correcting.
deviceinfo_bootimg_custom_args="--base 0x00000000 --header_version 4"
# The pre-v3 path packs a ramdisk into boot.img. U-Boot never reads it -- it
# loads /boot/initramfs itself -- so the real one would be 12.7 MB rewritten to
# flash on every kernel update for nothing. Same dummy device-jolla-c2 uses.
deviceinfo_bootimg_override_initramfs="dummy-initramfs"

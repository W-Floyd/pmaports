# On top of multi_v7_defconfig: what the live image and the stage need.
CONFIG_BTRFS_FS=y

# Amlogic sets the highest TEXT_OFFSET of the platforms multi_v7 builds
# (arch/arm/Makefile textofs): the kernel linked at 0x208000, 2 MB of RAM wasted,
# and kexec-tools put the initramfs where the decompressor overwrote it. Nothing
# here is an Amlogic; without it the kernel links at 0x8000.
# CONFIG_ARCH_MESON is not set

# The panel is the bootloader's simple-framebuffer. As a DRM device (simpledrm)
# it gives GNOME's compositor the KMS it needs, and fbdev emulation keeps
# /dev/fb0 for the Boot Manager's UI and the console. simplefb binds the same
# node, so it goes.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FB_SIMPLE is not set

# The BCM4359's Bluetooth is an HCI UART (uart1). Built in: the stage carries no
# modules, and hci_bcm (already built in) needs the stack and BT_BCM in place.
CONFIG_BT=y
CONFIG_BT_BCM=y
CONFIG_BT_HCIUART=y

# The Mali-G51 (Bifrost), built in: the stage carries no modules, and probing at
# boot is the test.
CONFIG_DRM_PANFROST=y

# Compressed swap for 1.5 GiB of RAM: postmarketos-zram-swap runs `modprobe zram`
# and fails without it.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y

# The TCC803x RTC, built in: the stage carries no modules. Its DT node is not
# enabled yet.
CONFIG_RTC_DRV_TCC803X=y

# The OTG port's PHY (USB gadget mode, tcc803x-avn-gadget.dts), built in.
CONFIG_PHY_TCC803X_USB_OTG=y

# The hard keys arrive as micom frames, which micomd injects through uinput.
CONFIG_INPUT_UINPUT=y

# Audio: the I2S driver and the simple card, built in for the stage's audio test
# (tcc803x-avn-audio.dtb); multi_v7_defconfig has the sound core as modules.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_TCC803X_I2S=y
CONFIG_SND_SOC_SPDIF=y
CONFIG_SND_SIMPLE_CARD=y

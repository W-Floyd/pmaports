# On top of multi_v7_defconfig: what the live image and the stage need.
CONFIG_BTRFS_FS=y

# The panel is the bootloader's simple-framebuffer. As a DRM device (simpledrm)
# it gives GNOME's compositor the KMS it needs, and fbdev emulation keeps
# /dev/fb0 for the Boot Manager's UI and the console. simplefb binds the same
# node, so it goes.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FB_SIMPLE is not set

# The BCM4359's Bluetooth is an HCI UART (uart1). Built in: the stage carries no
# modules, and hci_bcm (already built in) needs the stack and BT_BCM in place.
CONFIG_BT=y
CONFIG_BT_BCM=y
CONFIG_BT_HCIUART=y

# Compressed swap for 1.5 GiB of RAM: postmarketos-zram-swap runs `modprobe zram`
# and fails without it.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y

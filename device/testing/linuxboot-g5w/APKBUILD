# Maintainer: William Floyd <git@notmy.space>
#
# The LinuxBoot stage for the G5W-Android head unit (Telechips TCC8031, armv7):
# u-root plus postmarketOS Boot Manager, as one initramfs. The vendor Android
# runs NEMESIS.sh from a USB stick, which kexecs a kernel with this as its
# initramfs. Same recipe as linuxboot-fogona, minus the kernel: here the kernel
# is a separate payload and this package is the initramfs alone.
#
# Machine-specific files are not in the package: the SSH keys, android.cmdline,
# the Wi-Fi modules and vendor firmware. `nura usb` appends them as a second
# cpio, which the kernel unpacks over this one.
#
# The Boot Manager's UI is its own package (bootmanager-ui, cross-compiled), and
# this one is cross-compiled too (pmb:cross-native): Go builds for armv7 natively,
# and the armv7 userland the stage carries (busybox, kexec, hostapd, the fsck
# tools, ...) is unpacked from the armv7 repository into a sysroot with
# `apk --usermode --arch armv7`. Nothing here runs armv7 code, so there is no
# ldd: shared libraries are found from the ELF headers with readelf.
#
# u-root and the Boot Manager come as tarballs of the commits in the pins below,
# made by `nura stage sync` from the container's worktrees (git archive), so
# unpushed commits build too.
pkgname=linuxboot-g5w
pkgver=0
pkgrel=0
pkgdesc="LinuxBoot stage with postmarketOS Boot Manager for the G5W-Android head unit"
url="https://github.com/W-Floyd/bootmanager"
arch="armv7"
license="GPL-2.0-only AND BSD-3-Clause AND GPL-3.0-or-later"
depends=""
makedepends="
	binutils
	cpio
	go
	"
# net: go fetches its modules, apk the armv7 packages
options="net !check !strip !tracedeps pmb:cross-native"

# Set by `nura stage sync`.
_uroot_commit=
_bm_commit=

source="
	u-root-$_uroot_commit.tar.gz
	bootmanager-$_bm_commit.tar.gz
	uinit.sh
	rekexec.sh
	kexec.sh
	kexec-prep.sh
	bt-up.sh
	passwd
	group
	kia-ev6.json
	"
builddir="$srcdir"

_uroot="$srcdir/u-root-$_uroot_commit"
_bm="$srcdir/bootmanager-$_bm_commit"
_out="$srcdir/out"
_sys="$srcdir/sysroot"

# Where an armv7 binary of the sysroot is.
_find() {
	local d
	for d in sbin usr/sbin bin usr/bin; do
		[ -f "$_sys/$d/$1" ] && echo "$_sys/$d/$1" && return 0
	done
	return 1
}

# Copy the shared libraries ELF FILE needs, and theirs, from the sysroot to DIR.
# readelf reads armv7 headers anywhere; nothing is executed.
_libs() {
	local todo="$1" f n p
	while [ -n "$todo" ]; do
		f=${todo%% *}; case "$todo" in *" "*) todo=${todo#* } ;; *) todo= ;; esac
		for n in $(readelf -d "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'); do
			case "$n" in libc.musl-*) continue ;; esac
			[ -e "$2/$n" ] && continue
			for p in "$_sys"/usr/lib/$n "$_sys"/lib/$n; do
				[ -e "$p" ] || continue
				cp -L "$p" "$2/$n"
				todo="$todo $2/$n"
				break
			done
		done
	done
}

build() {
	export GOPATH="$srcdir/go" GOCACHE="$srcdir/go-cache" GOFLAGS="-modcacherw"

	# The armv7 userland, from the armv7 repositories (and the local one, for
	# bootmanager-ui), into a sysroot. Scripts are not run: they would be armv7.
	local alpine=http://cdn.alpinelinux.org/alpine/edge
	apk add --usermode --root "$_sys" --initdb --arch armv7 --no-scripts --no-cache \
		--allow-untrusted --repositories-file /dev/null \
		-X $alpine/main -X $alpine/community -X /mnt/pmbootstrap/packages/edge \
		busybox-static kexec-tools hostapd dnsmasq wpa_supplicant \
		bluez bluez-deprecated bluez-btmon \
		e2fsprogs dosfstools exfatprogs f2fs-tools xfsprogs cryptsetup \
		bootmanager-ui

	# /opt/ap: static busybox, kexec, Wi-Fi AP and Bluetooth tools with their
	# musl libraries, where uinit.sh expects them. The fsck tools and cryptsetup
	# go under usr/libexec, their libraries in /lib (the loader's default path).
	mkdir -p "$_out"/ap/bin "$_out"/ap/lib "$_out"/fsck/usr/libexec/fsck \
		"$_out"/fsck/usr/libexec/cryptsetup "$_out"/fsck/lib
	for b in usr/sbin/hostapd usr/sbin/dnsmasq sbin/wpa_supplicant sbin/wpa_cli \
		usr/sbin/kexec usr/bin/hciconfig usr/bin/hcitool usr/bin/btmon; do
		cp -L "$_sys/$b" "$_out"/ap/bin/
		_libs "$_sys/$b" "$_out"/ap/lib
	done
	cp -L "$_sys"/bin/busybox.static "$_out"/ap/bin/busybox
	for b in e2fsck fsck.fat fsck.exfat fsck.f2fs xfs_repair; do
		_f=$(_find "$b") || die "no $b in the sysroot"
		cp -L "$_f" "$_out"/fsck/usr/libexec/fsck/
		_libs "$_f" "$_out"/fsck/lib
	done
	_f=$(_find cryptsetup) || die "no cryptsetup in the sysroot"
	cp -L "$_f" "$_out"/fsck/usr/libexec/cryptsetup/
	_libs "$_f" "$_out"/fsck/lib
	# The loader, under both its names (libs ask for the libc one).
	for d in "$_out"/ap/lib "$_out"/fsck/lib; do
		cp -L "$_sys"/lib/ld-musl-armhf.so.1 "$d"/ld-musl-armhf.so.1
		cp -L "$_sys"/lib/ld-musl-armhf.so.1 "$d"/libc.musl-armv7.so.1
	done

	# The workspace u-root builds the Boot Manager backend in, as a u-root command.
	mkdir -p "$_out"
	(cd "$_out" && go work init "$_uroot" "$_bm"/bootmanager)

	mkdir -p "$_out"/files
	cp -L "$srcdir"/uinit.sh "$srcdir"/rekexec.sh "$srcdir"/kexec.sh \
		"$srcdir"/kexec-prep.sh "$srcdir"/bt-up.sh "$srcdir"/passwd \
		"$srcdir"/group "$srcdir"/kia-ev6.json "$_out"/files/

	# u-root itself runs here; what it builds is armv7. No ELF is passed to
	# -files singly (that would make u-root run ldd): directories only, and the
	# static bootmanager-ui.
	(cd "$_uroot" && env -u GOARCH -u GOARM GOWORK=off go build -o "$_out"/u-root-bin . &&
		GOARCH=arm GOARM=7 CGO_ENABLED=0 GOWORK="$_out"/go.work "$_out"/u-root-bin \
			-o "$_out"/stage.cpio \
			-uinitcmd="gosh /etc/uinit.sh" \
			-tags dev \
			-files "$_out/files/uinit.sh:etc/uinit.sh" \
			-files "$_out/files/rekexec.sh:etc/rekexec.sh" \
			-files "$_out/files/kexec.sh:etc/kexec.sh" \
			-files "$_out/files/kexec-prep.sh:etc/kexec-prep.sh" \
			-files "$_out/files/bt-up.sh:etc/bt-up.sh" \
			-files "$_out/files/passwd:etc/passwd" \
			-files "$_out/files/group:etc/group" \
			-files "$_out/files/kia-ev6.json:etc/bootmanager/kia-ev6.json" \
			-files "$_sys/usr/bin/bootmanager-ui:bin/bootmanager-ui" \
			-files "$_out/ap/bin:opt/ap/bin" \
			-files "$_out/ap/lib:opt/ap/lib" \
			-files "$_out/fsck/usr:usr" \
			-files "$_out/fsck/lib:lib" \
			core boot cmds/exp/fdtdump "$_bm"/bootmanager "$_bm"/bootmanager/tools/micomd)
	# A dangling link in the initramfs leaves the stage at a bare shell
	cpio -itv < "$_out"/stage.cpio | grep -e ' etc/.* -> /' &&
		die "initramfs links to a build path"
	gzip -9 -f -k "$_out"/stage.cpio
}

package() {
	install -Dm644 "$_out"/stage.cpio.gz \
		"$pkgdir"/usr/share/$pkgname/stage.cpio.gz
}

sha512sums=""

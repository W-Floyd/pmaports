# Maintainer: William Floyd <git@notmy.space>
#
# micomd: answers the head unit's micom (the vehicle's microcontroller) over
# its serial link, as Android's daemon of the same name did. The micom resets
# the SoC as hung when its CPU-alive requests go unanswered (about 3.5 minutes
# after the vendor Android is gone), so whatever runs on the unit has to
# answer: the Boot Manager stage does itself, and this is the same code for the
# system the stage boots into (device-mobis-g5w starts it as a service).
#
# It lives in its own module, github.com/W-Floyd/go-micomd. Built from the
# module proxy at the version the Boot Manager requires (bootmanager/go.mod), so
# the stage and the system answer the micom with the same code. Bump _ver with it.
pkgname=micomd
pkgver=0
pkgrel=0
pkgdesc="Answers the head unit's micom so it does not reset the SoC as hung"
url="https://github.com/W-Floyd/go-micomd"
arch="armv7"
license="MIT"
makedepends="go"
# net: go fetches the module. No check: the link needs the hardware.
options="net !check"

_ver=v0.0.0-20261018143633-f6892283e832

source=""
builddir="$srcdir"

build() {
	# pmbootstrap's persistent Go caches, kept across builds
	export GOCACHE=/mnt/pmbootstrap/go/gocache GOMODCACHE=/mnt/pmbootstrap/go/gomodcache
	export GOPATH="$srcdir/go" GOFLAGS="-modcacherw" GOBIN="$builddir"
	CGO_ENABLED=0 go install -trimpath -ldflags="-s -w" \
		github.com/W-Floyd/go-micomd/cmd/micomd@$_ver
}

package() {
	install -Dm755 micomd "$pkgdir"/usr/bin/micomd
}

sha512sums=""

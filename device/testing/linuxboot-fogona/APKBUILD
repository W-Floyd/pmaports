# Maintainer: William Floyd <git@notmy.space>
#
# A LinuxBoot stage for fogona: a Linux kernel with its own device tree and
# a u-root initramfs, started by ABL from the boot partition in place of
# U-Boot. It runs postmarketOS Boot Manager, which lists the boot entries
# (the extlinux.conf boot-deploy writes), boots the default one by kexec
# after a countdown, and offers a Remote UI and SSH on the USB network.
# Background: /repo/investigations/boot-chain.md, "LinuxBoot".
#
# One of the two providers of fogona-bootloader; u-boot-fogona is the other.
# Whichever is installed is the payload boot-deploy wraps into the boot
# image (deviceinfo_bootimg_override_payload); `apk add u-boot-fogona` or
# `apk add linuxboot-fogona` switches, and the install script flashes it.
#
# Everything the stage runs is inside the kernel Image: with a built-in DTB
# the kernel never learns where ABL put a ramdisk. What the device holds and
# a package cannot -- the touch controller's firmware (a vendor blob) and the
# SSH keys -- the install script copies to linuxboot/ on the boot partition,
# and the stage's uinit takes them from there.
#
# The Boot Manager is built with -tags dev: it can take a kernel upload and
# kexec it, behind its Dev uploads service (off unless switched on in the UI
# or by a one-shot request, tools/linuxboot/dev.sh stage-hold).
pkgname=linuxboot-fogona
pkgver=0_git20260927
pkgrel=10
pkgdesc="LinuxBoot stage with postmarketOS Boot Manager for the Moto G Play (2024)"
url="https://github.com/W-Floyd/linux"
arch="aarch64"
license="GPL-2.0-only AND BSD-3-Clause AND GPL-3.0-or-later"
provides="fogona-bootloader=$pkgver-r$pkgrel"
provider_priority=100
replaces="u-boot-fogona"
depends="openssh-keygen"
makedepends="
	bash
	bc
	binutils
	bison
	cargo
	cpio
	cryptsetup
	dosfstools
	dtc
	e2fsprogs
	exfatprogs
	f2fs-tools
	file
	findutils
	flex
	go
	gmp-dev
	linux-headers
	mpc1-dev
	mpfr-dev
	openssl-dev
	perl
	python3
	rust
	unudhcpd
	xfsprogs
	"
# net: go and cargo fetch their modules and crates
options="net !check !strip !tracedeps"
install="$pkgname.post-install $pkgname.post-upgrade"

# Pinned commits, bumped together. The kernel is the tip of exp-linuxboot
# (TREES.md), the stage layer over fogona-mainline; u-root is branch
# fogona-linuxboot, upstream plus the arm64 kexec_load DTB patch; the Boot
# Manager is its main branch.
_kernel_commit="85ed2f030b185e4be40c80ce8f9115e215870f70"
_uroot_commit="015d488be82e48ee31d6b548b23045cd755aacf5"
_bm_commit="a4314875098733cf97cea3000689d1f74bbfb334"
_uroot_url="https://github.com/W-Floyd/u-root"
_bm_url="https://github.com/W-Floyd/bootmanager"

source="
	linux-$_kernel_commit.tar.gz::$url/archive/$_kernel_commit.tar.gz
	u-root-$_uroot_commit.tar.gz::$_uroot_url/archive/$_uroot_commit.tar.gz
	bootmanager-$_bm_commit.tar.gz::$_bm_url/archive/$_bm_commit.tar.gz
	config-linuxboot-fogona.aarch64
	uinit.sh
	fogona-boot.sh
	motorola-fogona.json
	"
builddir="$srcdir/linux-$_kernel_commit"

_uroot="$srcdir/u-root-$_uroot_commit"
_bm="$srcdir/bootmanager-$_bm_commit"
_out="$srcdir/out"

build() {
	export GOPATH="$srcdir/go" GOCACHE="$srcdir/go-cache" GOFLAGS="-modcacherw"
	export CARGO_TARGET_DIR="$srcdir/cargo-target" CARGO_HOME="$srcdir/cargo"
	# pmbootstrap points this at sccache without installing it
	unset RUSTC_WRAPPER

	# The Boot Manager's parts: its UI (a static binary) and the Go
	# workspace u-root builds its backend in. The web UI needs a
	# wasm-bindgen CLI matching the crate's pin; without one, build.sh
	# leaves it out and Remote UI's page reports it missing.
	TAGS=dev UROOT="$_uroot" sh "$_bm"/build.sh "$_out"

	# The initramfs. u-root copies a symlink as a symlink, and abuild's
	# local sources in $srcdir are symlinks into the build directory, so
	# they go in as copies. unudhcpd asks for libc.musl-aarch64.so.1, which
	# on Alpine is a symlink to the loader, so that name is added by hand.
	mkdir -p "$_out"/files
	cp -L "$srcdir"/uinit.sh "$srcdir"/fogona-boot.sh \
		"$srcdir"/motorola-fogona.json "$_out"/files/
	: > "$_out"/files/dev

	# The disk tools behind two optional Boot Manager features, Check and
	# Repair (ext4, FAT32, exFAT, f2fs, XFS) and Unlock (LUKS, cryptsetup):
	# copied, with the shared libraries they link, from this chroot. Alpine
	# ships them dynamic only, so the stage's musl loader runs them; the
	# libraries are found and added by u-root itself, as it does for
	# unudhcpd. The Boot Manager leaves a feature out of its UI when its
	# tool is missing (hello.fsck, hello.luks).
	_toolfiles=
	_pack() { # BINARY DESTDIR
		local src= d
		for d in /sbin /usr/sbin /bin /usr/bin; do
			[ -f "$d/$1" ] && src="$d/$1" && break
		done
		[ -n "$src" ] || die "no $1 to pack"
		_toolfiles="$_toolfiles -files $src:$2/$1"
	}
	for _b in e2fsck fsck.fat fsck.exfat fsck.f2fs xfs_repair; do
		_pack $_b usr/libexec/fsck
	done
	_pack cryptsetup usr/libexec/cryptsetup

	(cd "$_uroot" && GOWORK=off go build -o "$_out"/u-root-bin . &&
		GOWORK="$_out"/go.work GOARCH=arm64 "$_out"/u-root-bin \
			-o "$_out"/u-root.cpio \
			-uinitcmd="gosh /etc/uinit.sh" \
			-tags dev \
			-files "$_out/files/uinit.sh:etc/uinit.sh" \
			-files "$_out/files/fogona-boot.sh:etc/fogona-boot.sh" \
			-files "/usr/bin/unudhcpd:usr/bin/unudhcpd" \
			-files "/lib/ld-musl-aarch64.so.1:lib/libc.musl-aarch64.so.1" \
			-files "$_out/bootmanager-ui:bin/bootmanager-ui" \
			-files "$_out/files/motorola-fogona.json:etc/bootmanager/motorola-fogona.json" \
			-files "$_out/files/dev:etc/bootmanager/dev" \
			$_toolfiles \
			core boot cmds/exp/fdtdump "$_bm"/bootmanager)
	# A dangling link in the initramfs leaves the stage at a bare shell
	cpio -itv < "$_out"/u-root.cpio | grep -e ' etc/.* -> /' &&
		die "initramfs links to a build path"

	# The kernel, with the initramfs and the stage's device tree built in.
	mkdir -p .output
	cp "$srcdir"/config-linuxboot-fogona.aarch64 .output/.config
	./scripts/config --file .output/.config \
		--set-str INITRAMFS_SOURCE "$_out/u-root.cpio"
	make O=.output ARCH=arm64 LOCALVERSION= olddefconfig
	for want in 'CONFIG_BUILTIN_DTB=y' \
		'CONFIG_BUILTIN_DTB_NAME="qcom/sm6225-motorola-fogona-linuxboot"' \
		'CONFIG_TOUCHSCREEN_CHIPONE_ICNL9916=y' \
		'CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y' \
		'CONFIG_I2C_QCOM_GENI=y' 'CONFIG_BATTERY_CW221X=y' \
		'CONFIG_CHARGER_BQ25890=y' 'CONFIG_DM_CRYPT=y' \
		'CONFIG_F2FS_FS=y' 'CONFIG_EXFAT_FS=y' 'CONFIG_XFS_FS=y' \
		"CONFIG_INITRAMFS_SOURCE=\"$_out/u-root.cpio\""; do
		grep -qxF "$want" .output/.config || die ".config lacks $want"
	done
	make O=.output ARCH=arm64 LOCALVERSION= Image dtbs
}

package() {
	local _image="$builddir"/.output/arch/arm64/boot/Image

	# ABL refuses an arm64 header whose text_offset is not 0.
	[ "$(od -An -tx8 -j8 -N8 "$_image" | tr -d ' ')" = 0000000000000000 ] ||
		die "text_offset is not 0"

	# The fogona-bootloader interface: the payload boot-deploy wraps, in
	# the directory mkinitfs stages (deviceinfo_uboot_boardname).
	install -Dm644 "$_image" \
		"$pkgdir"/usr/share/u-boot/fogona/fogona-bootloader.bin
}

